#!/usr/bin/env bash
set -Eeuo pipefail

die() {
	echo "REFUSED: $*" >&2
	exit 1
}

usage() {
	echo "usage: $0 [--apply] <printer-host> <app>" >&2
	exit 2
}

apply=0
if [[ $# == 3 && $1 == --apply ]]; then
	apply=1
	shift
elif [[ $# != 2 ]]; then
	usage
fi

host=$1
app=$2
[[ -n $host && $host != -* ]] || usage
[[ $app =~ ^[a-z][a-z0-9_-]{0,63}$ ]] || die "invalid app name"

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
source=$root/apps/$app/service
remote_root=/tmp/fre3nder-app-source
remote_dir=$remote_root/apps/$app
remote_service=$remote_dir/service

[[ -f $source && ! -L $source ]] ||
	die "local app definition is missing, non-regular, or a symlink: $source"
[[ $(head -n 1 -- "$source") == '#!/bin/sh' ]] ||
	die "local app definition must begin with #!/bin/sh: $source"
local_sha=$(sha256sum "$source" | awk '{print $1}')

root_status=$(
	ssh -o BatchMode=yes "$host" \
		'cat /run/fre3nder-root/status 2>/dev/null'
) || die "cannot read Fre3nder persistent-root status"

[[ $root_status == active ]] ||
	die "Fre3nder persistent root is not active"

remote_write="set -eu
for directory in '$remote_root' '$remote_root/apps' '$remote_dir'; do
	if [ -e \"\$directory\" ] || [ -L \"\$directory\" ]; then
		[ -d \"\$directory\" ] && [ ! -L \"\$directory\" ] || exit 1
	else
		mkdir -m 0700 \"\$directory\"
	fi
done
if [ -e '$remote_service' ] || [ -L '$remote_service' ]; then
	[ -f '$remote_service' ] && [ ! -L '$remote_service' ] || exit 1
fi
cat > '$remote_service'
chmod 0755 '$remote_service'"

ssh -o BatchMode=yes "$host" "$remote_write" < "$source" ||
	die "app definition transfer failed"

remote_sha=$(
	ssh -o BatchMode=yes "$host" "sha256sum '$remote_service'" |
		awk '{print $1}'
) || die "cannot verify transferred app definition"

[[ $remote_sha == "$local_sha" ]] ||
	die "transferred app definition SHA256 mismatch"

if ssh -o BatchMode=yes "$host" \
	"FRE3NDER_APP_SOURCE_DIR=$remote_root /usr/bin/fre3nder install '$app'"; then
	:
else
	rc=$?
	exit "$rc"
fi

[[ $apply == 1 ]] || exit 0

if ssh -o BatchMode=yes "$host" \
	'/etc/init.d/S61fre3nder-moonraker restart'; then
	:
else
	rc=$?
	exit "$rc"
fi

exec ssh -o BatchMode=yes "$host" \
	'/etc/init.d/S62fre3nder-web restart'
