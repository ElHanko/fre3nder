#!/usr/bin/env python3

import json
import pathlib
import sys


if len(sys.argv) != 2 or not sys.argv[1] or "" in sys.argv[1].split("."):
    raise SystemExit("usage: source-value dotted.path")

sources = pathlib.Path(__file__).resolve().parent.parent / "configs/x2000/sources.json"
value = json.loads(sources.read_text(encoding="utf-8"))
for key in sys.argv[1].split("."):
    if not isinstance(value, dict) or key not in value:
        raise SystemExit(f"unknown source path: {sys.argv[1]}")
    value = value[key]

if isinstance(value, (dict, list)):
    raise SystemExit(f"source path is not scalar: {sys.argv[1]}")

print(value if isinstance(value, str) else json.dumps(value))
