#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(cat "$root/VERSION")
image="ender3-v3-ke-fre3nder-x2000:$version"
runtime_user=$(id -u):$(id -g)
work_root="$root/local/production/work/x2000"
docker_cmd=${X2000_BUILD_DOCKER:-docker}
artifact_mode=release

usage() {
	echo "usage: $0 [--develop]" >&2
	exit 2
}

case "${1:-}" in
'') ;;
--develop) artifact_mode=development ;;
*) usage ;;
esac

[ "$#" -le 1 ] || usage
local_source=${FRE3NDER_FRE3NDERSCREEN_SOURCE:-}
if [ -n "$local_source" ]; then
	[ "$artifact_mode" = development ] || {
		echo 'local Fre3nderScreen source requires --develop' >&2; exit 2;
	}
	local_source=$(CDPATH='' cd -- "$local_source" && pwd -P)
	git -C "$local_source" rev-parse --show-toplevel >/dev/null
elif [ "$artifact_mode" = development ] && [ -d "$root/../fre3nderscreen/.git" ] &&
	[ -n "$(git -C "$root/../fre3nderscreen" status --porcelain=v1)" ]; then
	echo 'local Screen changes exist: set FRE3NDER_FRE3NDERSCREEN_SOURCE to build them instead of remote main' >&2
	exit 1
fi

# Local sources are copied explicitly; their repository is never mounted.
git -C "$root" check-ignore -q local/production
inputs=$(mktemp -d)
trap 'rm -rf -- "$inputs"' EXIT HUP INT TERM
python3 "$root/scripts/x2000-build-input-sha256" --root "$root" --snapshot "$inputs/project"
artifact_root="$root/local/production/artifacts/x2000"
mkdir -p "$work_root" "$artifact_root"
set --
if [ -n "$local_source" ]; then
	python3 "$root/build/x2000/snapshot-fre3nderscreen.py" "$local_source" "$work_root/fre3nderscreen-source"
	set -- -e FRE3NDER_SCREEN_LOCAL_SOURCE=prepared
fi

"$docker_cmd" build -t "$image" "$inputs/project/build/x2000"
"$docker_cmd" run --rm --user "$runtime_user" \
	-e "FRE3NDER_ARTIFACT_MODE=$artifact_mode" \
	-v "$inputs/project:/project:ro" \
	-v "$work_root:/work" \
	"$@" "$image" fetch-fre3nderscreen
"$docker_cmd" run --rm --network none --user "$runtime_user" \
	-e "FRE3NDER_ARTIFACT_MODE=$artifact_mode" \
	-v "$inputs/project:/project:ro" \
	-v "$work_root:/work" \
	-v "$artifact_root:/artifacts" \
	"$@" "$image" build-fre3nderscreen-app

artifact_dir="$root/local/production/artifacts/x2000/fre3nderscreen"
for member in app/bin/fre3nderscreen app/artifact-manifest.json app/SHA256SUMS; do
	[ -f "$artifact_dir/$member" ] && [ ! -L "$artifact_dir/$member" ] || {
		echo "Fre3nderScreen build finished without $member" >&2
		exit 1
	}
done
(cd "$artifact_dir/app" && sha256sum -c SHA256SUMS)

artifact_sha=$(sha256sum "$artifact_dir/app/artifact-manifest.json" | awk '{print $1}')

printf '\n'
printf '%s\n' '=== Fre3nderScreen app artifact build: PASS ==='
printf 'Mode:     %s\n' "$artifact_mode"
printf 'Artifact: %s\n' "$artifact_dir/app"
printf 'Manifest: %s\n' "$artifact_sha"
