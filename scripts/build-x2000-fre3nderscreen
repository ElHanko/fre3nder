#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(cat "$root/VERSION")
image="ender3-v3-ke-fre3nder-x2000:$version"
runtime_user=$(id -u):$(id -g)
work_root="$root/local/production/work/x2000"
docker_cmd=${X2000_BUILD_DOCKER:-docker}
artifact_mode=release

usage() {
	echo "usage: $0 [--develop]" >&2
	exit 2
}

case "${1:-}" in
'') ;;
--develop) artifact_mode=development ;;
*) usage ;;
esac

git -C "$root" check-ignore -q local/production
"$docker_cmd" build -t "$image" "$root/build/x2000"
mkdir -p "$work_root"
"$docker_cmd" run --rm --user "$runtime_user" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" fetch-fre3nderscreen
"$docker_cmd" run --rm --network none --user "$runtime_user" \
	-e "FRE3NDER_ARTIFACT_MODE=$artifact_mode" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" build-fre3nderscreen-component

artifact_dir="$root/local/production/artifacts/x2000/fre3nderscreen"
artifact="$artifact_dir/rootfs-overlay.tar"
manifest="$artifact_dir/component-manifest.json"

[ -f "$artifact" ] && [ ! -L "$artifact" ] || {
	echo 'Fre3nderScreen component build finished without rootfs-overlay.tar' >&2
	exit 1
}

[ -f "$manifest" ] && [ ! -L "$manifest" ] || {
	echo 'Fre3nderScreen component build finished without component-manifest.json' >&2
	exit 1
}

artifact_sha=$(sha256sum "$artifact" | awk '{print $1}')

printf '\n'
printf '%s\n' '=== Fre3nderScreen component build: PASS ==='
printf 'Mode:     %s\n' "$artifact_mode"
printf 'Artifact: %s\n' "$artifact"
printf 'SHA256:   %s\n' "$artifact_sha"
