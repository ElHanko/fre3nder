#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

artifact_dir=${X2000_DEPLOY_ARTIFACT_DIR:-"$root/local/production/artifacts/x2000/full"}
ssh_cmd=${X2000_DEPLOY_SSH:-ssh}
ab_cmd=${X2000_DEPLOY_AB:-"$root/scripts/x2000-ab"}
boot_timeout=${X2000_DEPLOY_BOOT_TIMEOUT:-120}
boot_poll=${X2000_DEPLOY_BOOT_POLL:-2}

mode=preflight
develop_mode=false
stock_mode=false
stock_source=${X2000_DEPLOY_STOCK_DIR:-"$root/local/backup/stock/image"}
deploy_kernel=false
deploy_rootfs=false
component_seen=false
all_seen=false

host=

active_slot=
target_slot=
selector_slot=

active_kernel_device=
active_root_device=
target_kernel_device=
target_root_device=

target_kernel_number=
target_root_number=

kernel_size=
kernel_sha=
rootfs_size=
rootfs_sha=
manifest_commit=
manifest_artifact_mode=
manifest_build_input_sha256=

tmp=

cleanup() {
	local result=$?
	trap - EXIT HUP INT TERM
	[ -z "$tmp" ] || rm -rf -- "$tmp"
	exit "$result"
}

usage() {
	cat >&2 <<EOF
usage:
  $0 <active-host> [OPTIONS]

components:
  --kernel    stage only the kernel in the inactive A/B slot;
              requires --develop when used without --rootfs
  --rootfs    stage only the RootFS in the inactive A/B slot;
              requires --develop when used without --kernel
  --all       stage kernel + RootFS

If no component option is given, --all is implied.
Without --develop, a Fre3nder deployment always requires kernel + RootFS.

stock restore:
  --stock [DIR]
              stage a complete Stock A p5/p7 pair
              default DIR: local/backup/stock/image

--stock cannot be combined with --kernel, --rootfs, --all, or --develop.

execution:
  default     fail-closed read-only preflight
  --write     write and verify the selected inactive-slot artifacts;
              normal Fre3nder deployment then activates and boots that slot
  --develop   accept a fingerprint-matched development artifact;
              does not imply --write or relax hardware safety gates

Normal Fre3nder --write prepares a clean SYS transition, selects the verified
target slot, reboots, and validates the new boot. --stock --write stages Stock A
only and does not change the selector or reboot.
EOF
	exit 2
}

die() {
	echo "REFUSED: $*" >&2
	exit 1
}

require_regular_file() {
	[ -f "$1" ] && [ ! -L "$1" ] ||
		die "missing or non-regular file: $1"
}

field() {
	local name=$1

	awk -F= -v name="$name" '
		$1 == name {
			count++
			value = substr($0, length(name) + 2)
		}
		END {
			if (count != 1)
				exit 1
			print value
		}
	'
}

selected() {
	[ "$1" = true ]
}

sums_sha() {
	local sums=$1
	local filename=$2

	awk -v expected="$filename" '
		NF == 2 {
			file = $2
			sub(/^\\*/, "", file)

			if (file == expected) {
				count++
				hash = $1
			}
		}

		END {
			if (count != 1)
				exit 1

			if (length(hash) != 64 || hash !~ /^[0-9a-f]+$/)
				exit 1

			print hash
		}
	' "$sums"
}

plan_value() {
	local enabled=$1

	if [ "$enabled" != true ]; then
		printf '%s\n' SKIP
	elif [ "$mode" = write ]; then
		printf '%s\n' WRITE
	else
		printf '%s\n' CHECK
	fi
}

verify_local_artifacts() {
	local sums=$artifact_dir/SHA256SUMS
	local manifest=$artifact_dir/build-manifest.json
	local kernel=$artifact_dir/kernel.uImage
	local rootfs=$artifact_dir/rootfs.squashfs
	local -a manifest_output
	local -a build_inputs
	local current_build_input_sha256

	require_regular_file "$sums"
	require_regular_file "$manifest"

	if selected "$deploy_kernel"; then
		local expected_kernel_sha

		require_regular_file "$kernel"

		kernel_size=$(wc -c < "$kernel")
		kernel_sha=$(sha256sum "$kernel" | awk '{print $1}')

		expected_kernel_sha=$(
			sums_sha "$sums" kernel.uImage
		) || die "SHA256SUMS has no unique valid kernel.uImage entry"

		[ "$kernel_sha" = "$expected_kernel_sha" ] ||
			die "kernel checksum differs from SHA256SUMS"

		[ "$kernel_size" -lt 8388608 ] ||
			die "kernel is not strictly smaller than an 8 MiB kernel slot"
	fi

	if selected "$deploy_rootfs"; then
		local expected_rootfs_sha

		require_regular_file "$rootfs"

		rootfs_size=$(wc -c < "$rootfs")
		rootfs_sha=$(sha256sum "$rootfs" | awk '{print $1}')

		expected_rootfs_sha=$(
			sums_sha "$sums" rootfs.squashfs
		) || die "SHA256SUMS has no unique valid rootfs.squashfs entry"

		[ "$rootfs_sha" = "$expected_rootfs_sha" ] ||
			die "RootFS checksum differs from SHA256SUMS"

		[ "$rootfs_size" -lt 524288000 ] ||
			die "RootFS is not strictly smaller than a 500 MiB RootFS slot"
	fi

	mapfile -t manifest_output < <(
		python3 - \
			"$manifest" \
			"$deploy_kernel" \
			"$kernel_sha" \
			"$deploy_rootfs" \
			"$rootfs_sha" \
			"$develop_mode" <<'PY'
import json
import pathlib
import re
import sys

(
    manifest_path,
    use_kernel,
    kernel_sha,
    use_rootfs,
    rootfs_sha,
    develop_mode,
) = sys.argv[1:]

manifest = json.loads(
    pathlib.Path(manifest_path).read_text(encoding="utf-8")
)

commit = manifest.get("project_commit")

if not isinstance(commit, str) or re.fullmatch(r"[0-9a-f]{40}", commit) is None:
    raise SystemExit("invalid project_commit")

artifact_mode = manifest.get("artifact_mode")
if artifact_mode not in ("release", "development"):
    raise SystemExit("invalid artifact_mode")

worktree_status = manifest.get("project_worktree_status")
build_input_sha256 = manifest.get("build_input_sha256", "")

if artifact_mode == "development":
    if develop_mode != "true":
        raise SystemExit("development artifact requires --develop")
    if worktree_status not in ("clean", "dirty"):
        raise SystemExit("invalid development worktree status")
    if re.fullmatch(r"[0-9a-f]{64}", build_input_sha256) is None:
        raise SystemExit("invalid development build-input fingerprint")
else:
    if worktree_status != "clean":
        raise SystemExit("release artifact was not built from a clean worktree")
    if build_input_sha256:
        raise SystemExit("release artifact has a development fingerprint")

artifacts = manifest.get("artifacts")

if not isinstance(artifacts, dict):
    raise SystemExit("invalid artifact map")

if use_kernel == "true":
    if artifacts.get("kernel.uImage") != kernel_sha:
        raise SystemExit("kernel differs from build manifest")

if use_rootfs == "true":
    if artifacts.get("rootfs.squashfs") != rootfs_sha:
        raise SystemExit("RootFS differs from build manifest")

print(commit)
print(artifact_mode)
print(build_input_sha256)
PY
	) || die "build manifest verification failed"

	[ "${#manifest_output[@]}" -eq 3 ] ||
		die "invalid build manifest verification output"

	manifest_commit=${manifest_output[0]}
	manifest_artifact_mode=${manifest_output[1]}
	manifest_build_input_sha256=${manifest_output[2]}

	git -C "$root" cat-file -e "${manifest_commit}^{commit}" 2>/dev/null ||
		die "artifact source commit is unavailable"

	git -C "$root" merge-base --is-ancestor \
		"$manifest_commit" HEAD 2>/dev/null ||
		die "artifact source commit is not an ancestor of HEAD"

	if [ "$manifest_artifact_mode" = development ]; then
		current_build_input_sha256=$(
			"$root/scripts/x2000-build-input-sha256" --root "$root"
		) || die "cannot fingerprint current X2000 build inputs"

		[ "$current_build_input_sha256" = "$manifest_build_input_sha256" ] ||
			die "current X2000 build inputs differ from development artifact"
	else
		mapfile -t build_inputs < <(
			"$root/scripts/x2000-build-input-sha256" --list-inputs
		)

		[ "${#build_inputs[@]}" -gt 0 ] ||
			die "X2000 build-input list is empty"

		git -C "$root" diff --quiet \
			"$manifest_commit"..HEAD \
			-- "${build_inputs[@]}" ||
			die "X2000 build inputs changed since artifact creation"

		git -C "$root" diff --quiet \
			-- "${build_inputs[@]}" ||
			die "uncommitted X2000 build-input changes exist"

		git -C "$root" diff --cached --quiet \
			-- "${build_inputs[@]}" ||
			die "staged X2000 build-input changes exist"
	fi

	echo "artifact source commit: $manifest_commit"
	echo "artifact mode: $manifest_artifact_mode"
	if [ "$manifest_artifact_mode" = development ]; then
		echo "build-input SHA256: $manifest_build_input_sha256"
	fi

	if selected "$deploy_kernel"; then
		echo "kernel artifact size: $kernel_size"
		echo "kernel artifact SHA256: $kernel_sha"
	fi

	if selected "$deploy_rootfs"; then
		echo "RootFS artifact size: $rootfs_size"
		echo "RootFS artifact SHA256: $rootfs_sha"
	fi
}


verify_stock_artifacts() {
	local sums=$stock_source/SHA256SUMS
	local kernel=$stock_source/p5.img
	local rootfs=$stock_source/p7.img
	local expected_kernel_sha
	local expected_rootfs_sha

	require_regular_file "$sums"
	require_regular_file "$kernel"
	require_regular_file "$rootfs"

	kernel_size=$(wc -c < "$kernel")
	rootfs_size=$(wc -c < "$rootfs")

	[ "$kernel_size" -eq 8388608 ] ||
		die "Stock p5.img is not exactly 8 MiB"

	[ "$rootfs_size" -eq 524288000 ] ||
		die "Stock p7.img is not exactly 500 MiB"

	kernel_sha=$(sha256sum "$kernel" | awk '{print $1}')
	rootfs_sha=$(sha256sum "$rootfs" | awk '{print $1}')

	expected_kernel_sha=$(
		sums_sha "$sums" p5.img
	) || die "SHA256SUMS has no unique valid p5.img entry"

	expected_rootfs_sha=$(
		sums_sha "$sums" p7.img
	) || die "SHA256SUMS has no unique valid p7.img entry"

	[ "$kernel_sha" = "$expected_kernel_sha" ] ||
		die "Stock p5.img checksum differs from SHA256SUMS"

	[ "$rootfs_sha" = "$expected_rootfs_sha" ] ||
		die "Stock p7.img checksum differs from SHA256SUMS"

	echo "stock source: $stock_source"
	echo "Stock p5 image size: $kernel_size"
	echo "Stock p5 image SHA256: $kernel_sha"
	echo "Stock p7 image size: $rootfs_size"
	echo "Stock p7 image SHA256: $rootfs_sha"
}

ab_status() {
	local target_host=$1

	"$ab_cmd" "$target_host" status ||
		die "cannot obtain x2000-ab status from $target_host"
}

detect_slots() {
	local status
	local classification

	status=$(ab_status "$host")

	active_root_device=$(
		printf '%s\n' "$status" |
			field ACTIVE_ROOT
	) || die "invalid ACTIVE_ROOT from $host"

	classification=$(
		printf '%s\n' "$status" |
			field CLASSIFICATION
	) || die "invalid selector classification from $host"

	[ "$(printf '%s\n' "$status" | field P1_DEVICE)" = /dev/mmcblk0p1 ] ||
		die "$host p1 device identity is invalid"

	[ "$(printf '%s\n' "$status" | field P1_PARTITION_NUMBER)" = 1 ] ||
		die "$host p1 partition number is invalid"

	[ "$(printf '%s\n' "$status" | field P1_START)" = 2048 ] ||
		die "$host p1 start is invalid"

	[ "$(printf '%s\n' "$status" | field P1_SECTORS)" = 2048 ] ||
		die "$host p1 size is invalid"

	[ "$(printf '%s\n' "$status" | field P1_IDENTITY)" = VALID ] ||
		die "$host p1 identity is invalid"

	case "$classification" in
	STOCK_A)
		selector_slot=A
		;;
	DEVELOP_B)
		selector_slot=B
		;;
	*)
		die "$host selector classification is unknown"
		;;
	esac

	case "$active_root_device" in
	/dev/mmcblk0p7)
		active_slot=A
		target_slot=B
		active_kernel_device=/dev/mmcblk0p5
		target_kernel_device=/dev/mmcblk0p6
		target_root_device=/dev/mmcblk0p8
		target_kernel_number=6
		target_root_number=8
		;;
	/dev/mmcblk0p8)
		active_slot=B
		target_slot=A
		active_kernel_device=/dev/mmcblk0p6
		target_kernel_device=/dev/mmcblk0p5
		target_root_device=/dev/mmcblk0p7
		target_kernel_number=5
		target_root_number=7
		;;
	*)
		die "$host active root is $active_root_device, expected p7 or p8"
		;;
	esac

	[ "$selector_slot" = "$active_slot" ] ||
		die "selector points to slot $selector_slot while slot $active_slot is active; inactive-slot staging is unsafe until the selector points to the active slot"

	echo "active slot: $active_slot"
	echo "active root: $active_root_device"
	echo "selector slot: $selector_slot"
	echo "target slot: $target_slot"
}


verify_stock_target() {
	[ "$active_slot" = B ] ||
		die "--stock requires slot B to be active"

	[ "$selector_slot" = B ] ||
		die "--stock requires the selector to point to slot B"

	[ "$target_slot" = A ] ||
		die "--stock requires slot A to be inactive"

	[ "$target_kernel_device" = /dev/mmcblk0p5 ] ||
		die "--stock kernel target is not p5"

	[ "$target_root_device" = /dev/mmcblk0p7 ] ||
		die "--stock RootFS target is not p7"
}

slot_metadata() {
	"$ssh_cmd" -o BatchMode=yes "$host" 'sh -eu' <<'REMOTE'
fail() {
	echo "REMOTE REFUSED: $*" >&2
	exit 1
}

root_count=0
active_root=

for argument in $(cat /proc/cmdline); do
	case "$argument" in
	root=*)
		active_root=${argument#root=}
		root_count=$((root_count + 1))
		;;
	esac
done

[ "$root_count" -eq 1 ] ||
	fail "expected exactly one root= argument"

for item in \
	"5:kernel:16384" \
	"6:kernel2:16384" \
	"7:rootfs:1024000" \
	"8:rootfs2:1024000"
do
	number=${item%%:*}
	rest=${item#*:}
	label=${rest%%:*}
	expected_sectors=${rest#*:}
	device=/dev/mmcblk0p${number}

	[ -b "$device" ] ||
		fail "p$number is not a block device"

	[ "$(readlink -f "$device")" = "$device" ] ||
		fail "p$number device identity mismatch"

	[ -r "/sys/class/block/mmcblk0p${number}/partition" ] ||
		fail "p$number partition metadata is absent"

	[ "$(cat "/sys/class/block/mmcblk0p${number}/partition")" = "$number" ] ||
		fail "p$number partition number mismatch"

	[ -r "/sys/class/block/mmcblk0p${number}/size" ] ||
		fail "p$number size metadata is absent"

	[ "$(cat "/sys/class/block/mmcblk0p${number}/size")" = "$expected_sectors" ] ||
		fail "p$number size mismatch"

	label_state=ABSENT_INFRASTRUCTURE

	if [ -e /dev/disk/by-partlabel ] ||
		[ -L /dev/disk/by-partlabel ]; then

		[ -d /dev/disk/by-partlabel ] ||
			fail "partlabel infrastructure is invalid"

		[ -e "/dev/disk/by-partlabel/$label" ] ||
		[ -L "/dev/disk/by-partlabel/$label" ] ||
			fail "$label partlabel is absent"

		[ "$(readlink -f "/dev/disk/by-partlabel/$label")" = "$device" ] ||
			fail "$label does not resolve to $device"

		label_state=VALID
	fi

	mounted=NO

	while read -r mounted_device _; do
		if [ "$mounted_device" = "$device" ]; then
			mounted=YES
			break
		fi
	done < /proc/mounts

	echo "P${number}_DEVICE=$device"
	echo "P${number}_PARTLABEL=$label_state"
	echo "P${number}_PARTITION_NUMBER=$number"
	echo "P${number}_SECTORS=$expected_sectors"
	echo "P${number}_MOUNTED=$mounted"
done

echo "ACTIVE_ROOT=$active_root"
REMOTE
}

verify_partition_metadata() {
	local metadata=$1
	local number=$2
	local expected_sectors=$3
	local role=$4
	local device=/dev/mmcblk0p${number}
	local label_state

	[ "$(printf '%s\n' "$metadata" | field "P${number}_DEVICE")" = "$device" ] ||
		die "$host $role device is invalid"

	[ "$(printf '%s\n' "$metadata" | field "P${number}_PARTITION_NUMBER")" = "$number" ] ||
		die "$host $role partition number is invalid"

	[ "$(printf '%s\n' "$metadata" | field "P${number}_SECTORS")" = "$expected_sectors" ] ||
		die "$host $role size is invalid"

	label_state=$(
		printf '%s\n' "$metadata" |
			field "P${number}_PARTLABEL"
	) || die "$host $role partlabel state is invalid"

	case "$label_state" in
	VALID|ABSENT_INFRASTRUCTURE)
		;;
	*)
		die "$host $role partlabel state is invalid"
		;;
	esac

	[ "$(printf '%s\n' "$metadata" | field "P${number}_MOUNTED")" = NO ] ||
		die "$host $role target $device is mounted"
}

verify_target_metadata() {
	local metadata

	metadata=$(slot_metadata) ||
		die "slot metadata verification failed on $host"

	[ "$(printf '%s\n' "$metadata" | field ACTIVE_ROOT)" = "$active_root_device" ] ||
		die "$host active root changed during deployment"

	if selected "$deploy_kernel"; then
		verify_partition_metadata \
			"$metadata" \
			"$target_kernel_number" \
			16384 \
			kernel
	fi

	if selected "$deploy_rootfs"; then
		verify_partition_metadata \
			"$metadata" \
			"$target_root_number" \
			1024000 \
			RootFS
	fi
}

active_hashes() {
	"$ssh_cmd" -o BatchMode=yes "$host" \
		"sha256sum '$active_kernel_device' '$active_root_device'"
}

arm_system_persistence_reset() {
	local output

	output=$(
		"$ssh_cmd" -o BatchMode=yes "$host" \
			"TARGET_ROOT='$target_root_device' sh -eu" <<'REMOTE'
fail() {
	echo "REMOTE REFUSED: $*" >&2
	exit 1
}

case "$TARGET_ROOT" in
/dev/mmcblk0p7|/dev/mmcblk0p8)
	;;
*)
	fail "target root is invalid"
	;;
esac

status_file=/run/fre3nder-root/status
system_mount=/run/fre3nder-root/system

[ -f "$status_file" ] &&
[ ! -L "$status_file" ] &&
[ "$(cat "$status_file")" = active ] ||
	fail "Fre3nder persistent root is not active"

[ -d "$system_mount" ] &&
[ ! -L "$system_mount" ] ||
	fail "system persistence mountpoint is invalid"

mount_count=0

while read -r _ mounted_path mounted_type mounted_options _; do
	[ "$mounted_path" = "$system_mount" ] || continue

	mount_count=$((mount_count + 1))

	[ "$mounted_type" = ext4 ] ||
		fail "system persistence is not ext4"

	case ",$mounted_options," in
	*,rw,*)
		;;
	*)
		fail "system persistence is not writable"
		;;
	esac
done < /proc/mounts

[ "$mount_count" -eq 1 ] ||
	fail "system persistence mount is not unique"

legacy_marker=$system_mount/.fre3nder-reset
marker=$system_mount/.fre3nder-reset-target
temporary=$system_mount/.fre3nder-reset-target.tmp.$$

cleanup() {
	rm -f "$temporary" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

[ ! -e "$temporary" ] && [ ! -L "$temporary" ] ||
	fail "temporary reset marker already exists"

[ ! -e "$legacy_marker" ] && [ ! -L "$legacy_marker" ] ||
	fail "legacy system reset marker is already pending"

if [ -e "$marker" ] || [ -L "$marker" ]; then
	[ -f "$marker" ] && [ ! -L "$marker" ] ||
		fail "targeted reset marker is invalid"

	rm -f "$marker" ||
		fail "cannot replace targeted reset marker"
fi

umask 077
printf 'RESET_ON_NEXT_BOOT_ROOT=%s\n' "$TARGET_ROOT" > "$temporary" ||
	fail "cannot write temporary reset marker"

[ -f "$temporary" ] &&
[ ! -L "$temporary" ] &&
[ "$(cat "$temporary")" = "RESET_ON_NEXT_BOOT_ROOT=$TARGET_ROOT" ] ||
	fail "temporary reset marker verification failed"

mv -f "$temporary" "$marker" ||
	fail "cannot install targeted reset marker"

sync

[ -f "$marker" ] &&
[ ! -L "$marker" ] &&
[ "$(cat "$marker")" = "RESET_ON_NEXT_BOOT_ROOT=$TARGET_ROOT" ] ||
	fail "targeted reset marker verification failed"

trap - EXIT HUP INT TERM

echo "SYSTEM_PERSISTENCE_RESET_MARKER=PASS"
REMOTE
	) || die "cannot arm targeted system persistence reset"

	printf '%s\n' "$output"
}

activate_target_slot() {
	local action
	local expected_class
	local status
	local actual_root
	local actual_class

	case "$target_slot" in
	A)
		action=select-a
		expected_class=STOCK_A
		;;
	B)
		action=select-b
		expected_class=DEVELOP_B
		;;
	*)
		die "target slot is invalid"
		;;
	esac

	"$ab_cmd" "$host" "$action" ||
		die "$action failed"

	status=$(ab_status "$host") ||
		die "cannot verify target selector"

	actual_root=$(
		printf '%s\n' "$status" |
			field ACTIVE_ROOT
	) || die "cannot verify active root before reboot"

	actual_class=$(
		printf '%s\n' "$status" |
			field CLASSIFICATION
	) || die "cannot verify selector before reboot"

	[ "$actual_root" = "$active_root_device" ] ||
		die "active root changed before reboot"

	[ "$actual_class" = "$expected_class" ] ||
		die "target selector verification failed"

	echo "target selector: $target_slot"
}

request_reboot() {
	"$ssh_cmd" -o BatchMode=yes "$host" \
		'sync; reboot' >/dev/null 2>&1 || :
}

wait_for_target_boot() {
	local expected_class
	local deadline
	local status
	local actual_root
	local actual_class

	case "$target_slot" in
	A)
		expected_class=STOCK_A
		;;
	B)
		expected_class=DEVELOP_B
		;;
	*)
		die "target slot is invalid"
		;;
	esac

	deadline=$((SECONDS + boot_timeout))

	while [ "$SECONDS" -lt "$deadline" ]; do
		if status=$(ab_status "$host" 2>/dev/null); then
			actual_root=$(
				printf '%s\n' "$status" |
					field ACTIVE_ROOT 2>/dev/null
			) || actual_root=

			actual_class=$(
				printf '%s\n' "$status" |
					field CLASSIFICATION 2>/dev/null
			) || actual_class=

			if [ "$actual_root" = "$target_root_device" ] &&
				[ "$actual_class" = "$expected_class" ]; then

				echo "booted target slot: $target_slot"
				echo "booted root: $actual_root"
				return
			fi
		fi

		sleep "$boot_poll"
	done

	die "target slot did not become reachable within ${boot_timeout}s"
}

verify_fre3nder_runtime() {
	"$ssh_cmd" -o BatchMode=yes "$host" 'sh -eu' <<'REMOTE'
fail() {
	echo "REMOTE REFUSED: $*" >&2
	exit 1
}

[ -f /run/fre3nder-root/status ] &&
[ ! -L /run/fre3nder-root/status ] &&
[ "$(cat /run/fre3nder-root/status)" = active ] ||
	fail "Fre3nder persistent root is not active"

mount_contract() {
	path=$1
	type=$2
	mode=$3

	awk -v path="$path" -v type="$type" -v mode="$mode" '
		$2 == path && $3 == type {
			n = split($4, options, ",")
			mode_found = 0

			for (i = 1; i <= n; i++)
				if (options[i] == mode)
					mode_found = 1

			if (mode_found)
				found++
		}

		END {
			if (found != 1)
				exit 1
		}
	' /proc/mounts
}

mount_contract / overlay rw ||
	fail "root filesystem is not writable OverlayFS"

mount_contract /rom squashfs ro ||
	fail "immutable lower is not read-only SquashFS"

mount_contract /home ext4 rw ||
	fail "persistent home is not writable ext4"

mount_contract /run/fre3nder-root/system ext4 rw ||
	fail "system persistence is not writable ext4"

reset_marker=/run/fre3nder-root/system/.fre3nder-reset-target

[ ! -e "$reset_marker" ] && [ ! -L "$reset_marker" ] ||
	fail "targeted system persistence reset marker was not consumed"

echo "HOST_RUNTIME=PASS"
REMOTE
}

ensure_tmp() {
	if [ -z "$tmp" ]; then
		tmp=$(mktemp -d) ||
			die "cannot create local readback directory"

		trap cleanup EXIT HUP INT TERM
	fi
}

write_and_verify() {
	local artifact=$1
	local device=$2
	local expected_sha=$3
	local size=$4
	local name=$5
	local sectors
	local readback
	local actual_sha

	ensure_tmp

	echo "writing $name -> $device"

	"$ssh_cmd" -o BatchMode=yes "$host" \
		"dd of=$device bs=4096 2>/dev/null && sync" \
		< "$artifact" ||
		die "$name write failed"

	sectors=$(( (size + 511) / 512 ))
	readback=$tmp/$name.readback

	"$ssh_cmd" -o BatchMode=yes "$host" \
		"dd if=$device bs=512 count=$sectors 2>/dev/null" \
		> "$readback" ||
		die "$name readback failed"

	truncate -s "$size" "$readback"

	actual_sha=$(sha256sum "$readback" | awk '{print $1}')

	[ "$actual_sha" = "$expected_sha" ] ||
		die "$name readback checksum mismatch"

	echo "$name artifact readback: PASS"
}

preflight() {
	detect_slots

	if [ "$stock_mode" = true ]; then
		verify_stock_target
	fi

	verify_target_metadata

	echo

	if [ "$stock_mode" = true ]; then
		echo "Fre3nder X2000 Stock-A restore staging preflight: PASS"
	else
		echo "Fre3nder X2000 inactive-slot staging preflight: PASS"
	fi

	echo "no partition writes, selector changes, SYS changes, or reboots performed"
}

deploy_write() {
	local -a before_hashes
	local -a after_hashes
	local before_kernel
	local before_root
	local after_kernel
	local after_root
	local kernel_artifact="$artifact_dir/kernel.uImage"
	local rootfs_artifact="$artifact_dir/rootfs.squashfs"

	if [ "$stock_mode" = true ]; then
		kernel_artifact=$stock_source/p5.img
		rootfs_artifact=$stock_source/p7.img
	fi

	detect_slots

	if [ "$stock_mode" = true ]; then
		verify_stock_target
	fi

	verify_target_metadata

	mapfile -t before_hashes < <(
		active_hashes |
			awk '{print $1}'
	)

	[ "${#before_hashes[@]}" -eq 2 ] ||
		die "cannot obtain active-slot pre-write hashes"

	before_kernel=${before_hashes[0]}
	before_root=${before_hashes[1]}

	if selected "$deploy_kernel"; then
		write_and_verify \
			"$kernel_artifact" \
			"$target_kernel_device" \
			"$kernel_sha" \
			"$kernel_size" \
			kernel
	fi

	if selected "$deploy_rootfs"; then
		write_and_verify \
			"$rootfs_artifact" \
			"$target_root_device" \
			"$rootfs_sha" \
			"$rootfs_size" \
			rootfs
	fi

	verify_target_metadata

	mapfile -t after_hashes < <(
		active_hashes |
			awk '{print $1}'
	)

	[ "${#after_hashes[@]}" -eq 2 ] ||
		die "cannot obtain active-slot post-write hashes"

	after_kernel=${after_hashes[0]}
	after_root=${after_hashes[1]}

	[ "$before_kernel" = "$after_kernel" ] ||
		die "active-slot kernel changed during staging"

	[ "$before_root" = "$after_root" ] ||
		die "active-slot RootFS changed during staging"

	echo "active-slot kernel unchanged: PASS"
	echo "active-slot RootFS unchanged: PASS"

	if [ "$stock_mode" = true ]; then
		return
	fi

	if selected "$deploy_rootfs"; then
		arm_system_persistence_reset
	fi

	activate_target_slot
	request_reboot
	wait_for_target_boot
	verify_fre3nder_runtime
}

main() {
	[[ $# -ge 1 ]] || usage

	host=$1
	shift

	[[ -n "$host" && "$host" != -* ]] ||
		usage

	[[ "$boot_timeout" =~ ^[1-9][0-9]*$ ]] ||
		die "X2000_DEPLOY_BOOT_TIMEOUT must be a positive integer"

	[[ "$boot_poll" =~ ^[1-9][0-9]*$ ]] ||
		die "X2000_DEPLOY_BOOT_POLL must be a positive integer"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--write)
			[ "$mode" = preflight ] ||
				usage

			mode=write
			;;

		--stock)
			[ "$stock_mode" = false ] ||
				usage

			stock_mode=true

			if [[ $# -gt 1 && "$2" != -* ]]; then
				stock_source=$2
				shift
			fi
			;;

		--stock=*)
			[ "$stock_mode" = false ] ||
				usage

			stock_mode=true
			stock_source=${1#--stock=}

			[ -n "$stock_source" ] ||
				usage
			;;

		--develop)
			[ "$develop_mode" = false ] ||
				usage

			develop_mode=true
			;;

		--all)
			[ "$all_seen" = false ] ||
				usage

			[ "$component_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			all_seen=true
			;;

		--kernel)
			[ "$all_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			component_seen=true
			deploy_kernel=true
			;;

		--rootfs)
			[ "$all_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			component_seen=true
			deploy_rootfs=true
			;;

		*)
			usage
			;;
		esac

		shift
	done

	if [ "$stock_mode" = true ]; then
		[ "$develop_mode" = false ] ||
			die "--stock cannot be combined with --develop"

		if [ "$all_seen" = true ] ||
			[ "$component_seen" = true ]; then
			die "--stock cannot be combined with component options"
		fi

		deploy_kernel=true
		deploy_rootfs=true
	elif [ "$all_seen" = true ] ||
		[ "$component_seen" = false ]; then

		deploy_kernel=true
		deploy_rootfs=true
	fi

	if [ "$stock_mode" = false ] &&
		[ "$develop_mode" = false ]; then

		if [ "$deploy_kernel" != true ] ||
			[ "$deploy_rootfs" != true ]; then
			die "--kernel or --rootfs alone requires --develop; normal Fre3nder deployment requires kernel + RootFS"
		fi
	fi

	echo "=== DEPLOY PLAN ==="
	echo "KERNEL=$(plan_value "$deploy_kernel")"
	echo "ROOTFS=$(plan_value "$deploy_rootfs")"
	echo "MODE=$mode"

	if [ "$stock_mode" = true ]; then
		echo "SOURCE=STOCK"
		echo "STOCK_SOURCE=$stock_source"
	else
		echo "SOURCE=FRE3NDER"
	fi

	echo
	echo "=== LOCAL ARTIFACT GATE ==="

	if [ "$stock_mode" = true ]; then
		verify_stock_artifacts
	else
		verify_local_artifacts
	fi

	echo "LOCAL_ARTIFACT_GATE=PASS"

	if [ "$mode" = preflight ]; then
		echo
		echo "=== REMOTE PREFLIGHT ==="

		preflight
		return
	fi

	echo
	echo "=== HOST DEPLOYMENT ==="

	deploy_write

	echo
	echo "=== DEPLOY RESULT ==="

	if selected "$deploy_kernel"; then
		echo "KERNEL_P${target_kernel_number}=PASS"
	else
		echo "KERNEL=SKIPPED"
	fi

	if selected "$deploy_rootfs"; then
		echo "ROOTFS_P${target_root_number}=PASS"
	else
		echo "ROOTFS=SKIPPED"
	fi

	if [ "$stock_mode" = true ]; then
		echo "STAGING_KIND=STOCK_A_RESTORE"
		echo "ACTIVE_SLOT=$active_slot"
		echo "TARGET_SLOT=$target_slot"
		echo "SELECTOR_SLOT=$selector_slot"
		echo "SYSTEM_PERSISTENCE_RESET=NOT_PERFORMED"
		echo "ACTIVATION=NOT_PERFORMED"
		echo "REBOOT=NOT_PERFORMED"
		echo "DEPLOY_X2000_STAGE=PASS"
	else
		echo "STAGING_KIND=FRE3NDER_UPDATE"

		if selected "$deploy_rootfs"; then
			echo "SYSTEM_PERSISTENCE_RESET=PASS"
		else
			echo "SYSTEM_PERSISTENCE_RESET=SKIPPED"
		fi

		echo "ACTIVATION=PASS"
		echo "REBOOT=PASS"
		echo "FINAL_ACTIVE_SLOT=$target_slot"
		echo "FINAL_ACTIVE_ROOT=$target_root_device"
		echo "FINAL_SELECTOR_SLOT=$target_slot"
		echo "DEPLOY_X2000=PASS"
	fi
}

main "$@"
