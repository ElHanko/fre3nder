#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

artifact_dir=${X2000_DEPLOY_ARTIFACT_DIR:-"$root/local/production/artifacts/x2000/full"}
ssh_cmd=${X2000_DEPLOY_SSH:-ssh}
ab_cmd=${X2000_DEPLOY_AB:-"$root/scripts/x2000-ab"}

mode=preflight
develop_mode=false
deploy_kernel=false
deploy_rootfs=false
component_seen=false
all_seen=false

host=

active_slot=
target_slot=
selector_slot=

active_kernel_device=
active_root_device=
target_kernel_device=
target_root_device=

target_kernel_number=
target_root_number=

kernel_size=
kernel_sha=
rootfs_size=
rootfs_sha=
manifest_commit=
manifest_artifact_mode=
manifest_build_input_sha256=

tmp=

cleanup() {
	local result=$?
	trap - EXIT HUP INT TERM
	[ -z "$tmp" ] || rm -rf -- "$tmp"
	exit "$result"
}

usage() {
	cat >&2 <<EOF
usage:
  $0 <active-host> [OPTIONS]

components:
  --kernel    stage the kernel in the inactive A/B slot
  --rootfs    stage the RootFS in the inactive A/B slot
  --all       stage kernel + RootFS

If no component option is given, --all is implied.

execution:
  default     fail-closed read-only preflight
  --write     write and read back the selected inactive-slot artifacts
  --develop   accept a fingerprint-matched development artifact;
              does not imply --write or relax hardware safety gates

This command does not change the boot selector, arm a SYS reset, or reboot.
EOF
	exit 2
}

die() {
	echo "REFUSED: $*" >&2
	exit 1
}

require_regular_file() {
	[ -f "$1" ] && [ ! -L "$1" ] ||
		die "missing or non-regular file: $1"
}

field() {
	local name=$1

	awk -F= -v name="$name" '
		$1 == name {
			count++
			value = substr($0, length(name) + 2)
		}
		END {
			if (count != 1)
				exit 1
			print value
		}
	'
}

selected() {
	[ "$1" = true ]
}

sums_sha() {
	local sums=$1
	local filename=$2

	awk -v expected="$filename" '
		NF == 2 {
			file = $2
			sub(/^\\*/, "", file)

			if (file == expected) {
				count++
				hash = $1
			}
		}

		END {
			if (count != 1)
				exit 1

			if (length(hash) != 64 || hash !~ /^[0-9a-f]+$/)
				exit 1

			print hash
		}
	' "$sums"
}

plan_value() {
	local enabled=$1

	if [ "$enabled" != true ]; then
		printf '%s\n' SKIP
	elif [ "$mode" = write ]; then
		printf '%s\n' WRITE
	else
		printf '%s\n' CHECK
	fi
}

verify_local_artifacts() {
	local sums=$artifact_dir/SHA256SUMS
	local manifest=$artifact_dir/build-manifest.json
	local kernel=$artifact_dir/kernel.uImage
	local rootfs=$artifact_dir/rootfs.squashfs
	local -a manifest_output
	local -a build_inputs
	local current_build_input_sha256

	require_regular_file "$sums"
	require_regular_file "$manifest"

	if selected "$deploy_kernel"; then
		local expected_kernel_sha

		require_regular_file "$kernel"

		kernel_size=$(wc -c < "$kernel")
		kernel_sha=$(sha256sum "$kernel" | awk '{print $1}')

		expected_kernel_sha=$(
			sums_sha "$sums" kernel.uImage
		) || die "SHA256SUMS has no unique valid kernel.uImage entry"

		[ "$kernel_sha" = "$expected_kernel_sha" ] ||
			die "kernel checksum differs from SHA256SUMS"

		[ "$kernel_size" -lt 8388608 ] ||
			die "kernel is not strictly smaller than an 8 MiB kernel slot"
	fi

	if selected "$deploy_rootfs"; then
		local expected_rootfs_sha

		require_regular_file "$rootfs"

		rootfs_size=$(wc -c < "$rootfs")
		rootfs_sha=$(sha256sum "$rootfs" | awk '{print $1}')

		expected_rootfs_sha=$(
			sums_sha "$sums" rootfs.squashfs
		) || die "SHA256SUMS has no unique valid rootfs.squashfs entry"

		[ "$rootfs_sha" = "$expected_rootfs_sha" ] ||
			die "RootFS checksum differs from SHA256SUMS"

		[ "$rootfs_size" -lt 524288000 ] ||
			die "RootFS is not strictly smaller than a 500 MiB RootFS slot"
	fi

	mapfile -t manifest_output < <(
		python3 - \
			"$manifest" \
			"$deploy_kernel" \
			"$kernel_sha" \
			"$deploy_rootfs" \
			"$rootfs_sha" \
			"$develop_mode" <<'PY'
import json
import pathlib
import re
import sys

(
    manifest_path,
    use_kernel,
    kernel_sha,
    use_rootfs,
    rootfs_sha,
    develop_mode,
) = sys.argv[1:]

manifest = json.loads(
    pathlib.Path(manifest_path).read_text(encoding="utf-8")
)

commit = manifest.get("project_commit")

if not isinstance(commit, str) or re.fullmatch(r"[0-9a-f]{40}", commit) is None:
    raise SystemExit("invalid project_commit")

artifact_mode = manifest.get("artifact_mode")
if artifact_mode not in ("release", "development"):
    raise SystemExit("invalid artifact_mode")

worktree_status = manifest.get("project_worktree_status")
build_input_sha256 = manifest.get("build_input_sha256", "")

if artifact_mode == "development":
    if develop_mode != "true":
        raise SystemExit("development artifact requires --develop")
    if worktree_status not in ("clean", "dirty"):
        raise SystemExit("invalid development worktree status")
    if re.fullmatch(r"[0-9a-f]{64}", build_input_sha256) is None:
        raise SystemExit("invalid development build-input fingerprint")
else:
    if worktree_status != "clean":
        raise SystemExit("release artifact was not built from a clean worktree")
    if build_input_sha256:
        raise SystemExit("release artifact has a development fingerprint")

artifacts = manifest.get("artifacts")

if not isinstance(artifacts, dict):
    raise SystemExit("invalid artifact map")

if use_kernel == "true":
    if artifacts.get("kernel.uImage") != kernel_sha:
        raise SystemExit("kernel differs from build manifest")

if use_rootfs == "true":
    if artifacts.get("rootfs.squashfs") != rootfs_sha:
        raise SystemExit("RootFS differs from build manifest")

print(commit)
print(artifact_mode)
print(build_input_sha256)
PY
	) || die "build manifest verification failed"

	[ "${#manifest_output[@]}" -eq 3 ] ||
		die "invalid build manifest verification output"

	manifest_commit=${manifest_output[0]}
	manifest_artifact_mode=${manifest_output[1]}
	manifest_build_input_sha256=${manifest_output[2]}

	git -C "$root" cat-file -e "${manifest_commit}^{commit}" 2>/dev/null ||
		die "artifact source commit is unavailable"

	git -C "$root" merge-base --is-ancestor \
		"$manifest_commit" HEAD 2>/dev/null ||
		die "artifact source commit is not an ancestor of HEAD"

	if [ "$manifest_artifact_mode" = development ]; then
		current_build_input_sha256=$(
			"$root/scripts/x2000-build-input-sha256" --root "$root"
		) || die "cannot fingerprint current X2000 build inputs"

		[ "$current_build_input_sha256" = "$manifest_build_input_sha256" ] ||
			die "current X2000 build inputs differ from development artifact"
	else
		mapfile -t build_inputs < <(
			"$root/scripts/x2000-build-input-sha256" --list-inputs
		)

		[ "${#build_inputs[@]}" -gt 0 ] ||
			die "X2000 build-input list is empty"

		git -C "$root" diff --quiet \
			"$manifest_commit"..HEAD \
			-- "${build_inputs[@]}" ||
			die "X2000 build inputs changed since artifact creation"

		git -C "$root" diff --quiet \
			-- "${build_inputs[@]}" ||
			die "uncommitted X2000 build-input changes exist"

		git -C "$root" diff --cached --quiet \
			-- "${build_inputs[@]}" ||
			die "staged X2000 build-input changes exist"
	fi

	echo "artifact source commit: $manifest_commit"
	echo "artifact mode: $manifest_artifact_mode"
	if [ "$manifest_artifact_mode" = development ]; then
		echo "build-input SHA256: $manifest_build_input_sha256"
	fi

	if selected "$deploy_kernel"; then
		echo "kernel artifact size: $kernel_size"
		echo "kernel artifact SHA256: $kernel_sha"
	fi

	if selected "$deploy_rootfs"; then
		echo "RootFS artifact size: $rootfs_size"
		echo "RootFS artifact SHA256: $rootfs_sha"
	fi
}

ab_status() {
	local target_host=$1

	"$ab_cmd" "$target_host" status ||
		die "cannot obtain x2000-ab status from $target_host"
}

detect_slots() {
	local status
	local classification

	status=$(ab_status "$host")

	active_root_device=$(
		printf '%s\n' "$status" |
			field ACTIVE_ROOT
	) || die "invalid ACTIVE_ROOT from $host"

	classification=$(
		printf '%s\n' "$status" |
			field CLASSIFICATION
	) || die "invalid selector classification from $host"

	[ "$(printf '%s\n' "$status" | field P1_DEVICE)" = /dev/mmcblk0p1 ] ||
		die "$host p1 device identity is invalid"

	[ "$(printf '%s\n' "$status" | field P1_PARTITION_NUMBER)" = 1 ] ||
		die "$host p1 partition number is invalid"

	[ "$(printf '%s\n' "$status" | field P1_START)" = 2048 ] ||
		die "$host p1 start is invalid"

	[ "$(printf '%s\n' "$status" | field P1_SECTORS)" = 2048 ] ||
		die "$host p1 size is invalid"

	[ "$(printf '%s\n' "$status" | field P1_IDENTITY)" = VALID ] ||
		die "$host p1 identity is invalid"

	case "$classification" in
	STOCK_A)
		selector_slot=A
		;;
	DEVELOP_B)
		selector_slot=B
		;;
	*)
		die "$host selector classification is unknown"
		;;
	esac

	case "$active_root_device" in
	/dev/mmcblk0p7)
		active_slot=A
		target_slot=B
		active_kernel_device=/dev/mmcblk0p5
		target_kernel_device=/dev/mmcblk0p6
		target_root_device=/dev/mmcblk0p8
		target_kernel_number=6
		target_root_number=8
		;;
	/dev/mmcblk0p8)
		active_slot=B
		target_slot=A
		active_kernel_device=/dev/mmcblk0p6
		target_kernel_device=/dev/mmcblk0p5
		target_root_device=/dev/mmcblk0p7
		target_kernel_number=5
		target_root_number=7
		;;
	*)
		die "$host active root is $active_root_device, expected p7 or p8"
		;;
	esac

	[ "$selector_slot" = "$active_slot" ] ||
		die "selector points to slot $selector_slot while slot $active_slot is active; inactive-slot staging is unsafe until the selector points to the active slot"

	echo "active slot: $active_slot"
	echo "active root: $active_root_device"
	echo "selector slot: $selector_slot"
	echo "target slot: $target_slot"
}

slot_metadata() {
	"$ssh_cmd" -o BatchMode=yes "$host" 'sh -eu' <<'REMOTE'
fail() {
	echo "REMOTE REFUSED: $*" >&2
	exit 1
}

root_count=0
active_root=

for argument in $(cat /proc/cmdline); do
	case "$argument" in
	root=*)
		active_root=${argument#root=}
		root_count=$((root_count + 1))
		;;
	esac
done

[ "$root_count" -eq 1 ] ||
	fail "expected exactly one root= argument"

for item in \
	"5:kernel:16384" \
	"6:kernel2:16384" \
	"7:rootfs:1024000" \
	"8:rootfs2:1024000"
do
	number=${item%%:*}
	rest=${item#*:}
	label=${rest%%:*}
	expected_sectors=${rest#*:}
	device=/dev/mmcblk0p${number}

	[ -b "$device" ] ||
		fail "p$number is not a block device"

	[ "$(readlink -f "$device")" = "$device" ] ||
		fail "p$number device identity mismatch"

	[ -r "/sys/class/block/mmcblk0p${number}/partition" ] ||
		fail "p$number partition metadata is absent"

	[ "$(cat "/sys/class/block/mmcblk0p${number}/partition")" = "$number" ] ||
		fail "p$number partition number mismatch"

	[ -r "/sys/class/block/mmcblk0p${number}/size" ] ||
		fail "p$number size metadata is absent"

	[ "$(cat "/sys/class/block/mmcblk0p${number}/size")" = "$expected_sectors" ] ||
		fail "p$number size mismatch"

	label_state=ABSENT_INFRASTRUCTURE

	if [ -e /dev/disk/by-partlabel ] ||
		[ -L /dev/disk/by-partlabel ]; then

		[ -d /dev/disk/by-partlabel ] ||
			fail "partlabel infrastructure is invalid"

		[ -e "/dev/disk/by-partlabel/$label" ] ||
		[ -L "/dev/disk/by-partlabel/$label" ] ||
			fail "$label partlabel is absent"

		[ "$(readlink -f "/dev/disk/by-partlabel/$label")" = "$device" ] ||
			fail "$label does not resolve to $device"

		label_state=VALID
	fi

	mounted=NO

	while read -r mounted_device _; do
		if [ "$mounted_device" = "$device" ]; then
			mounted=YES
			break
		fi
	done < /proc/mounts

	echo "P${number}_DEVICE=$device"
	echo "P${number}_PARTLABEL=$label_state"
	echo "P${number}_PARTITION_NUMBER=$number"
	echo "P${number}_SECTORS=$expected_sectors"
	echo "P${number}_MOUNTED=$mounted"
done

echo "ACTIVE_ROOT=$active_root"
REMOTE
}

verify_partition_metadata() {
	local metadata=$1
	local number=$2
	local expected_sectors=$3
	local role=$4
	local device=/dev/mmcblk0p${number}
	local label_state

	[ "$(printf '%s\n' "$metadata" | field "P${number}_DEVICE")" = "$device" ] ||
		die "$host $role device is invalid"

	[ "$(printf '%s\n' "$metadata" | field "P${number}_PARTITION_NUMBER")" = "$number" ] ||
		die "$host $role partition number is invalid"

	[ "$(printf '%s\n' "$metadata" | field "P${number}_SECTORS")" = "$expected_sectors" ] ||
		die "$host $role size is invalid"

	label_state=$(
		printf '%s\n' "$metadata" |
			field "P${number}_PARTLABEL"
	) || die "$host $role partlabel state is invalid"

	case "$label_state" in
	VALID|ABSENT_INFRASTRUCTURE)
		;;
	*)
		die "$host $role partlabel state is invalid"
		;;
	esac

	[ "$(printf '%s\n' "$metadata" | field "P${number}_MOUNTED")" = NO ] ||
		die "$host $role target $device is mounted"
}

verify_target_metadata() {
	local metadata

	metadata=$(slot_metadata) ||
		die "slot metadata verification failed on $host"

	[ "$(printf '%s\n' "$metadata" | field ACTIVE_ROOT)" = "$active_root_device" ] ||
		die "$host active root changed during deployment"

	if selected "$deploy_kernel"; then
		verify_partition_metadata \
			"$metadata" \
			"$target_kernel_number" \
			16384 \
			kernel
	fi

	if selected "$deploy_rootfs"; then
		verify_partition_metadata \
			"$metadata" \
			"$target_root_number" \
			1024000 \
			RootFS
	fi
}

active_hashes() {
	"$ssh_cmd" -o BatchMode=yes "$host" \
		"sha256sum '$active_kernel_device' '$active_root_device'"
}

ensure_tmp() {
	if [ -z "$tmp" ]; then
		tmp=$(mktemp -d) ||
			die "cannot create local readback directory"

		trap cleanup EXIT HUP INT TERM
	fi
}

write_and_verify() {
	local artifact=$1
	local device=$2
	local expected_sha=$3
	local size=$4
	local name=$5
	local sectors
	local readback
	local actual_sha

	ensure_tmp

	echo "writing $name -> $device"

	"$ssh_cmd" -o BatchMode=yes "$host" \
		"dd of=$device bs=4096 2>/dev/null && sync" \
		< "$artifact" ||
		die "$name write failed"

	sectors=$(( (size + 511) / 512 ))
	readback=$tmp/$name.readback

	"$ssh_cmd" -o BatchMode=yes "$host" \
		"dd if=$device bs=512 count=$sectors 2>/dev/null" \
		> "$readback" ||
		die "$name readback failed"

	truncate -s "$size" "$readback"

	actual_sha=$(sha256sum "$readback" | awk '{print $1}')

	[ "$actual_sha" = "$expected_sha" ] ||
		die "$name readback checksum mismatch"

	echo "$name artifact readback: PASS"
}

preflight() {
	detect_slots
	verify_target_metadata

	echo
	echo "Fre3nder X2000 inactive-slot staging preflight: PASS"
	echo "no partition writes, selector changes, SYS changes, or reboots performed"
}

deploy_write() {
	local -a before_hashes
	local -a after_hashes
	local before_kernel
	local before_root
	local after_kernel
	local after_root

	detect_slots
	verify_target_metadata

	mapfile -t before_hashes < <(
		active_hashes |
			awk '{print $1}'
	)

	[ "${#before_hashes[@]}" -eq 2 ] ||
		die "cannot obtain active-slot pre-write hashes"

	before_kernel=${before_hashes[0]}
	before_root=${before_hashes[1]}

	if selected "$deploy_kernel"; then
		write_and_verify \
			"$artifact_dir/kernel.uImage" \
			"$target_kernel_device" \
			"$kernel_sha" \
			"$kernel_size" \
			kernel
	fi

	if selected "$deploy_rootfs"; then
		write_and_verify \
			"$artifact_dir/rootfs.squashfs" \
			"$target_root_device" \
			"$rootfs_sha" \
			"$rootfs_size" \
			rootfs
	fi

	verify_target_metadata

	mapfile -t after_hashes < <(
		active_hashes |
			awk '{print $1}'
	)

	[ "${#after_hashes[@]}" -eq 2 ] ||
		die "cannot obtain active-slot post-write hashes"

	after_kernel=${after_hashes[0]}
	after_root=${after_hashes[1]}

	[ "$before_kernel" = "$after_kernel" ] ||
		die "active-slot kernel changed during staging"

	[ "$before_root" = "$after_root" ] ||
		die "active-slot RootFS changed during staging"

	echo "active-slot kernel unchanged: PASS"
	echo "active-slot RootFS unchanged: PASS"
}

main() {
	[[ $# -ge 1 ]] || usage

	host=$1
	shift

	[[ -n "$host" && "$host" != -* ]] ||
		usage

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--write)
			[ "$mode" = preflight ] ||
				usage

			mode=write
			;;

		--develop)
			[ "$develop_mode" = false ] ||
				usage

			develop_mode=true
			;;

		--all)
			[ "$all_seen" = false ] ||
				usage

			[ "$component_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			all_seen=true
			;;

		--kernel)
			[ "$all_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			component_seen=true
			deploy_kernel=true
			;;

		--rootfs)
			[ "$all_seen" = false ] ||
				die "--all cannot be combined with --kernel or --rootfs"

			component_seen=true
			deploy_rootfs=true
			;;

		*)
			usage
			;;
		esac

		shift
	done

	if [ "$all_seen" = true ] ||
		[ "$component_seen" = false ]; then

		deploy_kernel=true
		deploy_rootfs=true
	fi

	echo "=== DEPLOY PLAN ==="
	echo "KERNEL=$(plan_value "$deploy_kernel")"
	echo "ROOTFS=$(plan_value "$deploy_rootfs")"
	echo "MODE=$mode"

	echo
	echo "=== LOCAL ARTIFACT GATE ==="

	verify_local_artifacts

	echo "LOCAL_ARTIFACT_GATE=PASS"

	if [ "$mode" = preflight ]; then
		echo
		echo "=== REMOTE PREFLIGHT ==="

		preflight
		return
	fi

	echo
	echo "=== HOST DEPLOYMENT ==="

	deploy_write

	echo
	echo "=== DEPLOY RESULT ==="

	if selected "$deploy_kernel"; then
		echo "KERNEL_P${target_kernel_number}=PASS"
	else
		echo "KERNEL=SKIPPED"
	fi

	if selected "$deploy_rootfs"; then
		echo "ROOTFS_P${target_root_number}=PASS"
	else
		echo "ROOTFS=SKIPPED"
	fi

	echo "ACTIVE_SLOT=$active_slot"
	echo "TARGET_SLOT=$target_slot"
	echo "SELECTOR_SLOT=$selector_slot"
	echo "SYSTEM_PERSISTENCE_RESET=NOT_PERFORMED"
	echo "ACTIVATION=NOT_PERFORMED"
	echo "REBOOT=NOT_PERFORMED"
	echo "DEPLOY_X2000_STAGE=PASS"
}

main "$@"
