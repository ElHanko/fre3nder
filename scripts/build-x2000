#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
kernel_builder="$root/scripts/build-x2000-kernel"
buildroot_builder="$root/scripts/build-x2000-buildroot"
moonraker_builder="$root/scripts/build-x2000-moonraker"
guppyscreen_builder="$root/scripts/build-x2000-guppyscreen"
f005_builder="$root/scripts/build-f005"
artifact_root="$root/local/production/artifacts/x2000"
kernel_build=false
f005_build=false
develop=false

usage() {
	echo "usage: $0 [--develop] [--kernel-build] [--f005-build]" >&2
	exit 2
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--develop)
		[ "$develop" = false ] || usage
		develop=true
		;;
	--kernel-build)
		[ "$kernel_build" = false ] || usage
		kernel_build=true
		;;
	--f005-build)
		[ "$f005_build" = false ] || usage
		f005_build=true
		;;
	*) usage ;;
	esac
	shift
done

component_args=
if [ "$develop" = true ]; then
	component_args=--develop
fi

if [ "$kernel_build" = true ]; then
	"$kernel_builder" $component_args
fi

f005_firmware=
if [ "$f005_build" = true ]; then
	"$f005_builder"
	f005_firmware="$root/local/production/artifacts/f005/candidate/klipper-f005-mainline.bin"
fi

"$moonraker_builder" $component_args
"$buildroot_builder" --toolchain $component_args
"$guppyscreen_builder" $component_args
if [ -n "$f005_firmware" ]; then
	FRE3NDER_F005_FIRMWARE="$f005_firmware" \
		"$buildroot_builder" --assemble $component_args
else
	"$buildroot_builder" --assemble $component_args
fi

if [ "$kernel_build" = true ]; then
	python3 - "$artifact_root/kernel-only" "$artifact_root/rootfs-only" \
		"$artifact_root/full" <<'PY'
import hashlib
import json
import pathlib
import shutil
import sys
import tempfile

kernel_dir, rootfs_dir, full_dir = map(pathlib.Path, sys.argv[1:])

for directory, names in (
    (kernel_dir, ("kernel.uImage", "ender3-v3-ke.dtb", "effective-kernel-config")),
    (rootfs_dir, ("rootfs.squashfs", "buildroot.config")),
):
    for name in names:
        path = directory / name
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"missing component artifact: {path}")

kernel_manifest = json.loads((kernel_dir / "build-manifest.json").read_text())
rootfs_manifest = json.loads((rootfs_dir / "build-manifest.json").read_text())

dynamic_fields = {
    "artifacts",
    "kernel_build",
    "rootfs_components",
}

kernel_static = {
    key: value
    for key, value in kernel_manifest.items()
    if key not in dynamic_fields
}
rootfs_static = {
    key: value
    for key, value in rootfs_manifest.items()
    if key not in dynamic_fields
}
if kernel_static != rootfs_static:
    raise SystemExit("component manifests disagree on static provenance")

kernel_build = kernel_manifest.get("kernel_build")
if not isinstance(kernel_build, dict):
    raise SystemExit("kernel component manifest lacks kernel_build provenance")

if "kernel_build" in rootfs_manifest:
    raise SystemExit(
        "rootfs-only manifest must not claim an executed kernel build"
    )

required_kernel_build_fields = {
    "base_commit",
    "base_tree",
    "patch_series",
    "final_diff_sha256",
    "defconfig",
    "effective_config_sha256",
    "kernelrelease",
    "compiler",
    "buildroot_toolchain_fingerprint",
    "kbuild",
    "vmlinux_sha256",
    "artifacts",
}
missing_kernel_build_fields = (
    required_kernel_build_fields - kernel_build.keys()
)
if missing_kernel_build_fields:
    raise SystemExit(
        "kernel_build provenance missing fields: "
        + ", ".join(sorted(missing_kernel_build_fields))
    )

for directory, manifest, names in (
    (kernel_dir, kernel_manifest, ("kernel.uImage", "ender3-v3-ke.dtb", "effective-kernel-config")),
    (rootfs_dir, rootfs_manifest, ("rootfs.squashfs", "buildroot.config")),
):
    artifacts = manifest.get("artifacts", {})
    for name in names:
        actual = hashlib.sha256((directory / name).read_bytes()).hexdigest()
        if artifacts.get(name) != actual:
            raise SystemExit(f"component manifest checksum mismatch: {directory / name}")

kernel_artifact_names = (
    "kernel.uImage",
    "ender3-v3-ke.dtb",
    "effective-kernel-config",
)
expected_kernel_artifacts = {
    name: kernel_manifest["artifacts"][name]
    for name in kernel_artifact_names
}
if kernel_build.get("artifacts") != expected_kernel_artifacts:
    raise SystemExit(
        "kernel_build artifact provenance disagrees with kernel manifest"
    )

full_dir.parent.mkdir(parents=True, exist_ok=True)
stage = pathlib.Path(tempfile.mkdtemp(prefix=".full.", dir=full_dir.parent))
try:
    for source, name in (
        (kernel_dir / "kernel.uImage", "kernel.uImage"),
        (kernel_dir / "ender3-v3-ke.dtb", "ender3-v3-ke.dtb"),
        (kernel_dir / "effective-kernel-config", "effective-kernel-config"),
        (rootfs_dir / "rootfs.squashfs", "rootfs.squashfs"),
        (rootfs_dir / "buildroot.config", "buildroot.config"),
    ):
        shutil.copyfile(source, stage / name)

    manifest = dict(rootfs_manifest)
    manifest["kernel_build"] = kernel_build
    manifest["artifacts"] = {
        path.name: hashlib.sha256(path.read_bytes()).hexdigest()
        for path in sorted(stage.iterdir())
    }
    (stage / "build-manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    )
    with (stage / "SHA256SUMS").open("w") as stream:
        for path in sorted(stage.iterdir()):
            if path.name == "SHA256SUMS":
                continue
            stream.write(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.name}\n")

    if full_dir.exists():
        shutil.rmtree(full_dir)
    stage.rename(full_dir)
    stage = None
finally:
    if stage is not None:
        shutil.rmtree(stage)
PY
fi
