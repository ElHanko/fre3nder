#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
kernel_builder="$root/scripts/build-x2000-kernel"
buildroot_builder="$root/scripts/build-x2000-buildroot"
f005_builder="$root/scripts/build-f005"
artifact_root="$root/local/production/artifacts/x2000"
ota_key_dir="$root/local/production/keys/ota"
ota_private_key="$ota_key_dir/private.pem"
ota_public_key="$ota_key_dir/public.pem"
build_scope=full
scope_seen=false
f005_build=false
compose_only=false
develop=false
fre3nderscreen_app=false
factory_seed=${FRE3NDER_FACTORY_FRE3NDERSCREEN_APP:-"$root/local/production/factory-apps/fre3nderscreen.fre3app"}
factory_mode=release
development_logging=false
development_phase=
development_dir=

fail() {
	printf 'build-x2000: %s\n' "$*" >&2
	exit 1
}

compose_exit_report() {
	build_exit_code=$?
	trap - EXIT
	if [ "$compose_only" = true ] && [ "$build_exit_code" -ne 0 ]; then
		printf '\nX2000 composition: FAIL\n' >&2
	fi
	if [ "$development_logging" = true ]; then
		trap '' INT TERM
		development_finish "$build_exit_code" || :
	fi
	[ -z "$development_dir" ] || rm -rf -- "$development_dir"
	exit "$build_exit_code"
}
trap compose_exit_report EXIT

development_begin() {
	development_started=$(date +%s)
	development_dir=$(mktemp -d /tmp/fre3nder-build.XXXXXX)
	# Keep the builders umask unchanged while enforcing private log access.
	development_log=$(mktemp "/tmp/fre3nder-build-$(date +%Y%m%d-%H%M%S).XXXXXX.log")
	chmod 600 "$development_log"
	: > "$development_dir/phases"
	mkfifo -m 600 "$development_dir/output"
	exec 3>&1 4>&2
	# Keep tee alive on terminal interrupts so it can drain the final output.
	(trap '' INT TERM; exec tee "$development_log" < "$development_dir/output") &
	development_tee=$!
	exec > "$development_dir/output" 2>&1
	development_logging=true
	trap 'exit 130' INT
	trap 'exit 143' TERM
	printf '=== Fre3nder Development Build ===\nLog: %s\n\n' "$development_log"
}

begin_phase() {
	[ "$develop" = true ] || return 0
	development_phase=$1
	printf 'BEGIN %s %s\n' "$development_phase" "$(date +%s)" >> "$development_dir/phases"
}

end_phase() {
	[ "$develop" = true ] || return 0
	printf 'END %s %s PASS\n' "$development_phase" "$(date +%s)" >> "$development_dir/phases"
	development_phase=
}

development_finish() {
	development_finished=$(date +%s)
	if [ -n "$development_phase" ]; then
		printf 'END %s %s FAIL\n' "$development_phase" "$development_finished" >> "$development_dir/phases"
	fi
	# The build itself never runs in a pipeline. Restore the terminal and
	# drain tee before reading its log; its status cannot replace the build's.
	exec 1>&3 2>&4 3>&- 4>&-
	wait "$development_tee" || :
	awk -v log_path="$development_log" -v started="$development_started" \
		-v finished="$development_finished" -v result="$1" \
		-v f005="$f005_build" -v screen="$fre3nderscreen_app" '
		function duration(seconds) {
			if (seconds < 0) seconds = 0
			return sprintf("%02d:%02d:%02d", int(seconds / 3600), int(seconds / 60) % 60, seconds % 60)
		}
		function row(phase) {
			printf "%-16s %8s    %s\n", phase, (status[phase] ? duration(elapsed[phase]) : "--:--:--"), (status[phase] ? status[phase] : "SKIP")
		}
		FILENAME == ARGV[1] {
			if ($1 == "BEGIN") beginning[$2] = $3
			if ($1 == "END") {
				elapsed[$2] += $3 - beginning[$2]
				ending[$2] = $3
				status[$2] = $4
			}
			next
		}
		$1 == "[fre3nder-toolchain]" && $2 == "START" { toolchain_start = $3 }
		$1 == "[fre3nder-toolchain]" && $2 == "END" {
			toolchain_elapsed += $3 - toolchain_start
			toolchain_start = 0
			toolchain_status = "PASS"
		}
		END {
			if (toolchain_start) {
				toolchain_elapsed += ending["Kernel"] - toolchain_start
				toolchain_status = "FAIL"
				status["Kernel"] = "ABORT"
			}
			# The kernel wrapper includes toolchain work. Count it once,
			# and add any separate RootFS toolchain preparation/reuse.
			elapsed["Kernel"] -= toolchain_elapsed
			elapsed["Toolchain"] += toolchain_elapsed
			if (toolchain_status && status["Toolchain"] != "FAIL") status["Toolchain"] = toolchain_status
			printf "\n=== Fre3nder Development Build ===\nLog: %s\n\n", log_path
			printf "%-16s %8s    %s\n", "Phase", "Dauer", "Status"
			row("Kernel"); row("Toolchain"); row("RootFS"); row("OTA")
			if (f005 == "true") row("F005")
			if (screen == "true") row("Fre3nderScreen")
			print "------------------------------------"
			printf "%-16s %8s    %s\n", "Gesamt", duration(finished - started), (result == 0 ? "PASS" : "FAIL")
		}
	' "$development_dir/phases" "$development_log" | tee -a "$development_log"
}

show_help() {
	cat <<EOF
Usage:
  $0 [OPTIONS]

Build Fre3nder X2000 platform artifacts.

Build scope:
  (default)          Build Kernel + RootFS and compose the full OTA artifact
  --kernel-only      Build only the X2000 Kernel artifact
  --rootfs-only      Build only the RootFS stack
  --compose-only     Compose existing Kernel and RootFS artifacts

Build mode:
  --develop          Allow a development build from the current worktree
                     Write a live /tmp log and phase timing summary

Additional components:
  --f005-build       Rebuild the F005 firmware candidate before RootFS assembly
  --fre3nderscreen-app  Build a development Screen app (requires --develop and RootFS)

General:
  -h, --help         Show this help

Examples:
  $0
      Full release build

  $0 --develop
      Full development build

  $0 --rootfs-only --develop
      Development RootFS build without rebuilding the Kernel
EOF
}

usage() {
	show_help >&2
	exit 2
}

select_scope() {
	[ "$scope_seen" = false ] || usage
	build_scope=$1
	scope_seen=true
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--develop)
		[ "$develop" = false ] || usage
		develop=true
		;;
	--kernel-only)
		select_scope kernel
		;;
	--rootfs-only)
		select_scope rootfs
		;;
	--compose-only)
		select_scope compose
		;;
	--f005-build)
		[ "$f005_build" = false ] || usage
		f005_build=true
		;;
	--fre3nderscreen-app)
		[ "$fre3nderscreen_app" = false ] || usage
		fre3nderscreen_app=true
		;;
	-h|--help)
		show_help
		exit 0
		;;
	*) usage ;;
	esac
	shift
done

case "$build_scope" in
compose)
	[ "$f005_build" = false ] || usage
	[ "$develop" = false ] || usage
	compose_only=true
	;;
kernel)
	[ "$f005_build" = false ] || usage
	;;
esac

if [ "$fre3nderscreen_app" = true ]; then
	[ "$develop" = true ] || usage
	[ "$build_scope" = full ] || [ "$build_scope" = rootfs ] || usage
fi

if [ "$f005_build" = true ] && [ "$develop" != true ]; then
	fail '--f005-build requires --develop; release uses qualified F005 firmware'
fi

if [ "$develop" = true ]; then
	development_begin
fi

clean_rootfs_python_cache() {
	overlay="$root/configs/x2000/rootfs-overlay"

	find "$overlay" \
		-type f \( -name '*.pyc' -o -name '*.pyo' \) \
		-delete

	find "$overlay" \
		-type d -name '__pycache__' \
		-prune -exec rm -rf -- {} +
}

if [ "$build_scope" = full ] || [ "$build_scope" = rootfs ]; then
	clean_rootfs_python_cache
fi

component_args=
if [ "$develop" = true ]; then
	component_args=--develop
fi

if [ "$compose_only" = true ]; then
	printf '%s\n' 'X2000 composition: validating existing artifacts'
fi

if [ "$build_scope" = full ] || [ "$build_scope" = compose ]; then
	command -v openssl >/dev/null 2>&1 || {
		echo 'openssl is required to create signed Fre3nder OTA packages' >&2
		exit 1
	}
	for key in "$ota_private_key" "$ota_public_key"; do
		[ -f "$key" ] && [ ! -L "$key" ] || {
			echo "missing OTA signing key: $key" >&2
			echo 'run scripts/generate-ota-keypair before a full X2000 build' >&2
			exit 1
		}
	done

	if ! openssl pkey -in "$ota_private_key" -text -noout 2>/dev/null |
		grep -q '^ED25519 Private-Key:$'; then
		echo 'OTA private key is not Ed25519' >&2
		exit 1
	fi
	if ! openssl pkey -pubin -in "$ota_public_key" -text -noout 2>/dev/null |
		grep -q '^ED25519 Public-Key:$'; then
		echo 'OTA public key is not Ed25519' >&2
		exit 1
	fi

	derived_public=$(mktemp)
	if ! openssl pkey -in "$ota_private_key" -pubout -out "$derived_public"; then
		rm -f -- "$derived_public"
		echo 'cannot derive OTA public key from private key' >&2
		exit 1
	fi
	if ! cmp -s "$derived_public" "$ota_public_key"; then
		rm -f -- "$derived_public"
		echo 'OTA private and public keys do not form a matching keypair' >&2
		exit 1
	fi
	rm -f -- "$derived_public"

fi

if [ "$fre3nderscreen_app" = true ]; then
	begin_phase Fre3nderScreen
	apps_repo="$root/../fre3nder-apps"
	[ -d "$apps_repo" ] || fail 'missing fre3nder-apps repository'
	apps_repo=$(CDPATH='' cd -- "$apps_repo" && pwd -P)
	package_builder="$apps_repo/apps/fre3nderscreen/scripts/build-fre3nderscreen-development"
	[ -x "$package_builder" ] || fail 'missing Fre3nderScreen development package wrapper'
	"$root/scripts/build-x2000-fre3nderscreen" --develop
	artifact="$artifact_root/fre3nderscreen/app"
	# This option is Development-only. Stream the receipt while retaining it
	# for the existing validation, without putting the producer in a pipeline.
	mkfifo -m 600 "$development_dir/package-output"
	(trap '' INT TERM; exec tee "$development_dir/package-receipt" \
		< "$development_dir/package-output") &
	package_tee=$!
	"$package_builder" --artifact "$artifact" \
		--key "$root/local/production/keys/apps/private.pem" > "$development_dir/package-output"
	wait "$package_tee"
	package_output=$(cat "$development_dir/package-receipt")
	factory_seed=$(printf '%s\n' "$package_output" | awk '
		$0 == "=== Fre3nderScreen development package: PASS ===" { passes++; in_pass = 1; next }
		/^Package:/ {
			packages++
			if (!in_pass || index($0, "Package:  ") != 1) invalid = 1
			package = substr($0, 11)
		}
		END {
			if (passes != 1 || packages != 1 || invalid || package == "") exit 1
			print package
		}
	') || fail 'invalid development package receipt'
	case "$factory_seed" in /*) ;; *) fail 'development package path must be absolute' ;; esac
	[ -f "$factory_seed" ] && [ ! -L "$factory_seed" ] \
		|| fail 'development package is not a regular non-symlink file'
	factory_mode=development
	end_phase
fi

if [ "$build_scope" = full ] || [ "$build_scope" = kernel ]; then
	begin_phase Kernel
	"$kernel_builder" $component_args
	end_phase
fi

if [ "$build_scope" = full ] || [ "$build_scope" = rootfs ]; then
	f005_firmware=
	export FRE3NDER_F005_FIRMWARE_MODE=qualified
	if [ "$f005_build" = true ]; then
		begin_phase F005
		"$f005_builder"
		end_phase
		f005_firmware="$root/local/production/artifacts/f005/candidate/klipper-f005-mainline.bin"
		export FRE3NDER_F005_FIRMWARE_MODE=candidate
	fi

	export FRE3NDER_FACTORY_FRE3NDERSCREEN_APP="$factory_seed"
	export FRE3NDER_FACTORY_FRE3NDERSCREEN_MODE="$factory_mode"
	begin_phase Toolchain
	"$buildroot_builder" --toolchain $component_args
	end_phase
	begin_phase RootFS
	if [ -n "$f005_firmware" ]; then
		FRE3NDER_F005_FIRMWARE="$f005_firmware" \
		FRE3NDER_OTA_PUBLIC_KEY="$ota_public_key" \
			"$buildroot_builder" --assemble $component_args
	else
		FRE3NDER_OTA_PUBLIC_KEY="$ota_public_key" \
			"$buildroot_builder" --assemble $component_args
	fi
	end_phase
fi

if [ "$build_scope" = full ] || [ "$build_scope" = compose ]; then
	begin_phase OTA
	python3 - "$artifact_root/kernel-only" "$artifact_root/rootfs-only" \
		"$artifact_root/full" "$ota_private_key" "$ota_public_key" \
		"$compose_only" "$root" <<'PY'
import hashlib
import io
import json
import pathlib
import shutil
import subprocess
import sys
import tarfile
import tempfile

kernel_dir, rootfs_dir, full_dir, ota_private_key, ota_public_key = (
    map(pathlib.Path, sys.argv[1:6])
)
compose_only = sys.argv[6] == "true"
project_root = pathlib.Path(sys.argv[7])

for directory, names in (
    (kernel_dir, ("kernel.uImage", "ender3-v3-ke.dtb", "effective-kernel-config")),
    (rootfs_dir, ("rootfs.squashfs", "buildroot.config")),
):
    for name in names:
        path = directory / name
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"missing component artifact: {path}")

kernel_manifest = json.loads((kernel_dir / "build-manifest.json").read_text())
rootfs_manifest = json.loads((rootfs_dir / "build-manifest.json").read_text())

current_version = (project_root / "VERSION").read_text().strip()
if current_version != rootfs_manifest.get("version"):
    raise SystemExit("component version differs from current Fre3nder VERSION")

composition_commit = subprocess.run(
    ["git", "-C", str(project_root), "rev-parse", "HEAD"],
    check=True,
    capture_output=True,
    text=True,
).stdout.strip()

composition_status = subprocess.run(
    ["git", "-C", str(project_root), "status", "--porcelain=v1"],
    check=True,
    capture_output=True,
    text=True,
).stdout

composition_provenance = {
    "project_commit": composition_commit,
    "project_worktree_status": "dirty" if composition_status else "clean",
}

if rootfs_manifest.get("artifact_mode") == "development":
    composition_provenance["build_input_sha256"] = subprocess.run(
        [
            str(project_root / "scripts/x2000-build-input-sha256"),
            "--root",
            str(project_root),
        ],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
elif composition_status:
    raise SystemExit("release composition requires a clean project worktree")

expected_ota_public_key_sha256 = hashlib.sha256(
    ota_public_key.read_bytes()
).hexdigest()
if rootfs_manifest.get("ota_public_key_sha256") != expected_ota_public_key_sha256:
    raise SystemExit("RootFS manifest OTA public key does not match signing keypair")

for field in (
    "version",
    "artifact_mode",
):
    if kernel_manifest.get(field, "") != rootfs_manifest.get(field, ""):
        raise SystemExit(f"component manifests disagree on {field}")

if not compose_only:
    for field in (
        "project_commit",
        "project_worktree_status",
        "build_input_sha256",
    ):
        if kernel_manifest.get(field, "") != rootfs_manifest.get(field, ""):
            raise SystemExit(f"component manifests disagree on {field}")
for directory, manifest, names in (
    (kernel_dir, kernel_manifest, ("kernel.uImage", "ender3-v3-ke.dtb", "effective-kernel-config")),
    (rootfs_dir, rootfs_manifest, ("rootfs.squashfs", "buildroot.config")),
):
    artifacts = manifest.get("artifacts", {})
    for name in names:
        actual = hashlib.sha256((directory / name).read_bytes()).hexdigest()
        if artifacts.get(name) != actual:
            raise SystemExit(f"component manifest checksum mismatch: {directory / name}")

full_dir.parent.mkdir(parents=True, exist_ok=True)
stage = pathlib.Path(tempfile.mkdtemp(prefix=".full.", dir=full_dir.parent))
try:
    for source, name in (
        (kernel_dir / "kernel.uImage", "kernel.uImage"),
        (kernel_dir / "ender3-v3-ke.dtb", "ender3-v3-ke.dtb"),
        (kernel_dir / "effective-kernel-config", "effective-kernel-config"),
        (rootfs_dir / "rootfs.squashfs", "rootfs.squashfs"),
        (rootfs_dir / "buildroot.config", "buildroot.config"),
    ):
        shutil.copyfile(source, stage / name)

    payload_names = ("kernel.uImage", "rootfs.squashfs")
    payload_hashes = {
        name: hashlib.sha256((stage / name).read_bytes()).hexdigest()
        for name in payload_names
    }
    payload_sizes = {
        name: (stage / name).stat().st_size
        for name in payload_names
    }

    provenance_fields = (
        "version",
        "artifact_mode",
        "project_commit",
        "project_worktree_status",
        "build_input_sha256",
    )
    component_provenance = {
        component: {
            field: manifest[field]
            for field in provenance_fields
            if field in manifest
        }
        for component, manifest in (
            ("kernel", kernel_manifest),
            ("rootfs", rootfs_manifest),
        )
    }

    ota_manifest = dict(rootfs_manifest)
    ota_manifest["component_provenance"] = component_provenance
    ota_manifest["composition_provenance"] = composition_provenance
    ota_manifest["ota"] = {
        "format": "fre3nder-ota",
        "format_version": 1,
        "platform": "ender3-v3-ke",
        "signature": {
            "algorithm": "Ed25519",
            "file": "SHA256SUMS.sig",
            "signed_file": "SHA256SUMS",
        },
    }
    ota_manifest["artifacts"] = payload_hashes
    ota_manifest["artifact_sizes"] = payload_sizes

    ota_manifest_data = (
        json.dumps(ota_manifest, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")
    manifest_sha256 = hashlib.sha256(ota_manifest_data).hexdigest()
    ota_checksums_data = (
        f"{manifest_sha256}  manifest.json\n"
        + "".join(
            f"{payload_hashes[name]}  {name}\n"
            for name in payload_names
        )
    ).encode("utf-8")

    ota_work = pathlib.Path(
        tempfile.mkdtemp(prefix=".ota.", dir=full_dir.parent)
    )
    try:
        manifest_path = ota_work / "manifest.json"
        checksums_path = ota_work / "SHA256SUMS"
        signature_path = ota_work / "SHA256SUMS.sig"

        manifest_path.write_bytes(ota_manifest_data)
        checksums_path.write_bytes(ota_checksums_data)

        subprocess.run(
            [
                "openssl",
                "pkeyutl",
                "-sign",
                "-rawin",
                "-inkey",
                str(ota_private_key),
                "-in",
                str(checksums_path),
                "-out",
                str(signature_path),
            ],
            check=True,
        )
        subprocess.run(
            [
                "openssl",
                "pkeyutl",
                "-verify",
                "-rawin",
                "-pubin",
                "-inkey",
                str(ota_public_key),
                "-in",
                str(checksums_path),
                "-sigfile",
                str(signature_path),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
        )

        package_name = (
            f"fre3nder-{ota_manifest['version']}-ender3-v3-ke.ota"
        )
        package_path = stage / package_name

        def tar_info(name, size):
            info = tarfile.TarInfo(name)
            info.size = size
            info.mode = 0o644
            info.uid = 0
            info.gid = 0
            info.uname = "root"
            info.gname = "root"
            info.mtime = 0
            return info

        with tarfile.open(
            package_path,
            "w",
            format=tarfile.USTAR_FORMAT,
        ) as archive:
            for name in ("manifest.json", "SHA256SUMS", "SHA256SUMS.sig"):
                data = (ota_work / name).read_bytes()
                archive.addfile(tar_info(name, len(data)), io.BytesIO(data))

            for name in payload_names:
                source = stage / name
                with source.open("rb") as stream:
                    archive.addfile(
                        tar_info(name, source.stat().st_size),
                        stream,
                    )
    finally:
        shutil.rmtree(ota_work)

    manifest = dict(rootfs_manifest)
    manifest["component_provenance"] = component_provenance
    manifest["composition_provenance"] = composition_provenance
    manifest["artifacts"] = {
        path.name: hashlib.sha256(path.read_bytes()).hexdigest()
        for path in sorted(stage.iterdir())
    }
    (stage / "build-manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    )
    with (stage / "SHA256SUMS").open("w") as stream:
        for path in sorted(stage.iterdir()):
            if path.name == "SHA256SUMS":
                continue
            stream.write(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.name}\n")

    if full_dir.exists():
        shutil.rmtree(full_dir)
    stage.rename(full_dir)
    stage = None

    package_path = full_dir / package_name
    package_size = package_path.stat().st_size
    print("=== Fre3nder OTA ===")
    print("X2000 composition: PASS")
    print("Status:   PASS")
    print(f"Version:  {ota_manifest['version']}")
    print(f"Mode:     {ota_manifest['artifact_mode']}")
    print(f"OTA:      {package_path}")
    print(f"Size:     {package_size / 1024**2:.2f} MiB ({package_size} bytes)")
    print(f"SHA-256:  {manifest['artifacts'][package_name]}")
    print(f"Kernel:   {payload_hashes['kernel.uImage']}")
    print(f"RootFS:   {payload_hashes['rootfs.squashfs']}")
finally:
    if stage is not None:
        shutil.rmtree(stage)
PY
	end_phase
fi
