#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(cat "$root/VERSION")
image="ender3-v3-ke-fre3nder-x2000:$version"
runtime_user=$(id -u):$(id -g)
local_root="$root/local/production"
work_root="$local_root/work/x2000"
f005_firmware=${FRE3NDER_F005_FIRMWARE:-"$local_root/artifacts/x2000/f005/klipper-f005-mainline.bin"}
f005_firmware_mode=${FRE3NDER_F005_FIRMWARE_MODE:-qualified}
ota_public_key=${FRE3NDER_OTA_PUBLIC_KEY:-"$local_root/keys/ota/public.pem"}
factory_seed=${FRE3NDER_FACTORY_FRE3NDERSCREEN_APP:-"$local_root/factory-apps/fre3nderscreen.fre3app"}
factory_mode=${FRE3NDER_FACTORY_FRE3NDERSCREEN_MODE-release}
docker_cmd=${X2000_BUILD_DOCKER:-docker}
artifact_mode=release
phase=

usage() {
	echo "usage: $0 {--toolchain|--assemble} [--develop]" >&2
	exit 2
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--toolchain|--assemble)
		[ -z "$phase" ] || usage
		phase=$1
		;;
	--develop)
		[ "$artifact_mode" = release ] || usage
		artifact_mode=development
		;;
	*) usage ;;
	esac
	shift
done
[ -n "$phase" ] || usage

case "$f005_firmware_mode" in
qualified) ;;
candidate)
	[ "$artifact_mode" = development ] || {
		echo 'F005 candidate requires a development RootFS' >&2
		exit 1
	}
	;;
*) echo 'invalid FRE3NDER_F005_FIRMWARE_MODE' >&2; exit 1 ;;
esac

case "$factory_mode" in
release) ;;
development)
	[ "$artifact_mode" = development ] || {
		echo 'a release platform cannot use a development factory app' >&2
		exit 1
	}
	;;
*) echo "invalid Fre3nderScreen factory app mode: $factory_mode" >&2; exit 1 ;;
esac

clean_rootfs_python_cache() {
	overlay="$root/configs/x2000/rootfs-overlay"

	find "$overlay" \
		-type f \( -name '*.pyc' -o -name '*.pyo' \) \
		-delete

	find "$overlay" \
		-type d -name '__pycache__' \
		-prune -exec rm -rf -- {} +
}

clean_rootfs_python_cache

git -C "$root" check-ignore -q local/production
"$docker_cmd" build -t "$image" "$root/build/x2000"
mkdir -p "$work_root"

if [ "$phase" = --toolchain ]; then
	"$docker_cmd" run --rm --user "$runtime_user" \
		-v "$root:/project" \
		-v "$work_root:/work" \
		"$image" fetch-buildroot
	"$docker_cmd" run --rm --network none --user "$runtime_user" \
		-e "FRE3NDER_ARTIFACT_MODE=$artifact_mode" \
		-v "$root:/project" \
		-v "$work_root:/work" \
		"$image" prepare-buildroot-toolchain
	exit 0
fi

[ -f "$factory_seed" ] && [ ! -L "$factory_seed" ] || {
	echo "missing regular Fre3nderScreen factory app: $factory_seed" >&2
	exit 1
}
PYTHONDONTWRITEBYTECODE=1 python3 - "$root" "$factory_seed" "$factory_mode" <<'PY'
import importlib.machinery
import importlib.util
from pathlib import Path
import sys

root, seed = map(Path, sys.argv[1:3])
mode = sys.argv[3]
core_path = root / "configs/x2000/rootfs-overlay/usr/libexec/fre3nder-package-core"
loader = importlib.machinery.SourceFileLoader("fre3nder_factory_package_core", str(core_path))
spec = importlib.util.spec_from_loader(loader.name, loader)
core = importlib.util.module_from_spec(spec)
loader.exec_module(core)
core.BUILTIN_KEYS = root / "configs/x2000/rootfs-overlay/usr/share/fre3nder/app-keys"
package = core.verify_package(seed)
if (package["name"] != "fre3nderscreen"
        or package["publisher"] != "fre3nder-official"
        or package["display_frontend"] is not True
        or package["display_api"] != 1
        or package["autostart"] is not False):
    raise SystemExit("factory app identity or display contract is invalid")
serial = package["release_serial"]
if (mode == "development" and serial != 0) or (mode == "release" and serial < 1):
    raise SystemExit("factory app release serial does not match expected app mode")
PY

command -v openssl >/dev/null 2>&1 || {
	echo 'openssl is required to validate the OTA public key' >&2
	exit 1
}
[ -f "$ota_public_key" ] && [ ! -L "$ota_public_key" ] || {
	echo "missing OTA public key: $ota_public_key" >&2
	exit 1
}
openssl pkey -pubin -in "$ota_public_key" -noout >/dev/null 2>&1 || {
	echo "invalid OTA public key: $ota_public_key" >&2
	exit 1
}
openssl pkey -pubin -in "$ota_public_key" -text -noout 2>/dev/null |
	grep -q '^ED25519 Public-Key:$' || {
	echo "OTA public key is not Ed25519: $ota_public_key" >&2
	exit 1
}

python3 "$root/build/x2000/f005_firmware.py" --root "$root" \
	--firmware "$f005_firmware" --mode "$f005_firmware_mode" \
	--artifact-mode "$artifact_mode" >/dev/null

container_f005_firmware=/f005-firmware
set -- -v "$f005_firmware:$container_f005_firmware:ro"
if [ "$f005_firmware_mode" = candidate ]; then
	container_f005_firmware=/f005-candidate/klipper-f005-mainline.bin
	set -- -v "$(dirname -- "$f005_firmware"):/f005-candidate:ro"
fi

"$docker_cmd" run --rm --user "$runtime_user" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" fetch-rootfs
"$docker_cmd" run --rm --network none --user "$runtime_user" \
	-e "FRE3NDER_ARTIFACT_MODE=$artifact_mode" \
	-e FRE3NDER_REUSE_PREPARED_TOOLCHAIN=1 \
	-e "FRE3NDER_F005_FIRMWARE=$container_f005_firmware" \
	-e "FRE3NDER_F005_FIRMWARE_MODE=$f005_firmware_mode" \
	-e FRE3NDER_OTA_PUBLIC_KEY=/ota-public-key \
	-e FRE3NDER_FACTORY_FRE3NDERSCREEN_APP=/factory-fre3nderscreen-app \
	"$@" \
	-v "$ota_public_key:/ota-public-key:ro" \
	-v "$factory_seed:/factory-fre3nderscreen-app:ro" \
	-v "$root:/project" \
	-v "$work_root:/work" \
	"$image" build-rootfs-only
