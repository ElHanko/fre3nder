-static void iicsendbyte(unsigned char ch)
-{
-	unsigned char i;
-	I2CSCL_LOW;
-	for (i = 0; i < 8; i++) {
-		if (ch & 0x80) {
-			I2CSDA_HIGH;
-		} else {
-			I2CSDA_LOW;
-		}
-		__udelay(delay_data);
-		ch <<= 1;
-		I2CSCL_HIGH;
