-		for (i = 0; i < GTP_CONFIG_MAX_LENGTH; i++) {
-			data_len += snprintf(ptr + data_len, 4096 - data_len,
-			                     "0x%02X ", temp_data[i + 2]);
-
-			if (i % 8 == 7)
