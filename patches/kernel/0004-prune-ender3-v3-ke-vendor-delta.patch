-static int dpu_ctrl_alloc_comp_desc(struct dpu_ctrl *dctrl)
-{
-	unsigned int size = 0;
-	unsigned int alloc_size = 0;
-	dma_addr_t addr_phy = 0;
-	uint8_t *addr = 0;
-	int ret = 0;
-	int i = 0, j = 0;
-
-	/*Composer Frame desc. */
-	dctrl->framedesc_size = 0;
-	size = sizeof(struct ingenicfb_framedesc);
