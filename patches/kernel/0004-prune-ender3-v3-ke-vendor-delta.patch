-	{},
-};
-MODULE_DEVICE_TABLE(of, fts_dt_match);
-
-static struct i2c_driver fts_ts_driver = {
-	.probe = fts_ts_probe,
-	.remove = fts_ts_remove,
-	.driver = {
-		.name = FTS_DRIVER_NAME,
-		.owner = THIS_MODULE,
-		.of_match_table = of_match_ptr(fts_dt_match),
-		.pm = &fts_pm_ops,
-	},
-	.id_table = fts_ts_id,
