-	}
-	if ((g_cst3xx_ic_checkcode & 0xffff0000) != 0xCACA0000) {
-		printk("linc cst3xx [cst3xx] cst3xx_firmware_info read error .\r\n");
-		return -1;
-	}
-
-	buf[0] = 0xD1;
-	buf[1] = 0x09;
-	ret = cst3xx_i2c_write(client, buf, 2);
-	if (ret < 0) {
-		return -1;
-	}
-	mdelay(5);
