-static int __init ingenic_pwm_init(void)
-{
-	return platform_driver_register(&pwm_ingenic_driver);
-}
-
-static void __exit ingenic_pwm_exit(void)
-{
-	platform_driver_unregister(&pwm_ingenic_driver);
-}
