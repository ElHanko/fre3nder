-{
-	int ret;
-	unsigned char buf[3];
-
-	buf[0] = 0xA0;
-	buf[1] = 0x02;
-	buf[2] = 0x00;      //set cmd to erase main area
-	ret = cst3xx_i2c_write(client, buf, 3);
-	if (ret < 0) {
-		return -1;
-	}
-
-	mdelay(5);
-
-	buf[0] = 0xA0;
-	buf[1] = 0x03;
-	ret = cst3xx_i2c_read_register(client, buf, 1);
-	if (ret < 0) {
-		return -1;
-	}
-
-	if (buf[0] != 0x55) {
-		return -1;
-	}
-
-	return 0;
-}
