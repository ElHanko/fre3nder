-	if (ret < 0) {
-		return -1;
-	}
-
-	mdelay(2);
-
-	buf[0] = 0xA0;
-	buf[1] = 0x02;  //check whether into program mode
-	ret = cst3xx_i2c_read_register(client, buf, 1);
-	if (ret < 0) {
-		return -1;
-	}
-
-	if (buf[0] != 0x55) {
-		return -1;
-	}
-
-	return 0;
