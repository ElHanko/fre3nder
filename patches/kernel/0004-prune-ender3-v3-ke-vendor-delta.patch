-	}
-
-	return 0;
-}
-
-static void __exit ft6236_touch_exit(void)
-{
-	i2c_del_driver(&ft6236_ts_driver);
-}
-
-module_init(ft6236_touch_init);
-module_exit(ft6236_touch_exit);
-
