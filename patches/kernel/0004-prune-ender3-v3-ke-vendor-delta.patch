-	mdelay(20);
-START_FLOW:
-
-#ifdef HYN_UPDATE_FIRMWARE_POWERON_ENABLE
-	close_vcc3v3Power();
-	mdelay(20);
-	open_vcc3v3Power();
-	mdelay(5 + retry);
-#else
-	cst3xx_reset_ic(ts, 5 + retry);
