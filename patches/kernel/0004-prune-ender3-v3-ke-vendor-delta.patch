-
-	     iicsendbyte(buf[0]);
-	     __udelay(delay_data);
-	     waitack();
-	     __udelay(delay_data);
-	*/
-	iicstart();
-	__udelay(delay_data);
-
-	iicsendbyte((0x1a << 1) | 1);
-	__udelay(delay_data);
-	if (waitack()) {
-		iicstop();
-		printk(" cst3xx_i2c_read wait ack timeoue \n");
-		return 1;
-	}
-	__udelay(delay_data);
-
-	while (count) {
-		if (count == 1) {
-			*buf = iicreceivebyte(0);
-		} else {
-			*buf = iicreceivebyte(1);
-		}
-		count --;
-		buf++;
-	}
-	iicstop();
-	__udelay(delay_data);
-	return 0;
-}
