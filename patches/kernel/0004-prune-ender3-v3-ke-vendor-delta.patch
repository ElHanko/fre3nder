-		input_set_abs_params(input, ABS_MT_POSITION_Y, 0, pdata->max_x, 0, 0);
-	} else {
-		input_set_abs_params(input, ABS_MT_POSITION_X, 0, pdata->max_x, 0, 0);
-		input_set_abs_params(input, ABS_MT_POSITION_Y, 0, pdata->max_y, 0, 0);
