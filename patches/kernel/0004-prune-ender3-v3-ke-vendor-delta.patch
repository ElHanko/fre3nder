-	                            "", &adb_func_type);
-	usb_os_desc_prepare_interf_dir(&fi_adb->func_inst.group, 1,
-	                               descs, names, THIS_MODULE);
-
-	ret = adb_setup(fi_adb);
-	if (ret) {
-		kfree(fi_adb);
-		pr_err("Error setting ADB\n");
