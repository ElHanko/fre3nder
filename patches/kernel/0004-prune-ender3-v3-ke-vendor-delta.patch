-	memcpy((void *)mode->name, mode_info, name_len);
-	mode_info = strsep(&s, " ");
-	mode->refresh = simple_strtoul(mode_info, NULL, 0);
-	mode_info = strsep(&s, " ");
-	mode->xres = simple_strtoul(mode_info, NULL, 0);
