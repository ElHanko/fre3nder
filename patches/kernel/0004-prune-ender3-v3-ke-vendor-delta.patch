-ssize_t goodix_tool_read(struct file *file, char __user *page,
-                         size_t size, loff_t *ppos)
-{
-	s32 ret = 0;
-
-	if (*ppos) {
-		/* ADB call again
-		 * dev_dbg(&gt_client->dev, "[HEAD]wr: %d", cmd_head.wr);
-		 * dev_dbg(&gt_client->dev,
-		 * "[PARAM]size: %d, *ppos: %d", size, (int)*ppos);
