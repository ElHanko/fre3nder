-static int cst3xx_i2c_write(struct i2c_client *client, unsigned char *buf, int len)
-{
-	int count = len;
-	iicstart();
-	//   __udelay(delay_data);
-
-	iicsendbyte((0x1A << 1) | 0);
-	//      __udelay(delay_data);
-
-	if (waitack()) {
-		iicstop();
-		printk(" cst3xx_i2c_write send address wait ack timeoue \n");
-		return 1;
-	}
-
-	while (count--) {
-		iicsendbyte(*(buf++));
-		__udelay(delay_data);
-		if (waitack()) {
-			iicstop();
-			printk(" cst3xx_i2c_write wait ack timeoue \n");
-			return 1;
-		}
-		__udelay(delay_data);
-	}
-
-	iicstop();
-	__udelay(delay_data);
-
-	return 0;
