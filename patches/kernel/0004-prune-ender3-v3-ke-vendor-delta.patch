-static void clk_div_table_generate(void)
-{
-	int i;
-	for (i = 0; i < ARRAY_SIZE(ad100_clk_div_table); i++) {
-		ad100_clk_div_table[i].val = i;
-		ad100_clk_div_table[i].div = (i + 1) * 4;
-	}
-
-}
-
-static const struct of_device_id ext_clk_match[] __initconst = {
-	{ .compatible = "ingenic,fixed-clock", .data = (void *)0, },
-	{},
-};
-
-/* Register ad100 clocks. */
-static void __init ad100_clk_init(struct device_node *np)
-{
-	struct ingenic_clk_provider *ctx;
-	void __iomem *reg_base;
-
-	printk("ad100 Clock Power Management Unit init!\n");
-
-	if (np) {
-		reg_base = of_iomap(np, 0);
-		if (!reg_base) {
-			panic("%s: failed to map registers\n", __func__);
-		}
-	}
-
-	ctx = ingenic_clk_init(np, reg_base, NR_CLKS);
-	if (!ctx) {
-		panic("%s: unable to allocate context.\n", __func__);
-	}
-
-	/* Register Ext Clocks From DT */
-	ingenic_clk_of_register_fixed_ext(ctx, ad100_fixed_rate_ext_clks,
-	                                  ARRAY_SIZE(ad100_fixed_rate_ext_clks), ext_clk_match);
-
-	/* Register PLLs. */
-	ingenic_clk_register_pll(ctx, ad100_pll_clks,
-	                         ARRAY_SIZE(ad100_pll_clks), reg_base);
-
-	/* Register Muxs */
-	ingenic_clk_register_mux(ctx, ad100_mux_clks, ARRAY_SIZE(ad100_mux_clks));
-
-	/* Register Bus Divs */
-	ingenic_clk_register_bus_div(ctx, ad100_bus_div_clks, ARRAY_SIZE(ad100_bus_div_clks));
-
-	/* Register Divs */
-	clk_div_table_generate();
-	ingenic_clk_register_cgu_div(ctx, ad100_div_clks, ARRAY_SIZE(ad100_div_clks));
-
-	/* Register Fractional Divs */
-	ingenic_clk_register_fra_div(ctx, ad100_fdiv_clks, ARRAY_SIZE(ad100_fdiv_clks));
-
-	/* Register Gates */
-	ingenic_clk_register_gate(ctx, ad100_gate_clks, ARRAY_SIZE(ad100_gate_clks));
-
-	/* Register Powers */
-	//ingenic_power_register_gate(ctx, ad100_gate_power, ARRAY_SIZE(ad100_gate_power));
-
-	ingenic_clk_of_add_provider(np, ctx);
-
-	//ingenic_clk_of_dump(ctx);
-
-	pr_info("=========== ad100 clocks: =============\n"
-	        "\tapll     = %lu , mpll     = %lu, ddr = %lu\n"
-	        "\tcpu_clk  = %lu , l2c_clk  = %lu\n"
-	        "\tahb0_clk = %lu , ahb2_clk = %lu\n"
-	        "\tapb_clk  = %lu , ext_clk  = %lu\n\n",
-	        _get_rate("apll"),  _get_rate("mpll"), _get_rate("div_ddr"),
-	        _get_rate("div_cpu"), _get_rate("div_l2c"),
-	        _get_rate("div_ahb0"), _get_rate("div_ahb2"),
-	        _get_rate("div_apb"), _get_rate("ext"));
-
-}
-
-CLK_OF_DECLARE_DRIVER(ad100_clk, "ingenic,ad100-clocks", ad100_clk_init);
