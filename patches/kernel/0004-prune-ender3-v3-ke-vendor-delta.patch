-static int __init fts_ts_init(void)
-{
-	int ret = 0;
-
-	FTS_FUNC_ENTER();
-	ret = i2c_add_driver(&fts_ts_driver);
-	if (ret != 0) {
-		FTS_ERROR("Focaltech touch screen driver init failed!");
