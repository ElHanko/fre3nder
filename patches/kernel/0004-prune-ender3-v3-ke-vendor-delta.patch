-static u8 ascii2hex(u8 a)
-{
-	s8 value = 0;
-
-	if (a >= '0' && a <= '9') {
-		value = a - '0';
-	} else if (a >= 'A' && a <= 'F') {
-		value = a - 'A' + 0x0A;
-	} else if (a >= 'a' && a <= 'f') {
-		value = a - 'a' + 0x0A;
-	} else {
-		value = 0xff;
-	}
-
-	return value;
-}
-
-int gtp_ascii_to_array(const u8 *src_buf, int src_len, u8 *dst_buf)
-{
-	int i, ret;
-	int cfg_len = 0;
-	u8 high, low;
-
-	for (i = 0; i < src_len;) {
-		if (src_buf[i] == ' ' || src_buf[i] == '\r' ||
-		    src_buf[i] == '\n') {
-			i++;
-			continue;
-		}
-
-		if ((src_buf[i] == '0') && ((src_buf[i + 1] == 'x') ||
-		                            (src_buf[i + 1] == 'X'))) {
-			high = ascii2hex(src_buf[i + 2]);
-			low = ascii2hex(src_buf[i + 3]);
-
-			if ((high == 0xFF) || (low == 0xFF)) {
-				ret = -1;
-				goto convert_failed;
-			}
-
-			if (cfg_len < GTP_CONFIG_MAX_LENGTH) {
-				dst_buf[cfg_len++] = (high << 4) + low;
-				i += 5;
-			} else {
-				ret = -2;
-				goto convert_failed;
-			}
-		} else {
-			ret = -3;
-			goto convert_failed;
-		}
-	}
-	return cfg_len;
-
-convert_failed:
-	return ret;
-}
