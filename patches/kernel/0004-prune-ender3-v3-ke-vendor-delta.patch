-		printk("ERROR: cannot get pclk epll param \n");
-		return -1;
-	}
-	pclk_parent = clk_get(NULL, "epll");
-	clk_set_rate(pclk_parent, pclk_epll_tab[i].pll_freq);
-	clk_set_parent(clk_get(NULL, "mux_lcd"), pclk_parent);
-	clk_set_rate(dctrl->pclk, pclk_rate);
-	return 0;
-#else
-	return 0;
-#endif
