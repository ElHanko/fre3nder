-static irqreturn_t ingenic_cascade(int irq, void *data)
-{
-	uint32_t irq_reg;
-	unsigned i;
-
-	for (i = 0; i < ingenic_num_chips; i++) {
-		irq_reg = readl(intc_base + (i * PART_OFF) + IPR_OFF);
-		if (!irq_reg) {
-			continue;
-		}
-		generic_handle_irq(__fls(irq_reg) + (i * 32) + XBURST_SOC_IRQ_BASE);
-	}
-
-	return IRQ_HANDLED;
-}
