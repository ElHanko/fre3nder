-	ret = cst3xx_into_program_mode(ts->client);
-	if (ret < 0) {
-		printk(" cst3xx[cst3xx]into program mode failed.\n");
-		goto err_out;
-	}
-
-	ret = cst3xx_erase_program_area(ts->client);
-	if (ret) {
-		printk(" cst3xx[cst3xx]erase main area failed.\n");
