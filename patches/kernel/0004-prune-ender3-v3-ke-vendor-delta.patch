-		ret = cst3xx_boot_update_fw(ts, pcst3xx_update_firmware); //
-		if (ret < 0) {
-			printk(" cst3xx hyn_boot_update_fw failed.\n");
-			return -1;
-		}
-#endif
-
-	} else {
