-
-	ts->pins_release = pinctrl_lookup_state(ts->pinctrl, "pmx_ts_release");
-	if (IS_ERR_OR_NULL(ts->pins_release)) {
-		FTS_ERROR("Pin state[release] not found");
-		ret = PTR_ERR(ts->pins_release);
