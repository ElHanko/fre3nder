-			devm_gpiod_put(host->dev, card_gpio->cd);
-			card_gpio->cd = NULL;
-		}
-		if (card_gpio->wp) {
-			devm_gpiod_put(host->dev, card_gpio->wp);
-			card_gpio->wp = NULL;
-		}
-		if (card_gpio->pwr) {
-			devm_gpiod_put(host->dev, card_gpio->pwr);
-			card_gpio->pwr = NULL;
-		}
-		if (card_gpio->rst) {
-			devm_gpiod_put(host->dev, card_gpio->rst);
-			card_gpio->rst = NULL;
-		}
-	}
-}
