-static int panel_remove(struct platform_device *pdev)
-{
-	struct panel_dev *panel = dev_get_drvdata(&pdev->dev);
-
-	lcd_device_unregister(panel->lcd);
-	device_unregister(&panel_dev_device.dev);
-	gpio_free(panel->rst.gpio);
-	return 0;
-}
