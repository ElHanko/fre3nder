-
-	msgs[0].flags = 0;
-	msgs[0].addr  = client->addr;
-	msgs[0].len   = 2;
-	msgs[0].buf   = buf;
-
-	msgs[1].flags |= I2C_M_RD;
-	msgs[1].addr   = client->addr;
-	msgs[1].len    = len;
-	msgs[1].buf    = buf;
-
-	while (retries < 2) {
-		ret = i2c_transfer(client->adapter, msgs, 2);
-		if (ret == 2) {
-			break;
-		}
-		retries++;
-	}
-
-	return ret;
-}
