-
-#define save_mxu(tsk)							\
-	do {										\
-		if (cpu_has_mxu)						\
-			__save_mxu(tsk);					\
-	} while (0)
-
-#define restore_mxu(tsk)						\
-	do {										\
-		if (cpu_has_mxu)						\
-			__restore_mxu(tsk);					\
-	} while (0)
-
-#define __get_mxu_regs(tsk)						\
-	({											\
-		if (tsk == current)						\
-			__save_mxu(current);				\
-												\
-		tsk->thread.mxu.regs;					\
-	})
-
-#define __let_mxu_regs(tsk,regs)				\
-	do{											\
-		int i;									\
-		for(i = 0; i < NUM_MXU_REGS;i++)		\
-			tsk->thread.mxu.regs[i] = regs[i];	\
-		if (tsk == current)						\
-			__save_mxu(current);				\
-	}while(0)
-
-#endif /* _ASM_MXU_H */
