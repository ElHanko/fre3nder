-	misc_deregister(&efuse->mdev);
-#ifdef CONFIG_INGENIC_EFUSE_WRITABLE
-	dev_info(efuse->dev, "del vddq_protect_timer!\n");
-	del_timer(&efuse->vddq_protect_timer);
-#endif
-	iounmap(efuse->iomem);
