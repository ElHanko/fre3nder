-		return -1;  //bad fw, so do not update
-	}
-
-	pBuf = &pdata[CST3XX_BIN_SIZE - 16];
-
-	project_id = pBuf[1];
-	project_id <<= 8;
-	project_id |= pBuf[0];
-
-	ic_type = pBuf[3];
-	ic_type <<= 8;
-	ic_type |= pBuf[2];
-
-	fw_version = pBuf[7];
-	fw_version <<= 8;
