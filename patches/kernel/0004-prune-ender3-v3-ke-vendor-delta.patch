-static void ingenic_irq_pm_set_mask(struct irq_chip_generic *gc, uint32_t unmask)
-{
-	struct irq_chip_regs *regs = &gc->chip_types->regs;
-
-	writel(unmask, gc->reg_base + regs->enable);
-	writel(~unmask, gc->reg_base + regs->disable);
-}
