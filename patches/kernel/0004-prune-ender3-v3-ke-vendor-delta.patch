-	if (!input_dev) {
-		return -ENOMEM;
-	}
-
-	ts->pdata = pdata;
-	ts->client = client;
-	ts->input_dev = input_dev;
-
-	if (client->addr != 0x1A) { //check address
-		client->addr = 0x1A;
