-static int ft_request_irq(struct ft6236_data *ts)
-{
-	int ret = -1;
-
-	if (gpio_is_valid(ts->pdata->irq_gpio)) {
-		ts->client->irq = gpio_to_irq(ts->pdata->irq_gpio);
