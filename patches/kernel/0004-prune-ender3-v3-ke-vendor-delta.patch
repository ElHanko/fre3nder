-
-	printk("lpm is idle pd\n");
-
-	lcr &=~ 0x3; // low power mode: IDLE
-	lcr |= 2;
-	cpm_outl(lcr, CPM_LCR);
-
-	opcr &= ~ (1<<31);
-	opcr |= (1 << 30);
-	opcr |= (1 << 26);	//l2c power down
