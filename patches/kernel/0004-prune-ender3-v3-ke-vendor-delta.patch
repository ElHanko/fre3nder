-		dev_warn(dev, "invalid gpio rst.gpio: %d\n", panel->rst.gpio);
-	}
-
-	panel->vdd_en.gpio = of_get_named_gpio_flags(np, "ingenic,vdd-en-gpio", 0, &flags);
-	if (gpio_is_valid(panel->vdd_en.gpio)) {
