-MODULE_AUTHOR("Nick <nick.xhshen@ingenic.com>");
-MODULE_LICENSE("GPL");
-MODULE_DESCRIPTION("Ingenic RTC driver");
-MODULE_ALIAS("platform:rtc-ingenic");
