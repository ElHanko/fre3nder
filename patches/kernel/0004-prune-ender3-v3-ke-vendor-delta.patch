-static inline long timeval_sub_to_us(struct timespec64 lhs,
-                                     struct timespec64 rhs)
-{
-	long sec, nsec;
-	sec = lhs.tv_sec - rhs.tv_sec;
-	nsec = lhs.tv_nsec - rhs.tv_nsec;
-
-	return (sec * 1000000 + nsec / 1000);
-}
