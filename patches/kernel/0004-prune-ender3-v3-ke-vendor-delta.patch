-	}
-
-	sscanf(buf, "%d\n", &msecs);
-
-	if (msecs < 1000) {
-		msecs = 1000;
-	}
-	if (msecs > 30000) {
-		msecs = 30000;
-	}
-
-	wdt->msecs = msecs;
-	return count;
