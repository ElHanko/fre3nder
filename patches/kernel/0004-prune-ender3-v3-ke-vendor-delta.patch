-
-	int ret;
-	struct cst3xx_ts_data *ts;
-
-	struct cst3xx_platform_data *pdata = (struct cst3xx_platform_data *)client->dev.platform_data;
-	struct input_dev *input_dev;
-	int error;
-
-#if USE_ANALOG_I2C
-	if (gpio_is_valid(I2CSDA)) {
-		gpio_free(I2CSDA);
-		ret = gpio_request(GPIO_PC(27), "I2C1-SDA");
