-			reg_write(dctrl, DC_COM_CONFIG, com_cfg);
-			dctrl->chan = DATA_CH_ROT;
-		}
-		if ((comp_info->out_mode == COMP_DIRECT_OUT) && (dctrl->rot_cfg.rot_angle == 0)) {
-			com_cfg = reg_read(dctrl, DC_COM_CONFIG);
