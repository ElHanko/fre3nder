-		printk("  hyn the updated ic checksum is :0x%x. the updating firmware checksum is:0x%x------\n", checksum, bin_checksum);
-
-		if (checksum != bin_checksum) {
-			printk(" cst3xx hyn check sum error.\n");
-			return -1;
-
-		}
-
-	} else {
-		printk(" cst3xx hyn No checksum.\n");
-		return -1;
-	}
-	return 0;
-}
