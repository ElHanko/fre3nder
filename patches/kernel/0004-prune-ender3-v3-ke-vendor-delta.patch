-
-	     iicsendbyte(buf[0]);
-	     __udelay(delay_data);
-	     waitack();
-	     __udelay(delay_data);
-	*/
-	iicstart();
-	__udelay(delay_data);
-
-	iicsendbyte((0x1a << 1) | 1);
-	__udelay(delay_data);
-	if (waitack()) {
