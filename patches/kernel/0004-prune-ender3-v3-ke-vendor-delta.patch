-		if (formats[i].types & type) {
-			/* index-th format of type type found ? */
-			if (num == f->index) {
-				break;
-			}
-			/* Correct type but haven't reached our index yet,
-			 * just increment per-type index */
-			++num;
-		}
-	}
-
-	if (i < NUM_FORMATS) {
-		/* Format found */
-		fmt = &formats[i];
-		strncpy(f->description, fmt->name, sizeof(f->description) - 1);
