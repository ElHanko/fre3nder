-int fts_create_esd_sysfs(struct device *dev)
-{
-	int ret = 0;
-
-	ret = sysfs_create_group(&dev->kobj, &fts_esd_group);
-	if (ret != 0) {
-		FTS_ERROR("fts_create_esd_sysfs(sysfs) create fail");
-		sysfs_remove_group(&dev->kobj, &fts_esd_group);
