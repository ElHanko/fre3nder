-static unsigned char iicreceivebyte(unsigned char ack)
-{
-	unsigned char i = 8;
-	unsigned char ddata = 0;
-
-	gpio_direction_input(GPIO_PC(27));
-	__udelay(delay_data);
-
-	for (i = 0; i < 8; i++) {
-		I2CSCL_LOW;
-		__udelay(delay_data);
-		I2CSCL_HIGH;
-		__udelay(delay_data);
-
-		ddata <<= 1;
-		if (gpio_get_value(GPIO_PC(27))) {
-			ddata++;
-		}
-	}
-
-	if (!ack) {
-		sendnotack();
-	} else {
-		sendack();
-	}
-
-	return ddata;
-}
