-		 */
-		*ppos = 0;
-		return 0;
-	}
-
-	if (cmd_head.wr % 2) {
-		return -EPERM;
-	} else if (!cmd_head.wr) {
-		u16 len, data_len, loc, addr;
-
-		if (1 == cmd_head.flag) {
-			if (FAIL == comfirm()) {
-				dev_err(&gt_client->dev, "[READ]Comfirm fail!");
-				return -EPERM;
-			}
-		} else if (2 == cmd_head.flag) {
-			/*Need interrupt!*/
-		}
-
-		if (cmd_head.delay) {
-			msleep(cmd_head.delay);
-		}
-
-		data_len = cmd_head.data_len;
