-	}
-
-	((uint32_t *)(fb->pseudo_palette))[regno] =
-	    convert_color_to_hw(red, &fb->var.red) |
-	    convert_color_to_hw(green, &fb->var.green) |
-	    convert_color_to_hw(blue, &fb->var.blue) |
-	    convert_color_to_hw(transp, &fb->var.transp);
-
-	return 0;
-}
