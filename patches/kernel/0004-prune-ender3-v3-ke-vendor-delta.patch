-{
-	struct ingenic_tcu_chn *chn = irq_data_get_irq_chip_data(data);
-	int id = chn->cib.id;
-
-	switch (chn->irq_type) {
-		case FULL_IRQ_MODE :
-			tcu_mask_full_irq(id);
-			break;
-		case HALF_IRQ_MODE :
-			tcu_mask_half_irq(id);
-			break;
-		case FULL_HALF_IRQ_MODE :
