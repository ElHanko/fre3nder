-	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
-	if (!ctx) {
-		return -ENOMEM;
-	}
-
-	if (mutex_lock_interruptible(&dev->dev_mutex)) {
-		kfree(ctx);
-		return -ERESTARTSYS;
-	}
-
-	ctx->hw_comp = hw_composer_create(ctx);
-	if (!ctx->hw_comp) {
-		goto err_hw_comp;
-	}
-
-	ctx->dpu_dev = dev;
