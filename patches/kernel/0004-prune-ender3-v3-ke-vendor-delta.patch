-	input_set_abs_params(input_dev, ABS_X, ts->pdata->x_min, ts->pdata->x_max, 0, 0);
-	input_set_abs_params(input_dev, ABS_Y, ts->pdata->y_min, ts->pdata->y_max, 0, 0);
