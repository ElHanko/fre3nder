@@ -520,6 +531,18 @@ static int sdhci_ingenic_probe(struct platform_device *pdev)
 	sdhci_ing->pdev = pdev;
 	sdhci_ing->pdata = pdata;
 
+	if (pdev->id == 1) {
+		sdhci_ing->wlan_reg_on = devm_gpiod_get_optional(dev,
+			"wlan-reg-on", GPIOD_ASIS);
+		if (IS_ERR(sdhci_ing->wlan_reg_on))
+			return PTR_ERR(sdhci_ing->wlan_reg_on);
+		if (sdhci_ing->wlan_reg_on) {
+			ret = gpiod_direction_output_raw(sdhci_ing->wlan_reg_on, 0);
+			if (ret)
+				return ret;
+		}
+	}
+
 	host->ioaddr = of_iomap(pdev->dev.of_node, 0);
 	if (IS_ERR(host->ioaddr)) {
 		return PTR_ERR(host->ioaddr);
