+#ifdef CONFIG_PINCTRL_DUMP
+const unsigned char *func_map[] = {"Fun0", "Fun1", "Fun2", "Fun3", "Out0", "Out1", "Inpt", "Inpt", \
+                                   "IntL", "IntH", "IntF", "IntR", "ItLM", "ItHM", "ItFM", "ItRM", "IntD", "ItDM"
+                                  };
