+	p += sprintf(p, "layer3_end	: %lld\n", dbg->layer3_end);
+	p += sprintf(p, "layer2_end	: %lld\n", dbg->layer2_end);
+	p += sprintf(p, "layer1_end	: %lld\n", dbg->layer1_end);
