+/* 1. slcd/tft 接口初始化.
+ * 2. 设置pixclk.
+ * */
+int dpu_ctrl_setup(struct dpu_ctrl *dctrl)
+{
+	struct lcd_panel *panel = dctrl->panel;
+	unsigned int intc = 0;
+	int ret = 0;
+
+	disp_common_init(dctrl, dctrl->panel);
+	common_cfg_init(dctrl);
+
+	reg_write(dctrl, DC_CLR_ST, 0x01FFFFFE);
