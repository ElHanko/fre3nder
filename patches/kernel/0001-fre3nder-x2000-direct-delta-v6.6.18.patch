+ */
+dsih_error_t mipi_dsih_hal_dpi_video_mode_type(struct dsi_device *dsi, dsih_video_mode_t type)
+{
+	if (type < 3) {
+		mipi_dsih_write_part(dsi, R_DSI_HOST_VID_MODE_CFG, type, 0, 2);
+		return OK;
+	} else {
+		{
+			printk("undefined type");
+		}
+		return ERR_DSI_OUT_OF_BOUND;
+	}
