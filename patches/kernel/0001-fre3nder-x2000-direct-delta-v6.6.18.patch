+
+	if (count >= total_size) {
+		count = total_size;
+	}
+
+	if (count + p > total_size) {
+		count = total_size - p;
+	}
+
+	buffer = kmalloc((count > PAGE_SIZE) ? PAGE_SIZE : count,
+	                 GFP_KERNEL);
+	if (!buffer) {
