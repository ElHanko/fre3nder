+	TFT_LCD_COLOR_ODD_RBG,
+	TFT_LCD_COLOR_ODD_BGR,
+	TFT_LCD_COLOR_ODD_BRG,
+	TFT_LCD_COLOR_ODD_GBR,
+	TFT_LCD_COLOR_ODD_GRB,
+};
+
+enum tft_lcd_mode {
