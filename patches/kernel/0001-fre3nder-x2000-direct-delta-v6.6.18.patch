+{
+	struct sdhci_host *host = dev_get_drvdata(dev);
+	struct sdhci_ingenic *sdhci_ing = sdhci_priv(host);
+	int ret = 0;
+
+	ret = sdhci_suspend_host(host);
+
+	clk_disable_unprepare(sdhci_ing->clk_gate);
+	return ret;
