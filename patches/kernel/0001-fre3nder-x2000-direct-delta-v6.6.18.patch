+
+menuconfig TRUE_COLOR_LOGO
+       bool "True Color Logo for Ingenic"
+       depends on LOGO
+       default n
+
+config TRUE_COLOR_LOGO_FILE
+       string "Logo File"
+       depends on TRUE_COLOR_LOGO
+       default "module_drivers/drivers/video/logo-ingenic/logo.png"
+       help
+         set a picture file, support png, jpg, bmp.
+
+config TRUE_COLOR_LOGO_BACKGROUND
+       hex "Background Color"
+       depends on TRUE_COLOR_LOGO
+       default '0x00ffffff'
+       help
+         set default background color.
diff --git a/module_drivers/drivers/video/logo-ingenic/Makefile b/module_drivers/drivers/video/logo-ingenic/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..a643e00dc9683a729771f22becc5f38a778d4f65
--- /dev/null
+++ b/module_drivers/drivers/video/logo-ingenic/Makefile
@@ -0,0 +1,12 @@
+# Makefile for true color logo.
+
+obj-y	+= logo.o
+obj-y	+= showlogo.o
+
+ifeq ($(CONFIG_EXT_LOGO),y)
+LOGO_FILE:=$(srctree)/$(OUTSIDE_BUILD)/$(CONFIG_TRUE_COLOR_LOGO_FILE)
+else
+LOGO_FILE:=$(srctree)/$(CONFIG_TRUE_COLOR_LOGO_FILE)
+endif
+$(obj)/logo.c: scripts/pic2logo FORCE
+	@$< $(LOGO_FILE) 32 $(CONFIG_TRUE_COLOR_LOGO_BACKGROUND)> $@
