index 0000000000000000000000000000000000000000..be73baed15c4d7cec1e03b67c28b29a57d9fef38
--- /dev/null
+++ b/arch/mips/xburst2/soc-x2000/pm_firmware/include/mipsregs.h
@@ -0,0 +1,858 @@
