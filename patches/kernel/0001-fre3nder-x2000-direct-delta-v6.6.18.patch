+
+	unsigned int resume_pc;
+	unsigned int reload_pc;
+
+	unsigned int load_addr;
+	unsigned int load_space;
+
+};
+typedef void (*PMTEXTENTRY)(void *entry, struct pm_param **p);
+
+#endif /* INTERFACE_H */
diff --git a/arch/mips/xburst2/soc-x2000/pm_firmware/include/mipsregs.h b/arch/mips/xburst2/soc-x2000/pm_firmware/include/mipsregs.h
