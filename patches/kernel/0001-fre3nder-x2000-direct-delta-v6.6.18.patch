+
+	slcd_cfg_init(dctrl, panel->smart_config);
+	slcd_timing_init(dctrl, panel, mode);
+
+	if (panel_ops && panel_ops->enable) {
+		panel_ops->enable(panel);
+	}
+	ingenicfb_slcd_mcu_init(dctrl);
+
+	return 0;
+}
