+void jz_dsi_phy_stop(struct dsi_device *dsi)
+{
+	jz_dsih_dphy_reset(dsi, 0);
+	jz_dsih_dphy_shutdown(dsi, 0);
+	mipi_dsih_hal_power(dsi, 0);
+	jz_dsih_dphy_clock_en(dsi, 0);
+	clk_disable_unprepare(dsi->clk);
+}
