diff --git a/module_drivers/drivers/pinctrl/pinctrl-ingenic.c b/module_drivers/drivers/pinctrl/pinctrl-ingenic.c
new file mode 100644
index 0000000000000000000000000000000000000000..69822206d0d4a10f027d667ba8dab05e38e4c4e3
--- /dev/null
+++ b/module_drivers/drivers/pinctrl/pinctrl-ingenic.c
@@ -0,0 +1,2394 @@
+/*
+ * pinctrl/ingenic/pinctrl-ingenic.c
+ *
+ * Copyright 2015 Ingenic Semiconductor Co.,Ltd
+ *
+ * Author: cli <chen.li@ingenic.com>
+ *
