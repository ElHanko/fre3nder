diff --git a/arch/mips/boot/zcompressed/tools/entry b/arch/mips/boot/zcompressed/tools/entry
new file mode 100644
index 0000000000000000000000000000000000000000..376e822a6353bff6f56689f619e3f50b0b0ec46f
--- /dev/null
+++ b/arch/mips/boot/zcompressed/tools/entry
@@ -0,0 +1,12 @@
+#!/bin/sh
+
+# grab the kernel_entry address from the vmlinux elf image
+entry=`$1 $2  | grep kernel_entry`
+
+fs=`echo $entry | grep ffffffff`  # check toolchain output
+
+if [ -n "$fs" ]; then
+	echo "0x"`$1 $2  | grep kernel_entry | cut -c9- | awk '{print $1}'`
+else
+	echo "0x"`$1 $2  | grep kernel_entry | cut -c1- | awk '{print $1}'`
+fi
diff --git a/arch/mips/boot/zcompressed/tools/filesize b/arch/mips/boot/zcompressed/tools/filesize
new file mode 100644
index 0000000000000000000000000000000000000000..9fdebda56c07b3d31cd79dd9f8af457b922e5c43
--- /dev/null
+++ b/arch/mips/boot/zcompressed/tools/filesize
@@ -0,0 +1,14 @@
+#!/bin/sh
+
+file=$1
+
+which du > /dev/null
+if [ $? != 0 ]; then
+    echo "error: no 'du' cmd found" 1>&2
+    exit 1
+fi
+
+for size in `du -b $file`; do
+    echo $size;
+    exit 0
+done
