+	FUNC valid;
+	FUNC begin;
+	FUNC prepare;
+	FUNC enter;
+	FUNC finish;
+	FUNC end;
+	FUNC poweroff;
+
+	int uart_index;
+	int mcu_uart_idx;
+	int mcu_uart_baud;
