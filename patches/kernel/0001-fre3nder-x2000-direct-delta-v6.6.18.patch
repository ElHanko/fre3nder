+	TFT_LCD_MODE_PARALLEL_666,
+	TFT_LCD_MODE_PARALLEL_565,
+	TFT_LCD_MODE_SERIAL_RGB,
+	TFT_LCD_MODE_SERIAL_RGBD,
+};
+
+struct tft_config {
