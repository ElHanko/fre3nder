+u32 ingenic_dma_read_dtc(struct dma_chan *chan)
+{
+	struct ingenic_dma_chan *dmac = to_ingenic_dma_chan(chan);
+	return readl(dmac->iomem + CH_DTC);
+}
+EXPORT_SYMBOL_GPL(ingenic_dma_read_dtc);
