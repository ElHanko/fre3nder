index 0000000000000000000000000000000000000000..d98232e7211cc414d138422afdb5cdb1ba0e8fa6
--- /dev/null
+++ b/arch/mips/xburst2/soc-x2000/pm.c
@@ -0,0 +1,329 @@
+#include <linux/init.h>
+#include <linux/pm.h>
+#include <linux/ctype.h>
+#include <linux/module.h>
+
+#include <soc/gpio.h>
