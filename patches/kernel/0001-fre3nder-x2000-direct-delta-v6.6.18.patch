+void __init ingenic_clk_register_mux(struct ingenic_clk_provider *ctx,
+                                     const struct ingenic_mux_clock *list,
+                                     unsigned int nr_clk)
+{
+	struct clk *clk;
+	unsigned int idx, ret;
