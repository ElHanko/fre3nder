+void load_func_to_rtc_ram(void)
+{
+	int i;
+
+	rtc_ram_write_enable();
+
+	for (i = 0; i < 4096; i = i + 4) {
+		*(volatile unsigned int *)(RTC_MEMORY_START + i) = 0;
+	}
+
+	rtc_ram_store();
+
+	for (i = 0; i < FASTBOOT_RESUME_CODE_LEN / 4; i++) {
+		*(volatile unsigned int *)(FASTBOOT_RESUME_CODE1_ADDR + i * 4) = *(volatile unsigned int *)(fastboot_resume_code + i);
+	}
+
+	rtc_ram_write_disable();
+}
