+#define NUM_FORMATS ARRAY_SIZE(formats)
+
+static struct dpu_fmt *find_fmt(struct v4l2_format *f)
+{
+	unsigned int i;
+	for (i = 0; i < NUM_FORMATS; i++) {
+		if (formats[i].fourcc == f->fmt.pix.pixelformat) {
+			return &formats[i];
+		}
+	}
+	return NULL;
+}
