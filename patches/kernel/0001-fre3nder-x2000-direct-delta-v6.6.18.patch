+#ifdef CONFIG_SOC_X2600
+	if (panel->lcd_type == LCD_TYPE_LVDS_JEIDA || panel->lcd_type == LCD_TYPE_LVDS_VESA) {
+		lvds_rx_enable(dctrl->dsi);
+	}
+#endif
+	return ret;
+}
