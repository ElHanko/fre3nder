+++ b/arch/mips/xburst2/soc-x2000/pm_firmware/src/printf.c
@@ -0,0 +1,130 @@
+/*
+ * printf function in spl.
+ *
+ * Copyright (c) 2013 Ingenic Semiconductor Co.,Ltd
+ * Author: Zoro <ykli@ingenic.cn>
