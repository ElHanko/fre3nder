+static void lt9211_vid_chk_rst(struct i2c_client *client)
+{
+	i2c_write(client, 0xff, 0x81);
+	i2c_write(client, 0x10, 0xbe);
+	mdelay(10);
+	i2c_write(client, 0x10, 0xfe);
+}
+#endif
