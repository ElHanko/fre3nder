+	lw	k1,88(k0)
+	mtc0	k1,CP0_CONFIG5
+	lw	k1,92(k0)
+	mtc0	k1,CP0_CONFIG7
+	lw	k1,96(k0)
+	mtc0	k1,CP0_LLADDR
+	lw	k1,100(k0)
+	mtc0	k1,CP0_WATCHLo
+	lw	k1,104(k0)
+	mtc0	k1,CP0_WATCHHI
+	lw	k1,108(k0)
+	mtc0	k1,CP0_ERRCTL
+	lw	k1,112(k0)
+	mtc0	k1,CP0_CONTEXT
+	lw	k1,116(k0)
+	mtc0	k1,CP0_KSCRATCH1
+	lw	k1,120(k0)
+	mtc0	k1,CP0_KSCRATCH2
+	lw	k1,124(k0)
