+	struct ingenicfb_frm_cfg *frm_cfg = &fbdev->current_frm_mode.frm_cfg;
+	struct ingenicfb_lay_cfg *lay_cfg;
+	char *p = buf;
+
+	if (layer > CONFIG_FB_INGENIC_NR_LAYERS) {
+		return -EINVAL;
+	}
+
+	lay_cfg = &frm_cfg->lay_cfg[layer];
+
