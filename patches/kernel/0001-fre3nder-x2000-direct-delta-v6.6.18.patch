+static int soc_pm_wakeup_fastboot_config(void)
+{
+	unsigned int tmp;
+
+	/* clear fastboot reset */
+	tmp = rtc_read_reg(0xb0003048);
+	tmp &= ~(1 << 20);
+	rtc_write_reg(0xb0003048, tmp);
+
+	return 0;
+}
+
+void soc_pm_wakeup_fastboot(void)
+{
+
+	soc_pm_wakeup_fastboot_config();
+
+	sys_restore();
+
+}
