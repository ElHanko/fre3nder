+	.priv_data_init = x2000_priv_data_init,
+
+	.phy_init = x2000_phy_init,
+	.phy_set_wakeup = x2000_phy_set_wakeup,
+	.phy_get_wakeup = x2000_phy_get_wakeup,
+};
