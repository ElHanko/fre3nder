+static void LT9211_ChipID(struct i2c_client *client)
+{
+	i2c_write(client, 0xff, 0x81); //register bank
+	printk("LT9211 Chip ID:%x,", i2c_read(client, 0x00));
+	printk("%02x, ", i2c_read(client, 0x01));
+	printk("%02x\n", i2c_read(client, 0x02));
+}
