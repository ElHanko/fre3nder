+	container_of(attr, struct layer_device_attr, attr)
+
+#define LAYER_ATTR(layer, _name, _mode, _show, _store)          \
+	{                                                       \
+		.attr   = __ATTR(_name, _mode, _show, _store),  \
+		          .id     = layer,                                                \
