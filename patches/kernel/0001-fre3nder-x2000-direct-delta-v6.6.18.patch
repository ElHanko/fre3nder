+#ifndef __INGENIC_CLK_PLLV_H__
+#define __INGENIC_CLK_PLLV_H__
+
+extern const struct clk_ops ingenic_pll_ro_ops;
+
+static const s8 pll_od_encode[7] = {-1, 2, 4, 8, 16, 32, 64};
+
+#define PLL_RATE(_rate, _fd, _rd, _od)  \
+	{                   \
+		.rate = _rate,          \
+		        .fd = _fd,          \
+		              .rd = _rd,          \
+		                    .od = _od,          \
+	}
+
