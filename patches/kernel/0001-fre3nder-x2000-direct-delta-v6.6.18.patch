+	GPIO_FUNC_0 = 0x00,  //0000, GPIO as function 0 / device 0
+	GPIO_FUNC_1 = 0x01,  //0001, GPIO as function 1 / device 1
+	GPIO_FUNC_2 = 0x02,  //0010, GPIO as function 2 / device 2
+	GPIO_FUNC_3 = 0x03,  //0011, GPIO as function 3 / device 3
