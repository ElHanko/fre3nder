+
+	rtc_ram_write_enable();
+	memset((unsigned int *)RTC_MEMORY_START, 0, 4096);
+	rtc_ram_store();
+	memcpy((unsigned int *)FASTBOOT_RESUME_CODE1_ADDR, (unsigned int *)fastboot_resume_code, FASTBOOT_RESUME_CODE_LEN);
+	rtc_ram_write_disable();
+}
