# SPDX-License-Identifier: GPL-2.0-only
#
# Clean-port patch for upstream Linux v6.6.18.
# Upstream source: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
# Upstream commit: d8a27ea2c98685cdaa5fa66c809c7069a4ff394b
# Hardware-semantics reference: public Ingenic X2000 Linux SDK
# https://github.com/Llixuma/ingenic-linux-kernel6.6-x2000-v1.0-20250221
# Ingenic SDK commit: a98c2e1f22e4263ddd4153a4eca4db4dcfd2777b
#
# Add the minimal X2000 core Operating System Timer required by the
# Fre3nder clean port. Use the existing X2000 CGU OST clock, expose the
# global counter as clocksource/sched_clock, and provide the CPU0
# clockevent through MIPS CPU interrupt input 4.
#
# Keep the two-entry CPU OST mapping required by the later SMP port while
# excluding the vendor SYSOST, TCU, PM and diagnostic surface.
#

diff --git a/Documentation/devicetree/bindings/timer/ingenic,x2000-core-ost.yaml b/Documentation/devicetree/bindings/timer/ingenic,x2000-core-ost.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..1c3fdcd41500c1b6f96f5655db24e5a132dc4941
--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/ingenic,x2000-core-ost.yaml
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/ingenic,x2000-core-ost.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 core Operating System Timer
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+description:
+  The X2000 core OST provides one system-wide 64-bit free-running counter
+  and one 32-bit clockevent timer window per CPU.
+
+properties:
+  compatible:
+    const: ingenic,x2000-core-ost
+
+  reg:
+    minItems: 2
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: global
+      - const: core
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: ost
+
+  interrupts:
+    maxItems: 1
+
+  ingenic,cpu-ost-map:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 4
+    maxItems: 4
+    description:
+      Two CPU and core-register-offset pairs. The X2000 has two CPU-local
+      OST windows, for CPU0 and CPU1 respectively.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - ingenic,cpu-ost-map
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2000-cgu.h>
+
+    ost: timer@12000000 {
+        compatible = "ingenic,x2000-core-ost";
+        reg = <0x12000000 0x10000>,
+              <0x12100000 0x10000>;
+        reg-names = "global", "core";
+
+        clocks = <&cgu X2000_CLK_OST>;
+        clock-names = "ost";
+
+        interrupt-parent = <&cpuintc>;
+        interrupts = <4>;
+
+        ingenic,cpu-ost-map = <0 0x000>,
+                              <1 0x100>;
+    };
+...
