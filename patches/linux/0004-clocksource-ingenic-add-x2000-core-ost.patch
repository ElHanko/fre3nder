+config INGENIC_X2000_OST
+	bool "Clocksource/timer using the core OST in Ingenic X2000 SoCs"
+	depends on MACH_X2000
+	default MACH_X2000
+	select TIMER_OF
+	help
+	  Support the Operating System Timer found in Ingenic X2000 SoCs.
+	  The global OST provides the system clocksource and sched_clock,
+	  while the CPU-local OST provides the clockevent device through
+	  MIPS CPU interrupt input 4. The timer consumes the OST clock from
+	  the X2000 CGU and retains both CPU mappings for later SMP support.
+
 config MICROCHIP_PIT64B
 	bool "Microchip PIT64B support"
 	depends on OF && ARM
