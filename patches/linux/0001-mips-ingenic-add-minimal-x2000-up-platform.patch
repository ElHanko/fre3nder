diff --git a/arch/mips/mm/sc-xburst2.c b/arch/mips/mm/sc-xburst2.c
new file mode 100644
--- /dev/null
+++ b/arch/mips/mm/sc-xburst2.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic XBurst2 secondary cache support
+ *
+ * Derived from Ingenic-community/linux arch/mips/mm/c-ingenic.c at
+ * commit 91fe78280ac7dd0dae0f58cb271e821bd39ba97e and checked against
+ * the Ingenic X2000 Linux SDK arch/mips/xburst2/core/sc.c at commit
+ * a98c2e1f22e4263ddd4153a4eca4db4dcfd2777b.
+ *
+ * Copyright (C) 2006 Chris Dearman (chris@mips.com)
+ * Copyright (C) 2020 周琰杰 (Zhou Yanjie) <zhouyanjie@wanyeetech.com>
+ */
+
+#include <linux/bitops.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+
+#include <asm/addrspace.h>
+#include <asm/bcache.h>
+#include <asm/cacheops.h>
+#include <asm/cpu-type.h>
+#include <asm/mipsregs.h>
+#include <asm/r4kcache.h>
+
+#define X2000_CCU_MSCR_PHYS	0x12200060
+#define X2000_CCU_MSCR_DISL2C	BIT(0)
+
+static unsigned long xburst2_scache_size __read_mostly;
+
+static u32 xburst2_read_mscr(void)
+{
+	void __iomem *mscr = (void __iomem *)CKSEG1ADDR(X2000_CCU_MSCR_PHYS);
+
+	return readl(mscr);
+}
+
+static void xburst2_blast_scache(void)
+{
+	switch (cpu_scache_line_size()) {
+	case 32:
+		blast_scache32();
+		break;
+	case 64:
+		blast_scache64();
+		break;
+	case 128:
+		blast_scache128();
+		break;
+	default:
+		WARN_ON_ONCE(1);
+		break;
+	}
+}
+
+static void xburst2_sc_wback_inv(unsigned long addr, unsigned long size)
+{
+	if (size >= xburst2_scache_size)
+		xburst2_blast_scache();
+	else
+		blast_scache_range(addr, addr + size);
+}
+
+static void xburst2_sc_inv(unsigned long addr, unsigned long size)
+{
+	unsigned long lsize = cpu_scache_line_size();
+	unsigned long almask = ~(lsize - 1);
+
+	if (size >= xburst2_scache_size) {
+		xburst2_blast_scache();
+		return;
+	}
+
+	cache_op(Hit_Writeback_Inv_SD, addr & almask);
+	cache_op(Hit_Writeback_Inv_SD, (addr + size - 1) & almask);
+	blast_inv_scache_range(addr, addr + size);
+}
+
+static void xburst2_sc_noop(void)
+{
+}
+
+static struct bcache_ops xburst2_sc_ops = {
+	.bc_enable = xburst2_sc_noop,
+	.bc_disable = xburst2_sc_noop,
+	.bc_wback_inv = xburst2_sc_wback_inv,
+	.bc_inv = xburst2_sc_inv,
+};
+
+int xburst2_sc_init(void)
+{
+	struct cpuinfo_mips *c = &current_cpu_data;
+	unsigned int config1, config2, tmp;
+
+	c->scache.flags |= MIPS_CACHE_NOT_PRESENT;
+
+	if (current_cpu_type() != CPU_XBURST2)
+		return 0;
+
+	if (xburst2_read_mscr() & X2000_CCU_MSCR_DISL2C)
+		return 0;
+
+	config1 = read_c0_config1();
+	if (!(config1 & MIPS_CONF_M))
+		return 0;
+
+	config2 = read_c0_config2();
+
+	tmp = (config2 >> 4) & 0x0f;
+	if (!tmp || tmp > 7)
+		return 0;
+	c->scache.linesz = 2 << tmp;
+
+	tmp = (config2 >> 8) & 0x0f;
+	if (tmp > 7)
+		return 0;
+	c->scache.sets = 64 << tmp;
+
+	tmp = config2 & 0x0f;
+	if (tmp != 7 && tmp != 15)
+		return 0;
+	c->scache.ways = tmp + 1;
+
+	c->scache.waysize = c->scache.sets * c->scache.linesz;
+	c->scache.waybit = __ffs(c->scache.waysize);
+	c->scache.flags &= ~MIPS_CACHE_NOT_PRESENT;
+	c->scache.flags |= MIPS_CACHE_PINDEX;
+
+	xburst2_scache_size = c->scache.ways * c->scache.waysize;
+	bcops = &xburst2_sc_ops;
+
+	return 1;
+}
