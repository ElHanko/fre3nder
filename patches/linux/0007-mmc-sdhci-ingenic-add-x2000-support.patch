diff --git a/Documentation/devicetree/bindings/mmc/ingenic,x2000-sdhci.yaml b/Documentation/devicetree/bindings/mmc/ingenic,x2000-sdhci.yaml
new file mode 100644
index 000000000..45f63590d
--- /dev/null
+++ b/Documentation/devicetree/bindings/mmc/ingenic,x2000-sdhci.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/ingenic,x2000-sdhci.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 SDHCI Controller
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+allOf:
+  - $ref: mmc-controller.yaml#
+
+properties:
+  compatible:
+    const: ingenic,x2000-sdhci
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: mmc
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2000-cgu.h>
+
+    mmc@13450000 {
+        compatible = "ingenic,x2000-sdhci";
+        reg = <0x13450000 0x10000>;
+
+        interrupts = <37>;
+
+        clocks = <&cgu X2000_CLK_MSC0>;
+        clock-names = "mmc";
+
+        bus-width = <8>;
+        non-removable;
+    };
diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index bc7e2ad37..8610a7d0c 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -150,6 +150,19 @@ config MMC_SDHCI_PLTFM
 
 	  If unsure, say N.
 
+config MMC_SDHCI_INGENIC
+	tristate "Ingenic X2000 SDHCI support"
+	depends on MMC_SDHCI_PLTFM
+	depends on OF
+	depends on COMMON_CLK
+	depends on MACH_X2000 || COMPILE_TEST
+	help
+	  This selects support for the SDHCI-compatible MMC controllers
+	  found in the Ingenic X2000 SoC.
+
+	  The driver supports both the eMMC MSC0 controller and the MSC1
+	  controller used for SDIO devices.
+
 config MMC_SDHCI_OF_ARASAN
 	tristate "SDHCI OF support for the Arasan SDHCI controllers"
 	depends on MMC_SDHCI_PLTFM
