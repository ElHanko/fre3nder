# SPDX-License-Identifier: GPL-2.0-only
#
# Clean-port patch for upstream Linux v6.6.18.
# Upstream source: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
# Upstream commit: d8a27ea2c98685cdaa5fa66c809c7069a4ff394b
# Hardware-semantics reference: public Ingenic X2000 Linux SDK
# https://github.com/Llixuma/ingenic-linux-kernel6.6-x2000-v1.0-20250221
# Ingenic SDK commit: a98c2e1f22e4263ddd4153a4eca4db4dcfd2777b
# OpenKE bounds-check reference:
# https://github.com/coreflake1/NebulaOS-kernel
# OpenKE commit: e123bb14fd8e3fd03a5550cf187a5a9f64faf281
#
# Add the minimal X2000 core interrupt controller required by the
# Fre3nder clean port. Reuse the upstream MIPS CPU interrupt controller
# and chain the 64-source X2000 core INTC through CPU interrupt input 2.
# Retain bounded CPU-window DT parsing and the affinity support required
# by the later SMP port; exclude vendor wake, PM and diagnostic surface.
#
diff --git a/Documentation/devicetree/bindings/interrupt-controller/ingenic,x2000-intc.yaml b/Documentation/devicetree/bindings/interrupt-controller/ingenic,x2000-intc.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..bb3fa65e65510703535eb6732eb54a9d7a4b1faf
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/ingenic,x2000-intc.yaml
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/ingenic,x2000-intc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 core interrupt controller
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+description: |
+  The X2000 core interrupt controller provides 64 interrupt sources in two
+  groups of 32. Each CPU has a private register window within the controller.
+  The controller is cascaded through MIPS CPU interrupt input 2.
+
+properties:
+  compatible:
+    const: ingenic,x2000-intc
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-parent: true
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 1
+
+  ingenic,cpu-intc-map:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 4
+    maxItems: 4
+    description:
+      Two pairs containing the logical CPU number followed by that CPU's
+      register-window offset within the core interrupt controller resource.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-parent
+  - interrupt-controller
+  - "#interrupt-cells"
+  - ingenic,cpu-intc-map
+
+additionalProperties: false
+
+examples:
+  - |
+    cpuintc: interrupt-controller {
+      compatible = "mti,cpu-interrupt-controller";
+      #address-cells = <0>;
+      #interrupt-cells = <1>;
+      interrupt-controller;
+    };
+
+    core_intc: interrupt-controller@12300000 {
+      compatible = "ingenic,x2000-intc";
+      reg = <0x12300000 0x1000>;
+
+      interrupt-controller;
+      #interrupt-cells = <1>;
+
+      interrupt-parent = <&cpuintc>;
+      interrupts = <2>;
+
+      ingenic,cpu-intc-map = <0 0x000>,
+                             <1 0x100>;
+    };
