+
+#define X2000_IRQ_OTG		1
+
+#define X2000_IRQ_GPIO4		13
+#define X2000_IRQ_GPIO3		14
+#define X2000_IRQ_GPIO2		15
+#define X2000_IRQ_GPIO1		16
+#define X2000_IRQ_GPIO0		17
+
+#define X2000_IRQ_MSC1		36
