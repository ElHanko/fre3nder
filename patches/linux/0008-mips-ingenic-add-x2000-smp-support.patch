-static void __init x2000_ost_init_event(struct x2000_ost *ost,
+static void x2000_ost_init_event(struct x2000_ost *ost,
 					 unsigned int cpu)
 {
 	struct x2000_ost_event *event = &ost->events[cpu];
@@ -280,6 +280,41 @@ static void __init x2000_ost_init_event(struct x2000_ost *ost,
 	event->initialized = true;
 }
 
+void x2000_ost_init_secondary(void)
+{
+	struct x2000_ost *ost = &x2000_ost;
+	struct x2000_ost_event *event;
+	struct irq_chip *chip;
+	struct irq_data *data;
+	unsigned int cpu = raw_smp_processor_id();
+
+	if (cpu >= X2000_OST_CPU_COUNT)
+		return;
+
+	event = &ost->events[cpu];
+
+	if (!event->initialized)
+		x2000_ost_init_event(ost, cpu);
+
+	clockevents_config_and_register(&event->ced, ost->rate,
+					0xf, 0xffffffff);
+
+	writel(0, event->base + X2000_OST_MASK);
+
+	/*
+	 * The upstream MIPS CPU interrupt controller stores the CP0
+	 * interrupt mask in CPU-local state. CPU1 therefore has to
+	 * unmask IP4 for itself after the common IRQ was requested by CPU0.
+	 */
+	data = irq_get_irq_data(ost->irq);
+	if (!data)
+		return;
+
+	chip = irq_data_get_irq_chip(data);
+	if (chip && chip->irq_unmask)
+		chip->irq_unmask(data);
+}
+
 static int __init x2000_ost_init(struct device_node *np)
 {
 	struct x2000_ost *ost = &x2000_ost;
