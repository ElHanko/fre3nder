+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __X2000_DPU_FB_H__
+#define __X2000_DPU_FB_H__
+
+#include <linux/types.h>
+
+struct x2000_dpu_panel {
+	const char *name;
+
+	u32 pixelclock_hz;
+
+	u16 xres;
+	u16 yres;
+
+	u16 hsync_len;
+	u16 left_margin;
+	u16 right_margin;
+
+	u16 vsync_len;
+	u16 upper_margin;
+	u16 lower_margin;
+
+	bool de_low;
+	bool sync_low;
+	bool vsync_low;
+
+	void (*enable)(void *data);
+	void (*disable)(void *data);
+	void *data;
+};
+
+int x2000_dpu_register_panel(const struct x2000_dpu_panel *panel);
+int x2000_dpu_unregister_panel(const struct x2000_dpu_panel *panel);
+
+#endif
