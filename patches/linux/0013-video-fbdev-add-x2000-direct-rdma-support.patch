diff --git a/Documentation/devicetree/bindings/display/ingenic,x2000-dpu.yaml b/Documentation/devicetree/bindings/display/ingenic,x2000-dpu.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..a2b8ee13af85099227b87590da76100e7de9f196
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/ingenic,x2000-dpu.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/ingenic,x2000-dpu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 Display Processing Unit
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+description:
+  The X2000 DPU contains a direct-RDMA scanout path used to feed the
+  parallel TFT output. This binding describes the controller resources;
+  panel-specific timing and reset handling are provided separately.
+
+properties:
+  compatible:
+    const: ingenic,x2000-dpu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: lcd
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2000-cgu.h>
+
+    display-controller@13050000 {
+      compatible = "ingenic,x2000-dpu";
+      reg = <0x13050000 0x10000>;
+      clocks = <&cgu X2000_CLK_LCD>;
+      clock-names = "lcd";
+    };
