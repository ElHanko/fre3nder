+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/creality,ender-3-v3-ke.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Creality Ender-3 V3 KE 480x272 TFT panel
+
+maintainers:
+  - ElHanko <71714066+ElHanko@users.noreply.github.com>
+
+description:
+  Fixed 480x272 parallel-RGB TFT panel fitted to the Creality
+  Ender-3 V3 KE display unit. The panel uses a dedicated active-low
+  reset signal; its fixed video timing is provided by the matching
+  panel driver.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: creality,ender-3-v3-ke-panel
+
+  reset-gpios:
+    maxItems: 1
+
+required:
+  - compatible
+  - reset-gpios
+
+unevaluatedProperties: false
