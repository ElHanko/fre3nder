# SPDX-License-Identifier: GPL-2.0-only
#
# Clean-port patch for upstream Linux v6.6.18.
# Upstream source: https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
# Upstream commit: d8a27ea2c98685cdaa5fa66c809c7069a4ff394b
# Hardware-semantics reference: public Ingenic X2000 Linux SDK
# https://github.com/Llixuma/ingenic-linux-kernel6.6-x2000-v1.0-20250221
# Ingenic SDK commit: a98c2e1f22e4263ddd4153a4eca4db4dcfd2777b
#
# Add the reduced X2000 SoC description required by the Fre3nder clean
# port. Describe only the generic providers and controllers used by the
# target while keeping non-core devices disabled for board-level setup.
#
# Reuse the upstream X2000 pinctrl implementation, correct the MMC0
# four-bit pin range, and add the RTC32K pin function required by the
# later board WLAN description.
#
diff --git a/arch/mips/boot/dts/ingenic/x2000.dtsi b/arch/mips/boot/dts/ingenic/x2000.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..beba39c356a0048f0b2e9332557dbd5b4b655923
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/x2000.dtsi
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <dt-bindings/clock/ingenic,x2000-cgu.h>
+#include <dt-bindings/interrupt-controller/ingenic,x2000-irq.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,x2000";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2";
+			reg = <0>;
+
+			clocks = <&cgu X2000_CLK_CPU>;
+			clock-names = "cpu";
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2";
+			reg = <1>;
+
+			clocks = <&cgu X2000_CLK_CPU>;
+			clock-names = "cpu";
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		compatible = "mti,cpu-interrupt-controller";
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+	};
+
+	exclk: ext {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+	};
+
+	rtclk: rtc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	cgu: x2000-cgu@10000000 {
+		compatible = "ingenic,x2000-cgu", "simple-mfd";
+		reg = <0x10000000 0x100>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x10000000 0x100>;
+
+		#clock-cells = <1>;
+
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+
+		otg_phy: usb-phy@3c {
+			compatible = "ingenic,x2000-phy";
+			reg = <0x3c 0x10>;
+
+			clocks = <&cgu X2000_CLK_OTG>;
+
+			#phy-cells = <0>;
+
+			status = "disabled";
+		};
+	};
+
+	core_ost: timer@12000000 {
+		compatible = "ingenic,x2000-core-ost";
+		reg = <0x12000000 0x10000>,
+		      <0x12100000 0x10000>;
+		reg-names = "global", "core";
+
+		clocks = <&cgu X2000_CLK_OST>;
+		clock-names = "ost";
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <4>;
+
+		ingenic,cpu-ost-map = <0 0x000>,
+				      <1 0x100>;
+	};
+
+	core_intc: interrupt-controller@12300000 {
+		compatible = "ingenic,x2000-intc";
+		reg = <0x12300000 0x1000>;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+
+		ingenic,cpu-intc-map = <0 0x000>,
+				       <1 0x100>;
+	};
+
+	pinctrl: pin-controller@10010000 {
+		compatible = "ingenic,x2000-pinctrl";
+		reg = <0x10010000 0x800>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <0>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 0 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&core_intc>;
+			interrupts = <X2000_IRQ_GPIO0>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <1>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 32 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&core_intc>;
+			interrupts = <X2000_IRQ_GPIO1>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <2>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 64 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&core_intc>;
+			interrupts = <X2000_IRQ_GPIO2>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <3>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 96 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&core_intc>;
+			interrupts = <X2000_IRQ_GPIO3>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <4>;
+
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 128 32>;
+			#gpio-cells = <2>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			interrupt-parent = <&core_intc>;
+			interrupts = <X2000_IRQ_GPIO4>;
+		};
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,x2000-uart";
+		reg = <0x10031000 0x100>;
+
+		interrupt-parent = <&core_intc>;
+		interrupts = <X2000_IRQ_UART1>;
+
+		clocks = <&exclk>, <&cgu X2000_CLK_UART1>;
+		clock-names = "baud", "module";
+
+		status = "disabled";
+	};
+
+	i2c4: i2c-controller@10054000 {
+		compatible = "ingenic,x2000-i2c";
+		reg = <0x10054000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&core_intc>;
+		interrupts = <X2000_IRQ_I2C4>;
+
+		clocks = <&cgu X2000_CLK_I2C4>;
+
+		status = "disabled";
+	};
+
+	dpu: display-controller@13050000 {
+		compatible = "ingenic,x2000-dpu";
+		reg = <0x13050000 0x10000>;
+
+		clocks = <&cgu X2000_CLK_LCD>;
+		clock-names = "lcd";
+
+		status = "disabled";
+	};
+
+	msc0: mmc@13450000 {
+		compatible = "ingenic,x2000-sdhci";
+		reg = <0x13450000 0x10000>;
+
+		interrupt-parent = <&core_intc>;
+		interrupts = <X2000_IRQ_MSC0>;
+
+		clocks = <&cgu X2000_CLK_MSC0>;
+		clock-names = "mmc";
+
+		status = "disabled";
+	};
+
+	msc1: mmc@13460000 {
+		compatible = "ingenic,x2000-sdhci";
+		reg = <0x13460000 0x10000>;
+
+		interrupt-parent = <&core_intc>;
+		interrupts = <X2000_IRQ_MSC1>;
+
+		clocks = <&cgu X2000_CLK_MSC1>;
+		clock-names = "mmc";
+
+		status = "disabled";
+	};
+
+	pwm: pwm@134c0000 {
+		compatible = "ingenic,x2000-pwm";
+		reg = <0x134c0000 0x10000>;
+
+		clocks = <&cgu X2000_CLK_PWM>;
+		clock-names = "pwm";
+
+		#pwm-cells = <3>;
+
+		status = "disabled";
+	};
+
+	otg: usb@13500000 {
+		compatible = "ingenic,x2000-otg";
+		reg = <0x13500000 0x40000>;
+
+		interrupt-parent = <&core_intc>;
+		interrupts = <X2000_IRQ_OTG>;
+
+		clocks = <&cgu X2000_CLK_OTG>;
+		clock-names = "otg";
+
+		phys = <&otg_phy>;
+		phy-names = "usb2-phy";
+
+		status = "disabled";
+	};
+};
diff --git a/drivers/pinctrl/pinctrl-ingenic.c b/drivers/pinctrl/pinctrl-ingenic.c
