diff --git a/Documentation/devicetree/bindings/pwm/ingenic,x2000-pwm.yaml b/Documentation/devicetree/bindings/pwm/ingenic,x2000-pwm.yaml
new file mode 100644
index 000000000..1839dc3cd
--- /dev/null
+++ b/Documentation/devicetree/bindings/pwm/ingenic,x2000-pwm.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pwm/ingenic,x2000-pwm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 PWM controller
+
+maintainers:
+  - Paul Cercueil <paul@crapouillou.net>
+
+allOf:
+  - $ref: pwm.yaml#
+
+properties:
+  compatible:
+    const: ingenic,x2000-pwm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: pwm
+
+  "#pwm-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2000-cgu.h>
+
+    pwm@134c0000 {
+      compatible = "ingenic,x2000-pwm";
+      reg = <0x134c0000 0x10000>;
+      clocks = <&cgu X2000_CLK_PWM>;
+      clock-names = "pwm";
+      #pwm-cells = <3>;
+    };
