# Fre3nder X2000 additions to x2000_halley5_v30_linux_defconfig.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_RT is not set
CONFIG_LOCALVERSION="-fre3nder"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_FILE_LOCKING=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_FW_LOADER=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_USB_STORAGE=y
# The observed 0b95:1790 AX88179B presents CDC-NCM interfaces, so its VID:PID
# alone does not make the vendor-specific AX88179/178A driver bind.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDC_NCM=y

# CDC-NCM selects CDCETHER. Retain AX88179/178A for vendor-specific modes and
# leave the other default-y USB network drivers disabled.
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# The onboard ADXL345 is exposed through the generic GPIO SPI/spidev path.
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_SPI_SPIDEV=y

# Disable reference-board or deferred peripherals outside Develop-v0.
# CONFIG_BCMDHD is not set
# CONFIG_SND_ASOC_INGENIC is not set
# CONFIG_VIDEOBUF2_DMA_CONTIG_INGENIC is not set
# CONFIG_INGENIC_SPI is not set
# CONFIG_INGENIC_SFC is not set
# CONFIG_INGENIC_RSA is not set
# CONFIG_SPINLOCK_TEST is not set
# The camera is a standard USB-UVC device. Keep only its V4L2 capture path;
# platform/ISP camera support from the reference-board defconfig stays disabled.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_VIDEO_DEV=y
# MEDIA_SUPPORT_FILTER derives this core API from MEDIA_CAMERA_SUPPORT.
CONFIG_MEDIA_CONTROLLER=y
# CONFIG_VIDEO_V4L2_SUBDEV_API is not set
# CONFIG_V4L2_MEM2MEM_DEV is not set
# CONFIG_V4L2_FWNODE is not set
# CONFIG_V4L2_ASYNC is not set
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
# CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV is not set
# CONFIG_MEDIA_PLATFORM_DRIVERS is not set
# CONFIG_V4L_PLATFORM_DRIVERS is not set
# CONFIG_V4L_MEM2MEM_DRIVERS is not set
# CONFIG_VIDEOBUF2_DMA_CONTIG is not set
# CONFIG_VIDEOBUF2_DMA_SG is not set
# CONFIG_MEDIA_ATTACH is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# CONFIG_MEDIA_TUNER is not set
# CONFIG_VIDEO_CMDLINE is not set
# CONFIG_SOUND is not set
CONFIG_FB=y
CONFIG_FB_INGENIC=y
CONFIG_FB_INGENIC_STAGE=y
CONFIG_STAGE_ENDER3_V3_KE_480X272=y
# CONFIG_MTD is not set
# CONFIG_INGENIC_MAC is not set
# CONFIG_USB_LIBCOMPOSITE is not set
# CONFIG_USB_CONFIGFS is not set
# CONFIG_IIO is not set
# CONFIG_TOUCHSCREEN_GT9XX is not set
# CONFIG_VIDEO_INGENIC_ISP is not set
# CONFIG_VIDEO_INGENIC_ROTATE is not set
# CONFIG_VIDEO_INGENIC_VCODEC is not set
# CONFIG_HALLEY5_CAMERA_BOARD is not set
# CONFIG_RD_X2000_HALLEY5_CAMERA_4V3 is not set
# CONFIG_INGENIC_ISP_CAMERA_OV2735A is not set
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NS2009=y

# Ender-3 V3 KE onboard passive piezo on PC03 / PWM3.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PWM_BEEPER=y
