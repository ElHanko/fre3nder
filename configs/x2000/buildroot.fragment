# Fre3nder X2000 credential-free immutable RootFS.
BR2_TARGET_GENERIC_HOSTNAME="fre3nder"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/project/configs/x2000/busybox.fragment"
# BR2_PACKAGE_ALSA_LIB is not set
# BR2_PACKAGE_ALSA_UTILS is not set
BR2_PACKAGE_MJPG_STREAMER=y
# BR2_PACKAGE_NCURSES is not set
# BR2_PACKAGE_READLINE is not set
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_MTD is not set
# BR2_PACKAGE_I2C_TOOLS is not set
# BR2_PACKAGE_INPUT_EVENT_DAEMON is not set
# BR2_PACKAGE_SPI_TOOLS is not set
# BR2_PACKAGE_SYSSTAT is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_PACKAGE_LRZSZ is not set
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
# BR2_PACKAGE_BASH is not set
# BR2_PACKAGE_ANDROID_TOOLS is not set
# BR2_PACKAGE_DAEMON is not set
# BR2_PACKAGE_UTIL_LINUX is not set
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_PYTHON_CFFI=y
BR2_PACKAGE_PYTHON_GREENLET=y
BR2_PACKAGE_PYTHON_JINJA2=y
BR2_PACKAGE_PYTHON_MARKUPSAFE=y
BR2_PACKAGE_PYTHON_SERIAL=y
# BR2_PACKAGE_PYTHON_CAN is not set
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_FORCE_TLS=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIGHTTPD=y
BR2_PACKAGE_LIGHTTPD_PCRE=y
# BR2_PACKAGE_LIGHTTPD_BROTLI is not set
# BR2_PACKAGE_LIGHTTPD_BZIP2 is not set
# BR2_PACKAGE_LIGHTTPD_DBI is not set
# BR2_PACKAGE_LIGHTTPD_GNUTLS is not set
# BR2_PACKAGE_LIGHTTPD_KRB5 is not set
# BR2_PACKAGE_LIGHTTPD_LDAP is not set
# BR2_PACKAGE_LIGHTTPD_LUA is not set
# BR2_PACKAGE_LIGHTTPD_MAXMINDDB is not set
# BR2_PACKAGE_LIGHTTPD_MBEDTLS is not set
# BR2_PACKAGE_LIGHTTPD_MYSQL is not set
# BR2_PACKAGE_LIGHTTPD_NETTLE is not set
# BR2_PACKAGE_LIGHTTPD_OPENSSL is not set
# BR2_PACKAGE_LIGHTTPD_PAM is not set
# BR2_PACKAGE_LIGHTTPD_PGSQL is not set
# BR2_PACKAGE_LIGHTTPD_WEBDAV is not set
# BR2_PACKAGE_LIGHTTPD_WOLFSSL is not set
# BR2_PACKAGE_LIGHTTPD_ZLIB is not set
# BR2_PACKAGE_LIGHTTPD_ZSTD is not set
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_CYPRESS_CYW43XXX=y
# BR2_PACKAGE_WPA_SUPPLICANT_WEXT is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WIRED is not set
# BR2_PACKAGE_WPA_SUPPLICANT_IBSS_RSN is not set
# BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WIFI_DISPLAY is not set
# BR2_PACKAGE_WPA_SUPPLICANT_MESH_NETWORKING is not set
# BR2_PACKAGE_WPA_SUPPLICANT_OVERRIDES is not set
# BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN is not set
# BR2_PACKAGE_WPA_SUPPLICANT_EAP is not set
# BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT is not set
# BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPS is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPA3 is not set
# BR2_PACKAGE_WPA_SUPPLICANT_CLI is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO is not set
# BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE is not set
# BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE is not set
# BR2_PACKAGE_WPA_SUPPLICANT_DBUS is not set
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
# BR2_PACKAGE_DROPBEAR_WTMP is not set
# BR2_PACKAGE_DROPBEAR_LASTLOG is not set
# BR2_PACKAGE_DROPBEAR_LEGACY_CRYPTO is not set
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="/project/configs/x2000/dropbear.localoptions"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_PACKAGE_OPENCV4 is not set
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_JFFS2 is not set
# BR2_TARGET_ROOTFS_UBIFS is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_ROOTFS_POST_BUILD_SCRIPT="/project/configs/x2000/rootfs-post-build.sh"
BR2_PACKAGE_PYTHON_PYYAML=y
BR2_PACKAGE_PYTHON_TORNADO=y
BR2_PACKAGE_PYTHON_ZEROCONF=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
BR2_PACKAGE_PYTHON_STREAMING_FORM_DATA=y
BR2_PACKAGE_PYTHON_DISTRO=y
BR2_PACKAGE_PYTHON_PAHO_MQTT=y
BR2_PACKAGE_PYTHON_PERIPHERY=y
BR2_PACKAGE_PYTHON_CERTIFI=y
BR2_PACKAGE_PYTHON_REQUESTS=y
BR2_PACKAGE_PYTHON_REQUESTS_OAUTHLIB=y
BR2_PACKAGE_PYTHON_CLICK=y
BR2_PACKAGE_PYTHON_MARKDOWN=y
BR2_PACKAGE_PYTHON_PYASN1=y
BR2_PACKAGE_PYTHON_WRAPT=y
BR2_PACKAGE_LIBSODIUM=y
# BR2_PACKAGE_LIBSODIUM_FULL is not set
