#!/usr/bin/python3
"""Fre3nder OTA core."""

import hashlib
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time


EXPECTED_MEMBERS = (
    "manifest.json",
    "SHA256SUMS",
    "SHA256SUMS.sig",
    "kernel.uImage",
    "rootfs.squashfs",
)
CHECKSUM_MEMBERS = (
    "manifest.json",
    "kernel.uImage",
    "rootfs.squashfs",
)
PAYLOAD_MEMBERS = (
    "kernel.uImage",
    "rootfs.squashfs",
)
TRUSTED_PUBLIC_KEY = pathlib.Path("/ota/keys/public.pem")
PLATFORM = "ender3-v3-ke"
MAX_MANIFEST_SIZE = 64 * 1024
MAX_CHECKSUMS_SIZE = 1024
ED25519_SIGNATURE_SIZE = 64
SHA256_RE = re.compile(r"[0-9a-f]{64}")

INSTALLED_VERSION = pathlib.Path("/usr/share/fre3nder/VERSION")
ROOT_STATUS = pathlib.Path("/run/fre3nder-root/status")
CMDLINE = pathlib.Path("/proc/cmdline")
MOUNTS = pathlib.Path("/proc/mounts")
BLKID = pathlib.Path("/sbin/blkid")
SYS_MOUNT = "/run/fre3nder-root/system"
HOME_MOUNT = "/home"
USB_MOUNT = "/run/fre3nder/usb"
USB_STATUS = pathlib.Path("/run/fre3nder/usb-runtime/status")
HOME_BACKUP_DIRECTORY = "/home/Fre3nderBackup"
USB_BACKUP_DIRECTORY = "/run/fre3nder/usb/Fre3nderBackup"

SLOTS = {
    "A": {
        "kernel": "/dev/mmcblk0p5",
        "rootfs": "/dev/mmcblk0p7",
    },
    "B": {
        "kernel": "/dev/mmcblk0p6",
        "rootfs": "/dev/mmcblk0p8",
    },
}


def require_regular_file(path, description):
    try:
        metadata = path.lstat()
    except FileNotFoundError as exc:
        raise ValueError(f"{description} is missing: {path}") from exc
    if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
        raise ValueError(f"{description} must be a regular non-symlink file: {path}")


def read_small_member(archive, member, maximum, description):
    if member.size > maximum:
        raise ValueError(f"{description} is too large")
    stream = archive.extractfile(member)
    if stream is None:
        raise ValueError(f"cannot read {description}")
    data = stream.read(maximum + 1)
    if len(data) != member.size or len(data) > maximum:
        raise ValueError(f"cannot read complete {description}")
    return data


def verify_signature(checksums_data, signature_data, public_key):
    require_regular_file(public_key, "OTA public key")
    openssl = shutil.which("openssl")
    if openssl is None:
        raise ValueError("openssl command is unavailable")

    with tempfile.TemporaryDirectory(prefix="fre3nder-ota-") as temporary:
        temporary = pathlib.Path(temporary)
        checksums_path = temporary / "SHA256SUMS"
        signature_path = temporary / "SHA256SUMS.sig"
        checksums_path.write_bytes(checksums_data)
        signature_path.write_bytes(signature_data)

        result = subprocess.run(
            [
                openssl,
                "pkeyutl",
                "-verify",
                "-rawin",
                "-pubin",
                "-inkey",
                str(public_key),
                "-in",
                str(checksums_path),
                "-sigfile",
                str(signature_path),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    if result.returncode != 0:
        raise ValueError("Ed25519 signature verification failed")


def parse_checksums(data):
    try:
        text = data.decode("ascii")
    except UnicodeDecodeError as exc:
        raise ValueError("SHA256SUMS is not ASCII") from exc

    if not text.endswith("\n"):
        raise ValueError("SHA256SUMS must end with a newline")

    lines = text.splitlines()
    if len(lines) != len(CHECKSUM_MEMBERS):
        raise ValueError("SHA256SUMS has unexpected entries")

    checksums = {}
    for line, expected_name in zip(lines, CHECKSUM_MEMBERS):
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9._-]+)", line)
        if match is None:
            raise ValueError("SHA256SUMS has invalid syntax")
        digest, name = match.groups()
        if name != expected_name:
            raise ValueError("SHA256SUMS has unexpected member order or name")
        checksums[name] = digest
    return checksums


def sha256_stream(stream):
    digest = hashlib.sha256()
    size = 0
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        digest.update(chunk)
        size += len(chunk)
    return digest.hexdigest(), size


def validate_manifest(manifest, checksums, members, public_key):
    if not isinstance(manifest, dict):
        raise ValueError("manifest.json must contain a JSON object")

    version = manifest.get("version")
    if not isinstance(version, str) or not version or len(version) > 64:
        raise ValueError("manifest version is missing or invalid")

    ota = manifest.get("ota")
    if not isinstance(ota, dict):
        raise ValueError("manifest OTA metadata is missing")
    if ota.get("format") != "fre3nder-ota" or ota.get("format_version") != 1:
        raise ValueError("unsupported OTA format")
    if ota.get("platform") != PLATFORM:
        raise ValueError("OTA package targets a different platform")

    signature = ota.get("signature")
    if not isinstance(signature, dict) or signature != {
        "algorithm": "Ed25519",
        "file": "SHA256SUMS.sig",
        "signed_file": "SHA256SUMS",
    }:
        raise ValueError("unsupported OTA signature contract")

    artifacts = manifest.get("artifacts")
    sizes = manifest.get("artifact_sizes")
    if not isinstance(artifacts, dict) or set(artifacts) != set(PAYLOAD_MEMBERS):
        raise ValueError("manifest artifact hashes are incomplete")
    if not isinstance(sizes, dict) or set(sizes) != set(PAYLOAD_MEMBERS):
        raise ValueError("manifest artifact sizes are incomplete")

    for name in PAYLOAD_MEMBERS:
        digest = artifacts.get(name)
        size = sizes.get(name)
        if not isinstance(digest, str) or SHA256_RE.fullmatch(digest) is None:
            raise ValueError(f"manifest hash is invalid: {name}")
        if digest != checksums[name]:
            raise ValueError(f"manifest hash disagrees with SHA256SUMS: {name}")
        if type(size) is not int or size < 0:
            raise ValueError(f"manifest size is invalid: {name}")
        if size != members[name].size:
            raise ValueError(f"manifest size disagrees with TAR member: {name}")

    expected_key_hash = hashlib.sha256(public_key.read_bytes()).hexdigest()
    if manifest.get("ota_public_key_sha256") != expected_key_hash:
        raise ValueError("OTA package trust anchor differs from installed trust anchor")

    return version


def verify_package(package, public_key=TRUSTED_PUBLIC_KEY):
    package = pathlib.Path(package)
    public_key = pathlib.Path(public_key)
    require_regular_file(package, "OTA package")

    try:
        archive = tarfile.open(package, mode="r:")
    except (OSError, tarfile.TarError) as exc:
        raise ValueError(f"cannot open OTA package: {exc}") from exc

    with archive:
        members_list = archive.getmembers()
        names = tuple(member.name for member in members_list)
        if names != EXPECTED_MEMBERS:
            raise ValueError("OTA package must contain exactly the five v1 members in order")
        if any(not member.isfile() for member in members_list):
            raise ValueError("all OTA package members must be regular files")
        members = {member.name: member for member in members_list}

        checksums_data = read_small_member(
            archive,
            members["SHA256SUMS"],
            MAX_CHECKSUMS_SIZE,
            "SHA256SUMS",
        )
        signature_data = read_small_member(
            archive,
            members["SHA256SUMS.sig"],
            ED25519_SIGNATURE_SIZE,
            "SHA256SUMS.sig",
        )
        if len(signature_data) != ED25519_SIGNATURE_SIZE:
            raise ValueError("SHA256SUMS.sig is not an Ed25519 signature")

        verify_signature(checksums_data, signature_data, public_key)
        checksums = parse_checksums(checksums_data)

        manifest_data = read_small_member(
            archive,
            members["manifest.json"],
            MAX_MANIFEST_SIZE,
            "manifest.json",
        )
        if hashlib.sha256(manifest_data).hexdigest() != checksums["manifest.json"]:
            raise ValueError("manifest.json checksum mismatch")
        try:
            manifest = json.loads(manifest_data)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError("manifest.json is invalid JSON") from exc

        validate_manifest(manifest, checksums, members, public_key)

        for name in PAYLOAD_MEMBERS:
            stream = archive.extractfile(members[name])
            if stream is None:
                raise ValueError(f"cannot read payload: {name}")
            digest, size = sha256_stream(stream)
            if size != members[name].size:
                raise ValueError(f"payload size changed while reading: {name}")
            if digest != checksums[name]:
                raise ValueError(f"payload checksum mismatch: {name}")

    return manifest


def read_single_line(path, description):
    path = pathlib.Path(path)
    try:
        text = path.read_text()
    except OSError as exc:
        raise ValueError(f"cannot read {description}: {path}") from exc

    lines = text.splitlines()
    if len(lines) != 1 or not lines[0]:
        raise ValueError(f"{description} is missing or invalid")
    return lines[0]


def discover_active_slot(cmdline):
    roots = [
        argument.removeprefix("root=")
        for argument in cmdline.split()
        if argument.startswith("root=")
    ]
    if len(roots) != 1:
        raise ValueError("expected exactly one root= argument")

    active_root = roots[0]
    if active_root == SLOTS["A"]["rootfs"]:
        return "A", "B", active_root
    if active_root == SLOTS["B"]["rootfs"]:
        return "B", "A", active_root

    raise ValueError(
        f"active root is not a Fre3nder A/B root: {active_root}"
    )


def parse_blkid_roles(output):
    roles = {
        "SYS": [],
        "HOME": [],
    }

    for line in output.splitlines():
        if ":" not in line:
            continue

        device, metadata = line.split(":", 1)
        fields = metadata.split()

        if 'LABEL="FRE3NDERSYS"' in fields:
            roles["SYS"].append(device)
        if 'LABEL="FRE3NDERHOME"' in fields:
            roles["HOME"].append(device)

    for role, label in (
        ("SYS", "FRE3NDERSYS"),
        ("HOME", "FRE3NDERHOME"),
    ):
        devices = list(dict.fromkeys(roles[role]))
        if len(devices) != 1:
            raise ValueError(
                f"expected exactly one {label} backend, found {len(devices)}"
            )
        roles[role] = devices[0]

    if os.path.realpath(roles["SYS"]) == os.path.realpath(roles["HOME"]):
        raise ValueError("SYS and HOME resolve to the same backend")

    return roles


def decode_mount_field(value):
    return (
        value
        .replace(r"\\040", " ")
        .replace(r"\\011", "\t")
        .replace(r"\\012", "\n")
        .replace(r"\\134", "\\")
    )


def parse_mounts(text):
    entries = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        entries.append(
            (
                decode_mount_field(fields[0]),
                decode_mount_field(fields[1]),
                fields[2],
            )
        )
    return entries


def runtime_usb_state(status, mounts):
    if status != "mounted":
        return {
            "available": False,
            "status": status,
            "mount": None,
        }

    matches = []
    for line in mounts.splitlines():
        fields = line.split()
        if len(fields) < 4:
            continue

        mounted_source = decode_mount_field(fields[0])
        mounted_at = decode_mount_field(fields[1])
        fs_type = fields[2]
        options = fields[3].split(",")

        if mounted_at == USB_MOUNT:
            matches.append(
                (mounted_source, fs_type, options)
            )

    if len(matches) != 1:
        return {
            "available": False,
            "status": "mount-mismatch",
            "mount": None,
        }

    source, fs_type, options = matches[0]

    supported_filesystems = {
        "vfat",
        "exfat",
        "ext4",
        "ntfs3",
    }

    if fs_type not in supported_filesystems:
        return {
            "available": False,
            "status": "unsupported-filesystem",
            "mount": None,
        }

    if "rw" not in options:
        return {
            "available": False,
            "status": "not-writable",
            "mount": None,
        }

    return {
        "available": True,
        "status": "mounted",
        "mount": USB_MOUNT,
        "source": source,
        "filesystem": fs_type,
        "backup_available": fs_type != "vfat",
    }


def read_runtime_usb_state(
    usb_status_path=USB_STATUS,
    mounts_path=MOUNTS,
):
    try:
        status = pathlib.Path(usb_status_path).read_text().strip()
    except OSError:
        status = "absent"

    try:
        mounts = pathlib.Path(mounts_path).read_text()
    except OSError as exc:
        raise ValueError("cannot read mount table") from exc

    return runtime_usb_state(status, mounts)


def build_backup_offer(usb):
    usb_available = usb.get("backup_available", False)

    return {
        "selection_required": True,
        "home": {
            "role": "HOME",
            "offered": usb_available,
            "required": False,
            "targets": ["usb"] if usb_available else [],
        },
        "sys": {
            "role": "SYS",
            "offered": True,
            "required": False,
            "targets": (
                ["usb", "home"]
                if usb_available
                else ["home"]
            ),
        },
        "targets": {
            "home": {
                "available": True,
                "path": HOME_BACKUP_DIRECTORY,
            },
            "usb": {
                "available": usb_available,
                "path": (
                    USB_BACKUP_DIRECTORY
                    if usb_available
                    else None
                ),
            },
        },
    }


def require_role_mount(entries, mountpoint, source, role):
    matches = [
        (mounted_source, fs_type)
        for mounted_source, mounted_at, fs_type in entries
        if mounted_at == mountpoint
    ]

    if len(matches) != 1:
        raise ValueError(
            f"{role} is not mounted exactly once at {mountpoint}"
        )

    mounted_source, fs_type = matches[0]

    if os.path.realpath(mounted_source) != os.path.realpath(source):
        raise ValueError(
            f"{role} backend mounted at {mountpoint} "
            "does not match its resolved label"
        )

    if fs_type != "ext4":
        raise ValueError(
            f"{role} mounted at {mountpoint} is not ext4: {fs_type}"
        )


def build_preflight(
    manifest,
    installed_version,
    root_status,
    cmdline,
    blkid_output,
    mounts,
):
    if root_status != "active":
        raise ValueError(
            f"Fre3nder writable runtime is not active: {root_status}"
        )

    active_slot, target_slot, active_root = discover_active_slot(cmdline)
    roles = parse_blkid_roles(blkid_output)
    mount_entries = parse_mounts(mounts)

    require_role_mount(
        mount_entries,
        SYS_MOUNT,
        roles["SYS"],
        "SYS",
    )
    require_role_mount(
        mount_entries,
        HOME_MOUNT,
        roles["HOME"],
        "HOME",
    )

    return {
        "package_version": manifest["version"],
        "artifact_mode": manifest.get("artifact_mode", "unknown"),
        "installed_version": installed_version,
        "active_slot": active_slot,
        "active_root": active_root,
        "target_slot": target_slot,
        "target_kernel": SLOTS[target_slot]["kernel"],
        "target_rootfs": SLOTS[target_slot]["rootfs"],
        "sys_source": roles["SYS"],
        "home_source": roles["HOME"],
    }


def preflight_package(
    package,
    public_key=TRUSTED_PUBLIC_KEY,
    installed_version_path=INSTALLED_VERSION,
    root_status_path=ROOT_STATUS,
    cmdline_path=CMDLINE,
    mounts_path=MOUNTS,
    blkid_command=BLKID,
    usb_status_path=USB_STATUS,
):
    manifest = verify_package(package, public_key)

    installed_version = read_single_line(
        installed_version_path,
        "installed Fre3nder version",
    )
    root_status = read_single_line(
        root_status_path,
        "Fre3nder root status",
    )

    try:
        cmdline = pathlib.Path(cmdline_path).read_text().strip()
    except OSError as exc:
        raise ValueError("cannot read kernel command line") from exc

    try:
        mounts = pathlib.Path(mounts_path).read_text()
    except OSError as exc:
        raise ValueError("cannot read mount table") from exc

    try:
        usb_status = pathlib.Path(usb_status_path).read_text().strip()
    except OSError:
        usb_status = "absent"

    usb = runtime_usb_state(usb_status, mounts)

    try:
        result = subprocess.run(
            [str(blkid_command)],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise ValueError(f"cannot execute blkid: {blkid_command}") from exc

    if result.returncode != 0:
        raise ValueError("cannot resolve Fre3nder persistence backends")

    plan = build_preflight(
        manifest,
        installed_version,
        root_status,
        cmdline,
        result.stdout,
        mounts,
    )
    plan["usb"] = usb
    return plan



API_VERSION = 1


def verify_response(package, public_key=TRUSTED_PUBLIC_KEY):
    manifest = verify_package(package, public_key)

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "verify",
        "package": {
            "path": str(package),
            "status": "valid",
            "version": manifest["version"],
            "platform": PLATFORM,
            "artifact_mode": manifest.get("artifact_mode", "unknown"),
        },
    }


def preflight_response(package, **kwargs):
    plan = preflight_package(package, **kwargs)

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "preflight",
        "package": {
            "path": str(package),
            "status": "valid",
            "version": plan["package_version"],
            "platform": PLATFORM,
            "artifact_mode": plan["artifact_mode"],
        },
        "runtime": {
            "installed_version": plan["installed_version"],
            "active_slot": plan["active_slot"],
            "active_root": plan["active_root"],
        },
        "target": {
            "slot": plan["target_slot"],
            "kernel": plan["target_kernel"],
            "rootfs": plan["target_rootfs"],
        },
        "persistence": {
            "sys": {
                "status": "resolved",
                "source": plan["sys_source"],
                "action": "reset",
            },
            "home": {
                "status": "resolved",
                "source": plan["home_source"],
                "action": "preserve",
            },
        },
        "runtime_usb": plan["usb"],
        "backup_offer": build_backup_offer(plan["usb"]),
    }


def require_directory(path, description):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except FileNotFoundError as exc:
        raise ValueError(f"{description} is missing: {path}") from exc

    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(
            f"{description} must be a directory, not a symlink: {path}"
        )

    return metadata


def add_backup_tree(
    archive,
    source,
    arcname,
    root_device,
    excluded_paths=(),
):
    if source in excluded_paths:
        return

    metadata = source.lstat()

    if metadata.st_dev != root_device:
        return

    info = archive.gettarinfo(str(source), arcname=arcname)

    if info is None:
        return

    if info.isfile():
        with source.open("rb") as stream:
            archive.addfile(info, stream)
        return

    archive.addfile(info)

    if not info.isdir():
        return

    try:
        children = sorted(source.iterdir(), key=lambda child: child.name)
    except OSError as exc:
        raise ValueError(f"cannot read backup source: {source}") from exc

    for child in children:
        try:
            child_metadata = child.lstat()
        except OSError as exc:
            raise ValueError(f"cannot inspect backup source: {child}") from exc

        if child_metadata.st_dev != root_device:
            continue

        add_backup_tree(
            archive,
            child,
            f"{arcname}/{child.name}",
            root_device,
            excluded_paths,
        )


def create_backup_archive(
    source,
    target_directory,
    role,
    version,
    excluded_paths=(),
):
    source = pathlib.Path(source)
    target_directory = pathlib.Path(target_directory)
    excluded_paths = tuple(
        pathlib.Path(item)
        for item in excluded_paths
    )

    source_metadata = require_directory(
        source,
        f"{role} backup source",
    )
    require_directory(
        target_directory,
        f"{role} backup target",
    )

    safe_version = re.sub(r"[^A-Za-z0-9._-]+", "_", version)
    if not safe_version:
        raise ValueError("installed version is invalid for backup filename")

    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    filename = f"fre3nder-{role.lower()}-{safe_version}-{stamp}.tar"
    archive_path = target_directory / filename

    if archive_path.exists() or archive_path.is_symlink():
        raise ValueError(f"backup archive already exists: {archive_path}")

    temporary = tempfile.NamedTemporaryFile(
        mode="w+b",
        prefix=f".{filename}.",
        suffix=".tmp",
        dir=target_directory,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            with tarfile.open(
                fileobj=temporary,
                mode="w",
                format=tarfile.PAX_FORMAT,
            ) as archive:
                add_backup_tree(
                    archive,
                    source,
                    role.lower(),
                    source_metadata.st_dev,
                    excluded_paths,
                )

            temporary.flush()
            os.fsync(temporary.fileno())

        if archive_path.exists() or archive_path.is_symlink():
            raise ValueError(
                f"backup archive already exists: {archive_path}"
            )

        temporary_path.rename(archive_path)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    try:
        with archive_path.open("rb") as stream:
            digest, size = sha256_stream(stream)
    except OSError as exc:
        raise ValueError(
            f"cannot verify created backup archive: {archive_path}"
        ) from exc

    return {
        "archive": str(archive_path),
        "size": size,
        "sha256": digest,
    }


def ensure_backup_directory(path):
    path = pathlib.Path(path)

    if path.exists() or path.is_symlink():
        require_directory(path, "backup directory")
        return path

    try:
        path.mkdir(mode=0o700)
    except OSError as exc:
        raise ValueError(
            f"cannot create backup directory: {path}"
        ) from exc

    return path


def parse_backup_plan_args(arguments, backup_offer):
    home = None
    sys_backup = None
    index = 0

    while index < len(arguments):
        argument = arguments[index]

        if argument == "--home":
            if home is not None:
                raise ValueError("HOME backup selection specified more than once")
            home = {
                "selected": True,
                "target": "usb",
            }
            index += 1
            continue

        if argument == "--no-home":
            if home is not None:
                raise ValueError("HOME backup selection specified more than once")
            home = {
                "selected": False,
                "target": None,
            }
            index += 1
            continue

        if argument == "--sys":
            if sys_backup is not None:
                raise ValueError("SYS backup selection specified more than once")
            if index + 1 >= len(arguments):
                raise ValueError("--sys requires target usb or home")

            target = arguments[index + 1]
            if target not in ("usb", "home"):
                raise ValueError("SYS backup target must be usb or home")

            sys_backup = {
                "selected": True,
                "target": target,
            }
            index += 2
            continue

        if argument == "--no-sys":
            if sys_backup is not None:
                raise ValueError("SYS backup selection specified more than once")
            sys_backup = {
                "selected": False,
                "target": None,
            }
            index += 1
            continue

        raise ValueError(f"unsupported backup selection argument: {argument}")

    if home is None:
        raise ValueError("HOME backup must be explicitly selected or declined")

    if sys_backup is None:
        raise ValueError("SYS backup must be explicitly selected or declined")

    if home["selected"]:
        home_offer = backup_offer["home"]
        if (
            home_offer["offered"] is not True
            or "usb" not in home_offer["targets"]
        ):
            raise ValueError(
                "HOME backup requires a backup-capable runtime USB volume"
            )

    if sys_backup["selected"]:
        if sys_backup["target"] not in backup_offer["sys"]["targets"]:
            raise ValueError(
                f"SYS backup target {sys_backup['target']} is not available"
            )

    return {
        "home": home,
        "sys": sys_backup,
    }

def backup_response(
    package,
    arguments,
    home_source=pathlib.Path(HOME_MOUNT),
    sys_source=pathlib.Path(SYS_MOUNT) / "upper",
    home_backup_directory=pathlib.Path(HOME_BACKUP_DIRECTORY),
    usb_backup_directory=pathlib.Path(USB_BACKUP_DIRECTORY),
    **kwargs,
):
    response = preflight_response(package, **kwargs)
    offer = response["backup_offer"]

    selection = parse_backup_plan_args(
        arguments,
        offer,
    )

    installed_version = response["runtime"]["installed_version"]

    usb_selected = (
        selection["home"]["selected"]
        or (
            selection["sys"]["selected"]
            and selection["sys"]["target"] == "usb"
        )
    )

    if usb_selected:
        current_usb = read_runtime_usb_state(
            kwargs.get("usb_status_path", USB_STATUS),
            kwargs.get("mounts_path", MOUNTS),
        )
        initial_usb = response["runtime_usb"]

        if current_usb.get("backup_available") is not True:
            raise ValueError(
                "backup-capable runtime USB volume is no longer available"
            )

        if (
            current_usb.get("source") != initial_usb.get("source")
            or current_usb.get("filesystem")
            != initial_usb.get("filesystem")
        ):
            raise ValueError(
                "runtime USB volume changed after preflight"
            )

    home_source = pathlib.Path(home_source)
    sys_source = pathlib.Path(sys_source)
    home_backup_directory = pathlib.Path(home_backup_directory)
    usb_backup_directory = pathlib.Path(usb_backup_directory)

    result = {
        "complete": False,
        "home": {
            "selected": selection["home"]["selected"],
            "target": selection["home"]["target"],
        },
        "sys": {
            "selected": selection["sys"]["selected"],
            "target": selection["sys"]["target"],
        },
    }

    # HOME deliberately runs first. SYS may subsequently write its archive
    # below HOME, which must not become part of this HOME backup.
    if selection["home"]["selected"]:
        if offer["targets"]["usb"]["available"] is not True:
            raise ValueError(
                "HOME backup requires a backup-capable runtime USB volume"
            )

        target = ensure_backup_directory(
            usb_backup_directory
        )

        result["home"].update(
            create_backup_archive(
                home_source,
                target,
                "HOME",
                installed_version,
                excluded_paths=(
                    home_source / "Fre3nderBackup",
                ),
            )
        )

    if selection["sys"]["selected"]:
        target_name = selection["sys"]["target"]

        if target_name == "usb":
            if offer["targets"]["usb"]["available"] is not True:
                raise ValueError(
                    "SYS USB backup target is not available"
                )
            target = ensure_backup_directory(
                usb_backup_directory
            )

        elif target_name == "home":
            target = ensure_backup_directory(
                home_backup_directory
            )

        else:
            raise ValueError(
                f"unsupported SYS backup target: {target_name}"
            )

        result["sys"].update(
            create_backup_archive(
                sys_source,
                target,
                "SYS",
                installed_version,
            )
        )

    result["complete"] = True

    response["operation"] = "backup"
    response["backup_selection"] = {
        "complete": True,
        "home": selection["home"],
        "sys": selection["sys"],
    }
    response["backup_result"] = result

    return response


def backup_plan_response(package, arguments, **kwargs):
    response = preflight_response(package, **kwargs)
    selection = parse_backup_plan_args(
        arguments,
        response["backup_offer"],
    )

    response["operation"] = "backup-plan"
    response["backup_selection"] = {
        "complete": True,
        "home": selection["home"],
        "sys": selection["sys"],
    }

    return response


def error_response(operation, message):
    return {
        "api_version": API_VERSION,
        "ok": False,
        "operation": operation,
        "error": str(message),
    }


def main():
    if len(sys.argv) < 3 or sys.argv[1] not in (
        "verify",
        "preflight",
        "backup-plan",
        "backup",
    ):
        print(
            json.dumps(
                error_response(
                    None,
                    "usage: fre3nder-ota-core "
                    "{verify|preflight|backup-plan|backup} "
                    "<package.ota> [options]",
                ),
                sort_keys=True,
            )
        )
        return 2

    operation = sys.argv[1]
    package = sys.argv[2]
    arguments = sys.argv[3:]

    if operation in ("verify", "preflight") and arguments:
        print(
            json.dumps(
                error_response(
                    operation,
                    f"{operation} does not accept additional arguments",
                ),
                sort_keys=True,
            )
        )
        return 2

    try:
        if operation == "verify":
            response = verify_response(package)
        elif operation == "preflight":
            response = preflight_response(package)
        elif operation == "backup-plan":
            response = backup_plan_response(package, arguments)
        else:
            response = backup_response(package, arguments)
    except (OSError, ValueError) as exc:
        print(json.dumps(error_response(operation, exc), sort_keys=True))
        return 1

    print(json.dumps(response, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
