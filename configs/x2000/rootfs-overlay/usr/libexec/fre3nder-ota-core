#!/usr/bin/python3
"""Fre3nder OTA core."""

import fcntl
import hashlib
import json
import os
import pathlib
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time


EXPECTED_MEMBERS = (
    "manifest.json",
    "SHA256SUMS",
    "SHA256SUMS.sig",
    "kernel.uImage",
    "rootfs.squashfs",
)
CHECKSUM_MEMBERS = (
    "manifest.json",
    "kernel.uImage",
    "rootfs.squashfs",
)
PAYLOAD_MEMBERS = (
    "kernel.uImage",
    "rootfs.squashfs",
)
TRUSTED_PUBLIC_KEY = pathlib.Path("/ota/keys/public.pem")
PLATFORM = "ender3-v3-ke"
MAX_MANIFEST_SIZE = 64 * 1024
MAX_CHECKSUMS_SIZE = 1024
ED25519_SIGNATURE_SIZE = 64
SHA256_RE = re.compile(r"[0-9a-f]{64}")
MAX_PENDING_TRANSACTION_SIZE = 64 * 1024

INSTALLED_VERSION = pathlib.Path("/usr/share/fre3nder/VERSION")
ROOT_STATUS = pathlib.Path("/run/fre3nder-root/status")
CMDLINE = pathlib.Path("/proc/cmdline")
MOUNTS = pathlib.Path("/proc/mounts")
BLKID = pathlib.Path("/sbin/blkid")
SYS_MOUNT = "/run/fre3nder-root/system"
HOME_MOUNT = "/home"

BACKUP_CORE = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_CORE",
        pathlib.Path(__file__).resolve().with_name(
            "fre3nder-backup-core"
        ),
    )
)
OTA_RUNTIME_DIRECTORY = pathlib.Path("/run/fre3nder/ota")
PENDING_TRANSACTION = OTA_RUNTIME_DIRECTORY / "pending.json"
WRITE_LOCK = OTA_RUNTIME_DIRECTORY / "write.lock"

ACTIVATION_RECORD = (
    pathlib.Path(SYS_MOUNT)
    / ".fre3nder-ota-activation.json"
)
LEGACY_RESET_MARKER = (
    pathlib.Path(SYS_MOUNT)
    / ".fre3nder-reset"
)
TARGET_RESET_MARKER = (
    pathlib.Path(SYS_MOUNT)
    / ".fre3nder-reset-target"
)
MAX_ACTIVATION_RECORD_SIZE = 64 * 1024
KNOWN_GOOD_RECORD = (
    pathlib.Path(SYS_MOUNT)
    / ".fre3nder-ota-known-good.json"
)
REBOOT_COMMAND = pathlib.Path("/sbin/reboot")

SELECTOR_DEVICE = pathlib.Path("/dev/mmcblk0p1")
SELECTOR_SIZE = 512
SELECTOR_HASHES = {
    "A": (
        "ba68d7c969bfee94216c94768ec65545"
        "cf36cb352303ab55231c78e78b51ce6b"
    ),
    "B": (
        "29a335bc1f2935f9ee79955da3566d5f"
        "70d1b0591421745395fd714c8351bdc4"
    ),
}

SLOTS = {
    "A": {
        "kernel": "/dev/mmcblk0p5",
        "rootfs": "/dev/mmcblk0p7",
    },
    "B": {
        "kernel": "/dev/mmcblk0p6",
        "rootfs": "/dev/mmcblk0p8",
    },
}

SLOT_DEVICE_METADATA = {
    "A": {
        "kernel": {
            "partition": 5,
            "sectors": 16384,
            "partlabel": "kernel",
        },
        "rootfs": {
            "partition": 7,
            "sectors": 1024000,
            "partlabel": "rootfs",
        },
    },
    "B": {
        "kernel": {
            "partition": 6,
            "sectors": 16384,
            "partlabel": "kernel2",
        },
        "rootfs": {
            "partition": 8,
            "sectors": 1024000,
            "partlabel": "rootfs2",
        },
    },
}

SYS_CLASS_BLOCK = pathlib.Path("/sys/class/block")
PARTLABEL_DIRECTORY = pathlib.Path("/dev/disk/by-partlabel")


def require_regular_file(path, description):
    try:
        metadata = path.lstat()
    except FileNotFoundError as exc:
        raise ValueError(f"{description} is missing: {path}") from exc
    if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
        raise ValueError(f"{description} must be a regular non-symlink file: {path}")


def read_small_member(archive, member, maximum, description):
    if member.size > maximum:
        raise ValueError(f"{description} is too large")
    stream = archive.extractfile(member)
    if stream is None:
        raise ValueError(f"cannot read {description}")
    data = stream.read(maximum + 1)
    if len(data) != member.size or len(data) > maximum:
        raise ValueError(f"cannot read complete {description}")
    return data


def verify_signature(checksums_data, signature_data, public_key):
    require_regular_file(public_key, "OTA public key")
    openssl = shutil.which("openssl")
    if openssl is None:
        raise ValueError("openssl command is unavailable")

    with tempfile.TemporaryDirectory(prefix="fre3nder-ota-") as temporary:
        temporary = pathlib.Path(temporary)
        checksums_path = temporary / "SHA256SUMS"
        signature_path = temporary / "SHA256SUMS.sig"
        checksums_path.write_bytes(checksums_data)
        signature_path.write_bytes(signature_data)

        result = subprocess.run(
            [
                openssl,
                "pkeyutl",
                "-verify",
                "-rawin",
                "-pubin",
                "-inkey",
                str(public_key),
                "-in",
                str(checksums_path),
                "-sigfile",
                str(signature_path),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    if result.returncode != 0:
        raise ValueError("Ed25519 signature verification failed")


def parse_checksums(data):
    try:
        text = data.decode("ascii")
    except UnicodeDecodeError as exc:
        raise ValueError("SHA256SUMS is not ASCII") from exc

    if not text.endswith("\n"):
        raise ValueError("SHA256SUMS must end with a newline")

    lines = text.splitlines()
    if len(lines) != len(CHECKSUM_MEMBERS):
        raise ValueError("SHA256SUMS has unexpected entries")

    checksums = {}
    for line, expected_name in zip(lines, CHECKSUM_MEMBERS):
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9._-]+)", line)
        if match is None:
            raise ValueError("SHA256SUMS has invalid syntax")
        digest, name = match.groups()
        if name != expected_name:
            raise ValueError("SHA256SUMS has unexpected member order or name")
        checksums[name] = digest
    return checksums


def sha256_stream(stream):
    digest = hashlib.sha256()
    size = 0
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        digest.update(chunk)
        size += len(chunk)
    return digest.hexdigest(), size


def sha256_file(path, description):
    path = pathlib.Path(path)
    require_regular_file(path, description)

    try:
        with path.open("rb") as stream:
            return sha256_stream(stream)
    except OSError as exc:
        raise ValueError(
            f"cannot read {description}: {path}"
        ) from exc


def validate_manifest(manifest, checksums, members, public_key):
    if not isinstance(manifest, dict):
        raise ValueError("manifest.json must contain a JSON object")

    version = manifest.get("version")
    if not isinstance(version, str) or not version or len(version) > 64:
        raise ValueError("manifest version is missing or invalid")

    ota = manifest.get("ota")
    if not isinstance(ota, dict):
        raise ValueError("manifest OTA metadata is missing")
    if ota.get("format") != "fre3nder-ota" or ota.get("format_version") != 1:
        raise ValueError("unsupported OTA format")
    if ota.get("platform") != PLATFORM:
        raise ValueError("OTA package targets a different platform")

    signature = ota.get("signature")
    if not isinstance(signature, dict) or signature != {
        "algorithm": "Ed25519",
        "file": "SHA256SUMS.sig",
        "signed_file": "SHA256SUMS",
    }:
        raise ValueError("unsupported OTA signature contract")

    artifacts = manifest.get("artifacts")
    sizes = manifest.get("artifact_sizes")
    if not isinstance(artifacts, dict) or set(artifacts) != set(PAYLOAD_MEMBERS):
        raise ValueError("manifest artifact hashes are incomplete")
    if not isinstance(sizes, dict) or set(sizes) != set(PAYLOAD_MEMBERS):
        raise ValueError("manifest artifact sizes are incomplete")

    for name in PAYLOAD_MEMBERS:
        digest = artifacts.get(name)
        size = sizes.get(name)
        if not isinstance(digest, str) or SHA256_RE.fullmatch(digest) is None:
            raise ValueError(f"manifest hash is invalid: {name}")
        if digest != checksums[name]:
            raise ValueError(f"manifest hash disagrees with SHA256SUMS: {name}")
        if type(size) is not int or size < 0:
            raise ValueError(f"manifest size is invalid: {name}")
        if size != members[name].size:
            raise ValueError(f"manifest size disagrees with TAR member: {name}")

    expected_key_hash = hashlib.sha256(public_key.read_bytes()).hexdigest()
    if manifest.get("ota_public_key_sha256") != expected_key_hash:
        raise ValueError("OTA package trust anchor differs from installed trust anchor")

    return version


def verify_package(package, public_key=TRUSTED_PUBLIC_KEY):
    package = pathlib.Path(package)
    public_key = pathlib.Path(public_key)
    require_regular_file(package, "OTA package")

    try:
        archive = tarfile.open(package, mode="r:")
    except (OSError, tarfile.TarError) as exc:
        raise ValueError(f"cannot open OTA package: {exc}") from exc

    with archive:
        members_list = archive.getmembers()
        names = tuple(member.name for member in members_list)
        if names != EXPECTED_MEMBERS:
            raise ValueError("OTA package must contain exactly the five v1 members in order")
        if any(not member.isfile() for member in members_list):
            raise ValueError("all OTA package members must be regular files")
        members = {member.name: member for member in members_list}

        checksums_data = read_small_member(
            archive,
            members["SHA256SUMS"],
            MAX_CHECKSUMS_SIZE,
            "SHA256SUMS",
        )
        signature_data = read_small_member(
            archive,
            members["SHA256SUMS.sig"],
            ED25519_SIGNATURE_SIZE,
            "SHA256SUMS.sig",
        )
        if len(signature_data) != ED25519_SIGNATURE_SIZE:
            raise ValueError("SHA256SUMS.sig is not an Ed25519 signature")

        verify_signature(checksums_data, signature_data, public_key)
        checksums = parse_checksums(checksums_data)

        manifest_data = read_small_member(
            archive,
            members["manifest.json"],
            MAX_MANIFEST_SIZE,
            "manifest.json",
        )
        if hashlib.sha256(manifest_data).hexdigest() != checksums["manifest.json"]:
            raise ValueError("manifest.json checksum mismatch")
        try:
            manifest = json.loads(manifest_data)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError("manifest.json is invalid JSON") from exc

        validate_manifest(manifest, checksums, members, public_key)

        for name in PAYLOAD_MEMBERS:
            stream = archive.extractfile(members[name])
            if stream is None:
                raise ValueError(f"cannot read payload: {name}")
            digest, size = sha256_stream(stream)
            if size != members[name].size:
                raise ValueError(f"payload size changed while reading: {name}")
            if digest != checksums[name]:
                raise ValueError(f"payload checksum mismatch: {name}")

    return manifest


def read_single_line(path, description):
    path = pathlib.Path(path)
    try:
        text = path.read_text()
    except OSError as exc:
        raise ValueError(f"cannot read {description}: {path}") from exc

    lines = text.splitlines()
    if len(lines) != 1 or not lines[0]:
        raise ValueError(f"{description} is missing or invalid")
    return lines[0]


def discover_active_slot(cmdline):
    roots = [
        argument.removeprefix("root=")
        for argument in cmdline.split()
        if argument.startswith("root=")
    ]
    if len(roots) != 1:
        raise ValueError("expected exactly one root= argument")

    active_root = roots[0]
    if active_root == SLOTS["A"]["rootfs"]:
        return "A", "B", active_root
    if active_root == SLOTS["B"]["rootfs"]:
        return "B", "A", active_root

    raise ValueError(
        f"active root is not a Fre3nder A/B root: {active_root}"
    )


def parse_blkid_roles(output):
    roles = {
        "SYS": [],
        "HOME": [],
    }

    for line in output.splitlines():
        if ":" not in line:
            continue

        device, metadata = line.split(":", 1)
        fields = metadata.split()

        if 'LABEL="FRE3NDERSYS"' in fields:
            roles["SYS"].append(device)
        if 'LABEL="FRE3NDERHOME"' in fields:
            roles["HOME"].append(device)

    for role, label in (
        ("SYS", "FRE3NDERSYS"),
        ("HOME", "FRE3NDERHOME"),
    ):
        devices = list(dict.fromkeys(roles[role]))
        if len(devices) != 1:
            raise ValueError(
                f"expected exactly one {label} backend, found {len(devices)}"
            )
        roles[role] = devices[0]

    if os.path.realpath(roles["SYS"]) == os.path.realpath(roles["HOME"]):
        raise ValueError("SYS and HOME resolve to the same backend")

    return roles


def decode_mount_field(value):
    return (
        value
        .replace(r"\\040", " ")
        .replace(r"\\011", "\t")
        .replace(r"\\012", "\n")
        .replace(r"\\134", "\\")
    )


def parse_mounts(text):
    entries = []
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        entries.append(
            (
                decode_mount_field(fields[0]),
                decode_mount_field(fields[1]),
                fields[2],
            )
        )
    return entries


def require_role_mount(entries, mountpoint, source, role):
    matches = [
        (mounted_source, fs_type)
        for mounted_source, mounted_at, fs_type in entries
        if mounted_at == mountpoint
    ]

    if len(matches) != 1:
        raise ValueError(
            f"{role} is not mounted exactly once at {mountpoint}"
        )

    mounted_source, fs_type = matches[0]

    if os.path.realpath(mounted_source) != os.path.realpath(source):
        raise ValueError(
            f"{role} backend mounted at {mountpoint} "
            "does not match its resolved label"
        )

    if fs_type != "ext4":
        raise ValueError(
            f"{role} mounted at {mountpoint} is not ext4: {fs_type}"
        )


def build_preflight(
    manifest,
    installed_version,
    root_status,
    cmdline,
    blkid_output,
    mounts,
):
    if root_status != "active":
        raise ValueError(
            f"Fre3nder writable runtime is not active: {root_status}"
        )

    active_slot, target_slot, active_root = discover_active_slot(cmdline)
    roles = parse_blkid_roles(blkid_output)
    mount_entries = parse_mounts(mounts)

    require_role_mount(
        mount_entries,
        SYS_MOUNT,
        roles["SYS"],
        "SYS",
    )
    require_role_mount(
        mount_entries,
        HOME_MOUNT,
        roles["HOME"],
        "HOME",
    )

    return {
        "package_version": manifest["version"],
        "artifact_mode": manifest.get("artifact_mode", "unknown"),
        "installed_version": installed_version,
        "active_slot": active_slot,
        "active_root": active_root,
        "target_slot": target_slot,
        "target_kernel": SLOTS[target_slot]["kernel"],
        "target_rootfs": SLOTS[target_slot]["rootfs"],
        "sys_source": roles["SYS"],
        "home_source": roles["HOME"],
    }


def preflight_package(
    package,
    public_key=TRUSTED_PUBLIC_KEY,
    installed_version_path=INSTALLED_VERSION,
    root_status_path=ROOT_STATUS,
    cmdline_path=CMDLINE,
    mounts_path=MOUNTS,
    blkid_command=BLKID,
):
    manifest = verify_package(package, public_key)

    installed_version = read_single_line(
        installed_version_path,
        "installed Fre3nder version",
    )
    root_status = read_single_line(
        root_status_path,
        "Fre3nder root status",
    )

    try:
        cmdline = pathlib.Path(cmdline_path).read_text().strip()
    except OSError as exc:
        raise ValueError("cannot read kernel command line") from exc

    try:
        mounts = pathlib.Path(mounts_path).read_text()
    except OSError as exc:
        raise ValueError("cannot read mount table") from exc

    try:
        result = subprocess.run(
            [str(blkid_command)],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise ValueError(f"cannot execute blkid: {blkid_command}") from exc

    if result.returncode != 0:
        raise ValueError("cannot resolve Fre3nder persistence backends")

    return build_preflight(
        manifest,
        installed_version,
        root_status,
        cmdline,
        result.stdout,
        mounts,
    )



API_VERSION = 1


def verify_response(package, public_key=TRUSTED_PUBLIC_KEY):
    manifest = verify_package(package, public_key)

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "verify",
        "package": {
            "path": str(package),
            "status": "valid",
            "version": manifest["version"],
            "platform": PLATFORM,
            "artifact_mode": manifest.get("artifact_mode", "unknown"),
        },
    }


def preflight_response(
    package,
    backup_core=BACKUP_CORE,
    **kwargs,
):
    preflight_kwargs = dict(kwargs)

    usb_helper = preflight_kwargs.pop(
        "usb_helper",
        None,
    )

    plan = preflight_package(
        package,
        **preflight_kwargs,
    )

    backup = backup_offer(
        usb_helper,
        backup_core,
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "preflight",
        "package": {
            "path": str(package),
            "status": "valid",
            "version": plan["package_version"],
            "platform": PLATFORM,
            "artifact_mode": plan["artifact_mode"],
        },
        "runtime": {
            "installed_version": plan["installed_version"],
            "active_slot": plan["active_slot"],
            "active_root": plan["active_root"],
        },
        "target": {
            "slot": plan["target_slot"],
            "kernel": plan["target_kernel"],
            "rootfs": plan["target_rootfs"],
        },
        "persistence": {
            "sys": {
                "status": "resolved",
                "source": plan["sys_source"],
                "action": "reset",
            },
            "home": {
                "status": "resolved",
                "source": plan["home_source"],
                "action": "preserve",
            },
        },
        "runtime_usb": backup["runtime_usb"],
        "backup_offer": backup["backup_offer"],
    }


BACKUP_ENVIRONMENT_KEYS = (
    "FRE3NDER_BACKUP_VERSION",
    "FRE3NDER_BACKUP_HOME_SOURCE",
    "FRE3NDER_BACKUP_SYS_SOURCE",
    "FRE3NDER_BACKUP_USB_HELPER",
    "FRE3NDER_BACKUP_HOME_DIRECTORY",
    "FRE3NDER_BACKUP_USB_DIRECTORY",
    "FRE3NDER_BACKUP_EXPECTED_USB_SOURCE",
    "FRE3NDER_BACKUP_EXPECTED_USB_FILESYSTEM",
)


def backup_environment(
    version=None,
    home_source=None,
    sys_source=None,
    usb_helper=None,
    home_backup_directory=None,
    usb_backup_directory=None,
    expected_usb=None,
):
    values = {
        "FRE3NDER_BACKUP_VERSION": version,
        "FRE3NDER_BACKUP_HOME_SOURCE": home_source,
        "FRE3NDER_BACKUP_SYS_SOURCE": sys_source,
        "FRE3NDER_BACKUP_USB_HELPER": usb_helper,
        "FRE3NDER_BACKUP_HOME_DIRECTORY": home_backup_directory,
        "FRE3NDER_BACKUP_USB_DIRECTORY": usb_backup_directory,
    }

    if isinstance(expected_usb, dict):
        source = expected_usb.get("source")
        filesystem = expected_usb.get("filesystem")

        if (
            isinstance(source, str)
            and source
            and isinstance(filesystem, str)
            and filesystem
        ):
            values[
                "FRE3NDER_BACKUP_EXPECTED_USB_SOURCE"
            ] = source
            values[
                "FRE3NDER_BACKUP_EXPECTED_USB_FILESYSTEM"
            ] = filesystem

    return {
        key: str(value)
        for key, value in values.items()
        if value is not None
    }


def run_backup_core(
    operation,
    arguments,
    backup_core=BACKUP_CORE,
    environment=None,
):
    backup_core = pathlib.Path(backup_core)

    child_environment = os.environ.copy()

    # Caller environment must never redirect privileged backup
    # paths implicitly. Only explicit adapter values below apply.
    for key in BACKUP_ENVIRONMENT_KEYS:
        child_environment.pop(key, None)

    if environment:
        child_environment.update(environment)

    try:
        result = subprocess.run(
            [
                str(backup_core),
                operation,
                *map(str, arguments),
            ],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
            env=child_environment,
        )
    except OSError as exc:
        raise ValueError(
            f"cannot execute backup core: {backup_core}"
        ) from exc

    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ValueError(
            "backup core returned invalid JSON"
        ) from exc

    if not isinstance(response, dict):
        raise ValueError(
            "backup core returned an invalid response"
        )

    if (
        response.get("api_version") != API_VERSION
        or response.get("operation") != operation
    ):
        raise ValueError(
            "backup core returned an incompatible response"
        )

    if (
        result.returncode != 0
        or response.get("ok") is not True
    ):
        error = response.get(
            "error",
            "backup operation failed",
        )

        if not isinstance(error, str):
            error = "backup operation failed"

        raise ValueError(error)

    return response


def backup_offer(
    usb_helper=None,
    backup_core=BACKUP_CORE,
):
    response = run_backup_core(
        "offer",
        (),
        backup_core,
        backup_environment(
            usb_helper=usb_helper,
        ),
    )

    if (
        not isinstance(
            response.get("runtime_usb"),
            dict,
        )
        or not isinstance(
            response.get("backup_offer"),
            dict,
        )
    ):
        raise ValueError(
            "backup core returned invalid offer state"
        )

    return response


def backup_plan(
    arguments,
    usb_helper=None,
    backup_core=BACKUP_CORE,
):
    response = run_backup_core(
        "plan",
        arguments,
        backup_core,
        backup_environment(
            usb_helper=usb_helper,
        ),
    )

    selection = response.get(
        "backup_selection"
    )

    if (
        not isinstance(selection, dict)
        or selection.get("complete") is not True
    ):
        raise ValueError(
            "backup core returned invalid selection"
        )

    return response


def backup_execute(
    version,
    arguments,
    expected_usb=None,
    home_source=None,
    sys_source=None,
    home_backup_directory=None,
    usb_backup_directory=None,
    usb_helper=None,
    backup_core=BACKUP_CORE,
):
    response = run_backup_core(
        "execute",
        arguments,
        backup_core,
        backup_environment(
            version=version,
            home_source=home_source,
            sys_source=sys_source,
            usb_helper=usb_helper,
            home_backup_directory=home_backup_directory,
            usb_backup_directory=usb_backup_directory,
            expected_usb=expected_usb,
        ),
    )

    selection = response.get(
        "backup_selection"
    )
    result = response.get(
        "backup_result"
    )

    if (
        not isinstance(selection, dict)
        or selection.get("complete") is not True
        or not isinstance(result, dict)
        or result.get("complete") is not True
    ):
        raise ValueError(
            "backup core returned incomplete execution"
        )

    return response


def backup_verify(
    archive,
    expected_size,
    expected_digest,
    backup_core=BACKUP_CORE,
):
    response = run_backup_core(
        "verify",
        (
            str(archive),
            str(expected_size),
            expected_digest,
        ),
        backup_core,
    )

    backup = response.get("backup")

    if (
        not isinstance(backup, dict)
        or backup.get("status") != "valid"
        or backup.get("archive") != str(archive)
        or backup.get("size") != expected_size
        or backup.get("sha256") != expected_digest
    ):
        raise ValueError(
            "backup core returned invalid verification result"
        )

    return backup


def ensure_new_transaction_available(
    pending_path=PENDING_TRANSACTION,
    activation_record_path=ACTIVATION_RECORD,
):
    pending_path = pathlib.Path(pending_path)
    activation_record_path = pathlib.Path(
        activation_record_path
    )

    if (
        activation_record_path.exists()
        or activation_record_path.is_symlink()
    ):
        raise ValueError(
            "pending OTA activation requires recovery "
            "before a new update"
        )

    if pending_path.exists() or pending_path.is_symlink():
        state = load_pending_transaction(
            pending_path
        )

        raise ValueError(
            "another OTA transaction is already active: "
            f"{state['state']}"
        )



def write_pending_transaction(
    package,
    response,
    path=PENDING_TRANSACTION,
):
    path = pathlib.Path(path)
    package = pathlib.Path(package)

    package_sha256, package_size = sha256_file(
        package,
        "OTA package",
    )

    transaction_id = secrets.token_hex(16)

    state = {
        "api_version": API_VERSION,
        "state": "awaiting-confirmation",
        "transaction_id": transaction_id,
        "package": {
            "path": str(package.absolute()),
            "version": response["package"]["version"],
            "sha256": package_sha256,
            "size": package_size,
        },
        "runtime": {
            "installed_version": response["runtime"]["installed_version"],
            "active_slot": response["runtime"]["active_slot"],
            "active_root": response["runtime"]["active_root"],
        },
        "target": response["target"],
        "backup_selection": response["backup_selection"],
        "backup_result": response["backup_result"],
    }

    parent = path.parent

    try:
        parent.mkdir(
            mode=0o700,
            parents=True,
            exist_ok=True,
        )
    except OSError as exc:
        raise ValueError(
            f"cannot create OTA runtime state directory: {parent}"
        ) from exc

    if parent.is_symlink() or not parent.is_dir():
        raise ValueError(
            f"OTA runtime state path is not a directory: {parent}"
        )

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".pending.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)
            json.dump(
                state,
                temporary,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        os.replace(temporary_path, path)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    return {
        "required": True,
        "state": "awaiting-confirmation",
        "transaction_id": transaction_id,
    }


def load_pending_transaction(
    path=PENDING_TRANSACTION,
):
    path = pathlib.Path(path)

    require_regular_file(
        path,
        "pending OTA transaction",
    )

    metadata = path.lstat()
    if metadata.st_size > MAX_PENDING_TRANSACTION_SIZE:
        raise ValueError(
            "pending OTA transaction is too large"
        )

    try:
        state = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(
            "pending OTA transaction is invalid"
        ) from exc

    if not isinstance(state, dict):
        raise ValueError(
            "pending OTA transaction is invalid"
        )

    if state.get("api_version") != API_VERSION:
        raise ValueError(
            "pending OTA transaction API version is unsupported"
        )

    transaction_id = state.get("transaction_id")
    if (
        not isinstance(transaction_id, str)
        or re.fullmatch(r"[0-9a-f]{32}", transaction_id)
        is None
    ):
        raise ValueError(
            "pending OTA transaction ID is invalid"
        )

    if state.get("state") not in (
        "awaiting-confirmation",
        "confirmed",
        "written-awaiting-readback",
        "readback-verified",
        "activation-prepared",
    ):
        raise ValueError(
            "pending OTA transaction state is invalid"
        )

    return state


def verify_pending_backup_result(state):
    selection = state.get("backup_selection")
    result = state.get("backup_result")

    if (
        not isinstance(selection, dict)
        or selection.get("complete") is not True
        or not isinstance(result, dict)
        or result.get("complete") is not True
    ):
        raise ValueError(
            "pending OTA backup state is incomplete"
        )

    for role in ("home", "sys"):
        selected = selection.get(role)
        created = result.get(role)

        if (
            not isinstance(selected, dict)
            or not isinstance(created, dict)
        ):
            raise ValueError(
                f"pending OTA {role.upper()} backup state is invalid"
            )

        is_selected = selected.get("selected")
        target = selected.get("target")

        if type(is_selected) is not bool:
            raise ValueError(
                f"pending OTA {role.upper()} backup selection is invalid"
            )

        if is_selected:
            if target not in ("usb", "home"):
                raise ValueError(
                    f"pending OTA {role.upper()} backup target is invalid"
                )
        elif target is not None:
            raise ValueError(
                f"pending OTA {role.upper()} declined backup has a target"
            )

        if (
            created.get("selected") != is_selected
            or created.get("target") != target
        ):
            raise ValueError(
                f"pending OTA {role.upper()} backup result is inconsistent"
            )

        if not is_selected:
            continue

        archive = created.get("archive")
        expected_size = created.get("size")
        expected_digest = created.get("sha256")

        if (
            not isinstance(archive, str)
            or not archive
            or type(expected_size) is not int
            or expected_size < 0
            or not isinstance(expected_digest, str)
            or SHA256_RE.fullmatch(expected_digest) is None
        ):
            raise ValueError(
                f"pending OTA {role.upper()} backup metadata is invalid"
            )

        try:
            backup_verify(
                pathlib.Path(archive),
                expected_size,
                expected_digest,
            )
        except ValueError as exc:
            raise ValueError(
                f"{role.upper()} backup archive changed after backup"
            ) from exc


def store_transaction_state(
    state,
    new_state,
    path=PENDING_TRANSACTION,
    extra=None,
):
    path = pathlib.Path(path)
    parent = path.parent

    try:
        metadata = parent.lstat()
    except OSError as exc:
        raise ValueError(
            f"OTA runtime state directory is unavailable: {parent}"
        ) from exc

    if parent.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(
            f"OTA runtime state path is not a directory: {parent}"
        )

    updated = dict(state)
    updated["state"] = new_state

    if extra is not None:
        updated.update(extra)

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".pending.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)
            json.dump(
                updated,
                temporary,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        os.replace(temporary_path, path)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    return updated


def store_confirmed_transaction(
    state,
    path=PENDING_TRANSACTION,
):
    return store_transaction_state(
        state,
        "confirmed",
        path,
    )


def validate_transaction_binding(
    package,
    state,
    **kwargs,
):
    response = preflight_response(
        package,
        **kwargs,
    )

    package_state = state.get("package")
    runtime_state = state.get("runtime")
    target_state = state.get("target")

    if (
        not isinstance(package_state, dict)
        or not isinstance(runtime_state, dict)
        or not isinstance(target_state, dict)
    ):
        raise ValueError(
            "pending OTA transaction is incomplete"
        )

    package_digest, package_size = sha256_file(
        pathlib.Path(package),
        "OTA package",
    )

    if (
        package_state.get("version")
        != response["package"]["version"]
        or package_state.get("sha256")
        != package_digest
        or package_state.get("size")
        != package_size
    ):
        raise ValueError(
            "OTA package changed after backup"
        )

    if runtime_state != response["runtime"]:
        raise ValueError(
            "OTA runtime changed after backup"
        )

    if target_state != response["target"]:
        raise ValueError(
            "OTA target changed after backup"
        )

    verify_pending_backup_result(state)

    return response


def confirm_response(
    package,
    arguments,
    pending_transaction_path=PENDING_TRANSACTION,
    **kwargs,
):
    if len(arguments) != 1:
        raise ValueError(
            "confirm requires exactly one transaction ID"
        )

    transaction_id = arguments[0]

    state = load_pending_transaction(
        pending_transaction_path
    )

    if state["state"] != "awaiting-confirmation":
        raise ValueError(
            "pending OTA transaction is not awaiting confirmation"
        )

    if transaction_id != state["transaction_id"]:
        raise ValueError(
            "OTA transaction ID does not match"
        )

    response = validate_transaction_binding(
        package,
        state,
        **kwargs,
    )

    confirmed = store_confirmed_transaction(
        state,
        pending_transaction_path,
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "confirm",
        "package": response["package"],
        "runtime": response["runtime"],
        "target": response["target"],
        "confirmation": {
            "state": confirmed["state"],
            "transaction_id": confirmed["transaction_id"],
        },
    }


def require_targets_unmounted(
    mounts_path,
    targets,
):
    try:
        mounts = pathlib.Path(mounts_path).read_text()
    except OSError as exc:
        raise ValueError(
            "cannot read mount table before OTA write"
        ) from exc

    target_paths = {
        os.path.realpath(str(target))
        for target in targets
    }

    for source, mounted_at, _fs_type in parse_mounts(mounts):
        if os.path.realpath(source) in target_paths:
            raise ValueError(
                f"inactive OTA target is mounted: "
                f"{source} at {mounted_at}"
            )


def require_write_target(
    path,
    description,
    allow_regular_targets=False,
):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"{description} is unavailable: {path}"
        ) from exc

    if path.is_symlink():
        raise ValueError(
            f"{description} must not be a symlink: {path}"
        )

    if stat.S_ISBLK(metadata.st_mode):
        return

    if (
        allow_regular_targets
        and stat.S_ISREG(metadata.st_mode)
    ):
        return

    raise ValueError(
        f"{description} is not a block device: {path}"
    )


def require_identity_device(
    path,
    description,
    allow_regular_target=False,
):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"{description} is unavailable: {path}"
        ) from exc

    if path.is_symlink():
        raise ValueError(
            f"{description} must not be a symlink: {path}"
        )

    if stat.S_ISBLK(metadata.st_mode):
        return

    if (
        allow_regular_target
        and stat.S_ISREG(metadata.st_mode)
    ):
        return

    raise ValueError(
        f"{description} is not a block device: {path}"
    )


def read_block_metadata(
    sys_class_block,
    device_name,
    field,
    description,
):
    path = (
        pathlib.Path(sys_class_block)
        / device_name
        / field
    )

    try:
        return path.read_text().strip()
    except OSError as exc:
        raise ValueError(
            f"{description} metadata is unavailable: {field}"
        ) from exc


def validate_partition_identity(
    device,
    expected_partition,
    expected_sectors,
    expected_partlabel,
    active_root,
    sys_class_block=SYS_CLASS_BLOCK,
    partlabel_directory=PARTLABEL_DIRECTORY,
    allow_regular_target=False,
):
    device = pathlib.Path(device)
    active_root = pathlib.Path(active_root)
    sys_class_block = pathlib.Path(
        sys_class_block
    )
    partlabel_directory = pathlib.Path(
        partlabel_directory
    )

    require_identity_device(
        device,
        "inactive OTA target",
        allow_regular_target,
    )

    require_identity_device(
        active_root,
        "active OTA root",
        allow_regular_target,
    )

    if os.path.realpath(device) != str(device):
        raise ValueError(
            f"inactive OTA target identity mismatch: {device}"
        )

    if os.path.realpath(active_root) != str(active_root):
        raise ValueError(
            f"active OTA root identity mismatch: {active_root}"
        )

    expected_name = (
        f"mmcblk0p{expected_partition}"
    )

    if device.name != expected_name:
        raise ValueError(
            "inactive OTA target partition name mismatch"
        )

    partition_number = read_block_metadata(
        sys_class_block,
        device.name,
        "partition",
        "inactive OTA target",
    )

    if partition_number != str(expected_partition):
        raise ValueError(
            "inactive OTA target partition number mismatch"
        )

    sector_count = read_block_metadata(
        sys_class_block,
        device.name,
        "size",
        "inactive OTA target",
    )

    if sector_count != str(expected_sectors):
        raise ValueError(
            "inactive OTA target size mismatch"
        )

    active_name = active_root.name

    if active_name not in (
        "mmcblk0p7",
        "mmcblk0p8",
    ):
        raise ValueError(
            "active OTA root is not p7 or p8"
        )

    expected_active_partition = (
        "7"
        if active_name == "mmcblk0p7"
        else "8"
    )

    active_partition = read_block_metadata(
        sys_class_block,
        active_name,
        "partition",
        "active OTA root",
    )

    if active_partition != expected_active_partition:
        raise ValueError(
            "active OTA root partition number mismatch"
        )

    try:
        target_sys = (
            sys_class_block
            / device.name
        ).resolve(strict=True)

        active_sys = (
            sys_class_block
            / active_name
        ).resolve(strict=True)

    except OSError as exc:
        raise ValueError(
            "cannot resolve OTA block-device topology"
        ) from exc

    if target_sys.parent != active_sys.parent:
        raise ValueError(
            "inactive OTA target and active root are "
            "not on the same block device"
        )

    if (
        partlabel_directory.exists()
        or partlabel_directory.is_symlink()
    ):
        if not partlabel_directory.is_dir():
            raise ValueError(
                "partition-label infrastructure is invalid"
            )

        label = (
            partlabel_directory
            / expected_partlabel
        )

        if not (
            label.exists()
            or label.is_symlink()
        ):
            raise ValueError(
                f"{expected_partlabel} partlabel is absent"
            )

        if (
            os.path.realpath(label)
            != os.path.realpath(device)
        ):
            raise ValueError(
                f"{expected_partlabel} partlabel "
                "does not resolve to OTA target"
            )


def validate_inactive_slot_identity(
    response,
    sys_class_block=SYS_CLASS_BLOCK,
    partlabel_directory=PARTLABEL_DIRECTORY,
):
    runtime = response.get("runtime")
    target = response.get("target")

    if (
        not isinstance(runtime, dict)
        or not isinstance(target, dict)
    ):
        raise ValueError(
            "OTA slot identity state is invalid"
        )

    active_slot = runtime.get("active_slot")
    target_slot = target.get("slot")

    if (
        active_slot not in ("A", "B")
        or target_slot not in ("A", "B")
        or active_slot == target_slot
    ):
        raise ValueError(
            "OTA active/target slot identity is invalid"
        )

    expected_target_slot = (
        "B"
        if active_slot == "A"
        else "A"
    )

    if target_slot != expected_target_slot:
        raise ValueError(
            "OTA target is not the inactive slot"
        )

    expected_active_root = (
        SLOTS[active_slot]["rootfs"]
    )

    if runtime.get("active_root") != expected_active_root:
        raise ValueError(
            "OTA active root does not match active slot"
        )

    for role in ("kernel", "rootfs"):
        expected_device = (
            SLOTS[target_slot][role]
        )

        if target.get(role) != expected_device:
            raise ValueError(
                f"OTA {role} target does not match "
                "inactive slot"
            )

        metadata = (
            SLOT_DEVICE_METADATA[
                target_slot
            ][role]
        )

        validate_partition_identity(
            pathlib.Path(expected_device),
            metadata["partition"],
            metadata["sectors"],
            metadata["partlabel"],
            pathlib.Path(expected_active_root),
            sys_class_block,
            partlabel_directory,
        )


def target_capacity(
    path,
    description,
    allow_regular_targets=False,
):
    require_write_target(
        path,
        description,
        allow_regular_targets,
    )

    try:
        with pathlib.Path(path).open(
            "rb",
            buffering=0,
        ) as stream:
            size = stream.seek(0, os.SEEK_END)
    except OSError as exc:
        raise ValueError(
            f"cannot determine {description} size: {path}"
        ) from exc

    return size


def write_payload_member(
    package,
    member_name,
    target,
    expected_size,
    expected_digest,
    allow_regular_targets=False,
):
    target = pathlib.Path(target)

    require_write_target(
        target,
        f"OTA write target for {member_name}",
        allow_regular_targets,
    )

    try:
        archive = tarfile.open(
            package,
            mode="r:",
        )
    except (OSError, tarfile.TarError) as exc:
        raise ValueError(
            "cannot reopen OTA package for writing"
        ) from exc

    with archive:
        try:
            member = archive.getmember(member_name)
        except KeyError as exc:
            raise ValueError(
                f"OTA payload is missing: {member_name}"
            ) from exc

        if (
            not member.isfile()
            or member.size != expected_size
        ):
            raise ValueError(
                f"OTA payload changed before write: {member_name}"
            )

        source = archive.extractfile(member)
        if source is None:
            raise ValueError(
                f"cannot read OTA payload: {member_name}"
            )

        digest = hashlib.sha256()
        written = 0

        try:
            with target.open(
                "r+b",
                buffering=0,
            ) as destination:
                destination.seek(0)

                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break

                    view = memoryview(chunk)

                    while view:
                        count = destination.write(view)
                        if count is None or count <= 0:
                            raise ValueError(
                                f"short write to OTA target: {target}"
                            )
                        view = view[count:]

                    digest.update(chunk)
                    written += len(chunk)

                destination.flush()
                os.fsync(destination.fileno())

        except OSError as exc:
            raise ValueError(
                f"cannot write OTA target: {target}"
            ) from exc

    actual_digest = digest.hexdigest()

    if written != expected_size:
        raise ValueError(
            f"OTA payload size changed during write: {member_name}"
        )

    if actual_digest != expected_digest:
        raise ValueError(
            f"OTA payload checksum changed during write: {member_name}"
        )

    return {
        "size": written,
        "sha256": actual_digest,
    }


def write_response(
    package,
    arguments,
    pending_transaction_path=PENDING_TRANSACTION,
    write_lock_path=WRITE_LOCK,
    target_overrides=None,
    allow_regular_targets=False,
    **kwargs,
):
    if len(arguments) != 1:
        raise ValueError(
            "write requires exactly one transaction ID"
        )

    transaction_id = arguments[0]

    state = load_pending_transaction(
        pending_transaction_path
    )

    if state["state"] != "confirmed":
        raise ValueError(
            "pending OTA transaction is not confirmed"
        )

    if transaction_id != state["transaction_id"]:
        raise ValueError(
            "OTA transaction ID does not match"
        )

    response = validate_transaction_binding(
        package,
        state,
        **kwargs,
    )

    manifest = verify_package(
        package,
        kwargs.get(
            "public_key",
            TRUSTED_PUBLIC_KEY,
        ),
    )

    logical_kernel = pathlib.Path(
        response["target"]["kernel"]
    )
    logical_rootfs = pathlib.Path(
        response["target"]["rootfs"]
    )

    require_targets_unmounted(
        kwargs.get("mounts_path", MOUNTS),
        (
            logical_kernel,
            logical_rootfs,
        ),
    )

    overrides = target_overrides or {}

    kernel_target = pathlib.Path(
        overrides.get(
            "kernel",
            logical_kernel,
        )
    )
    rootfs_target = pathlib.Path(
        overrides.get(
            "rootfs",
            logical_rootfs,
        )
    )

    if (
        os.path.realpath(kernel_target)
        == os.path.realpath(rootfs_target)
    ):
        raise ValueError(
            "kernel and RootFS OTA targets resolve to the same path"
        )

    kernel_size = manifest["artifact_sizes"]["kernel.uImage"]
    rootfs_size = manifest["artifact_sizes"]["rootfs.squashfs"]

    if target_capacity(
        kernel_target,
        "inactive kernel target",
        allow_regular_targets,
    ) < kernel_size:
        raise ValueError(
            "inactive kernel target is too small"
        )

    if target_capacity(
        rootfs_target,
        "inactive RootFS target",
        allow_regular_targets,
    ) < rootfs_size:
        raise ValueError(
            "inactive RootFS target is too small"
        )

    lock_path = pathlib.Path(write_lock_path)

    try:
        lock_path.parent.mkdir(
            mode=0o700,
            parents=True,
            exist_ok=True,
        )
        lock_stream = lock_path.open("a+")
    except OSError as exc:
        raise ValueError(
            "cannot open OTA write lock"
        ) from exc

    with lock_stream:
        try:
            fcntl.flock(
                lock_stream.fileno(),
                fcntl.LOCK_EX | fcntl.LOCK_NB,
            )
        except BlockingIOError as exc:
            raise ValueError(
                "another OTA write operation is active"
            ) from exc

        # RootFS first, kernel second. Activation is still untouched.
        rootfs_result = write_payload_member(
            package,
            "rootfs.squashfs",
            rootfs_target,
            rootfs_size,
            manifest["artifacts"]["rootfs.squashfs"],
            allow_regular_targets,
        )

        kernel_result = write_payload_member(
            package,
            "kernel.uImage",
            kernel_target,
            kernel_size,
            manifest["artifacts"]["kernel.uImage"],
            allow_regular_targets,
        )

    write_result = {
        "complete": True,
        "kernel": {
            "target": str(logical_kernel),
            **kernel_result,
        },
        "rootfs": {
            "target": str(logical_rootfs),
            **rootfs_result,
        },
    }

    updated = store_transaction_state(
        state,
        "written-awaiting-readback",
        pending_transaction_path,
        extra={
            "write_result": write_result,
        },
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "write",
        "package": response["package"],
        "runtime": response["runtime"],
        "target": response["target"],
        "write_result": write_result,
        "transaction": {
            "state": updated["state"],
            "transaction_id": updated["transaction_id"],
        },
    }


def sha256_target_prefix(
    path,
    size,
    description,
    allow_regular_targets=False,
):
    path = pathlib.Path(path)

    require_write_target(
        path,
        description,
        allow_regular_targets,
    )

    digest = hashlib.sha256()
    remaining = size

    try:
        with path.open("rb", buffering=0) as stream:
            while remaining:
                chunk = stream.read(
                    min(1024 * 1024, remaining)
                )

                if not chunk:
                    raise ValueError(
                        f"unexpected end of {description}: {path}"
                    )

                digest.update(chunk)
                remaining -= len(chunk)

    except OSError as exc:
        raise ValueError(
            f"cannot read {description}: {path}"
        ) from exc

    return {
        "size": size,
        "sha256": digest.hexdigest(),
    }


def readback_response(
    package,
    arguments,
    pending_transaction_path=PENDING_TRANSACTION,
    target_overrides=None,
    allow_regular_targets=False,
    **kwargs,
):
    if len(arguments) != 1:
        raise ValueError(
            "readback requires exactly one transaction ID"
        )

    transaction_id = arguments[0]

    state = load_pending_transaction(
        pending_transaction_path
    )

    if state["state"] != "written-awaiting-readback":
        raise ValueError(
            "pending OTA transaction is not awaiting readback"
        )

    if transaction_id != state["transaction_id"]:
        raise ValueError(
            "OTA transaction ID does not match"
        )

    response = validate_transaction_binding(
        package,
        state,
        **kwargs,
    )

    manifest = verify_package(
        package,
        kwargs.get(
            "public_key",
            TRUSTED_PUBLIC_KEY,
        ),
    )

    write_result = state.get("write_result")

    if (
        not isinstance(write_result, dict)
        or write_result.get("complete") is not True
    ):
        raise ValueError(
            "pending OTA write result is incomplete"
        )

    logical_kernel = pathlib.Path(
        response["target"]["kernel"]
    )
    logical_rootfs = pathlib.Path(
        response["target"]["rootfs"]
    )

    kernel_written = write_result.get("kernel")
    rootfs_written = write_result.get("rootfs")

    if (
        not isinstance(kernel_written, dict)
        or not isinstance(rootfs_written, dict)
    ):
        raise ValueError(
            "pending OTA write result is invalid"
        )

    expected_kernel_size = (
        manifest["artifact_sizes"]["kernel.uImage"]
    )
    expected_rootfs_size = (
        manifest["artifact_sizes"]["rootfs.squashfs"]
    )

    expected_kernel_digest = (
        manifest["artifacts"]["kernel.uImage"]
    )
    expected_rootfs_digest = (
        manifest["artifacts"]["rootfs.squashfs"]
    )

    if kernel_written != {
        "target": str(logical_kernel),
        "size": expected_kernel_size,
        "sha256": expected_kernel_digest,
    }:
        raise ValueError(
            "recorded kernel write result does not match package"
        )

    if rootfs_written != {
        "target": str(logical_rootfs),
        "size": expected_rootfs_size,
        "sha256": expected_rootfs_digest,
    }:
        raise ValueError(
            "recorded RootFS write result does not match package"
        )

    require_targets_unmounted(
        kwargs.get("mounts_path", MOUNTS),
        (
            logical_kernel,
            logical_rootfs,
        ),
    )

    overrides = target_overrides or {}

    kernel_target = pathlib.Path(
        overrides.get(
            "kernel",
            logical_kernel,
        )
    )
    rootfs_target = pathlib.Path(
        overrides.get(
            "rootfs",
            logical_rootfs,
        )
    )

    if (
        os.path.realpath(kernel_target)
        == os.path.realpath(rootfs_target)
    ):
        raise ValueError(
            "kernel and RootFS OTA targets resolve to the same path"
        )

    rootfs_result = sha256_target_prefix(
        rootfs_target,
        expected_rootfs_size,
        "inactive RootFS readback target",
        allow_regular_targets,
    )

    if (
        rootfs_result["sha256"]
        != expected_rootfs_digest
    ):
        raise ValueError(
            "inactive RootFS readback checksum mismatch"
        )

    kernel_result = sha256_target_prefix(
        kernel_target,
        expected_kernel_size,
        "inactive kernel readback target",
        allow_regular_targets,
    )

    if (
        kernel_result["sha256"]
        != expected_kernel_digest
    ):
        raise ValueError(
            "inactive kernel readback checksum mismatch"
        )

    readback_result = {
        "complete": True,
        "kernel": {
            "target": str(logical_kernel),
            **kernel_result,
        },
        "rootfs": {
            "target": str(logical_rootfs),
            **rootfs_result,
        },
    }

    updated = store_transaction_state(
        state,
        "readback-verified",
        pending_transaction_path,
        extra={
            "readback_result": readback_result,
        },
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "readback",
        "package": response["package"],
        "runtime": response["runtime"],
        "target": response["target"],
        "readback_result": readback_result,
        "transaction": {
            "state": updated["state"],
            "transaction_id": updated["transaction_id"],
        },
    }


def selector_payload(slot):
    if slot == "A":
        prefix = b"ota:kernel\n\n"
    elif slot == "B":
        prefix = b"ota:kernel2\n\n"
    else:
        raise ValueError(
            f"invalid selector slot: {slot}"
        )

    payload = (
        prefix
        + b"\x00" * (SELECTOR_SIZE - len(prefix))
    )

    digest = hashlib.sha256(payload).hexdigest()

    if digest != SELECTOR_HASHES[slot]:
        raise ValueError(
            f"internal selector payload mismatch for slot {slot}"
        )

    return payload


def classify_selector(payload):
    if len(payload) != SELECTOR_SIZE:
        return None

    digest = hashlib.sha256(payload).hexdigest()

    for slot, expected in SELECTOR_HASHES.items():
        if digest == expected:
            return slot

    return None


def read_selector_target(
    path,
    allow_regular_target=False,
):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"selector target is unavailable: {path}"
        ) from exc

    if path.is_symlink():
        raise ValueError(
            f"selector target must not be a symlink: {path}"
        )

    if stat.S_ISBLK(metadata.st_mode):
        pass
    elif (
        allow_regular_target
        and stat.S_ISREG(metadata.st_mode)
    ):
        pass
    else:
        raise ValueError(
            f"selector target is not a block device: {path}"
        )

    try:
        with path.open("rb", buffering=0) as stream:
            payload = stream.read(SELECTOR_SIZE)
    except OSError as exc:
        raise ValueError(
            f"cannot read selector target: {path}"
        ) from exc

    if len(payload) != SELECTOR_SIZE:
        raise ValueError(
            "cannot read exact 512-byte selector record"
        )

    slot = classify_selector(payload)

    if slot is None:
        raise ValueError(
            "current selector classification is unknown"
        )

    return {
        "slot": slot,
        "sha256": hashlib.sha256(
            payload
        ).hexdigest(),
    }


def write_selector_target(
    path,
    active_slot,
    target_slot,
    allow_regular_target=False,
):
    path = pathlib.Path(path)

    if active_slot not in ("A", "B"):
        raise ValueError(
            f"invalid active selector slot: {active_slot}"
        )

    if target_slot not in ("A", "B"):
        raise ValueError(
            f"invalid target selector slot: {target_slot}"
        )

    if active_slot == target_slot:
        raise ValueError(
            "selector target slot equals active slot"
        )

    current = read_selector_target(
        path,
        allow_regular_target,
    )

    if current["slot"] != active_slot:
        raise ValueError(
            "selector does not match the active runtime slot"
        )

    payload = selector_payload(target_slot)

    try:
        with path.open("r+b", buffering=0) as stream:
            stream.seek(0)

            view = memoryview(payload)

            while view:
                written = stream.write(view)

                if written is None or written <= 0:
                    raise ValueError(
                        "short selector write"
                    )

                view = view[written:]

            stream.flush()
            os.fsync(stream.fileno())

    except OSError as exc:
        raise ValueError(
            f"cannot write selector target: {path}"
        ) from exc

    readback = read_selector_target(
        path,
        allow_regular_target,
    )

    if (
        readback["slot"] != target_slot
        or readback["sha256"]
        != SELECTOR_HASHES[target_slot]
    ):
        raise ValueError(
            "selector readback verification failed"
        )

    return {
        "previous_slot": active_slot,
        "target_slot": target_slot,
        "size": SELECTOR_SIZE,
        "sha256": readback["sha256"],
    }


def build_activation_record(state):
    package = state.get("package")
    runtime = state.get("runtime")
    target = state.get("target")
    write_result = state.get("write_result")
    readback_result = state.get("readback_result")
    transaction_id = state.get("transaction_id")

    if (
        not isinstance(package, dict)
        or not isinstance(runtime, dict)
        or not isinstance(target, dict)
        or not isinstance(write_result, dict)
        or not isinstance(readback_result, dict)
        or write_result.get("complete") is not True
        or readback_result.get("complete") is not True
        or not isinstance(transaction_id, str)
        or re.fullmatch(
            r"[0-9a-f]{32}",
            transaction_id,
        )
        is None
    ):
        raise ValueError(
            "OTA transaction cannot prepare activation"
        )

    return {
        "api_version": API_VERSION,
        "state": "preparing",
        "transaction_id": transaction_id,
        "package": package,
        "previous_runtime": runtime,
        "target": target,
        "write_result": write_result,
        "readback_result": readback_result,
    }


def load_activation_record(
    path=ACTIVATION_RECORD,
):
    path = pathlib.Path(path)

    require_regular_file(
        path,
        "OTA activation record",
    )

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"cannot inspect OTA activation record: {path}"
        ) from exc

    if metadata.st_size > MAX_ACTIVATION_RECORD_SIZE:
        raise ValueError(
            "OTA activation record is too large"
        )

    try:
        record = json.loads(path.read_text())
    except (
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as exc:
        raise ValueError(
            "OTA activation record is invalid"
        ) from exc

    if not isinstance(record, dict):
        raise ValueError(
            "OTA activation record is invalid"
        )

    if record.get("api_version") != API_VERSION:
        raise ValueError(
            "OTA activation record API version is unsupported"
        )

    if record.get("state") not in (
        "preparing",
        "activation-prepared",
    ):
        raise ValueError(
            "OTA activation record state is invalid"
        )

    transaction_id = record.get("transaction_id")

    if (
        not isinstance(transaction_id, str)
        or re.fullmatch(
            r"[0-9a-f]{32}",
            transaction_id,
        )
        is None
    ):
        raise ValueError(
            "OTA activation record transaction ID is invalid"
        )

    return record


def write_activation_record(
    record,
    path=ACTIVATION_RECORD,
):
    path = pathlib.Path(path)
    parent = path.parent

    try:
        metadata = parent.lstat()
    except OSError as exc:
        raise ValueError(
            f"OTA activation state directory is unavailable: {parent}"
        ) from exc

    if parent.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(
            f"OTA activation state path is not a directory: {parent}"
        )

    if path.exists() or path.is_symlink():
        existing = load_activation_record(path)

        if existing == record:
            return existing

        raise ValueError(
            "another OTA activation record is already pending"
        )

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".fre3nder-ota-activation.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)

            json.dump(
                record,
                temporary,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        if path.exists() or path.is_symlink():
            raise ValueError(
                "OTA activation record appeared concurrently"
            )

        os.replace(
            temporary_path,
            path,
        )

        directory_fd = os.open(
            parent,
            os.O_RDONLY,
        )

        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    stored = load_activation_record(path)

    if stored != record:
        raise ValueError(
            "OTA activation record verification failed"
        )

    return stored


def write_target_reset_marker(
    target_root,
    marker_path=TARGET_RESET_MARKER,
    legacy_marker_path=LEGACY_RESET_MARKER,
):
    if target_root not in (
        SLOTS["A"]["rootfs"],
        SLOTS["B"]["rootfs"],
    ):
        raise ValueError(
            f"invalid targeted reset root: {target_root}"
        )

    marker_path = pathlib.Path(marker_path)
    legacy_marker_path = pathlib.Path(
        legacy_marker_path
    )

    if (
        legacy_marker_path.exists()
        or legacy_marker_path.is_symlink()
    ):
        raise ValueError(
            "legacy system reset marker is already pending"
        )

    expected = (
        f"RESET_ON_NEXT_BOOT_ROOT={target_root}\n"
    )

    if marker_path.exists() or marker_path.is_symlink():
        require_regular_file(
            marker_path,
            "targeted system reset marker",
        )

        try:
            existing = marker_path.read_text()
        except OSError as exc:
            raise ValueError(
                "cannot read targeted system reset marker"
            ) from exc

        if existing == expected:
            return

        raise ValueError(
            "different targeted system reset marker is already pending"
        )

    parent = marker_path.parent

    try:
        metadata = parent.lstat()
    except OSError as exc:
        raise ValueError(
            f"system persistence directory is unavailable: {parent}"
        ) from exc

    if parent.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(
            f"system persistence path is not a directory: {parent}"
        )

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".fre3nder-reset-target.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)
            temporary.write(expected)
            temporary.flush()
            os.fsync(temporary.fileno())

        if marker_path.exists() or marker_path.is_symlink():
            raise ValueError(
                "targeted system reset marker appeared concurrently"
            )

        os.replace(
            temporary_path,
            marker_path,
        )

        directory_fd = os.open(
            parent,
            os.O_RDONLY,
        )

        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    try:
        actual = marker_path.read_text()
    except OSError as exc:
        raise ValueError(
            "cannot verify targeted system reset marker"
        ) from exc

    if actual != expected:
        raise ValueError(
            "targeted system reset marker verification failed"
        )


def activation_record_matches(
    existing,
    expected,
):
    keys = (
        "api_version",
        "transaction_id",
        "package",
        "previous_runtime",
        "target",
        "write_result",
        "readback_result",
    )

    return all(
        existing.get(key) == expected.get(key)
        for key in keys
    )


def advance_activation_record(
    expected,
    selector_result,
    path=ACTIVATION_RECORD,
):
    path = pathlib.Path(path)

    existing = load_activation_record(path)

    if not activation_record_matches(
        existing,
        expected,
    ):
        raise ValueError(
            "OTA activation record differs from transaction"
        )

    if existing["state"] == "activation-prepared":
        if (
            existing.get("selector_result")
            != selector_result
        ):
            raise ValueError(
                "OTA activation selector result differs"
            )

        return existing

    if existing["state"] != "preparing":
        raise ValueError(
            "OTA activation record cannot advance"
        )

    updated = dict(existing)
    updated["state"] = "activation-prepared"
    updated["selector_result"] = selector_result

    parent = path.parent

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".fre3nder-ota-activation.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)

            json.dump(
                updated,
                temporary,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        os.replace(
            temporary_path,
            path,
        )

        directory_fd = os.open(
            parent,
            os.O_RDONLY,
        )

        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    stored = load_activation_record(path)

    if stored != updated:
        raise ValueError(
            "OTA activation record advance verification failed"
        )

    return stored


def validate_selector_identity(
    selector_path,
    active_root,
    mounts_path=MOUNTS,
    allow_regular_target=False,
):
    selector_path = pathlib.Path(selector_path)

    require_write_target(
        selector_path,
        "boot selector target",
        allow_regular_target,
    )

    require_targets_unmounted(
        mounts_path,
        (selector_path,),
    )

    if allow_regular_target:
        return

    if (
        os.path.realpath(selector_path)
        != str(SELECTOR_DEVICE)
    ):
        raise ValueError(
            "boot selector device identity mismatch"
        )

    selector_name = selector_path.name

    partition_file = (
        pathlib.Path("/sys/class/block")
        / selector_name
        / "partition"
    )
    start_file = (
        pathlib.Path("/sys/class/block")
        / selector_name
        / "start"
    )
    size_file = (
        pathlib.Path("/sys/class/block")
        / selector_name
        / "size"
    )

    try:
        partition_number = partition_file.read_text().strip()
        start_sector = start_file.read_text().strip()
        sector_count = size_file.read_text().strip()
    except OSError as exc:
        raise ValueError(
            "boot selector partition metadata is unavailable"
        ) from exc

    if partition_number != "1":
        raise ValueError(
            "boot selector is not partition 1"
        )

    if start_sector != "2048":
        raise ValueError(
            "boot selector start sector is unexpected"
        )

    if sector_count != "2048":
        raise ValueError(
            "boot selector partition size is unexpected"
        )

    partlabel_dir = pathlib.Path(
        "/dev/disk/by-partlabel"
    )

    if (
        partlabel_dir.exists()
        or partlabel_dir.is_symlink()
    ):
        if (
            partlabel_dir.is_symlink()
            or not partlabel_dir.is_dir()
        ):
            raise ValueError(
                "partition-label path is invalid"
            )

        ota_label = partlabel_dir / "ota"

        if not (
            ota_label.exists()
            or ota_label.is_symlink()
        ):
            raise ValueError(
                "ota partition label is absent"
            )

        if (
            os.path.realpath(ota_label)
            != str(SELECTOR_DEVICE)
        ):
            raise ValueError(
                "ota partition label does not resolve to selector"
            )

    active_root = pathlib.Path(active_root)

    if (
        os.path.realpath(active_root)
        != str(active_root)
    ):
        raise ValueError(
            "active root device identity mismatch"
        )

    root_name = active_root.name

    if root_name not in (
        "mmcblk0p7",
        "mmcblk0p8",
    ):
        raise ValueError(
            "active root is not a Fre3nder A/B root"
        )

    root_partition_file = (
        pathlib.Path("/sys/class/block")
        / root_name
        / "partition"
    )

    try:
        root_partition = (
            root_partition_file
            .read_text()
            .strip()
        )
    except OSError as exc:
        raise ValueError(
            "active root partition metadata is unavailable"
        ) from exc

    expected_root_partition = (
        "7"
        if root_name == "mmcblk0p7"
        else "8"
    )

    if root_partition != expected_root_partition:
        raise ValueError(
            "active root partition identity mismatch"
        )

    try:
        selector_sys = (
            pathlib.Path("/sys/class/block")
            / selector_name
        ).resolve(strict=True)

        root_sys = (
            pathlib.Path("/sys/class/block")
            / root_name
        ).resolve(strict=True)

    except OSError as exc:
        raise ValueError(
            "cannot resolve block-device topology"
        ) from exc

    if selector_sys.parent != root_sys.parent:
        raise ValueError(
            "boot selector and active root are not "
            "on the same block device"
        )


def verify_activation_targets(
    package,
    state,
    response,
    target_overrides=None,
    allow_regular_targets=False,
    public_key=TRUSTED_PUBLIC_KEY,
):
    manifest = verify_package(
        package,
        public_key,
    )

    readback_result = state.get(
        "readback_result"
    )

    if (
        not isinstance(readback_result, dict)
        or readback_result.get("complete") is not True
    ):
        raise ValueError(
            "pending OTA readback result is incomplete"
        )

    logical_kernel = pathlib.Path(
        response["target"]["kernel"]
    )
    logical_rootfs = pathlib.Path(
        response["target"]["rootfs"]
    )

    expected_kernel = {
        "target": str(logical_kernel),
        "size": (
            manifest["artifact_sizes"]["kernel.uImage"]
        ),
        "sha256": (
            manifest["artifacts"]["kernel.uImage"]
        ),
    }

    expected_rootfs = {
        "target": str(logical_rootfs),
        "size": (
            manifest["artifact_sizes"]["rootfs.squashfs"]
        ),
        "sha256": (
            manifest["artifacts"]["rootfs.squashfs"]
        ),
    }

    if readback_result.get("kernel") != expected_kernel:
        raise ValueError(
            "recorded kernel readback does not match package"
        )

    if readback_result.get("rootfs") != expected_rootfs:
        raise ValueError(
            "recorded RootFS readback does not match package"
        )

    require_targets_unmounted(
        response.get(
            "_mounts_path",
            MOUNTS,
        ),
        (
            logical_kernel,
            logical_rootfs,
        ),
    )

    overrides = target_overrides or {}

    kernel_target = pathlib.Path(
        overrides.get(
            "kernel",
            logical_kernel,
        )
    )
    rootfs_target = pathlib.Path(
        overrides.get(
            "rootfs",
            logical_rootfs,
        )
    )

    kernel_actual = sha256_target_prefix(
        kernel_target,
        expected_kernel["size"],
        "inactive kernel activation target",
        allow_regular_targets,
    )

    rootfs_actual = sha256_target_prefix(
        rootfs_target,
        expected_rootfs["size"],
        "inactive RootFS activation target",
        allow_regular_targets,
    )

    if (
        kernel_actual["sha256"]
        != expected_kernel["sha256"]
    ):
        raise ValueError(
            "inactive kernel target changed after readback"
        )

    if (
        rootfs_actual["sha256"]
        != expected_rootfs["sha256"]
    ):
        raise ValueError(
            "inactive RootFS target changed after readback"
        )


def prepare_activation_response(
    package,
    arguments,
    pending_transaction_path=PENDING_TRANSACTION,
    activation_record_path=ACTIVATION_RECORD,
    target_reset_marker_path=TARGET_RESET_MARKER,
    legacy_reset_marker_path=LEGACY_RESET_MARKER,
    selector_path=SELECTOR_DEVICE,
    target_overrides=None,
    allow_regular_targets=False,
    allow_regular_selector_target=False,
    **kwargs,
):
    if len(arguments) != 1:
        raise ValueError(
            "prepare-activation requires exactly "
            "one transaction ID"
        )

    transaction_id = arguments[0]

    state = load_pending_transaction(
        pending_transaction_path
    )

    if state["state"] not in (
        "readback-verified",
        "activation-prepared",
    ):
        raise ValueError(
            "pending OTA transaction is not "
            "ready for activation"
        )

    if transaction_id != state["transaction_id"]:
        raise ValueError(
            "OTA transaction ID does not match"
        )

    response = validate_transaction_binding(
        package,
        state,
        **kwargs,
    )

    # Recheck the actual inactive-slot bytes immediately
    # before making the slot bootable.
    response["_mounts_path"] = kwargs.get(
        "mounts_path",
        MOUNTS,
    )

    verify_activation_targets(
        package,
        state,
        response,
        target_overrides=target_overrides,
        allow_regular_targets=allow_regular_targets,
        public_key=kwargs.get(
            "public_key",
            TRUSTED_PUBLIC_KEY,
        ),
    )

    del response["_mounts_path"]

    expected_record = build_activation_record(
        state
    )

    activation_record_path = pathlib.Path(
        activation_record_path
    )

    if (
        activation_record_path.exists()
        or activation_record_path.is_symlink()
    ):
        activation_record = load_activation_record(
            activation_record_path
        )

        if not activation_record_matches(
            activation_record,
            expected_record,
        ):
            raise ValueError(
                "another OTA activation record "
                "is already pending"
            )

    else:
        activation_record = write_activation_record(
            expected_record,
            activation_record_path,
        )

    write_target_reset_marker(
        response["target"]["rootfs"],
        target_reset_marker_path,
        legacy_reset_marker_path,
    )

    validate_selector_identity(
        selector_path,
        response["runtime"]["active_root"],
        kwargs.get("mounts_path", MOUNTS),
        allow_regular_selector_target,
    )

    current_selector = read_selector_target(
        selector_path,
        allow_regular_selector_target,
    )

    active_slot = response["runtime"]["active_slot"]
    target_slot = response["target"]["slot"]

    if current_selector["slot"] == active_slot:
        selector_result = write_selector_target(
            selector_path,
            active_slot,
            target_slot,
            allow_regular_selector_target,
        )

    elif current_selector["slot"] == target_slot:
        # Recovery/idempotence case: selector write succeeded
        # previously but later state persistence was interrupted.
        selector_result = {
            "previous_slot": active_slot,
            "target_slot": target_slot,
            "size": SELECTOR_SIZE,
            "sha256": SELECTOR_HASHES[target_slot],
        }

    else:
        raise ValueError(
            "boot selector matches neither active "
            "nor intended target slot"
        )

    activation_record = advance_activation_record(
        expected_record,
        selector_result,
        activation_record_path,
    )

    activation_result = {
        "complete": True,
        "record": str(activation_record_path),
        "reset_marker": str(
            target_reset_marker_path
        ),
        "selector": selector_result,
    }

    updated = store_transaction_state(
        state,
        "activation-prepared",
        pending_transaction_path,
        extra={
            "activation": activation_result,
        },
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "prepare-activation",
        "package": response["package"],
        "runtime": response["runtime"],
        "target": response["target"],
        "activation": activation_result,
        "transaction": {
            "state": updated["state"],
            "transaction_id": updated["transaction_id"],
        },
    }


def require_mount_contract(
    mounts,
    mountpoint,
    filesystem,
    mode,
):
    matches = []

    for line in mounts.splitlines():
        fields = line.split()

        if len(fields) < 4:
            continue

        mounted_at = decode_mount_field(fields[1])

        if mounted_at != mountpoint:
            continue

        matches.append(
            (
                fields[2],
                fields[3].split(","),
            )
        )

    if len(matches) != 1:
        raise ValueError(
            f"runtime mount is not unique: {mountpoint}"
        )

    actual_filesystem, options = matches[0]

    if actual_filesystem != filesystem:
        raise ValueError(
            f"runtime mount has wrong filesystem: {mountpoint}"
        )

    if mode not in options:
        raise ValueError(
            f"runtime mount has wrong mode: {mountpoint}"
        )


def build_known_good_record(
    activation,
    installed_version,
    selector,
):
    package = activation["package"]
    target = activation["target"]

    return {
        "api_version": API_VERSION,
        "state": "known-good",
        "transaction_id": activation["transaction_id"],
        "version": installed_version,
        "slot": target["slot"],
        "root": target["rootfs"],
        "package": {
            "version": package["version"],
            "sha256": package["sha256"],
            "size": package["size"],
        },
        "selector": selector,
        "readback_result": activation["readback_result"],
    }


def write_known_good_record(
    record,
    path=KNOWN_GOOD_RECORD,
):
    path = pathlib.Path(path)
    parent = path.parent

    try:
        metadata = parent.lstat()
    except OSError as exc:
        raise ValueError(
            f"known-good state directory is unavailable: {parent}"
        ) from exc

    if parent.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError(
            f"known-good state path is not a directory: {parent}"
        )

    if path.exists() or path.is_symlink():
        require_regular_file(
            path,
            "known-good OTA record",
        )

    temporary = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix=".fre3nder-ota-known-good.",
        suffix=".tmp",
        dir=parent,
        delete=False,
    )
    temporary_path = pathlib.Path(temporary.name)

    try:
        with temporary:
            os.fchmod(temporary.fileno(), 0o600)
            json.dump(
                record,
                temporary,
                sort_keys=True,
            )
            temporary.write("\n")
            temporary.flush()
            os.fsync(temporary.fileno())

        os.replace(
            temporary_path,
            path,
        )

        directory_fd = os.open(
            parent,
            os.O_RDONLY,
        )

        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass
        raise

    try:
        stored = json.loads(path.read_text())
    except (
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as exc:
        raise ValueError(
            "cannot verify known-good OTA record"
        ) from exc

    if stored != record:
        raise ValueError(
            "known-good OTA record verification failed"
        )

    return stored


def complete_activation_record(
    activation_record_path,
):
    path = pathlib.Path(activation_record_path)
    parent = path.parent

    try:
        path.unlink()
    except OSError as exc:
        raise ValueError(
            "cannot remove completed OTA activation record"
        ) from exc

    directory_fd = os.open(
        parent,
        os.O_RDONLY,
    )

    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def postboot_response(
    activation_record_path=ACTIVATION_RECORD,
    known_good_path=KNOWN_GOOD_RECORD,
    installed_version_path=INSTALLED_VERSION,
    root_status_path=ROOT_STATUS,
    cmdline_path=CMDLINE,
    mounts_path=MOUNTS,
    selector_path=SELECTOR_DEVICE,
    target_reset_marker_path=TARGET_RESET_MARKER,
    allow_regular_selector_target=False,
):
    activation = load_activation_record(
        activation_record_path
    )

    if activation["state"] not in (
        "preparing",
        "activation-prepared",
    ):
        raise ValueError(
            "OTA activation is not valid for post-boot validation"
        )

    root_status = read_single_line(
        root_status_path,
        "Fre3nder root status",
    )

    if root_status != "active":
        raise ValueError(
            f"Fre3nder writable runtime is not active: {root_status}"
        )

    try:
        cmdline = pathlib.Path(
            cmdline_path
        ).read_text().strip()
    except OSError as exc:
        raise ValueError(
            "cannot read kernel command line"
        ) from exc

    active_slot, _inactive_slot, active_root = (
        discover_active_slot(cmdline)
    )

    target = activation.get("target")

    if not isinstance(target, dict):
        raise ValueError(
            "OTA activation target is invalid"
        )

    if (
        active_slot != target.get("slot")
        or active_root != target.get("rootfs")
    ):
        raise ValueError(
            "booted slot does not match OTA activation target"
        )

    installed_version = read_single_line(
        installed_version_path,
        "installed Fre3nder version",
    )

    package = activation.get("package")

    if (
        not isinstance(package, dict)
        or installed_version != package.get("version")
    ):
        raise ValueError(
            "booted Fre3nder version does not match OTA target"
        )

    try:
        mounts = pathlib.Path(
            mounts_path
        ).read_text()
    except OSError as exc:
        raise ValueError(
            "cannot read mount table"
        ) from exc

    require_mount_contract(
        mounts,
        "/",
        "overlay",
        "rw",
    )

    require_mount_contract(
        mounts,
        "/rom",
        "squashfs",
        "ro",
    )

    require_mount_contract(
        mounts,
        HOME_MOUNT,
        "ext4",
        "rw",
    )

    require_mount_contract(
        mounts,
        SYS_MOUNT,
        "ext4",
        "rw",
    )

    marker = pathlib.Path(
        target_reset_marker_path
    )

    if marker.exists() or marker.is_symlink():
        raise ValueError(
            "targeted system reset marker was not consumed"
        )

    validate_selector_identity(
        selector_path,
        active_root,
        mounts_path,
        allow_regular_selector_target,
    )

    selector = read_selector_target(
        selector_path,
        allow_regular_selector_target,
    )

    if selector["slot"] != active_slot:
        raise ValueError(
            "boot selector does not match booted OTA slot"
        )

    previous_runtime = activation.get(
        "previous_runtime"
    )

    if (
        not isinstance(previous_runtime, dict)
        or previous_runtime.get("active_slot")
        not in ("A", "B")
        or previous_runtime.get("active_root")
        != SLOTS[
            previous_runtime.get("active_slot")
        ]["rootfs"]
        or previous_runtime.get("active_slot")
        == active_slot
    ):
        raise ValueError(
            "previous OTA runtime state is invalid"
        )

    selector_result = activation.get(
        "selector_result"
    )

    if activation["state"] == "preparing":
        # Power-loss recovery: the persistent record may still
        # say "preparing" although the selector write completed.
        # Reaching the intended target root with its exact known
        # selector proves that activation crossed that boundary.
        selector_result = {
            "previous_slot": (
                previous_runtime["active_slot"]
            ),
            "target_slot": active_slot,
            "size": SELECTOR_SIZE,
            "sha256": selector["sha256"],
        }

    if (
        not isinstance(selector_result, dict)
        or selector_result.get("previous_slot")
        != previous_runtime["active_slot"]
        or selector_result.get("target_slot")
        != active_slot
        or selector_result.get("size")
        != SELECTOR_SIZE
        or selector_result.get("sha256")
        != selector["sha256"]
    ):
        raise ValueError(
            "boot selector differs from prepared OTA activation"
        )

    known_good = build_known_good_record(
        activation,
        installed_version,
        selector,
    )

    write_known_good_record(
        known_good,
        known_good_path,
    )

    complete_activation_record(
        activation_record_path
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "postboot",
        "state": "known-good",
        "version": installed_version,
        "slot": active_slot,
        "root": active_root,
        "transaction_id": activation["transaction_id"],
        "known_good_record": str(
            known_good_path
        ),
    }


def verify_prepared_activation(
    state,
    activation_record_path=ACTIVATION_RECORD,
    target_reset_marker_path=TARGET_RESET_MARKER,
    selector_path=SELECTOR_DEVICE,
    mounts_path=MOUNTS,
    allow_regular_selector_target=False,
):
    if state.get("state") != "activation-prepared":
        raise ValueError(
            "OTA transaction is not prepared for reboot"
        )

    activation = load_activation_record(
        activation_record_path
    )

    if activation.get("state") != "activation-prepared":
        raise ValueError(
            "persistent OTA activation is not prepared"
        )

    expected = build_activation_record(state)

    if not activation_record_matches(
        activation,
        expected,
    ):
        raise ValueError(
            "persistent OTA activation differs from transaction"
        )

    selector_result = activation.get(
        "selector_result"
    )

    if not isinstance(selector_result, dict):
        raise ValueError(
            "persistent OTA selector result is missing"
        )

    target = state.get("target")
    runtime = state.get("runtime")

    if (
        not isinstance(target, dict)
        or not isinstance(runtime, dict)
    ):
        raise ValueError(
            "OTA transaction runtime state is invalid"
        )

    target_slot = target.get("slot")
    active_root = runtime.get("active_root")

    if (
        target_slot not in ("A", "B")
        or active_root
        not in (
            SLOTS["A"]["rootfs"],
            SLOTS["B"]["rootfs"],
        )
    ):
        raise ValueError(
            "OTA transaction slot state is invalid"
        )

    if (
        selector_result.get("target_slot")
        != target_slot
        or selector_result.get("sha256")
        != SELECTOR_HASHES[target_slot]
    ):
        raise ValueError(
            "prepared selector result does not match target slot"
        )

    marker = pathlib.Path(
        target_reset_marker_path
    )

    require_regular_file(
        marker,
        "targeted system reset marker",
    )

    try:
        marker_value = marker.read_text()
    except OSError as exc:
        raise ValueError(
            "cannot read targeted system reset marker"
        ) from exc

    expected_marker = (
        "RESET_ON_NEXT_BOOT_ROOT="
        f"{target['rootfs']}\n"
    )

    if marker_value != expected_marker:
        raise ValueError(
            "targeted system reset marker does not match OTA target"
        )

    validate_selector_identity(
        selector_path,
        active_root,
        mounts_path,
        allow_regular_selector_target,
    )

    selector = read_selector_target(
        selector_path,
        allow_regular_selector_target,
    )

    if (
        selector["slot"] != target_slot
        or selector["sha256"]
        != SELECTOR_HASHES[target_slot]
    ):
        raise ValueError(
            "boot selector no longer matches prepared OTA target"
        )

    return activation


def reboot_response(
    arguments,
    pending_transaction_path=PENDING_TRANSACTION,
    activation_record_path=ACTIVATION_RECORD,
    target_reset_marker_path=TARGET_RESET_MARKER,
    selector_path=SELECTOR_DEVICE,
    mounts_path=MOUNTS,
    reboot_command=REBOOT_COMMAND,
    allow_regular_selector_target=False,
):
    if len(arguments) != 1:
        raise ValueError(
            "reboot requires exactly one transaction ID"
        )

    transaction_id = arguments[0]

    state = load_pending_transaction(
        pending_transaction_path
    )

    if transaction_id != state.get("transaction_id"):
        raise ValueError(
            "OTA transaction ID does not match"
        )

    activation = verify_prepared_activation(
        state,
        activation_record_path,
        target_reset_marker_path,
        selector_path,
        mounts_path,
        allow_regular_selector_target,
    )

    try:
        os.sync()
    except OSError as exc:
        raise ValueError(
            "cannot synchronize filesystems before reboot"
        ) from exc

    reboot_command = pathlib.Path(
        reboot_command
    )

    try:
        result = subprocess.run(
            [str(reboot_command)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise ValueError(
            f"cannot execute reboot command: {reboot_command}"
        ) from exc

    if result.returncode != 0:
        raise ValueError(
            "reboot command failed"
        )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "reboot",
        "state": "reboot-requested",
        "transaction_id": transaction_id,
        "target": activation["target"],
    }


def backup_response(
    package,
    arguments,
    home_source=None,
    sys_source=None,
    home_backup_directory=None,
    usb_backup_directory=None,
    pending_transaction_path=PENDING_TRANSACTION,
    activation_record_path=ACTIVATION_RECORD,
    backup_core=BACKUP_CORE,
    **kwargs,
):
    pending_transaction_path = pathlib.Path(
        pending_transaction_path
    )

    ensure_new_transaction_available(
        pending_transaction_path,
        activation_record_path,
    )

    response = preflight_response(
        package,
        backup_core=backup_core,
        **kwargs,
    )

    execution = backup_execute(
        response["runtime"]["installed_version"],
        arguments,
        expected_usb=response["runtime_usb"],
        home_source=home_source,
        sys_source=sys_source,
        home_backup_directory=home_backup_directory,
        usb_backup_directory=usb_backup_directory,
        usb_helper=kwargs.get(
            "usb_helper"
        ),
        backup_core=backup_core,
    )

    response["operation"] = "backup"
    response["runtime_usb"] = execution[
        "runtime_usb"
    ]
    response["backup_offer"] = execution[
        "backup_offer"
    ]
    response["backup_selection"] = execution[
        "backup_selection"
    ]
    response["backup_result"] = execution[
        "backup_result"
    ]

    response["confirmation"] = (
        write_pending_transaction(
            package,
            response,
            pending_transaction_path,
        )
    )

    return response


def backup_plan_response(
    package,
    arguments,
    backup_core=BACKUP_CORE,
    **kwargs,
):
    response = preflight_response(
        package,
        backup_core=backup_core,
        **kwargs,
    )

    planned = backup_plan(
        arguments,
        usb_helper=kwargs.get(
            "usb_helper"
        ),
        backup_core=backup_core,
    )

    response["operation"] = "backup-plan"
    response["runtime_usb"] = planned[
        "runtime_usb"
    ]
    response["backup_offer"] = planned[
        "backup_offer"
    ]
    response["backup_selection"] = planned[
        "backup_selection"
    ]

    return response


def error_response(operation, message):
    return {
        "api_version": API_VERSION,
        "ok": False,
        "operation": operation,
        "error": str(message),
    }


def main():
    if (
        len(sys.argv) == 3
        and sys.argv[1] == "reboot"
    ):
        try:
            response = reboot_response(
                [sys.argv[2]]
            )
        except (OSError, ValueError) as exc:
            print(
                json.dumps(
                    error_response(
                        "reboot",
                        exc,
                    ),
                    sort_keys=True,
                )
            )
            return 1

        print(
            json.dumps(
                response,
                sort_keys=True,
            )
        )
        return 0

    if (
        len(sys.argv) == 2
        and sys.argv[1] == "postboot"
    ):
        try:
            response = postboot_response()
        except (OSError, ValueError) as exc:
            print(
                json.dumps(
                    error_response(
                        "postboot",
                        exc,
                    ),
                    sort_keys=True,
                )
            )
            return 1

        print(
            json.dumps(
                response,
                sort_keys=True,
            )
        )
        return 0

    if len(sys.argv) < 3 or sys.argv[1] not in (
        "verify",
        "preflight",
        "backup-plan",
        "backup",
        "confirm",
        "write",
        "readback",
        "prepare-activation",
    ):
        print(
            json.dumps(
                error_response(
                    None,
                    "usage: fre3nder-ota-core "
                    "{verify|preflight|backup-plan|backup|confirm|write|readback|prepare-activation} "
                    "<package.ota> [options]",
                ),
                sort_keys=True,
            )
        )
        return 2

    operation = sys.argv[1]
    package = sys.argv[2]
    arguments = sys.argv[3:]

    if operation in ("verify", "preflight") and arguments:
        print(
            json.dumps(
                error_response(
                    operation,
                    f"{operation} does not accept additional arguments",
                ),
                sort_keys=True,
            )
        )
        return 2

    try:
        if operation == "verify":
            response = verify_response(package)
        elif operation == "preflight":
            response = preflight_response(package)
        elif operation == "backup-plan":
            response = backup_plan_response(package, arguments)
        elif operation == "backup":
            response = backup_response(package, arguments)
        elif operation == "confirm":
            response = confirm_response(package, arguments)
        elif operation == "write":
            response = write_response(package, arguments)
        elif operation == "readback":
            response = readback_response(package, arguments)
        else:
            response = prepare_activation_response(
                package,
                arguments,
            )
    except (OSError, ValueError) as exc:
        print(json.dumps(error_response(operation, exc), sort_keys=True))
        return 1

    print(json.dumps(response, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
