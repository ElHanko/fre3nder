    os.environ.get(
        "FRE3NDER_BACKUP_VERSION_FILE",
        "/usr/share/fre3nder/VERSION",
    )
)

HOME_SOURCE = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_HOME_SOURCE",
        "/home",
    )
)
SYS_SOURCE = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_SYS_SOURCE",
        "/run/fre3nder-root/system/upper",
    )
)

USB_MOUNT = "/run/fre3nder/usb"
USB_HELPER = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_USB_HELPER",
        pathlib.Path(__file__).resolve().with_name(
            "usb"
        ),
    )
)

HOME_BACKUP_DIRECTORY = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_HOME_DIRECTORY",
        "/home/Fre3nderBackup",
    )
)
USB_BACKUP_DIRECTORY = pathlib.Path(
    os.environ.get(
        "FRE3NDER_BACKUP_USB_DIRECTORY",
        "/run/fre3nder/usb/Fre3nderBackup",
    )
)
STAGING_DIRECTORY = pathlib.Path(os.environ.get(
    "FRE3NDER_BACKUP_STAGING_DIRECTORY", "/home/.tmp/backup"
))
OPERATION_LOCK = pathlib.Path(os.environ.get(
    "FRE3NDER_BACKUP_LOCK_PATH", "/run/fre3nder/ota/write.lock"
))
SPACE_RESERVE = 32 * 1024 * 1024


@contextlib.contextmanager
def operation_lock():
    """OTA passes its open lock description; never acquire a nested lock."""
    inherited = os.environ.get("FRE3NDER_BACKUP_LOCK_FD")
    OPERATION_LOCK.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    require_directory(OPERATION_LOCK.parent, "operation lock directory")
    fd = (os.dup(int(inherited)) if inherited is not None else
          os.open(OPERATION_LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600))
    try:
        metadata = os.fstat(fd)
        expected = OPERATION_LOCK.lstat()
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid()
                or metadata.st_mode & 0o022
                or (metadata.st_dev, metadata.st_ino) != (expected.st_dev, expected.st_ino)):
            raise ValueError("unsafe backup operation lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ValueError("another OTA/app/backup operation is active") from exc
        yield
    finally:
        os.close(fd)


def staging_directory(path):
    path = pathlib.Path(path)
    # HOME and .tmp are root-controlled by the runtime storage layer.
    for parent in reversed((path, *path.parents)):
        if not parent.exists() and parent in (path, path.parent):
            parent.mkdir(mode=0o700)
        metadata = require_directory(parent, "backup staging directory")
        if parent in (path, path.parent) and (
                metadata.st_uid != os.geteuid() or metadata.st_mode & 0o022):
            raise ValueError("backup staging is not root-controlled")
    os.chmod(path, 0o700)
    return path


def require_space(directory, size):
    fs = os.statvfs(directory)
    if fs.f_bavail * fs.f_frsize < size + SPACE_RESERVE:
        raise ValueError("insufficient backup space including operating reserve")


def sha256_stream(stream):
    digest = hashlib.sha256()
    size = 0

    for chunk in iter(
        lambda: stream.read(1024 * 1024),
        b"",
    ):
        digest.update(chunk)
        size += len(chunk)

    return digest.hexdigest(), size


def require_regular_file(path, description):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"{description} is missing: {path}"
        ) from exc

    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
    ):
        raise ValueError(
            f"{description} must be a regular "
            f"non-symlink file: {path}"
        )

    return metadata


def require_directory(path, description):
    path = pathlib.Path(path)

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise ValueError(
            f"{description} is missing: {path}"
        ) from exc

    if (
        path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
    ):
        raise ValueError(
            f"{description} must be a directory, "
            f"not a symlink: {path}"
        )

    return metadata


def ensure_backup_directory(path):
    path = pathlib.Path(path)

    if path.exists() or path.is_symlink():
        require_directory(
            path,
            "backup directory",
        )
        return path

    try:
        path.mkdir(mode=0o700)
    except OSError as exc:
        raise ValueError(
            f"cannot create backup directory: {path}"
        ) from exc

    return path


def add_backup_tree(
    archive,
    source,
    arcname,
    root_device,
    excluded_paths=(),
    estimate=False,
):
    source = pathlib.Path(source)

    if source in excluded_paths:
        return 0

    try:
        metadata = source.lstat()
    except OSError as exc:
        raise ValueError(
            f"cannot inspect backup source: {source}"
        ) from exc

    if metadata.st_dev != root_device:
        return 0

    info = archive.gettarinfo(
        str(source),
        arcname=arcname,
    )

    if info is None:
        return 0

    size = len(info.tobuf(format=tarfile.PAX_FORMAT)) if estimate else 0
    if estimate and info.isfile():
        size += (info.size + 511) // 512 * 512

    if info.isfile() and not estimate:
        try:
            with source.open("rb") as stream:
                archive.addfile(
                    info,
                    stream,
                )
        except OSError as exc:
            raise ValueError(
                f"cannot read backup source: {source}"
            ) from exc

        return size

    if not estimate:
        archive.addfile(info)

    if not info.isdir():
        return size

    try:
        children = sorted(
            source.iterdir(),
            key=lambda child: child.name,
        )
    except OSError as exc:
        raise ValueError(
            f"cannot read backup source: {source}"
        ) from exc

    for child in children:
        try:
            child_metadata = child.lstat()
        except OSError as exc:
            raise ValueError(
                f"cannot inspect backup source: {child}"
            ) from exc

        if child_metadata.st_dev != root_device:
            continue

        size += add_backup_tree(
            archive,
            child,
            f"{arcname}/{child.name}",
            root_device,
            excluded_paths,
            estimate,
        )

    return size


def estimated_archive_size(source, role, excludes):
    metadata = require_directory(source, f"{role} backup source")
    with tarfile.open(fileobj=io.BytesIO(), mode="w", format=tarfile.PAX_FORMAT) as archive:
        size = add_backup_tree(archive, source, role.lower(), metadata.st_dev, excludes, estimate=True)
    # TAR records, plus headroom for source changes between inspection and read.
    return ((size + 1024) // 10240 + 1) * 10240 * 105 // 100


def rename_no_replace(source, destination):
    """Linux atomic publication, including filesystems without hard links."""
    import ctypes

    try:
        rename = ctypes.CDLL(None, use_errno=True).renameat2
    except AttributeError as exc:
        raise ValueError("atomic no-replace backup publication is unavailable") from exc
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    # AT_FDCWD and RENAME_NOREPLACE from the Linux/glibc interface.
    if rename(-100, os.fsencode(source), -100, os.fsencode(destination), 1) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), str(destination))


def create_backup_archive(
    source,
    target_directory,
    role,
    version,
    excluded_paths=(),
):
    source = pathlib.Path(source)
    target_directory = pathlib.Path(
        target_directory
    )

    if role not in ROLES:
        raise ValueError(
            f"unsupported backup role: {role}"
        )

    excluded_paths = tuple(
        pathlib.Path(item)
        for item in excluded_paths
    )

    source_metadata = require_directory(
        source,
        f"{role} backup source",
    )

    ensure_backup_directory(
        target_directory
    )

    safe_version = re.sub(
        r"[^A-Za-z0-9._-]+",
        "_",
        version,
    )

    if not safe_version:
        raise ValueError(
            "version is invalid for backup filename"
        )

    stamp = time.strftime(
        "%Y%m%dT%H%M%SZ",
        time.gmtime(),
    )

    filename = (
        f"fre3nder-{role.lower()}-"
        f"{safe_version}-{stamp}.tar"
    )

    archive_path = (
        target_directory / filename
    )

    if (
        archive_path.exists()
        or archive_path.is_symlink()
    ):
        raise ValueError(
            f"backup archive already exists: "
            f"{archive_path}"
        )

    temporary = tempfile.NamedTemporaryFile(
        mode="w+b",
        prefix=f".{filename}.",
        suffix=".tmp",
        dir=target_directory,
        delete=False,
    )

    temporary_path = pathlib.Path(
        temporary.name
    )

    try:
        with temporary:
            with tarfile.open(
                fileobj=temporary,
                mode="w",
                format=tarfile.PAX_FORMAT,
            ) as archive:
                add_backup_tree(
                    archive,
                    source,
                    role.lower(),
                    source_metadata.st_dev,
                    excluded_paths,
                )

            temporary.flush()
            os.fsync(
                temporary.fileno()
            )

        if (
            archive_path.exists()
            or archive_path.is_symlink()
        ):
            raise ValueError(
                f"backup archive already exists: "
                f"{archive_path}"
            )

        rename_no_replace(temporary_path, archive_path)

    except Exception:
        try:
            temporary_path.unlink()
        except OSError:
            pass

        raise

    try:
        with archive_path.open(
            "rb"
        ) as stream:
            digest, size = sha256_stream(
                stream
            )
    except OSError as exc:
        archive_path.unlink(missing_ok=True)
        raise ValueError(
            "cannot verify created backup "
            f"archive: {archive_path}"
        ) from exc

    return {
        "role": role,
        "archive": str(archive_path),
        "size": size,
        "sha256": digest,
    }


def verify_backup_archive(
    archive,
    expected_size,
    expected_sha256,
    *,
    stream=None,
):
    archive = pathlib.Path(archive)

    metadata = (require_regular_file(archive, "backup archive") if stream is None
                else os.fstat(stream.fileno()))
    if not stat.S_ISREG(metadata.st_mode):
        raise ValueError("backup archive must be a regular file")

    if metadata.st_size != expected_size:
        raise ValueError(
            "backup archive size mismatch"
        )

    try:
        with (archive.open("rb") if stream is None else contextlib.nullcontext(stream)) as stream:
            stream.seek(0)
            digest, size = sha256_stream(
                stream
            )
    except OSError as exc:
        raise ValueError(
            f"cannot read backup archive: {archive}"
        ) from exc

    if size != expected_size:
        raise ValueError(
            "backup archive size mismatch"
        )

    if digest != expected_sha256:
        raise ValueError(
            "backup archive checksum mismatch"
        )

    return {
        "archive": str(archive),
        "size": size,
        "sha256": digest,
        "status": "valid",
    }


def parse_runtime_usb_status(text):
    values = {}

    for line in text.splitlines():
        if not line:
            continue

        key, separator, value = line.partition("=")

        if (
            not separator
            or not key
            or key in values
        ):
            raise ValueError(
                "runtime USB helper returned invalid status"
            )

        values[key] = value

    if values.get("api_version") != "1":
        raise ValueError(
            "unsupported runtime USB status API version"
        )

    status = values.get("status")

    if not status:
        raise ValueError(
            "runtime USB helper returned no status"
        )

    return values


def runtime_usb_state(values):
    status = values["status"]

    if status != "mounted":
        return {
            "available": False,
            "status": status,
            "mount": None,
        }

    mount = values.get("mount")
    source = values.get("source")
    filesystem = values.get("filesystem")
    writable = values.get("writable")

    if (
        mount != USB_MOUNT
        or not source
        or not filesystem
        or writable not in ("true", "false")
    ):
        return {
            "available": False,
            "status": "mount-mismatch",
            "mount": None,
        }

    supported_filesystems = {
        "vfat",
        "exfat",
        "ext4",
        "ntfs3",
    }

    if filesystem not in supported_filesystems:
        return {
            "available": False,
            "status": "unsupported-filesystem",
            "mount": None,
        }

    if writable != "true":
        return {
            "available": False,
            "status": "not-writable",
            "mount": None,
        }

    return {
        "available": True,
        "status": "mounted",
        "mount": mount,
        "source": source,
        "filesystem": filesystem,
        "backup_available": (
            filesystem != "vfat"
        ),
    }


def read_runtime_usb_state(
    usb_helper=USB_HELPER,
):
    try:
        result = subprocess.run(
            [
                str(usb_helper),
                "status",
            ],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise ValueError(
            "cannot execute runtime USB helper"
        ) from exc

    if result.returncode != 0:
        raise ValueError(
            "runtime USB helper failed"
        )

    return runtime_usb_state(
        parse_runtime_usb_status(
            result.stdout
        )
    )


def build_backup_offer(
    usb,
    home_backup_directory=HOME_BACKUP_DIRECTORY,
    usb_backup_directory=USB_BACKUP_DIRECTORY,
):
    usb_available = usb.get(
        "backup_available",
        False,
    )

    return {
        "selection_required": True,
        "home": {
            "role": "HOME",
            "offered": True,
            "required": False,
            "targets": (
                ["download", "usb"]
                if usb_available
                else ["download"]
            ),
        },
        "sys": {
            "role": "SYS",
            "offered": True,
            "required": False,
            "targets": (
                ["download", "usb", "home"]
                if usb_available
                else ["download", "home"]
            ),
        },
        "targets": {
            "download": {"available": True, "path": str(STAGING_DIRECTORY)},
            "home": {
                "available": True,
                "path": str(
                    home_backup_directory
                ),
            },
            "usb": {
                "available": usb_available,
                "path": (
                    str(
                        usb_backup_directory
                    )
                    if usb_available
                    else None
                ),
            },
        },
    }


def parse_backup_plan_args(
    arguments,
    backup_offer,
):
    home = None
    sys_backup = None
    index = 0

    while index < len(arguments):
        argument = arguments[index]

        if argument == "--home":
            if home is not None:
                raise ValueError(
                    "HOME backup selection "
                    "specified more than once"
                )

            target = "usb"  # Preserve the existing bare --home interface.
            if index + 1 < len(arguments) and not arguments[index + 1].startswith("--"):
                target = arguments[index + 1]
                index += 1
            if target not in ("usb", "download"):
                raise ValueError("HOME backup target must be usb or download")
            home = {
                "selected": True,
                "target": target,
            }

            index += 1
            continue

        if argument == "--no-home":
            if home is not None:
                raise ValueError(
                    "HOME backup selection "
                    "specified more than once"
                )

            home = {
                "selected": False,
                "target": None,
            }

            index += 1
            continue

        if argument == "--sys":
            if sys_backup is not None:
                raise ValueError(
                    "SYS backup selection "
                    "specified more than once"
                )

            if index + 1 >= len(arguments):
                raise ValueError(
                    "--sys requires target download, usb or home"
                )

            target = arguments[index + 1]

            if target not in (
                "download",
                "usb",
                "home",
            ):
                raise ValueError(
                    "SYS backup target must "
                    "be download, usb or home"
                )

            sys_backup = {
                "selected": True,
                "target": target,
            }

            index += 2
            continue

        if argument == "--no-sys":
            if sys_backup is not None:
                raise ValueError(
                    "SYS backup selection "
                    "specified more than once"
                )

            sys_backup = {
                "selected": False,
                "target": None,
            }

            index += 1
            continue

        raise ValueError(
            "unsupported backup selection "
            f"argument: {argument}"
        )

    if home is None:
        raise ValueError(
            "HOME backup must be explicitly "
            "selected or declined"
        )

    if sys_backup is None:
        raise ValueError(
            "SYS backup must be explicitly "
            "selected or declined"
        )

    if home["selected"]:
        home_offer = backup_offer["home"]

        if (
            home_offer["offered"] is not True
            or home["target"]
            not in home_offer["targets"]
        ):
            raise ValueError(
                f"HOME backup target {home['target']} is not available"
            )

    if sys_backup["selected"]:
        if (
            sys_backup["target"]
            not in backup_offer["sys"]["targets"]
        ):
            raise ValueError(
                "SYS backup target "
                f"{sys_backup['target']} "
                "is not available"
            )

    return {
        "home": home,
        "sys": sys_backup,
    }


def backup_offer_response(
    usb_helper=USB_HELPER,
    home_backup_directory=HOME_BACKUP_DIRECTORY,
    usb_backup_directory=USB_BACKUP_DIRECTORY,
):
    usb = read_runtime_usb_state(
        usb_helper,
    )

    offer = build_backup_offer(
        usb,
        home_backup_directory,
        usb_backup_directory,
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "offer",
        "runtime_usb": usb,
        "backup_offer": offer,
    }


def backup_plan_response(
    arguments,
    usb_helper=USB_HELPER,
    home_backup_directory=HOME_BACKUP_DIRECTORY,
    usb_backup_directory=USB_BACKUP_DIRECTORY,
):
    response = backup_offer_response(
        usb_helper,
        home_backup_directory,
        usb_backup_directory,
    )

    selection = parse_backup_plan_args(
        arguments,
        response["backup_offer"],
    )

    response["operation"] = "plan"
    response["backup_selection"] = {
        "complete": True,
        "home": selection["home"],
        "sys": selection["sys"],
    }

    return response


def read_installed_version(
    path=INSTALLED_VERSION,
):
    path = pathlib.Path(path)

    try:
        value = path.read_text().strip()
    except OSError as exc:
        raise ValueError(
            f"cannot read installed Fre3nder version: {path}"
        ) from exc

    if (
        not value
        or "\n" in value
        or "\r" in value
    ):
        raise ValueError(
            "installed Fre3nder version is invalid"
        )

    return value


def publish_backup(created, directory, check_target=lambda: None, move=False):
    """Publish only complete, verified data; partial copies have private names."""
    source = pathlib.Path(created["archive"])
    directory = ensure_backup_directory(directory)
    destination = directory / source.name
    if destination.exists() or destination.is_symlink():
        raise ValueError(f"backup archive already exists: {destination}")
    partial = None
    published = False
    # Pin the selected directory while USB may be removed or replaced. Cleanup
    # must never follow the mountpoint onto a newly inserted volume.
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    pinned_directory = pathlib.Path(f"/proc/self/fd/{directory_fd}")
    published_path = pinned_directory / source.name
    try:
        check_target()
        pinned = os.fstat(directory_fd)
        current = directory.stat()
        if (pinned.st_dev, pinned.st_ino) != (current.st_dev, current.st_ino):
            raise ValueError("backup destination changed during publication")
        if move and source.stat().st_dev == directory.stat().st_dev:
            rename_no_replace(source, published_path)
            published = True
        else:
            require_space(directory, created["size"])
            with tempfile.NamedTemporaryFile(mode="wb", dir=pinned_directory,
                    prefix=".backup-", suffix=".part", delete=False) as output:
                partial = pathlib.Path(output.name)
                with source.open("rb") as stream:
                    shutil.copyfileobj(stream, output, 1024 * 1024)
                output.flush()
                os.fsync(output.fileno())
            check_target()
            verify_backup_archive(partial, created["size"], created["sha256"])
            require_space(directory, 0)
            check_target()
            rename_no_replace(partial, published_path)
            published = True
        check_target()
        verify_backup_archive(published_path, created["size"], created["sha256"])
        require_space(directory, 0)
        os.fsync(directory_fd)
        check_target()
        return {**created, "archive": str(destination), "verified": True}
    except Exception:
        if published:
            published_path.unlink(missing_ok=True)
        raise
    finally:
        if partial is not None:
            partial.unlink(missing_ok=True)
        os.close(directory_fd)


def execute_backup(
    version,
    arguments,
    home_source=HOME_SOURCE,
    sys_source=SYS_SOURCE,
    home_backup_directory=HOME_BACKUP_DIRECTORY,
    usb_backup_directory=USB_BACKUP_DIRECTORY,
    usb_helper=USB_HELPER,
    expected_usb=None,
    staging=STAGING_DIRECTORY,
):
    initial_usb = read_runtime_usb_state(usb_helper)
    offer = build_backup_offer(initial_usb, home_backup_directory, usb_backup_directory)
    selection = parse_backup_plan_args(arguments, offer)
    usb_selected = any(value["selected"] and value["target"] == "usb"
                       for value in selection.values())

    def check_usb():
        current = read_runtime_usb_state(usb_helper)
        if current.get("backup_available") is not True:
            raise ValueError("backup-capable runtime USB volume is no longer available")
        if any(current.get(key) != initial_usb.get(key) for key in ("source", "filesystem")):
            raise ValueError("runtime USB volume changed after backup planning")

    if usb_selected:
        if expected_usb is not None and (not isinstance(expected_usb, dict) or any(
                initial_usb.get(key) != expected_usb.get(key) for key in ("source", "filesystem"))):
            raise ValueError("runtime USB volume changed after preflight")
        check_usb()

    home_source, sys_source = pathlib.Path(home_source), pathlib.Path(sys_source)
    if any(value["selected"] for value in selection.values()):
        staging = staging_directory(staging)
    result = {"complete": False, **{role: dict(value) for role, value in selection.items()}}
    retained = []
    try:
        # HOME first; both temporary data and existing permanent backups are excluded.
        for role, source, excludes in (
            ("home", home_source, (home_source / ".tmp", home_source / "Fre3nderBackup")),
            ("sys", sys_source, (sys_source / "ota" / "packages",)),
        ):
            if not selection[role]["selected"]:
                continue
            target = selection[role]["target"]
            size = estimated_archive_size(source, role.upper(), excludes)
            require_space(staging, size)
            directory = None
            if target != "download":
                if target == "usb":
                    check_usb()
                directory = ensure_backup_directory(
                    usb_backup_directory if target == "usb" else home_backup_directory)
                identity = directory.stat()
                same_fs = identity.st_dev == staging.stat().st_dev
                require_space(directory, size * (2 if same_fs and target == "usb" else 1))

            work = pathlib.Path(tempfile.mkdtemp(prefix="job-", dir=staging))
            keep = False
            try:
                created = create_backup_archive(source, work, role.upper(), version, excludes)
                verify_backup_archive(created["archive"], created["size"], created["sha256"])
                require_space(staging, 0)
                if target == "download":
                    result[role].update(created, verified=True)
                    retained.append(work)
                    keep = True
                else:
                    def check_target():
                        if target == "usb":
                            check_usb()
                        current = require_directory(directory, "backup destination")
                        if (current.st_dev, current.st_ino) != (identity.st_dev, identity.st_ino):
                            raise ValueError("backup destination changed during backup")

                    result[role].update(publish_backup(
                        created, directory, check_target, move=target == "home"))
            finally:
                if not keep:
                    shutil.rmtree(work)
        result["complete"] = True
    except Exception:
        for work in retained:
            shutil.rmtree(work)
        raise
    return {
        "runtime_usb": initial_usb,
        "backup_offer": offer,
        "backup_selection": {"complete": True, **selection},
        "backup_result": result,
    }


def execute_response(arguments, expected_usb=None):
    version = os.environ.get(
        "FRE3NDER_BACKUP_VERSION"
    )

    if version is None:
        version = read_installed_version()

    elif (
        not version
        or "\n" in version
        or "\r" in version
    ):
        raise ValueError(
            "backup version is invalid"
        )

    expected_source = os.environ.get(
        "FRE3NDER_BACKUP_EXPECTED_USB_SOURCE"
    )
    expected_filesystem = os.environ.get(
        "FRE3NDER_BACKUP_EXPECTED_USB_FILESYSTEM"
    )

    if (
        (expected_source is None)
        != (expected_filesystem is None)
    ):
        raise ValueError(
            "expected USB identity is incomplete"
        )

    if expected_usb is None and expected_source is not None:
        expected_usb = {
            "source": expected_source,
            "filesystem": expected_filesystem,
        }

    with operation_lock():
        result = execute_backup(
            version, arguments, expected_usb=expected_usb,
        )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "execute",
        **result,
    }


def parse_archive(arguments):
    if len(arguments) < 4:
        raise ValueError(
            "archive requires ROLE SOURCE "
            "TARGET-DIRECTORY VERSION"
        )

    role = arguments[0]
    source = arguments[1]
    target = arguments[2]
    version = arguments[3]

    excludes = []
    index = 4

    while index < len(arguments):
        if arguments[index] != "--exclude":
            raise ValueError(
                "unsupported create argument: "
                f"{arguments[index]}"
            )

        if index + 1 >= len(arguments):
            raise ValueError(
                "--exclude requires a path"
            )

        excludes.append(
            arguments[index + 1]
        )

        index += 2

    return (
        role,
        source,
        target,
        version,
        excludes,
    )


def archive_response(arguments):
    (
        role,
        source,
        target,
        version,
        excludes,
    ) = parse_archive(arguments)

    result = create_backup_archive(
        source,
        target,
        role,
        version,
        excluded_paths=excludes,
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "archive",
        "backup": result,
    }


def verify_response(arguments):
    if len(arguments) != 3:
        raise ValueError(
            "verify requires ARCHIVE SIZE SHA256"
        )

    archive = arguments[0]

    try:
        size = int(arguments[1], 10)
    except ValueError as exc:
        raise ValueError(
            "backup size is invalid"
        ) from exc

    if size < 0:
        raise ValueError(
            "backup size is invalid"
        )

    sha256 = arguments[2]

    if re.fullmatch(
        r"[0-9a-f]{64}",
        sha256,
    ) is None:
        raise ValueError(
            "backup SHA256 is invalid"
        )

    result = verify_backup_archive(
        archive,
        size,
        sha256,
    )

    return {
        "api_version": API_VERSION,
        "ok": True,
        "operation": "verify",
        "backup": result,
    }


def error_response(operation, error):
    return {
        "api_version": API_VERSION,
        "ok": False,
        "operation": operation,
        "error": str(error),
    }


def main():
    if len(sys.argv) < 2:
        print(
            json.dumps(
                error_response(
                    "unknown",
                    ValueError(
                        "usage: /usr/libexec/fre3nder/backup-core "
                        "{offer|plan|execute|archive|verify} ..."
                    ),
                ),
                sort_keys=True,
            )
        )
        return 2

    operation = sys.argv[1]
    arguments = sys.argv[2:]

    try:
        if operation == "offer":
            if arguments:
                raise ValueError(
                    "offer takes no arguments"
                )

            response = backup_offer_response()

        elif operation == "plan":
            response = backup_plan_response(
                arguments
            )

        elif operation == "execute":
            response = execute_response(
                arguments
            )

        elif operation == "archive":
            response = archive_response(
                arguments
            )

        elif operation == "verify":
            response = verify_response(
                arguments
            )

        else:
            raise ValueError(
                f"unsupported backup operation: "
                f"{operation}"
            )

    except (OSError, ValueError) as exc:
        print(
            json.dumps(
                error_response(
                    operation,
                    exc,
                ),
                sort_keys=True,
            )
        )
        return 1

    print(
        json.dumps(
            response,
            sort_keys=True,
        )
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
