#!/usr/bin/env python3
"""Operator-guided, fail-closed Stock-to-Fre3nder F005 transition."""

import argparse
import os
import stat
import sys
import time

from f005_bootloader import FlasherError, flash_image, load_validated_image
from f005_mcu import (QUALIFIED_RELEASE_MANIFEST, RUNTIME_TARGET_MANIFEST,
                     SafetyError, load_release_manifest, probe_mcu)


ROOT_STATUS = "/run/fre3nder-root/status"


def regular_file(path):
    try:
        mode = os.lstat(path).st_mode
    except OSError:
        return False
    if not stat.S_ISREG(mode) or stat.S_ISLNK(mode):
        return False
    return True


def root_active(status_path=ROOT_STATUS):
    if not regular_file(status_path):
        return False
    with open(status_path, "r", encoding="ascii") as stream:
        return stream.read().strip() == "active"


def preflight(manifest_path, root_status):
    if not root_active(root_status):
        raise SafetyError("persistent root is not active")
    manifest = load_release_manifest(manifest_path)
    try:
        image, policy, _info = load_validated_image(manifest)
    except FlasherError as exc:
        raise SafetyError("target firmware validation failed: %s" % exc) from exc
    return manifest, image, policy


def transition(write=False, manifest_path=None,
               root_status=ROOT_STATUS, probe=probe_mcu,
               flash=flash_image, sleep=time.sleep,
               from_qualified=False,
               qualified_manifest_path=QUALIFIED_RELEASE_MANIFEST):
    manifest, image, policy = preflight(
        manifest_path or RUNTIME_TARGET_MANIFEST,
        root_status)

    source_state = "stock"
    probe_options = {}
    if from_qualified:
        source_state = "fre3nder-qualified"
        probe_options = {
            "qualified_manifest": load_release_manifest(qualified_manifest_path),
            "expected_reset_state": source_state,
        }
    observed = probe(manifest, send_reset=write, **probe_options)
    if observed.get("state") != source_state:
        raise SafetyError("current MCU is not exact supported %s F005" % source_state)
    if not observed.get("reset_supported"):
        raise SafetyError("source dictionary lacks exact reset command")
    if not write:
        return "dry-run-ready"
    if not observed.get("reset_sent"):
        raise SafetyError("write mode did not confirm the single reset")
    if not observed.get("connection_closed"):
        raise SafetyError("source UART cleanup was not confirmed")
    sleep(1.0)
    try:
        flash(image, policy)
    except FlasherError as exc:
        raise SafetyError("open bootloader flash failed: %s" % exc) from exc

    final = probe(manifest, send_reset=False, **probe_options)
    if final.get("state") != "fre3nder":
        raise SafetyError("post-update MCU identity is not Fre3nder")
    return "transition-complete"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--write", action="store_true",
                        help="send one reset and run one open bootloader transfer")
    parser.add_argument("--from-qualified", action="store_true",
                        help="require the exact previous qualified MCU instead of Stock")
    args = parser.parse_args()
    try:
        result = transition(write=args.write, from_qualified=args.from_qualified)
    except Exception as exc:
        print("f005-stock-to-fre3nder: FAIL CLOSED: %s" % exc,
              file=sys.stderr)
        return 1
    print("f005-stock-to-fre3nder: %s" % result)
    if not args.write:
        print("no reset sent and no flash invoked; use --write only after operator authorization")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
