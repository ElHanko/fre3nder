#!/usr/bin/python3
"""Fre3nder signed application package core."""

from __future__ import annotations

import hashlib
import contextlib
import fcntl
import grp
import json
import os
import pathlib
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
import zipfile

API_VERSION = 1
FORMAT_VERSION = 1
DISPLAY_API_VERSION = 1
# Only the verified, official Screen package may inherit the management socket GID.
MANAGEMENT_GROUP = "fre3nder-management"
SCREEN_APP = "fre3nderscreen"
SCREEN_PUBLISHER = "fre3nder-official"
SYSTEM_PUBLISHER = "fre3nder-official"
SYSTEM_APP_DIR = pathlib.Path(os.environ.get(
    "FRE3NDER_SYSTEM_APP_DIR", "/usr/share/fre3nder/system-apps"))
PLATFORM = "fre3nder-x2000"
ARCH = "mipsel"
APP_RE = re.compile(r"[a-z][a-z0-9_-]{0,63}")
PUBLISHER_RE = re.compile(r"[a-z][a-z0-9_.-]{0,63}")
SHA256_RE = re.compile(r"[0-9a-f]{64}")
BUILTIN_KEYS = pathlib.Path("/usr/share/fre3nder/app-keys")
HOME_DIR = pathlib.Path(os.environ.get("FRE3NDER_HOME_DIR", "/home/fre3nder"))
PACKAGE_STATE_ROOT = pathlib.Path(
    os.environ.get("FRE3NDER_PACKAGE_STATE_ROOT", "/home/.fre3nder")
)
STATE_ROOT = PACKAGE_STATE_ROOT / "packages"
USER_KEYS = PACKAGE_STATE_ROOT / "app-keys"
DATA_ROOT = HOME_DIR / ".local/share"
RUNTIME_ROOT = pathlib.Path(os.environ.get("FRE3NDER_PACKAGE_RUNTIME_ROOT", "/opt/fre3nder/apps-v2"))
HOME_RUNTIME_ROOT = PACKAGE_STATE_ROOT.parent / ".fre3nder-runtime/apps-v2"
RECOVERY_ROOT = pathlib.Path(os.environ.get("FRE3NDER_PACKAGE_RECOVERY_DIR", "/ota/apps-v2"))
FRONTEND_ROOT = PACKAGE_STATE_ROOT / "frontend"
ACTIVE_FRONTEND = FRONTEND_ROOT / "active"
DISPLAY_ROOT = PACKAGE_STATE_ROOT / "display"
ACTIVE_DISPLAY = DISPLAY_ROOT / "active"
WEB_SERVICE = pathlib.Path(os.environ.get("FRE3NDER_WEB_SERVICE", "/etc/init.d/S62fre3nder-web"))
DISPLAY_SERVICE = pathlib.Path(
    os.environ.get("FRE3NDER_DISPLAY_SERVICE", "/etc/init.d/S64fre3nder-display")
)
DISPLAY_STATUS = pathlib.Path(os.environ.get("FRE3NDER_DISPLAY_RUNTIME", "/run/fre3nder-display")) / "status"
MAX_MANIFEST = 64 * 1024
MAX_CHECKSUMS = 2 * 1024 * 1024
MAX_SIGNATURE = 64
MAX_PUBLIC_KEY = 16 * 1024
MAX_FILES = 4096
MAX_MEMBER = 512 * 1024 * 1024
MAX_TOTAL = 1024 * 1024 * 1024
MAX_PACKAGE = MAX_TOTAL + 64 * 1024 * 1024


def regular_file(path: pathlib.Path, description: str) -> None:
    try:
        st = path.lstat()
    except FileNotFoundError as exc:
        raise ValueError(f"{description} is missing: {path}") from exc
    if path.is_symlink() or not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{description} must be a regular non-symlink file: {path}")


def ensure_manager_directory(path: pathlib.Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = path.lstat()
    if path.is_symlink() or not stat.S_ISDIR(st.st_mode):
        raise ValueError(f"package-manager path must be a directory: {path}")
    if st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError(f"package-manager path has unsafe ownership or mode: {path}")


def openssl() -> str:
    value = shutil.which("openssl")
    if value is None:
        raise ValueError("openssl command is unavailable")
    return value


def key_der(path: pathlib.Path) -> bytes:
    regular_file(path, "publisher public key")
    result = subprocess.run(
        [openssl(), "pkey", "-pubin", "-in", str(path), "-outform", "DER"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise ValueError(f"invalid public key: {path}")
    text = subprocess.run(
        [openssl(), "pkey", "-pubin", "-in", str(path), "-text", "-noout"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if text.returncode != 0 or not text.stdout.startswith("ED25519 Public-Key:"):
        raise ValueError(f"publisher key is not Ed25519: {path}")
    return result.stdout


def fingerprint(path: pathlib.Path) -> str:
    return hashlib.sha256(key_der(path)).hexdigest()


def key_path(publisher: str) -> pathlib.Path:
    if not PUBLISHER_RE.fullmatch(publisher):
        raise ValueError("invalid publisher id")
    builtin = BUILTIN_KEYS / f"{publisher}.pem"
    if builtin.exists() or builtin.is_symlink():
        regular_file(builtin, "built-in publisher key")
        return builtin
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(USER_KEYS)
    user = USER_KEYS / f"{publisher}.pem"
    regular_file(user, "user publisher key")
    return user


def list_keys() -> list[dict]:
    result = []
    seen = set()
    for root, trust in ((BUILTIN_KEYS, "built-in"), (USER_KEYS, "user")):
        if not root.exists():
            continue
        if root == USER_KEYS:
            ensure_manager_directory(PACKAGE_STATE_ROOT)
            ensure_manager_directory(USER_KEYS)
        for path in sorted(root.glob("*.pem")):
            publisher = path.stem
            if publisher in seen or not PUBLISHER_RE.fullmatch(publisher):
                continue
            try:
                fp = fingerprint(path)
            except ValueError:
                continue
            seen.add(publisher)
            result.append({"publisher": publisher, "fingerprint": fp, "trust": trust})
    return result


def add_key(publisher: str, source: pathlib.Path) -> dict:
    if not PUBLISHER_RE.fullmatch(publisher):
        raise ValueError("invalid publisher id")
    if (BUILTIN_KEYS / f"{publisher}.pem").exists():
        raise ValueError("cannot replace a built-in publisher key")
    target = USER_KEYS / f"{publisher}.pem"
    if target.exists() or target.is_symlink():
        raise ValueError("publisher key already exists")
    regular_file(source, "publisher public key")
    if source.stat().st_size > MAX_PUBLIC_KEY:
        raise ValueError("publisher public key is too large")
    key_data = source.read_bytes()
    if len(key_data) > MAX_PUBLIC_KEY:
        raise ValueError("publisher public key is too large")
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(USER_KEYS)
    with tempfile.NamedTemporaryFile(dir=USER_KEYS, prefix=f".{publisher}.", delete=False) as tmp:
        tmp_path = pathlib.Path(tmp.name)
        tmp.write(key_data)
    try:
        tmp_path.chmod(0o644)
        fp = fingerprint(tmp_path)
        os.replace(tmp_path, target)
    finally:
        if tmp_path.exists():
            tmp_path.unlink()
    return {"publisher": publisher, "fingerprint": fp, "trust": "user"}


def remove_key(publisher: str) -> None:
    if (BUILTIN_KEYS / f"{publisher}.pem").exists():
        raise ValueError("cannot remove a built-in publisher key")
    if STATE_ROOT.exists():
        for root in STATE_ROOT.iterdir():
            if not APP_RE.fullmatch(root.name) or not installed(root.name):
                continue
            metadata = read_metadata(root.name)
            if metadata.get("publisher") == publisher:
                raise ValueError(
                    f"publisher key is required by installed app: {root.name}"
                )
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(USER_KEYS)
    target = USER_KEYS / f"{publisher}.pem"
    regular_file(target, "user publisher key")
    target.unlink()


def safe_zip_name(name: str) -> pathlib.PurePosixPath:
    if (
        not name
        or "\\" in name
        or name.startswith("/")
        or "\x00" in name
        or any(ord(character) < 32 or ord(character) == 127 for character in name)
    ):
        raise ValueError(f"unsafe package member: {name}")
    parts = name.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise ValueError(f"unsafe package member: {name}")
    path = pathlib.PurePosixPath(*parts)
    if path.as_posix() != name:
        raise ValueError(f"non-canonical package member: {name}")
    return path


def is_zip_symlink(info: zipfile.ZipInfo) -> bool:
    mode = (info.external_attr >> 16) & 0xFFFF
    return stat.S_IFMT(mode) == stat.S_IFLNK


def read_member(archive: zipfile.ZipFile, info: zipfile.ZipInfo, maximum: int) -> bytes:
    if info.file_size > maximum:
        raise ValueError(f"package member too large: {info.filename}")
    with archive.open(info, "r") as stream:
        data = stream.read(maximum + 1)
    if len(data) != info.file_size or len(data) > maximum:
        raise ValueError(f"cannot read complete package member: {info.filename}")
    return data


def parse_checksums(data: bytes, expected: list[str]) -> dict[str, str]:
    try:
        text = data.decode("ascii")
    except UnicodeDecodeError as exc:
        raise ValueError("SHA256SUMS is not ASCII") from exc
    if not text.endswith("\n"):
        raise ValueError("SHA256SUMS must end with newline")
    lines = text.splitlines()
    if len(lines) != len(expected):
        raise ValueError("SHA256SUMS has unexpected entries")
    result = {}
    for line, name in zip(lines, expected):
        match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
        if match is None or match.group(2) != name:
            raise ValueError("SHA256SUMS has unexpected order or syntax")
        result[name] = match.group(1)
    return result


def verify_signature(checksums: bytes, signature: bytes, key: pathlib.Path) -> None:
    if len(signature) != 64:
        raise ValueError("SHA256SUMS.sig is not an Ed25519 signature")
    with tempfile.TemporaryDirectory(prefix="fre3app-signature-") as tmp:
        tmp = pathlib.Path(tmp)
        sums = tmp / "SHA256SUMS"
        sig = tmp / "SHA256SUMS.sig"
        sums.write_bytes(checksums)
        sig.write_bytes(signature)
        result = subprocess.run(
            [openssl(), "pkeyutl", "-verify", "-rawin", "-pubin", "-inkey", str(key),
             "-in", str(sums), "-sigfile", str(sig)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    if result.returncode != 0:
        raise ValueError("Ed25519 signature verification failed")


def verify_package(package: pathlib.Path) -> dict:
    regular_file(package, "fre3app package")
    if package.stat().st_size > MAX_PACKAGE:
        raise ValueError("fre3app package exceeds size limit")
    try:
        archive = zipfile.ZipFile(package, "r")
    except (OSError, zipfile.BadZipFile) as exc:
        raise ValueError(f"cannot open fre3app package: {exc}") from exc
    with archive:
        infos = archive.infolist()
        if len(infos) > MAX_FILES:
            raise ValueError("fre3app contains too many members")
        names = [info.filename for info in infos]
        if len(names) != len(set(names)):
            raise ValueError("fre3app contains duplicate members")
        canonical_names = set()
        total = 0
        files = {}
        for info in infos:
            logical_name = info.filename[:-1] if info.is_dir() else info.filename
            canonical = safe_zip_name(logical_name).as_posix()
            if canonical in canonical_names:
                raise ValueError(f"fre3app contains colliding members: {logical_name}")
            canonical_names.add(canonical)
            if info.flag_bits & 0x1:
                raise ValueError(f"encrypted package member is not allowed: {info.filename}")
            if is_zip_symlink(info):
                raise ValueError(f"symlinks are not allowed: {info.filename}")
            if info.is_dir():
                continue
            if info.file_size > MAX_MEMBER:
                raise ValueError(f"package member too large: {info.filename}")
            total += info.file_size
            if total > MAX_TOTAL:
                raise ValueError("fre3app uncompressed size exceeds limit")
            files[info.filename] = info
        for required in ("manifest.toml", "service", "SHA256SUMS", "SHA256SUMS.sig"):
            if required not in files:
                raise ValueError(f"fre3app member missing: {required}")
        manifest_data = read_member(archive, files["manifest.toml"], MAX_MANIFEST)
        try:
            manifest = tomllib.loads(manifest_data.decode("utf-8"))
        except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
            raise ValueError("manifest.toml is invalid") from exc
        publisher = manifest.get("publisher")
        if not isinstance(publisher, dict):
            raise ValueError("manifest publisher metadata is missing")
        publisher_id = publisher.get("id")
        expected_fp = publisher.get("key_fingerprint")
        if not isinstance(publisher_id, str) or not PUBLISHER_RE.fullmatch(publisher_id):
            raise ValueError("manifest publisher id is invalid")
        if not isinstance(expected_fp, str) or not SHA256_RE.fullmatch(expected_fp):
            raise ValueError("manifest publisher fingerprint is invalid")
        key = key_path(publisher_id)
        actual_fp = fingerprint(key)
        if actual_fp != expected_fp:
            raise ValueError("package publisher fingerprint differs from trusted key")
        sums_data = read_member(archive, files["SHA256SUMS"], MAX_CHECKSUMS)
        signature = read_member(archive, files["SHA256SUMS.sig"], MAX_SIGNATURE)
        verify_signature(sums_data, signature, key)
        signed_names = sorted(name for name in files if name not in ("SHA256SUMS", "SHA256SUMS.sig"))
        checksums = parse_checksums(sums_data, signed_names)
        for name in signed_names:
            with archive.open(files[name], "r") as stream:
                digest = hashlib.sha256()
                size = 0
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    digest.update(chunk)
                    size += len(chunk)
            if size != files[name].file_size or digest.hexdigest() != checksums[name]:
                raise ValueError(f"package checksum mismatch: {name}")
        if manifest.get("format") != FORMAT_VERSION:
            raise ValueError("unsupported fre3app format")
        app = manifest.get("app")
        target = manifest.get("target")
        runtime = manifest.get("runtime")
        signature_meta = manifest.get("signature")
        if not isinstance(app, dict) or not isinstance(target, dict) or not isinstance(runtime, dict):
            raise ValueError("manifest application metadata is incomplete")
        name = app.get("name")
        version = app.get("version")
        serial = app.get("release_serial")
        if not isinstance(name, str) or not APP_RE.fullmatch(name):
            raise ValueError("manifest app name is invalid")
        if not isinstance(version, str) or not version or len(version) > 128:
            raise ValueError("manifest app version is invalid")
        if type(serial) is not int or serial < 0:
            raise ValueError("manifest release_serial is invalid")
        if target.get("platform") != PLATFORM or target.get("arch") != ARCH:
            raise ValueError("fre3app targets a different platform or architecture")
        if runtime.get("service") != "service" or type(runtime.get("autostart", True)) is not bool:
            raise ValueError("manifest runtime contract is invalid")
        web = manifest.get("web", {})
        if not isinstance(web, dict) or type(web.get("frontend", False)) is not bool:
            raise ValueError("manifest web capability is invalid")
        web_frontend = web.get("frontend", False)
        if web_frontend and ("payload/index.html" not in files or files["payload/index.html"].file_size == 0):
            raise ValueError("web frontend requires a nonempty payload/index.html")
        display = manifest.get("display", {})
        if (
            not isinstance(display, dict)
            or type(display.get("frontend", False)) is not bool
        ):
            raise ValueError("manifest display capability is invalid")
        display_frontend = display.get("frontend", False)
        display_api = display.get("api")
        if display_frontend:
            if type(display_api) is not int or display_api != DISPLAY_API_VERSION:
                raise ValueError("manifest display API is invalid")
            if runtime.get("autostart", True):
                raise ValueError("display frontend must disable autostart")
        elif display_api is not None:
            raise ValueError("display API requires display frontend capability")
        if signature_meta != {"algorithm": "Ed25519", "file": "SHA256SUMS.sig", "signed_file": "SHA256SUMS"}:
            raise ValueError("unsupported fre3app signature contract")
        return {
            "manifest": manifest,
            "name": name,
            "version": version,
            "release_serial": serial,
            "publisher": publisher_id,
            "fingerprint": actual_fp,
            "autostart": runtime.get("autostart", True),
            "web_frontend": web_frontend,
            "display_frontend": display_frontend,
            "display_api": display_api if display_frontend else None,
        }


def state_dir(name: str) -> pathlib.Path:
    return STATE_ROOT / name


def storage_role(value: str) -> str:
    if value not in ("sys", "home"):
        raise ValueError("app storage must be sys or home")
    return value


def runtime_root(storage: str) -> pathlib.Path:
    root = RUNTIME_ROOT if storage_role(storage) == "sys" else HOME_RUNTIME_ROOT
    for part in (root, *root.parents):
        if part.is_symlink() or (part.exists() and not part.is_dir()):
            raise ValueError(f"unsafe app runtime path: {part}")
    return root


def prepare_runtime_root(storage: str) -> pathlib.Path:
    root = runtime_root(storage)
    # HOME's runtime is public-readable, while cache and trust remain private.
    for path in ([root.parent] if storage == "home" else []) + [root]:
        if not path.exists():
            path.mkdir(parents=True, mode=0o755)
            path.chmod(0o755)
        st = path.stat()
        if st.st_uid != os.geteuid() or st.st_mode & 0o022:
            raise ValueError(f"unsafe app runtime directory: {path}")
    return root


def runtime_dir(name: str, storage: str | None = None) -> pathlib.Path:
    if not APP_RE.fullmatch(name):
        raise ValueError("invalid app name")
    role = storage_role(storage if storage is not None else read_metadata(name).get("storage", "sys"))
    path = runtime_root(role) / name
    if path.is_symlink() or (path.exists() and not path.is_dir()):
        raise ValueError(f"unsafe app runtime directory: {path}")
    return path


def storage_status() -> dict:
    result = {}
    for role in ("sys", "home"):
        try:
            path = runtime_root(role)
            while not path.exists():
                path = path.parent
            fs = os.statvfs(path)
            result[role] = {"available_bytes": fs.f_bavail * fs.f_frsize}
        except (OSError, ValueError):
            result[role] = {"available_bytes": None}
    return result


def check_install_space(package: pathlib.Path, target: pathlib.Path, storage: str) -> None:
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    fs = os.statvfs(target)
    block = fs.f_frsize
    with zipfile.ZipFile(package) as archive:
        # The old runtime stays allocated during update; free space must hold
        # the complete new extraction plus directory/transaction overhead.
        unpacked = sum(((item.file_size + block - 1) // block + len(pathlib.PurePosixPath(item.filename).parts)) * block
                       for item in archive.infolist())
    cache = package.stat().st_size + 4 * block
    reserve = 32 * 1024 * 1024
    home_fs = os.statvfs(PACKAGE_STATE_ROOT)
    if target.stat().st_dev == PACKAGE_STATE_ROOT.stat().st_dev:
        if min(fs.f_bavail * block, home_fs.f_bavail * home_fs.f_frsize) < unpacked + cache + reserve:
            raise ValueError(f"not enough {storage.upper()}/HOME space for app extraction, transaction and package cache")
    else:
        if fs.f_bavail * block < unpacked + reserve:
            raise ValueError(f"not enough {storage.upper()} space for app extraction and transaction")
        if home_fs.f_bavail * home_fs.f_frsize < cache + reserve:
            raise ValueError("not enough HOME space for the persistent package cache")


def runtime_matches(package: pathlib.Path, current: pathlib.Path) -> bool:
    """Compare retained HOME files with the already authenticated cached package."""
    if not current.is_dir():
        return False
    try:
        with zipfile.ZipFile(package) as archive:
            names = sorted(item.filename for item in archive.infolist()
                           if not item.is_dir() and item.filename not in ("SHA256SUMS", "SHA256SUMS.sig"))
            checksums = parse_checksums(archive.read("SHA256SUMS"), names)
        actual = set()
        for directory, dirs, files in os.walk(current):
            if any((pathlib.Path(directory) / name).is_symlink() for name in dirs):
                return False
            for name in files:
                path = pathlib.Path(directory) / name
                relative = path.relative_to(current).as_posix()
                regular_file(path, "retained app file")
                mode = 0o755 if relative == "service" or relative.startswith("payload/bin/") else 0o644
                if stat.S_IMODE(path.stat().st_mode) != mode or relative not in checksums:
                    return False
                with path.open("rb") as stream:
                    if hashlib.file_digest(stream, "sha256").hexdigest() != checksums[relative]:
                        return False
                actual.add(relative)
        return actual == set(names)
    except (OSError, ValueError):
        return False


def metadata_path(name: str) -> pathlib.Path:
    return state_dir(name) / "metadata.json"


def installed(name: str) -> bool:
    path = state_dir(name) / "installed"
    return path.is_file() and not path.is_symlink()


def read_metadata(name: str) -> dict:
    regular_file(metadata_path(name), "installed package metadata")
    data = json.loads(metadata_path(name).read_text())
    if not isinstance(data, dict) or data.get("name") != name:
        raise ValueError("installed package metadata is invalid")
    # Packages installed before frontend capabilities existed were non-frontends.
    data.setdefault("web_frontend", False)
    data.setdefault("display_frontend", False)
    data.setdefault("display_api", None)
    data.setdefault("system_app", False)
    if type(data["system_app"]) is not bool:
        raise ValueError("installed system app role is invalid")
    data["storage"] = storage_role(data.get("storage", "sys"))
    if type(data["web_frontend"]) is not bool:
        raise ValueError("installed web capability is invalid")
    if type(data["display_frontend"]) is not bool:
        raise ValueError("installed display capability is invalid")
    if data["display_frontend"]:
        if (
            type(data["display_api"]) is not int
            or data["display_api"] != DISPLAY_API_VERSION
        ):
            raise ValueError("installed display API is invalid")
        if data.get("autostart") is not False:
            raise ValueError("installed display frontend must disable autostart")
    elif data["display_api"] is not None:
        raise ValueError("installed display API requires display frontend capability")
    return data


def active_frontend() -> str | None:
    if not FRONTEND_ROOT.exists() and not FRONTEND_ROOT.is_symlink():
        return None
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(FRONTEND_ROOT)
    if not ACTIVE_FRONTEND.exists() and not ACTIVE_FRONTEND.is_symlink():
        return None
    regular_file(ACTIVE_FRONTEND, "active frontend")
    st = ACTIVE_FRONTEND.stat()
    if st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError("active frontend has unsafe ownership or mode")
    value = ACTIVE_FRONTEND.read_text()
    if not value.endswith("\n") or not APP_RE.fullmatch(value[:-1]):
        raise ValueError("active frontend name is invalid")
    return value[:-1]


def select_frontend(name: str) -> None:
    if active_frontend() is not None:
        return
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(FRONTEND_ROOT)
    with tempfile.NamedTemporaryFile(mode="w", dir=FRONTEND_ROOT, prefix=".active.", delete=False) as output:
        staged = pathlib.Path(output.name)
        try:
            output.write(name + "\n")
            output.flush()
            staged.chmod(0o644)
            os.replace(staged, ACTIVE_FRONTEND)
        finally:
            staged.unlink(missing_ok=True)


def active_display() -> str | None:
    if not DISPLAY_ROOT.exists() and not DISPLAY_ROOT.is_symlink():
        return None
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(DISPLAY_ROOT)
    if not ACTIVE_DISPLAY.exists() and not ACTIVE_DISPLAY.is_symlink():
        return None
    regular_file(ACTIVE_DISPLAY, "active display frontend")
    st = ACTIVE_DISPLAY.stat()
    if st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError("active display frontend has unsafe ownership or mode")
    value = ACTIVE_DISPLAY.read_text()
    if not value.endswith("\n") or not APP_RE.fullmatch(value[:-1]):
        raise ValueError("active display frontend name is invalid")
    return value[:-1]


def display_metadata(name: str) -> dict:
    if not APP_RE.fullmatch(name) or not installed(name):
        raise ValueError(f"app is not installed: {name}")
    metadata = read_metadata(name)
    if not metadata["display_frontend"]:
        raise ValueError(f"app is not a display frontend: {name}")
    return metadata


def select_display(name: str) -> None:
    display_metadata(name)
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(DISPLAY_ROOT)
    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=DISPLAY_ROOT,
        prefix=".active.",
        delete=False,
    ) as output:
        staged = pathlib.Path(output.name)
        try:
            output.write(name + "\n")
            output.flush()
            staged.chmod(0o644)
            os.replace(staged, ACTIVE_DISPLAY)
        finally:
            staged.unlink(missing_ok=True)


def disable_display() -> None:
    active_display()
    ACTIVE_DISPLAY.unlink(missing_ok=True)



def display_service_environment() -> dict[str, str]:
    if os.environ.get("FRE3NDER_DISPLAY_API") != str(DISPLAY_API_VERSION):
        raise ValueError("display runtime API is unavailable")

    framebuffer = os.environ.get("FRE3NDER_DISPLAY_FRAMEBUFFER", "")
    input_path = os.environ.get("FRE3NDER_DISPLAY_INPUT", "")
    if not framebuffer:
        raise ValueError("display framebuffer path is unavailable")
    if not input_path:
        raise ValueError("display input path is unavailable")

    return {
        "FRE3NDER_DISPLAY_API": str(DISPLAY_API_VERSION),
        "FRE3NDER_DISPLAY_VT": os.environ.get("FRE3NDER_DISPLAY_VT", ""),
        "FRE3NDER_DISPLAY_FRAMEBUFFER": framebuffer,
        "FRE3NDER_DISPLAY_INPUT": input_path,
        "FRE3NDER_DISPLAY_BACKLIGHT_POWER": os.environ.get(
            "FRE3NDER_DISPLAY_BACKLIGHT_POWER", ""
        ),
        "FRE3NDER_DISPLAY_BEEPER": os.environ.get(
            "FRE3NDER_DISPLAY_BEEPER", ""
        ),
    }


def display_group_ids() -> tuple[int, ...]:
    values = []
    for name in ("video", "input", "beep"):
        try:
            gid = grp.getgrnam(name).gr_gid
        except KeyError as exc:
            raise ValueError(
                f"display runtime group is unavailable: {name}"
            ) from exc
        values.append(gid)
    return tuple(values)


def display_service_action(action: str) -> int:
    if action not in ("start", "stop", "status"):
        raise ValueError(f"unsupported display service action: {action}")

    name = active_display()
    if name is None:
        raise ValueError("no display frontend is selected")

    display_metadata(name)
    if not runtime_dir(name).is_dir():
        raise ValueError(f"selected display runtime is unavailable: {name}")

    return service_action(
        name,
        action,
        extra_env=display_service_environment(),
        supplementary_groups=display_group_ids(),
    )


def run_display_manager(action: str, *, required: bool = False) -> bool:
    if action not in ("start", "stop", "restart", "status"):
        raise ValueError(f"unsupported display manager action: {action}")

    try:
        result = subprocess.run(
            [str(DISPLAY_SERVICE), action],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            return True
        reason = f"exit {result.returncode}"
    except OSError as exc:
        reason = str(exc)

    if required:
        raise ValueError(f"display manager {action} failed: {reason}")

    print(
        f"fre3nder package: display manager {action} failed ({reason}); "
        "package state remains authoritative",
        file=sys.stderr,
    )
    return False



def display_runtime_status() -> str:
    try:
        regular_file(DISPLAY_STATUS, "display runtime status")
        return DISPLAY_STATUS.read_text().strip() or "unavailable"
    except (OSError, ValueError):
        return "unavailable"


def display_manager_running() -> bool:
    if display_runtime_status() != "active":
        return False
    try:
        result = subprocess.run(
            [str(DISPLAY_SERVICE), "status"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return False
    return result.returncode == 0


def start_selected_display(name: str) -> None:
    try:
        run_display_manager("start", required=True)
    except ValueError as exc:
        raise ValueError(f'Display frontend "{name}" failed to start ({exc}; status: {display_runtime_status()}).') from exc
    # S64 already waits for app/VT readiness; its boot-safe exit code is not
    # evidence of success. Both the runtime state and live service must agree.
    if not display_manager_running():
        raise ValueError(f'Display frontend "{name}" failed to start (status: {display_runtime_status()}; service status not confirmed).')


def stop_selected_display() -> None:
    if display_runtime_status() == "stop-failed":
        raise ValueError("display manager stop-failed; VT ownership is unconfirmed")
    try:
        run_display_manager("stop", required=True)
    except ValueError as exc:
        raise ValueError(f"{exc} (status: {display_runtime_status()})") from exc
    if display_runtime_status() != "stopped":
        raise ValueError(f"display manager stop not confirmed (status: {display_runtime_status()}); VT ownership is unconfirmed")


def switch_display(name: str) -> None:
    display_metadata(name)
    previous = active_display()
    if display_runtime_status() == "stop-failed":
        raise ValueError("display manager stop-failed; VT ownership is unconfirmed; selection unchanged")
    if previous == name:
        if not display_manager_running():
            start_selected_display(name)
        return
    if previous is not None:
        stop_selected_display()
    try:
        select_display(name)
        start_selected_display(name)
    except (OSError, ValueError) as failure:
        try:
            stop_selected_display()
            if previous is not None:
                select_display(previous)
                start_selected_display(previous)
                restored = f'Previous display "{previous}" restored.'
            else:
                disable_display()
                run_display_manager("start", required=True)
                if display_runtime_status() != "disabled":
                    raise ValueError(f"display disable not confirmed (status: {display_runtime_status()})")
                restored = "Display selection cleared; diagnostic console fallback requested."
        except (OSError, ValueError) as recovery:
            raise ValueError(f"{failure} Recovery failed: {recovery}") from failure
        raise ValueError(f"{failure} {restored}") from failure


def refresh_web() -> None:
    try:
        result = subprocess.run([str(WEB_SERVICE), "restart"], check=False)
        if result.returncode == 0:
            return
        reason = f"exit {result.returncode}"
    except OSError as exc:
        reason = str(exc)
    print(f"fre3nder package: web refresh failed ({reason}); package transaction remains complete", file=sys.stderr)



def image_system_app_seeds() -> list[pathlib.Path]:
    """Enumerate candidate image packages; validation is per package."""
    if not SYSTEM_APP_DIR.exists() and not SYSTEM_APP_DIR.is_symlink():
        return []
    if SYSTEM_APP_DIR.is_symlink() or not SYSTEM_APP_DIR.is_dir():
        raise ValueError("image system-app directory is unsafe")
    info = SYSTEM_APP_DIR.stat()
    if info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError("image system-app directory is not protected")
    return sorted(package for package in SYSTEM_APP_DIR.iterdir()
                  if package.suffix == ".fre3app")


def verify_image_system_app(package: pathlib.Path) -> dict:
    """Check signature, official built-in publisher and canonical filename."""
    regular_file(package, "image system-app package")
    key = BUILTIN_KEYS / (SYSTEM_PUBLISHER + ".pem")
    regular_file(key, "built-in system-app publisher key")
    key_info = key.stat()
    if key_info.st_uid != os.geteuid() or key_info.st_mode & 0o022:
        raise ValueError("system-app publisher key is not protected")
    candidate = verify_package(package)
    if (package.name != candidate["name"] + ".fre3app"
            or candidate["publisher"] != SYSTEM_PUBLISHER
            or candidate["fingerprint"] != fingerprint(key)
            or candidate["display_frontend"]):
        raise ValueError("invalid image system-app identity: " + package.name)
    return candidate


def image_system_app(name: str) -> dict | None:
    """Only consult the matching image seed for install/remove policy."""
    if not APP_RE.fullmatch(name):
        raise ValueError("invalid app name")
    # Always validate immutable directory permissions even for a missing seed.
    image_system_app_seeds()
    package = SYSTEM_APP_DIR / (name + ".fre3app")
    if not package.exists() and not package.is_symlink():
        return None
    return verify_image_system_app(package)


def image_system_apps() -> list[tuple[pathlib.Path, dict]]:
    """Strict inspection of the entire image for diagnostics and tests."""
    return [(package, verify_image_system_app(package))
            for package in image_system_app_seeds()]


def promote_system_app(name: str) -> None:
    """Persist required status even if a later image omits this system app."""
    metadata = read_metadata(name)
    if metadata["system_app"]:
        return
    metadata["system_app"] = True
    destination = metadata_path(name)
    with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=destination.parent,
            prefix=".system-app.", delete=False) as stream:
        staged = pathlib.Path(stream.name)
        try:
            json.dump(metadata, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
            os.chmod(staged, 0o644)
            os.replace(staged, destination)
        finally:
            staged.unlink(missing_ok=True)


def reconcile_system_apps() -> int:
    """Boot-only upgrade of newer signed image seeds; never downgrade."""
    failed = False
    try:
        seeds = image_system_app_seeds()
    except (OSError, ValueError) as exc:
        print(f"fre3nder system apps: invalid image: {exc}", file=sys.stderr)
        return 1
    for package in seeds:
        name = package.stem
        try:
            candidate = verify_image_system_app(package)
            name = candidate["name"]
            if not installed(name):
                activate_package(package, "install", storage="sys",
                                 start_service=False, system_app=True)
                print(f"fre3nder system apps: installed {name}")
                continue
            current = read_metadata(name)
            if (current.get("publisher") != candidate["publisher"]
                    or current.get("fingerprint") != candidate["fingerprint"]):
                raise ValueError("installed publisher differs from image system app")
            current_serial = current.get("release_serial")
            seed_serial = candidate["release_serial"]
            if type(current_serial) is not int or current_serial < 0:
                raise ValueError("invalid installed release serial")
            if seed_serial > current_serial:
                activate_package(package, "update", start_service=False,
                                 system_app=True)
                print(f"fre3nder system apps: updated {name}")
            elif seed_serial == current_serial and current.get("version") != candidate["version"]:
                if seed_serial != 0:
                    raise ValueError("same release serial has different version")
                # Development serial 0 has no ordering: preserve local version.
                promote_system_app(name)
            else:
                promote_system_app(name)
        except (OSError, ValueError, RuntimeError) as exc:
            failed = True
            print(f"fre3nder system apps: {name}: DEGRADED: {exc}", file=sys.stderr)
    return 1 if failed else 0


def app_user():
    try:
        account = pwd.getpwnam("fre3nder")
    except KeyError as exc:
        raise ValueError("fre3nder runtime user is unavailable") from exc
    return account.pw_uid, account.pw_gid


def official_screen(metadata: dict) -> bool:
    """Recognize the pinned official display role, never a name-only privilege."""
    if (metadata.get("name") != SCREEN_APP
            or metadata.get("publisher") != SCREEN_PUBLISHER
            or metadata.get("display_frontend") is not True
            or metadata.get("display_api") != DISPLAY_API_VERSION):
        return False
    key = BUILTIN_KEYS / (SCREEN_PUBLISHER + ".pem")
    regular_file(key, "built-in Screen publisher key")
    info = key.stat()
    if info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError("built-in Screen publisher key is not protected")
    return metadata.get("fingerprint") == fingerprint(key)


def protected_screen_runtime(runtime: pathlib.Path) -> bool:
    """All executable/package files must be manager-owned and non-writable."""
    if not runtime.is_dir() or runtime.is_symlink():
        return False
    for directory, directories, files in os.walk(runtime, followlinks=False):
        for name in ["", *directories, *files]:
            path = pathlib.Path(directory) / name if name else pathlib.Path(directory)
            try:
                info = path.lstat()
            except OSError:
                return False
            if (info.st_uid != os.geteuid() or info.st_mode & 0o022
                    or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode))):
                return False
    return True


def chown_tree(path: pathlib.Path, uid: int, gid: int) -> None:
    for root, dirs, files in os.walk(path):
        os.chown(root, uid, gid)
        for item in dirs:
            os.chown(os.path.join(root, item), uid, gid)
        for item in files:
            os.chown(os.path.join(root, item), uid, gid)


def service_action(
    name: str,
    action: str,
    runtime: pathlib.Path | None = None,
    extra_env: dict[str, str] | None = None,
    supplementary_groups: tuple[int, ...] = (),
) -> int:
    runtime = runtime or runtime_dir(name)
    service = runtime / "service"
    regular_file(service, "app service")
    uid, gid = app_user()
    # Protect the management capability with *both* peer UID and primary GID.
    # No ordinary application inherits this GID; UID stays unprivileged.
    service_gid = gid
    if (action in ("start", "stop", "status") and name == SCREEN_APP
            and installed(name) and active_display() == name):
        metadata = read_metadata(name)
        if official_screen(metadata) and protected_screen_runtime(runtime):
            service_gid = grp.getgrnam(MANAGEMENT_GROUP).gr_gid
    data_dir = DATA_ROOT / name
    data_dir.mkdir(parents=True, exist_ok=True)
    os.chown(data_dir, uid, gid)
    env = os.environ.copy()
    env.update({
        "HOME": str(HOME_DIR),
        "USER": "fre3nder",
        "LOGNAME": "fre3nder",
        "FRE3NDER_APP_NAME": name,
        "FRE3NDER_APP_RUNTIME_DIR": str(runtime),
        "FRE3NDER_APP_STATE_DIR": str(state_dir(name)),
        "FRE3NDER_APP_DATA_DIR": str(data_dir),
        "FRE3NDER_HOME_DIR": str(HOME_DIR),
    })
    if extra_env:
        env.update(extra_env)

    def demote():
        groups = set(supplementary_groups)
        # S64's root:fre3nder 0710 runtime needs the original app GID for
        # directory traversal even when Screen uses the management primary GID.
        if service_gid != gid:
            groups.add(gid)
        os.setgroups(sorted(groups))
        os.setgid(service_gid)
        os.setuid(uid)
    result = subprocess.run(
        [str(service), action],
        cwd=runtime,
        env=env,
        stdin=subprocess.DEVNULL,
        check=False,
        preexec_fn=demote,
    )
    return result.returncode


def extract_runtime(package: pathlib.Path, verified: dict, target: pathlib.Path) -> None:
    # The privileged Screen's signed executable/service must not be writable by
    # another .fre3app sharing the generic fre3nder UID.
    uid, gid = ((os.geteuid(), os.getegid()) if official_screen(verified)
                else app_user())
    with zipfile.ZipFile(package, "r") as archive:
        target.mkdir(parents=True, mode=0o755)
        for info in archive.infolist():
            name = info.filename
            if name in ("SHA256SUMS", "SHA256SUMS.sig"):
                continue
            path = target.joinpath(*pathlib.PurePosixPath(name).parts)
            if info.is_dir():
                path.mkdir(parents=True, exist_ok=True)
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            with archive.open(info, "r") as src, path.open("wb") as dst:
                shutil.copyfileobj(src, dst)
            path.chmod(0o755 if name == "service" or name.startswith("payload/bin/") else 0o644)
    chown_tree(target, uid, gid)


def write_state(package: pathlib.Path, verified: dict, storage: str = "sys",
                system_app: bool = False) -> None:
    storage = storage_role(storage)
    name = verified["name"]
    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(STATE_ROOT)
    with tempfile.TemporaryDirectory(dir=STATE_ROOT, prefix=f".{name}.state.") as tmp:
        transaction = pathlib.Path(tmp)
        staged = transaction / "new"
        staged.mkdir(mode=0o755)
        cached = staged / "package.fre3app"
        shutil.copyfile(package, cached)
        cached.chmod(0o644)
        # Finish writing before validating and publishing persistent state.
        # I/O or fsync failure must abort the transaction.
        with cached.open("rb") as stream:
            os.fsync(stream.fileno())

        cached_verified = verify_package(cached)
        if cached_verified != verified:
            raise ValueError("cached package identity differs from verified source")

        # Keep the exact original archive, including unsigned ZIP metadata.
        # Comparison is streaming, so large packages are not held in RAM.
        with package.open("rb") as source, cached.open("rb") as target:
            while True:
                source_chunk = source.read(1024 * 1024)
                target_chunk = target.read(1024 * 1024)
                if source_chunk != target_chunk:
                    raise ValueError("cached package bytes differ from source")
                if not source_chunk:
                    break

        metadata = {
            "name": name,
            "storage": storage,
            "version": verified["version"],
            "release_serial": verified["release_serial"],
            "publisher": verified["publisher"],
            "fingerprint": verified["fingerprint"],
            "autostart": verified["autostart"],
            "web_frontend": verified["web_frontend"],
            "display_frontend": verified["display_frontend"],
            "display_api": verified["display_api"],
            "system_app": system_app,
        }
        (staged / "metadata.json").write_text(
            json.dumps(metadata, sort_keys=True) + "\n"
        )
        (staged / "installed").touch()
        if verified["autostart"]:
            (staged / "autostart").touch()

        current = state_dir(name)
        previous = transaction / "previous"
        if current.exists() or current.is_symlink():
            os.replace(current, previous)
        try:
            os.replace(staged, current)
        except Exception:
            if previous.exists() or previous.is_symlink():
                os.replace(previous, current)
            raise


def activate_package(package: pathlib.Path, operation: str, allow_downgrade: bool = False,
                     storage: str | None = None, start_service: bool = True,
                     system_app: bool = False) -> dict:
    if operation == "update" and storage is not None:
        raise ValueError("updates preserve the installed app storage")
    storage = storage_role(storage if storage is not None else "sys")
    verified = verify_package(package)
    name = verified["name"]
    selected_before = active_frontend() if verified["web_frontend"] else None
    exists = installed(name)
    # Only the immutable image, not the signed manifest, grants this role.
    image_seed = image_system_app(name)
    if image_seed is not None and (
            verified["publisher"] != image_seed["publisher"]
            or verified["fingerprint"] != image_seed["fingerprint"]):
        raise ValueError("system-app name is reserved for the official publisher")
    system_role = system_app or image_seed is not None
    display_selected = (
        exists and verified["display_frontend"] and active_display() == name
    )
    if operation == "install" and exists:
        raise ValueError(f"app already installed: {name}")
    if operation == "update" and not exists:
        raise ValueError(f"app is not installed: {name}")
    if exists:
        old = read_metadata(name)
        system_role = system_role or old.get("system_app", False)
        storage = storage_role(old.get("storage", "sys"))
        if old.get("web_frontend") != verified["web_frontend"]:
            raise ValueError("web frontend capability differs from installed app")
        if (
            old.get("display_frontend", False) != verified["display_frontend"]
            or old.get("display_api") != verified["display_api"]
        ):
            raise ValueError("display frontend capability differs from installed app")
        if (
            old.get("publisher") != verified["publisher"]
            or old.get("fingerprint") != verified["fingerprint"]
        ):
            raise ValueError("package publisher differs from installed app")
        old_serial = old.get("release_serial")
        if type(old_serial) is not int or old_serial < 0:
            raise ValueError("installed release_serial is invalid")
        if verified["release_serial"] == old_serial == 0:
            if verified["version"] == old.get("version"):
                raise ValueError("same development package is already installed")
        elif verified["release_serial"] == old_serial:
            raise ValueError("same package release is already installed")
        if verified["release_serial"] < old_serial and not allow_downgrade:
            raise ValueError("package downgrade requires --allow-downgrade")
    target = prepare_runtime_root(storage)
    current = runtime_dir(name, storage)
    check_install_space(package, target, storage)
    with tempfile.TemporaryDirectory(dir=target, prefix=f".{name}.") as tmp:
        staged = pathlib.Path(tmp) / "new"
        extract_runtime(package, verified, staged)
        previous = pathlib.Path(tmp) / "previous"
        was_running = False
        display_stopped = False
        if exists and current.exists():
            if display_selected:
                run_display_manager("stop", required=True)
                display_stopped = True
            else:
                was_running = service_action(name, "status", current) == 0
                if was_running:
                    rc = service_action(name, "stop", current)
                    if rc != 0:
                        raise ValueError(f"app service stop failed: exit {rc}")
            os.replace(current, previous)
        try:
            os.replace(staged, current)
            action = "update" if exists else "install"
            rc = service_action(name, action, current)
            if rc != 0:
                raise ValueError(f"app service {action} failed: exit {rc}")
            started = False
            if verified["autostart"] and start_service:
                rc = service_action(name, "start", current)
                if rc != 0:
                    raise ValueError(f"app service start failed: exit {rc}")
                started = True
            selected_new = False
            try:
                if operation == "install" and verified["web_frontend"] and selected_before is None:
                    select_frontend(name)
                    selected_new = True
                write_state(package, verified, storage, system_app=system_role)
            except Exception:
                if selected_new:
                    ACTIVE_FRONTEND.unlink(missing_ok=True)
                if started:
                    service_action(name, "stop", current)
                raise
        except Exception:
            if current.exists():
                shutil.rmtree(current, ignore_errors=True)
            if previous.exists():
                os.replace(previous, current)
                if was_running:
                    service_action(name, "start", current)
            if display_stopped:
                run_display_manager("start")
            raise
    recovery = RECOVERY_ROOT / name
    recovery.mkdir(parents=True, exist_ok=True)
    (recovery / "restored").touch(exist_ok=True)
    if verified["web_frontend"] and active_frontend() == name:
        refresh_web()
    if display_selected:
        run_display_manager("start")
    return verified


def remove_package(name: str) -> None:
    if not APP_RE.fullmatch(name) or not installed(name):
        raise ValueError(f"app is not installed: {name}")
    if (read_metadata(name)["system_app"]
            or image_system_app(name) is not None):
        raise ValueError(f"system app cannot be removed: {name}")
    current = runtime_dir(name)
    was_active = active_frontend() == name
    was_display_active = active_display() == name
    was_running = False
    display_stopped = False
    if current.exists():
        if was_display_active:
            run_display_manager("stop", required=True)
            display_stopped = True
        else:
            was_running = service_action(name, "status", current) == 0
            if was_running:
                rc = service_action(name, "stop", current)
                if rc != 0:
                    raise ValueError(f"app service stop failed: exit {rc}")

        rc = service_action(name, "uninstall", current)
        if rc != 0:
            if was_running:
                service_action(name, "start", current)
            if display_stopped:
                run_display_manager("start")
            raise ValueError(f"app service uninstall failed: exit {rc}")

    ensure_manager_directory(PACKAGE_STATE_ROOT)
    ensure_manager_directory(STATE_ROOT)
    with tempfile.TemporaryDirectory(dir=STATE_ROOT, prefix=f".{name}.remove.") as tmp:
        transaction = pathlib.Path(tmp)
        removed_state = transaction / "state"
        current_state = state_dir(name)
        os.replace(current_state, removed_state)
        try:
            if current.exists():
                shutil.rmtree(current)
            shutil.rmtree(RECOVERY_ROOT / name, ignore_errors=True)
        except Exception:
            if not current_state.exists() and removed_state.exists():
                os.replace(removed_state, current_state)
            if was_running and current.exists():
                service_action(name, "start", current)
            if display_stopped and current.exists():
                run_display_manager("start")
            raise
    if was_active:
        ACTIVE_FRONTEND.unlink()
        refresh_web()
    if was_display_active:
        ACTIVE_DISPLAY.unlink(missing_ok=True)


def restore_installed() -> int:
    failed = False
    if not STATE_ROOT.exists():
        return 0
    for root in sorted(STATE_ROOT.iterdir(), key=lambda p: p.name):
        name = root.name
        if not APP_RE.fullmatch(name) or not installed(name):
            continue
        try:
            marker = RECOVERY_ROOT / name / "restored"
            metadata = read_metadata(name)
            storage = metadata["storage"]
            current = runtime_dir(name, storage)
            if (storage == "sys" and marker.is_file() and not marker.is_symlink()
                    and current.is_dir() and
                    (not official_screen(metadata) or protected_screen_runtime(current))):
                continue
            package = state_dir(name) / "package.fre3app"
            verified = verify_package(package)
            expected = {
                "name": verified["name"],
                "version": verified["version"],
                "release_serial": verified["release_serial"],
                "publisher": verified["publisher"],
                "fingerprint": verified["fingerprint"],
                "autostart": verified["autostart"],
                "web_frontend": verified["web_frontend"],
                "display_frontend": verified["display_frontend"],
                "display_api": verified["display_api"],
                "storage": storage,
                "system_app": metadata["system_app"],
            }
            if metadata != expected or verified["name"] != name:
                raise ValueError("cached package differs from installed state")
            if (storage == "home" and runtime_matches(package, current) and
                    (not official_screen(metadata) or protected_screen_runtime(current))):
                if not marker.is_file() or marker.is_symlink():
                    rc = service_action(name, "restore", current)
                    if rc != 0:
                        raise ValueError(f"app service restore failed: exit {rc}")
                    marker.parent.mkdir(parents=True, exist_ok=True)
                    marker.touch(exist_ok=True)
                continue
            target = prepare_runtime_root(storage)
            check_install_space(package, target, storage)
            with tempfile.TemporaryDirectory(dir=target, prefix=f".{name}.") as tmp:
                transaction = pathlib.Path(tmp)
                staged = transaction / "new"
                previous = transaction / "previous"
                extract_runtime(package, verified, staged)
                if current.exists():
                    os.replace(current, previous)
                try:
                    os.replace(staged, current)
                    rc = service_action(name, "restore", current)
                    if rc != 0:
                        raise ValueError(f"app service restore failed: exit {rc}")
                except Exception:
                    if current.exists():
                        shutil.rmtree(current, ignore_errors=True)
                    if previous.exists():
                        os.replace(previous, current)
                    raise
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.touch(exist_ok=True)
            print(f"fre3nder package recovery: restored {name}")
        except Exception as exc:
            print(f"fre3nder package recovery: {name}: {exc}", file=sys.stderr)
            failed = True
    return 1 if failed else 0


def start_installed() -> int:
    failed = False
    if not STATE_ROOT.exists():
        return 0
    for root in sorted(STATE_ROOT.iterdir(), key=lambda p: p.name):
        name = root.name
        marker = root / "autostart"
        if (
            not APP_RE.fullmatch(name)
            or not installed(name)
            or not marker.is_file()
            or marker.is_symlink()
        ):
            continue
        try:
            if read_metadata(name)["display_frontend"]:
                continue
            if service_action(name, "status") == 0:
                continue
            rc = service_action(name, "start")
            if rc != 0:
                raise ValueError(f"exit {rc}")
        except Exception as exc:
            print(f"fre3nder app runtime: {name}: start failed: {exc}", file=sys.stderr)
            failed = True
    return 1 if failed else 0


def stop_installed() -> int:
    failed = False
    if not STATE_ROOT.exists():
        return 0
    for root in sorted(STATE_ROOT.iterdir(), key=lambda p: p.name, reverse=True):
        name = root.name
        if not APP_RE.fullmatch(name) or not installed(name):
            continue
        try:
            if not runtime_dir(name).is_dir():
                continue
            if read_metadata(name)["display_frontend"]:
                continue
            if service_action(name, "status") != 0:
                continue
            rc = service_action(name, "stop")
            if rc != 0:
                raise ValueError(f"exit {rc}")
        except Exception as exc:
            print(f"fre3nder app runtime: {name}: stop failed: {exc}", file=sys.stderr)
            failed = True
    return 1 if failed else 0


def response(operation: str, ok: bool, **fields):
    value = {"api_version": API_VERSION, "operation": operation, "ok": ok}
    value.update(fields)
    print(json.dumps(value, sort_keys=True))


def main() -> int:
    args = sys.argv[1:]
    if args == ["key-list"]:
        response("key-list", True, keys=list_keys()); return 0
    if len(args) == 3 and args[0] == "key-add":
        result = add_key(args[1], pathlib.Path(args[2])); response("key-add", True, key=result); return 0
    if len(args) == 2 and args[0] == "key-show":
        path = key_path(args[1]); response("key-show", True, key={"publisher": args[1], "fingerprint": fingerprint(path), "path": str(path)}); return 0
    if len(args) == 2 and args[0] == "key-remove":
        remove_key(args[1]); response("key-remove", True, publisher=args[1]); return 0
    if len(args) == 2 and args[0] == "verify":
        item = verify_package(pathlib.Path(args[1])); response("verify", True, package={k: item[k] for k in ("name","version","release_serial","publisher","fingerprint","web_frontend","display_frontend","display_api")}); return 0
    if len(args) in (2, 4) and args[0] == "install":
        if len(args) == 4 and args[2] != "--storage":
            raise ValueError("unsupported install option")
        storage = storage_role(args[3]) if len(args) == 4 else "sys"
        item = activate_package(pathlib.Path(args[1]), "install", storage=storage)
        response("install", True, package={**{k: item[k] for k in ("name","version","release_serial","publisher")}, "storage": storage}); return 0
    if len(args) in (2, 3) and args[0] == "update":
        allow = len(args) == 3 and args[2] == "--allow-downgrade"
        if len(args) == 3 and not allow:
            raise ValueError("unsupported update option")
        item = activate_package(pathlib.Path(args[1]), "update", allow); response("update", True, package={k: item[k] for k in ("name","version","release_serial","publisher")}); return 0
    if len(args) == 2 and args[0] == "remove":
        remove_package(args[1]); response("remove", True, name=args[1]); return 0
    if args == ["list"]:
        apps = []
        if STATE_ROOT.exists():
            for root in sorted(STATE_ROOT.iterdir(), key=lambda p: p.name):
                if APP_RE.fullmatch(root.name) and installed(root.name):
                    apps.append(read_metadata(root.name))
        response("list", True, apps=apps); return 0
    if len(args) == 2 and args[0] == "status":
        if not installed(args[1]):
            raise ValueError(f"app is not installed: {args[1]}")
        meta = read_metadata(args[1])
        if meta["display_frontend"]:
            meta["running"] = (
                active_display() == args[1] and display_manager_running()
            )
        else:
            meta["running"] = service_action(args[1], "status") == 0
        response("status", True, app=meta); return 0
    if args == ["display-list"]:
        selected = active_display()
        apps = []
        if STATE_ROOT.exists():
            for root in sorted(STATE_ROOT.iterdir(), key=lambda p: p.name):
                if not APP_RE.fullmatch(root.name) or not installed(root.name):
                    continue
                meta = read_metadata(root.name)
                if not meta["display_frontend"]:
                    continue
                item = dict(meta)
                item["active"] = root.name == selected
                apps.append(item)
        response("display-list", True, active=selected, apps=apps); return 0
    if args == ["frontend-status"]:
        name = active_frontend()
        document_root = None
        if name is not None:
            if not installed(name) or not read_metadata(name)["web_frontend"]:
                raise ValueError("selected app is not an installed web frontend")
            document_root = str(runtime_dir(name) / "payload")
        response("frontend-status", True, frontend={"active": name, "document_root": document_root}); return 0
    if args == ["storage-status"]:
        response("storage-status", True, storage=storage_status()); return 0
    if args == ["display-status"]:
        response("display-status", True, display={"active": active_display()}); return 0
    if len(args) == 2 and args[0] == "display-select":
        name = args[1]
        switch_display(name)
        response("display-select", True, display={"active": name}); return 0
    if args == ["display-disable"]:
        previous = active_display()
        if previous is not None:
            run_display_manager("stop", required=True)
            try:
                disable_display()
            except Exception:
                run_display_manager("start")
                raise
        response("display-disable", True, display={"active": None, "previous": previous}); return 0
    if len(args) == 1 and args[0] in (
        "display-service-start",
        "display-service-stop",
        "display-service-status",
    ):
        action = args[0].removeprefix("display-service-")
        rc = display_service_action(action)
        response(
            args[0],
            rc == 0,
            display={"active": active_display(), "service_action": action},
            exit_code=rc,
        )
        return 0 if rc == 0 else 1
    if args == ["restore-installed"]:
        return restore_installed()
    if args == ["reconcile-system-apps"]:
        return reconcile_system_apps()
    if args == ["start-installed"]:
        return start_installed()
    if args == ["stop-installed"]:
        return stop_installed()
    raise ValueError("unsupported package-core operation")


if __name__ == "__main__":
    try:
        # All callers acquire OTA first, then package, for the whole mutation.
        if sys.argv[1:2] and sys.argv[1] in (
                "install", "update", "remove", "display-select", "display-disable",
                "restore-installed", "reconcile-system-apps",
                "start-installed", "stop-installed", "key-add", "key-remove"):
            # Keep host fixtures isolated from the machine's global /run.
            lock_root = (PACKAGE_STATE_ROOT if "FRE3NDER_PACKAGE_STATE_ROOT" in os.environ
                         else pathlib.Path("/run"))
            ensure_manager_directory(lock_root)
            ota_lock = (lock_root / "ota/write.lock" if "FRE3NDER_PACKAGE_STATE_ROOT" in os.environ
                        else pathlib.Path("/run/fre3nder/ota/write.lock"))
            with contextlib.ExitStack() as locks:
                for description, path in (("OTA/app", ota_lock),
                                          ("package", lock_root / ".package-operation.lock")):
                    ensure_manager_directory(path.parent)
                    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
                    lock = locks.enter_context(os.fdopen(fd, "r+"))
                    metadata = os.fstat(fd)
                    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid()
                            or metadata.st_mode & 0o077):
                        raise ValueError(f"unsafe {description} operation lock")
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError as exc:
                        raise ValueError(f"another {description} operation is active") from exc
                sys.exit(main())
        sys.exit(main())
    except (
        OSError,
        ValueError,
        RuntimeError,
        NotImplementedError,
        json.JSONDecodeError,
        zipfile.BadZipFile,
    ) as exc:
        operation = sys.argv[1] if len(sys.argv) > 1 else "unknown"
        response(operation, False, error=str(exc))
        sys.exit(1)
