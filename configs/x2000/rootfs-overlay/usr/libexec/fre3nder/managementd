def auth_locked(function):
    @functools.wraps(function)
    def locked(*args, **kwargs):
        with _auth_lock:
            return function(*args, **kwargs)
    return locked


class ManagementError(Exception):
    def __init__(self, status, code, message):
        super().__init__(message)
        self.status = status
        self.code = code
        self.message = message


def manager_uid():
    return os.geteuid()


def mutation_uids():
    allowed = {0}
    if ADMIN_UID_OVERRIDE is not None:
        allowed.add(int(ADMIN_UID_OVERRIDE))
    return allowed


def web_uids():
    allowed = set()
    try:
        allowed.add(pwd.getpwnam(WEB_USER).pw_uid)
    except KeyError:
        pass
    if WEB_UID_OVERRIDE is not None:
        allowed.add(int(WEB_UID_OVERRIDE))
    return allowed


@auth_locked
def clear_web_auth():
    global _pairing
    _pairing = None
    _sessions.clear()


@auth_locked
def prune_web_sessions(now=None):
    if now is None:
        now = time.monotonic()
    expired = [
        token
        for token, session in _sessions.items()
        if (
            now - session["last_seen"] >= SESSION_IDLE_SECONDS
            or now - session["created"] >= SESSION_MAX_SECONDS
        )
    ]
    for token in expired:
        _sessions.pop(token, None)


@auth_locked
def create_web_session():
    now = time.monotonic()
    prune_web_sessions(now)
    token = secrets.token_urlsafe(32)
    _sessions[token] = {
        "created": now,
        "last_seen": now,
        "csrf": secrets.token_urlsafe(32),
    }
    return token


@auth_locked
def web_session_valid(token, touch=True):
    if not token:
        return False
    now = time.monotonic()
    prune_web_sessions(now)
    session = _sessions.get(token)
    if session is None:
        return False
    if touch:
        session["last_seen"] = now
    return True


@auth_locked
def revoke_web_session(token):
    if token:
        _sessions.pop(token, None)


def session_token_from_headers(headers):
    raw = headers.get("Cookie")
    if not raw:
        return None
    cookies = http.cookies.SimpleCookie()
    try:
        cookies.load(raw)
    except http.cookies.CookieError:
        return None
    morsel = cookies.get(SESSION_COOKIE_NAME)
    return morsel.value if morsel is not None else None


def session_cookie(token):
    return (
        f"{SESSION_COOKIE_NAME}={token}; "
        f"Path={SESSION_COOKIE_PATH}; HttpOnly; SameSite=Strict"
    )


def expired_session_cookie():
    return (
        f"{SESSION_COOKIE_NAME}=; "
        f"Path={SESSION_COOKIE_PATH}; HttpOnly; SameSite=Strict; Max-Age=0"
    )


def check_dir(path, description, create=False):
    try:
        st = path.lstat()
    except FileNotFoundError:
        if not create:
            raise ValueError(f"{description} is missing: {path}")
        path.mkdir(mode=0o700)
        st = path.lstat()
    if path.is_symlink() or not stat.S_ISDIR(st.st_mode):
        raise ValueError(f"{description} is not a directory: {path}")
    if st.st_uid != manager_uid() or st.st_mode & 0o022:
        raise ValueError(f"{description} has unsafe ownership or mode: {path}")


def check_file(path, description, required=True):
    try:
        st = path.lstat()
    except FileNotFoundError:
        if required:
            raise ValueError(f"{description} is missing: {path}")
        return None
    if path.is_symlink() or not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{description} is not a regular file: {path}")
    return st


def read_line(path, description, required=True):
    if check_file(path, description, required) is None:
        return None
    value = path.read_text()
    if not value.endswith("\n") or "\n" in value[:-1]:
        raise ValueError(f"{description} must contain exactly one line")
    return value[:-1]


def maintenance_enabled():
    st = check_file(MAINTENANCE_STATE, "maintenance state", required=False)
    if st is None:
        return False
    if st.st_uid != manager_uid() or st.st_mode & 0o022:
        raise ValueError("maintenance state has unsafe ownership or mode")
    if MAINTENANCE_STATE.read_text() != "enabled\n":
        raise ValueError("maintenance state is invalid")
    return True


def require_active_root():
    value = read_line(ROOT_STATUS, "Fre3nder root status")
    if value != "active":
        raise ManagementError(
            409,
            "runtime-unavailable",
            f"Fre3nder writable runtime is not active: {value}",
        )


@auth_locked
def create_pairing_code():
    global _pairing
    require_active_root()
    if not maintenance_enabled():
        raise ManagementError(
            409,
            "maintenance-disabled",
            "Maintenance Web must be enabled before creating a pairing code",
        )
    code = f"{secrets.randbelow(1_000_000):06d}"
    _pairing = {
        "code": code,
        "expires": time.monotonic() + PAIRING_TTL_SECONDS,
        "attempts": 0,
    }
    return code


@auth_locked
def redeem_pairing_code(code):
    global _pairing
    require_active_root()
    if not maintenance_enabled():
        clear_web_auth()
        raise ManagementError(
            409,
            "maintenance-disabled",
            "Maintenance Web is disabled",
        )

    now = time.monotonic()
    pairing = _pairing
    if pairing is None or now >= pairing["expires"]:
        _pairing = None
        raise ManagementError(
            401,
            "pairing-invalid",
            "pairing code is invalid or expired",
        )

    pairing["attempts"] += 1
    valid_format = isinstance(code, str) and len(code) == 6 and code.isdigit()
    valid = valid_format and hmac.compare_digest(code, pairing["code"])
    if not valid:
        if pairing["attempts"] >= PAIRING_MAX_ATTEMPTS:
            _pairing = None
        raise ManagementError(
            401,
            "pairing-invalid",
            "pairing code is invalid or expired",
        )

    _pairing = None
    return create_web_session()


@auth_locked
def set_maintenance(enabled):
    require_active_root()
    current = maintenance_enabled()
    if not enabled:
        clear_web_auth()
        if current:
            MAINTENANCE_STATE.unlink()
        return
    if current:
        return

    state_root = MAINTENANCE_STATE.parent.parent
    check_dir(state_root.parent, "management state parent")
    check_dir(state_root, "management state root", create=True)
    check_dir(MAINTENANCE_STATE.parent, "maintenance state directory", create=True)

    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=MAINTENANCE_STATE.parent,
        prefix=".enabled.",
        delete=False,
    ) as output:
        staging = pathlib.Path(output.name)
        try:
            output.write("enabled\n")
            output.flush()
            os.fsync(output.fileno())
            staging.chmod(0o644)
            os.replace(staging, MAINTENANCE_STATE)
        finally:
            staging.unlink(missing_ok=True)


def web_status():
    try:
        return read_line(WEB_STATUS, "web status", required=False) or "stopped"
    except (OSError, ValueError):
        return "unknown"


def refresh_web():
    try:
        result = subprocess.run(
            [str(WEB_SERVICE), "restart"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return "failed"
    return "requested" if result.returncode == 0 else "failed"


def response(operation, **fields):
    value = {"api_version": API_VERSION, "ok": True, "operation": operation}
    value.update(fields)
    return value


def error(code, message):
    return {
        "api_version": API_VERSION,
        "ok": False,
        "error": {"code": code, "message": message},
    }


def package_directory():
    for path in (OTA_PACKAGES, *OTA_PACKAGES.parents):
        if path.is_symlink():
            raise ManagementError(409, "storage-unsafe", "OTA storage contains a symlink")
    check_dir(OTA_PACKAGES, "OTA package directory")
    return OTA_PACKAGES


def package_path(package_id):
    if not isinstance(package_id, str) or re.fullmatch(r"[0-9a-f]{32}", package_id) is None:
        raise ManagementError(400, "invalid-package", "invalid OTA package ID")
    path = package_directory() / (package_id + ".ota")
    try:
        metadata = check_file(path, "OTA package", required=False)
    except ValueError as exc:
        raise ManagementError(409, "storage-unsafe", "OTA package is not a regular non-symlink file") from exc
    if metadata is None:
        raise ManagementError(404, "package-unavailable", "The staged OTA package is unavailable")
    if metadata.st_uid != manager_uid() or metadata.st_mode & 0o022:
        raise ManagementError(409, "storage-unsafe", "OTA package has unsafe ownership or mode")
    return path


def upload_space(remaining=0):
    directory = package_directory()
    for path in (OTA_UPLOAD_BUFFER, *OTA_UPLOAD_BUFFER.parents):
        if path.is_symlink():
            raise ManagementError(409, "storage-unsafe", "Upload buffer contains a symlink")
    metadata = OTA_UPLOAD_BUFFER.stat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != manager_uid() or metadata.st_mode & 0o007:
        raise ManagementError(409, "storage-unsafe", "Upload buffer has unsafe ownership or permissions")
    fs = os.statvfs(directory)
    proxy_fs = os.statvfs(OTA_UPLOAD_BUFFER)
    available = fs.f_bavail * fs.f_frsize
    proxy_available = proxy_fs.f_bavail * proxy_fs.f_frsize
    same_filesystem = directory.stat().st_dev == metadata.st_dev
    required = remaining * (2 if same_filesystem else 1) + OTA_SPACE_RESERVE
    if remaining and (available < required or proxy_available < required):
        raise ManagementError(507, "insufficient-space", "Not enough SYS staging or HOME proxy space for the upload and operating reserve")
    return {
        "available_bytes": available,
        "max_package_bytes": OTA_UPLOAD_LIMIT,
        "reserve_bytes": OTA_SPACE_RESERVE,
        "proxy_copy_reserved": True,
        "proxy_available_bytes": proxy_available,
    }


def store_execution(value):
    global _execution
    check_dir(OTA_EXECUTION.parent, "management runtime directory")
    check_file(OTA_EXECUTION, "OTA execution status", required=False)
    with tempfile.NamedTemporaryFile(mode="w", dir=OTA_EXECUTION.parent, prefix=".ota-execution.", delete=False) as output:
        staging = pathlib.Path(output.name)
        try:
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
            os.replace(staging, OTA_EXECUTION)
        finally:
            staging.unlink(missing_ok=True)
    _execution = value


def restore_execution():
    global _execution
    metadata = check_file(OTA_EXECUTION, "OTA execution status", required=False)
    if metadata is None:
        return
    if metadata.st_uid != manager_uid() or metadata.st_mode & 0o077 or metadata.st_size > 256 * 1024:
        raise ValueError("unsafe OTA execution status")
    value = json.loads(OTA_EXECUTION.read_text())
    if not isinstance(value, dict) or value.get("state") not in ("uploading", "running", "succeeded", "failed", "unknown"):
        raise ValueError("invalid OTA execution status")
    if value["state"] in ("running", "uploading"):
        value["state"] = "unknown"
        value["error"] = {"code": "execution-unknown", "message": "Management restarted during OTA; completion is unknown. Inspect the Core state before proceeding."}
    _execution = value
    # Uploads are never published until complete. No Core consumes these files.
    for staging in package_directory().glob(".upload-*.part"):
        check_file(staging, "incomplete OTA upload")
        staging.unlink()


def run_ota_core(operation, arguments=()):
    environment = {key: value for key, value in os.environ.items() if not key.startswith("FRE3NDER_")}
    try:
        result = subprocess.run(
            [str(OTA_CORE), operation, *arguments], stdin=subprocess.DEVNULL,
            capture_output=True, text=True, check=False, env=environment,
        )
        value = json.loads(result.stdout)
    except (OSError, UnicodeError, ValueError) as exc:
        raise ManagementError(502, "ota-core-unavailable", "OTA Core could not return a valid response") from exc
    if not isinstance(value, dict) or value.get("api_version") != API_VERSION or value.get("operation") != operation or type(value.get("ok")) is not bool:
        raise ManagementError(502, "ota-core-invalid", "OTA Core returned an incompatible response")
    if result.returncode != 0 or not value["ok"]:
        message = value.get("error")
        raise ManagementError(409, "ota-operation-failed", message if isinstance(message, str) else "OTA operation failed")
    return value


def require_ota_idle():
    if _execution and _execution["state"] in ("uploading", "running", "unknown"):
        raise ManagementError(409, "ota-busy", "An OTA operation is running or its completion is unknown")
    if run_ota_core("status").get("busy"):
        raise ManagementError(409, "ota-busy", "An OTA operation is active through another interface")


def execute_ota(execution, arguments):
    try:
        result = run_ota_core(execution["operation"], arguments)
        completed = {**execution, "state": "succeeded", "result": result}
    except ManagementError as exc:
        completed = {**execution, "state": "failed", "error": {"code": exc.code, "message": exc.message}}
    except Exception:
        completed = {**execution, "state": "unknown", "error": {"code": "execution-unknown", "message": "OTA execution outcome is unknown"}}
    with _ota_lock:
        try:
            store_execution(completed)
        except OSError:
            # The Core outcome survives a disconnected browser even if /run fails.
            global _execution
            _execution = {**completed, "state": "unknown"}


def start_ota(operation, payload, reserved=False):
    with _ota_lock:
        if not reserved:
            require_ota_idle()
        fields = {"transaction_id"} if operation == "reboot" else {"package_id"}
        if operation in ("backup-plan", "backup"):
            fields |= {"home", "sys"}
        elif operation in ("confirm", "write", "readback", "prepare-activation"):
            fields.add("transaction_id")
        if set(payload) != fields:
            raise ManagementError(400, "invalid-request", "OTA arguments are incomplete or unsupported")
        arguments = [] if operation == "reboot" else [str(package_path(payload["package_id"]))]
        if "home" in fields:
            if payload["home"] not in ("usb", "none") or payload["sys"] not in ("usb", "home", "none"):
                raise ManagementError(400, "invalid-selection", "Invalid HOME/SYS backup selection")
            arguments.append("--home" if payload["home"] == "usb" else "--no-home")
            arguments.extend(["--no-sys"] if payload["sys"] == "none" else ["--sys", payload["sys"]])
        if "transaction_id" in fields:
            transaction_id = payload["transaction_id"]
            if not isinstance(transaction_id, str) or re.fullmatch(r"[0-9a-f]{32}", transaction_id) is None:
                raise ManagementError(400, "invalid-transaction", "Invalid OTA transaction ID")
            arguments.append(transaction_id)
        execution = {"id": secrets.token_hex(16), "state": "running", "operation": operation, **payload}
        store_execution(execution)
        threading.Thread(target=execute_ota, args=(execution, arguments), daemon=True).start()
        return execution


def ota_status():
    core = run_ota_core("status")
    packages = []
    for path in sorted(package_directory().glob("*.ota")):
        package_id = path.stem
        if re.fullmatch(r"[0-9a-f]{32}", package_id):
            metadata = package_path(package_id).stat()
            packages.append({"id": package_id, "size": metadata.st_size})
    with _ota_lock:
        execution = _execution
    return {"core": core, "execution": execution, "packages": packages, "storage": upload_space()}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "Fre3nderManagement/1"
    sys_version = ""
    protocol_version = "HTTP/1.0"

    def setup(self):
        super().setup()
        self.connection.settimeout(60)

    def address_string(self):
        return "local"

    def log_message(self, _format, *_args):
        pass

    def send_json(self, status, value, extra_headers=()):
        body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode() + b"\n"
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for name, header_value in extra_headers:
            self.send_header(name, header_value)
        try:
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            # Execution was accepted independently; a lost reply is not a failure.
            pass

    def peer_credentials(self):
        raw = self.connection.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
        )
        return struct.unpack("3i", raw)

    def peer_uid(self):
        return self.peer_credentials()[1]

    def is_screen_peer(self):
        # Linux SO_PEERCRED primary GID is set only by root's Package-Core for
        # a protected, officially signed Fre3nderScreen runtime.
        try:
            uid = pwd.getpwnam("fre3nder").pw_uid
            gid = grp.getgrnam(MANAGEMENT_GROUP).gr_gid
        except KeyError:
            return False
        _, peer_uid, peer_gid = self.peer_credentials()
        return peer_uid == uid and peer_gid == gid

    def require_admin(self):
        if self.peer_uid() not in mutation_uids() and not self.is_screen_peer():
            raise ManagementError(
                403,
                "forbidden",
                "operation is not permitted for this local client",
            )

    def require_screen_or_web_session(self):
        if self.is_screen_peer():
            return
        self.require_web_peer()
        if self.current_web_session(touch=True) is None:
            raise ManagementError(401, "authentication-required", "Browser administrative session is not authenticated")

    def require_screen_or_web_admin(self):
        if not self.is_screen_peer():
            self.require_web_admin()

    def require_web_peer(self):
        if self.peer_uid() not in web_uids():
            raise ManagementError(
                403,
                "forbidden",
                "browser authentication is not permitted for this local client",
            )

    def request_length(self):
        if self.headers.get("Transfer-Encoding") is not None:
            raise ManagementError(
                400,
                "invalid-request",
                "Transfer-Encoding is not supported",
            )
        lengths = self.headers.get_all("Content-Length", [])
        value = lengths[0] if len(lengths) == 1 else None
        if len(lengths) > 1:
            raise ManagementError(400, "invalid-request", "ambiguous Content-Length")
        if value is None:
            return None
        if re.fullmatch(r"[0-9]+", value) is None:
            raise ManagementError(400, "invalid-request", "invalid Content-Length")
        try:
            length = int(value)
        except ValueError as exc:
            raise ManagementError(
                400,
                "invalid-request",
                "invalid Content-Length",
            ) from exc
        if length < 0:
            raise ManagementError(
                400,
                "invalid-request",
                "invalid Content-Length",
            )
        return length

    def require_empty_body(self):
        length = self.request_length()
        if length not in (None, 0):
            raise ManagementError(
                400,
                "invalid-request",
                "request body is not supported",
            )

    def read_json_body(self):
        length = self.request_length()
        if length is None:
            raise ManagementError(
                411,
                "length-required",
                "Content-Length is required",
            )
        if length == 0:
            raise ManagementError(
                400,
                "invalid-request",
                "JSON request body is required",
            )
        if length > 256:
            raise ManagementError(
                413,
                "request-too-large",
                "request body is too large",
            )
        if self.headers.get_content_type() != "application/json":
            raise ManagementError(
                415,
                "unsupported-media-type",
                "Content-Type must be application/json",
            )
        try:
            body = self.rfile.read(length)
            if len(body) != length:
                raise ManagementError(400, "invalid-request", "incomplete JSON request")
            payload = json.loads(body)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ManagementError(
                400,
                "invalid-request",
                "request body is not valid JSON",
            ) from exc
        if not isinstance(payload, dict):
            raise ManagementError(
                400,
                "invalid-request",
                "request body must be a JSON object",
            )
        return payload

    @auth_locked
    def current_web_session(self, touch=False):
        if not maintenance_enabled():
            clear_web_auth()
            return None
        token = session_token_from_headers(self.headers)
        if not web_session_valid(token, touch=touch):
            return None
        return token

    def require_maintenance_origin(self):
        origin = self.headers.get("Origin")
        host = self.headers.get("Host")
        if not origin or not host:
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            )
        try:
            origin_url = urllib.parse.urlsplit(origin)
            host_url = urllib.parse.urlsplit("//" + host)
            origin_port = origin_url.port
            host_port = host_url.port
        except ValueError as exc:
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            ) from exc

        if (
            origin_url.scheme != "http"
            or origin_url.path
            or origin_url.query
            or origin_url.fragment
            or origin_url.username is not None
            or origin_url.password is not None
            or origin_url.hostname is None
            or host_url.hostname is None
            or origin_port != MAINTENANCE_PORT
            or host_port != MAINTENANCE_PORT
            or origin_url.hostname.lower() != host_url.hostname.lower()
        ):
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            )

    @auth_locked
    def require_web_admin(self):
        self.require_web_peer()
        self.require_maintenance_origin()
        token = self.current_web_session(touch=False)
        if token is None:
            raise ManagementError(
                401,
                "authentication-required",
                "browser administrative session is not authenticated",
            )

        supplied = self.headers.get(CSRF_HEADER)
        expected = _sessions[token]["csrf"]
        if (
            not isinstance(supplied, str)
            or not hmac.compare_digest(supplied, expected)
        ):
            raise ManagementError(
                403,
                "csrf-invalid",
                "browser administrative request is not authorized",
            )

        _sessions[token]["last_seen"] = time.monotonic()
        return token

    @auth_locked
    def auth_state(self, token):
        if token not in _sessions:
            token = None
        state = {
            "authenticated": token is not None,
            "idle_timeout_seconds": SESSION_IDLE_SECONDS,
            "max_age_seconds": SESSION_MAX_SECONDS,
        }
        if token is not None:
            state["csrf_token"] = _sessions[token]["csrf"]
        return state

    def fail(self, exc):
        if isinstance(exc, apps.AppError):
            self.send_json(exc.status, error(exc.code, exc.message))
            return
        if isinstance(exc, ManagementError):
            self.send_json(exc.status, error(exc.code, exc.message))
            return
        print(f"fre3nder management: {exc}", file=sys.stderr)
        self.send_json(500, error("internal-error", "management operation failed"))

    def do_GET(self):
        try:
            if self.path == "/fre3nder/api/v1/system/details":
                if self.peer_uid() not in mutation_uids():
                    self.require_screen_or_web_session()
                with _ota_lock:
                    execution = _execution
                self.send_json(200, response("system-details", system=system_info.snapshot(
                    VERSION_FILE, ROOT_STATUS, maintenance_enabled, WEB_STATUS, execution)))
                return
            if self.path == "/fre3nder/api/v1/apps/status":
                self.require_screen_or_web_session()
                self.send_json(200, response("apps-status", apps=apps.overview()))
                return
            if self.path.startswith("/fre3nder/api/v1/apps/detail?"):
                self.require_screen_or_web_session()
                query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query, strict_parsing=True)
                if set(query) != {"name"} or len(query["name"]) != 1:
                    raise ManagementError(400, "invalid-request", "Expected exactly one app name")
                self.send_json(200, response("apps-detail", app=apps.details(query["name"][0])))
                return
            if self.path == "/fre3nder/api/v1/ota/status":
                self.require_screen_or_web_session()
                self.send_json(200, response("ota-status", ota=ota_status()))
                return
            if self.path == "/fre3nder/api/v1/system":
                system = {
                    "version": read_line(VERSION_FILE, "Fre3nder version"),
                    "root_status": read_line(
                        ROOT_STATUS, "Fre3nder root status", required=False
                    )
                    or "unavailable",
                }
                self.send_json(200, response("system-status", system=system))
                return
            if self.path == "/fre3nder/api/v1/maintenance":
                state = {
                    "enabled": maintenance_enabled(),
                    "web_status": web_status(),
                }
                self.send_json(200, response("maintenance-status", maintenance=state))
                return
            if self.path == "/fre3nder/api/v1/auth/session":
                self.require_web_peer()
                raw_token = session_token_from_headers(self.headers)
                token = self.current_web_session()
                headers = ()
                if raw_token and token is None:
                    headers = (("Set-Cookie", expired_session_cookie()),)
                self.send_json(
                    200,
                    response(
                        "auth-session",
                        auth=self.auth_state(token),
                    ),
                    headers,
                )
                return
            raise ManagementError(404, "not-found", "management endpoint does not exist")
        except (ManagementError, apps.AppError, OSError, ValueError, RuntimeError) as exc:
            self.fail(exc)

    def do_POST(self):
        try:
            app_prefix = "/fre3nder/api/v1/apps/"
            if self.path.startswith(app_prefix):
                operation = self.path[len(app_prefix):]
                operations = {
                    "upload": None, "verify": "verify", "install": "install",
                    "update": "update", "remove": "remove",
                    "display/select": "display-select", "display/disable": "display-disable",
                    "discard": None, "acknowledge": None,
                }
                if operation not in operations:
                    raise ManagementError(404, "not-found", "Apps endpoint does not exist")
                self.require_screen_or_web_admin()
                require_active_root()
                with _ota_lock:
                    require_ota_idle()
                    if operation == "upload":
                        if self.headers.get_content_type() != "application/octet-stream":
                            raise ManagementError(415, "unsupported-media-type", "App upload requires application/octet-stream")
                        filename = urllib.parse.unquote(self.headers.get("X-Fre3nder-Filename", ""))
                        job = apps.upload(self.rfile, self.request_length(), filename)
                    else:
                        payload = self.read_json_body()
                        if operation == "discard":
                            if set(payload) != {"package_id"}:
                                raise ManagementError(400, "invalid-request", "Expected package_id")
                            value = apps.discard(payload["package_id"])
                            self.send_json(200, response("apps-discard", discarded=value))
                            return
                        if operation == "acknowledge":
                            if payload:
                                raise ManagementError(400, "invalid-request", "Expected empty object")
                            apps.acknowledge()
                            self.send_json(200, response("apps-acknowledge"))
                            return
                        job = apps.start(operations[operation], payload)
                self.send_json(202, response("apps-accepted", execution=job))
                return
            prefix = "/fre3nder/api/v1/ota/"
            if self.path.startswith(prefix):
                operation = self.path[len(prefix):]
                if operation not in (*OTA_OPERATIONS, "upload"):
                    raise ManagementError(404, "not-found", "OTA endpoint does not exist")
                self.require_screen_or_web_admin()
                require_active_root()
                with _ota_lock:
                    if apps.running():
                        raise ManagementError(409, "apps-busy", "An app operation is active or its outcome is unknown")
                    if operation == "upload":
                        execution = self.upload_ota()
                    else:
                        execution = start_ota(operation, self.read_json_body())
                self.send_json(202, response("ota-accepted", execution=execution))
                return
            actions = {
                "/fre3nder/api/v1/maintenance/enable": (True, "maintenance-enable"),
                "/fre3nder/api/v1/maintenance/disable": (False, "maintenance-disable"),
            }
            if self.path in actions:
                self.require_empty_body()
                self.require_admin()
                enabled, operation = actions[self.path]
                already_active = (
                    enabled and maintenance_enabled() and web_status() == "active"
                )
                set_maintenance(enabled)
                refresh = "not-needed" if already_active else refresh_web()
                state = {
                    "enabled": maintenance_enabled(),
                    "web_status": web_status(),
                }
                self.send_json(
                    200,
                    response(
                        operation,
                        maintenance=state,
                        web_refresh=refresh,
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/maintenance/unlock":
                self.require_empty_body()
                self.require_admin()
                code = create_pairing_code()
                self.send_json(
                    200,
                    response(
                        "maintenance-unlock",
                        auth={
                            "pairing_code": code,
                            "expires_in_seconds": PAIRING_TTL_SECONDS,
                        },
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/maintenance/lock":
                self.require_empty_body()
                self.require_admin()
                clear_web_auth()
                self.send_json(
                    200,
                    response(
                        "maintenance-lock",
                        auth={"locked": True},
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/auth/unlock":
                self.require_web_peer()
                self.require_maintenance_origin()
                payload = self.read_json_body()
                token = redeem_pairing_code(payload.get("code"))
                self.send_json(
                    200,
                    response(
                        "auth-unlock",
                        auth=self.auth_state(token),
                    ),
                    (("Set-Cookie", session_cookie(token)),),
                )
                return

            if self.path == "/fre3nder/api/v1/auth/lock":
                self.require_empty_body()
                token = self.require_web_admin()
                revoke_web_session(token)
                self.send_json(
                    200,
                    response(
                        "auth-lock",
                        auth=self.auth_state(None),
                    ),
                    (("Set-Cookie", expired_session_cookie()),),
                )
                return

            raise ManagementError(
                404,
                "not-found",
                "management endpoint does not exist",
            )
        except (ManagementError, apps.AppError, OSError, ValueError, RuntimeError) as exc:
            self.fail(exc)

    def upload_ota(self):
        length = self.request_length()
        if length is None:
            raise ManagementError(411, "length-required", "Content-Length is required")
        if length <= 0 or length > OTA_UPLOAD_LIMIT:
            raise ManagementError(413, "request-too-large", "OTA upload must be between 1 byte and 96 MiB")
        if self.headers.get_content_type() != "application/octet-stream":
            raise ManagementError(415, "unsupported-media-type", "OTA upload requires application/octet-stream")
        name = urllib.parse.unquote(self.headers.get("X-Fre3nder-Filename", ""))
        if not name.endswith(".ota") or len(name) > 255 or any(c in name for c in "/\\\x00\r\n"):
            raise ManagementError(400, "invalid-filename", "Select a local .ota file; server paths are not accepted")
        with _ota_lock:
            require_ota_idle()
            upload_space(length)
            package_id = secrets.token_hex(16)
            store_execution({"id": secrets.token_hex(16), "operation": "upload", "package_id": package_id, "state": "uploading"})
        staging = None
        try:
            with tempfile.NamedTemporaryFile(mode="wb", dir=package_directory(), prefix=".upload-", suffix=".part", delete=False) as output:
                staging = pathlib.Path(output.name)
                remaining = length
                while remaining:
                    upload_space(remaining)
                    chunk = self.rfile.read(min(64 * 1024, remaining))
                    if not chunk:
                        raise ManagementError(400, "upload-incomplete", "OTA upload ended before Content-Length")
                    output.write(chunk)
                    remaining -= len(chunk)
                output.flush()
                os.fsync(output.fileno())
            # Atomic publication without replacing an existing package.
            os.link(staging, OTA_PACKAGES / (package_id + ".ota"))
            staging.unlink()
            return start_ota("verify", {"package_id": package_id}, reserved=True)
        except (OSError, ManagementError) as exc:
            failure = exc if isinstance(exc, ManagementError) else ManagementError(
                507 if getattr(exc, "errno", None) == 28 else 400,
                "upload-failed", "OTA upload could not be completed; no incomplete package was published",
            )
            with _ota_lock:
                store_execution({"id": secrets.token_hex(16), "operation": "upload", "package_id": package_id, "state": "failed", "error": {"code": failure.code, "message": failure.message}})
            raise failure
        finally:
            if staging is not None:
                staging.unlink(missing_ok=True)

    def do_PUT(self):
        self.send_json(405, error("method-not-allowed", "HTTP method is not supported"))

    do_DELETE = do_PUT
    do_PATCH = do_PUT


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    allow_reuse_address = False
    daemon_threads = True


def prepare_socket():
    check_dir(SOCKET_PATH.parent, "management runtime directory")
    try:
        st = SOCKET_PATH.lstat()
    except FileNotFoundError:
        return
    if SOCKET_PATH.is_symlink() or not stat.S_ISSOCK(st.st_mode):
        raise ValueError(f"management socket path is unsafe: {SOCKET_PATH}")
    if st.st_uid != manager_uid():
        raise ValueError(f"management socket has unsafe ownership: {SOCKET_PATH}")
    SOCKET_PATH.unlink()


def serve():
    if os.geteuid() != 0:
        raise RuntimeError("management daemon must run as root")
    prepare_socket()
    restore_execution()
    apps.restore()
    try:
        group = grp.getgrnam(MANAGEMENT_GROUP)
    except KeyError as exc:
        raise RuntimeError(f"management group is unavailable: {MANAGEMENT_GROUP}") from exc

    server = Server(str(SOCKET_PATH), Handler)
    try:
        os.chown(SOCKET_PATH, 0, group.gr_gid)
        os.chmod(SOCKET_PATH, 0o660)
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()


if __name__ == "__main__":
    try:
        serve()
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"fre3nder management: {exc}", file=sys.stderr)
        raise SystemExit(1)
