#!/usr/bin/python3
"""Local privileged management API for Fre3nder."""

import grp
import hmac
import http.cookies
import http.server
import json
import os
import pathlib
import pwd
import secrets
import socket
import socketserver
import stat
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse


API_VERSION = 1
SOCKET_PATH = pathlib.Path(
    os.environ.get("FRE3NDER_MANAGEMENT_SOCKET", "/run/fre3nder-management/api.sock")
)
MANAGEMENT_GROUP = os.environ.get(
    "FRE3NDER_MANAGEMENT_GROUP", "fre3nder-management"
)
MAINTENANCE_STATE = pathlib.Path(
    os.environ.get(
        "FRE3NDER_MAINTENANCE_STATE", "/home/.fre3nder/maintenance/enabled"
    )
)
VERSION_FILE = pathlib.Path(
    os.environ.get("FRE3NDER_VERSION_FILE", "/usr/share/fre3nder/VERSION")
)
ROOT_STATUS = pathlib.Path(
    os.environ.get("FRE3NDER_ROOT_STATUS", "/run/fre3nder-root/status")
)
WEB_STATUS = pathlib.Path(
    os.environ.get("FRE3NDER_WEB_STATUS", "/run/fre3nder-maintenance-web/status")
)
WEB_SERVICE = pathlib.Path(
    os.environ.get(
        "FRE3NDER_WEB_SERVICE", "/etc/init.d/S62fre3nder-maintenance-web"
    )
)
WEB_USER = os.environ.get("FRE3NDER_MANAGEMENT_WEB_USER", "nobody")

PAIRING_TTL_SECONDS = 10 * 60
PAIRING_MAX_ATTEMPTS = 5
SESSION_IDLE_SECONDS = 30 * 60
SESSION_MAX_SECONDS = 8 * 60 * 60
SESSION_COOKIE_NAME = "fre3nder_admin"
SESSION_COOKIE_PATH = "/fre3nder/api/v1/"
MAINTENANCE_PORT = 8081
CSRF_HEADER = "X-Fre3nder-CSRF"

# Host tests may override these after import. Production mutation authority is
# always UID 0, while browser-auth endpoints are accepted only from the
# configured Lighttpd worker UID.
ADMIN_UID_OVERRIDE = None
WEB_UID_OVERRIDE = None

_pairing = None
_sessions = {}


class ManagementError(Exception):
    def __init__(self, status, code, message):
        super().__init__(message)
        self.status = status
        self.code = code
        self.message = message


def manager_uid():
    return os.geteuid()


def mutation_uids():
    allowed = {0}
    if ADMIN_UID_OVERRIDE is not None:
        allowed.add(int(ADMIN_UID_OVERRIDE))
    return allowed


def web_uids():
    allowed = set()
    try:
        allowed.add(pwd.getpwnam(WEB_USER).pw_uid)
    except KeyError:
        pass
    if WEB_UID_OVERRIDE is not None:
        allowed.add(int(WEB_UID_OVERRIDE))
    return allowed


def clear_web_auth():
    global _pairing
    _pairing = None
    _sessions.clear()


def prune_web_sessions(now=None):
    if now is None:
        now = time.monotonic()
    expired = [
        token
        for token, session in _sessions.items()
        if (
            now - session["last_seen"] >= SESSION_IDLE_SECONDS
            or now - session["created"] >= SESSION_MAX_SECONDS
        )
    ]
    for token in expired:
        _sessions.pop(token, None)


def create_web_session():
    now = time.monotonic()
    prune_web_sessions(now)
    token = secrets.token_urlsafe(32)
    _sessions[token] = {
        "created": now,
        "last_seen": now,
        "csrf": secrets.token_urlsafe(32),
    }
    return token


def web_session_valid(token, touch=True):
    if not token:
        return False
    now = time.monotonic()
    prune_web_sessions(now)
    session = _sessions.get(token)
    if session is None:
        return False
    if touch:
        session["last_seen"] = now
    return True


def revoke_web_session(token):
    if token:
        _sessions.pop(token, None)


def session_token_from_headers(headers):
    raw = headers.get("Cookie")
    if not raw:
        return None
    cookies = http.cookies.SimpleCookie()
    try:
        cookies.load(raw)
    except http.cookies.CookieError:
        return None
    morsel = cookies.get(SESSION_COOKIE_NAME)
    return morsel.value if morsel is not None else None


def session_cookie(token):
    return (
        f"{SESSION_COOKIE_NAME}={token}; "
        f"Path={SESSION_COOKIE_PATH}; HttpOnly; SameSite=Strict"
    )


def expired_session_cookie():
    return (
        f"{SESSION_COOKIE_NAME}=; "
        f"Path={SESSION_COOKIE_PATH}; HttpOnly; SameSite=Strict; Max-Age=0"
    )


def check_dir(path, description, create=False):
    try:
        st = path.lstat()
    except FileNotFoundError:
        if not create:
            raise ValueError(f"{description} is missing: {path}")
        path.mkdir(mode=0o700)
        st = path.lstat()
    if path.is_symlink() or not stat.S_ISDIR(st.st_mode):
        raise ValueError(f"{description} is not a directory: {path}")
    if st.st_uid != manager_uid() or st.st_mode & 0o022:
        raise ValueError(f"{description} has unsafe ownership or mode: {path}")


def check_file(path, description, required=True):
    try:
        st = path.lstat()
    except FileNotFoundError:
        if required:
            raise ValueError(f"{description} is missing: {path}")
        return None
    if path.is_symlink() or not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{description} is not a regular file: {path}")
    return st


def read_line(path, description, required=True):
    if check_file(path, description, required) is None:
        return None
    value = path.read_text()
    if not value.endswith("\n") or "\n" in value[:-1]:
        raise ValueError(f"{description} must contain exactly one line")
    return value[:-1]


def maintenance_enabled():
    st = check_file(MAINTENANCE_STATE, "maintenance state", required=False)
    if st is None:
        return False
    if st.st_uid != manager_uid() or st.st_mode & 0o022:
        raise ValueError("maintenance state has unsafe ownership or mode")
    if MAINTENANCE_STATE.read_text() != "enabled\n":
        raise ValueError("maintenance state is invalid")
    return True


def require_active_root():
    value = read_line(ROOT_STATUS, "Fre3nder root status")
    if value != "active":
        raise ManagementError(
            409,
            "runtime-unavailable",
            f"Fre3nder writable runtime is not active: {value}",
        )


def create_pairing_code():
    global _pairing
    require_active_root()
    if not maintenance_enabled():
        raise ManagementError(
            409,
            "maintenance-disabled",
            "Maintenance Web must be enabled before creating a pairing code",
        )
    code = f"{secrets.randbelow(1_000_000):06d}"
    _pairing = {
        "code": code,
        "expires": time.monotonic() + PAIRING_TTL_SECONDS,
        "attempts": 0,
    }
    return code


def redeem_pairing_code(code):
    global _pairing
    require_active_root()
    if not maintenance_enabled():
        clear_web_auth()
        raise ManagementError(
            409,
            "maintenance-disabled",
            "Maintenance Web is disabled",
        )

    now = time.monotonic()
    pairing = _pairing
    if pairing is None or now >= pairing["expires"]:
        _pairing = None
        raise ManagementError(
            401,
            "pairing-invalid",
            "pairing code is invalid or expired",
        )

    pairing["attempts"] += 1
    valid_format = isinstance(code, str) and len(code) == 6 and code.isdigit()
    valid = valid_format and hmac.compare_digest(code, pairing["code"])
    if not valid:
        if pairing["attempts"] >= PAIRING_MAX_ATTEMPTS:
            _pairing = None
        raise ManagementError(
            401,
            "pairing-invalid",
            "pairing code is invalid or expired",
        )

    _pairing = None
    return create_web_session()


def set_maintenance(enabled):
    require_active_root()
    current = maintenance_enabled()
    if not enabled:
        clear_web_auth()
        if current:
            MAINTENANCE_STATE.unlink()
        return
    if current:
        return

    state_root = MAINTENANCE_STATE.parent.parent
    check_dir(state_root.parent, "management state parent")
    check_dir(state_root, "management state root", create=True)
    check_dir(MAINTENANCE_STATE.parent, "maintenance state directory", create=True)

    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=MAINTENANCE_STATE.parent,
        prefix=".enabled.",
        delete=False,
    ) as output:
        staging = pathlib.Path(output.name)
        try:
            output.write("enabled\n")
            output.flush()
            os.fsync(output.fileno())
            staging.chmod(0o644)
            os.replace(staging, MAINTENANCE_STATE)
        finally:
            staging.unlink(missing_ok=True)


def web_status():
    try:
        return read_line(WEB_STATUS, "web status", required=False) or "stopped"
    except (OSError, ValueError):
        return "unknown"


def refresh_web():
    try:
        result = subprocess.run(
            [str(WEB_SERVICE), "restart"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return "failed"
    return "requested" if result.returncode == 0 else "failed"


def response(operation, **fields):
    value = {"api_version": API_VERSION, "ok": True, "operation": operation}
    value.update(fields)
    return value


def error(code, message):
    return {
        "api_version": API_VERSION,
        "ok": False,
        "error": {"code": code, "message": message},
    }


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "Fre3nderManagement/1"
    sys_version = ""
    protocol_version = "HTTP/1.0"

    def address_string(self):
        return "local"

    def log_message(self, _format, *_args):
        pass

    def send_json(self, status, value, extra_headers=()):
        body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode() + b"\n"
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for name, header_value in extra_headers:
            self.send_header(name, header_value)
        self.end_headers()
        self.wfile.write(body)

    def peer_uid(self):
        raw = self.connection.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
        )
        return struct.unpack("3i", raw)[1]

    def require_admin(self):
        if self.peer_uid() not in mutation_uids():
            raise ManagementError(
                403,
                "forbidden",
                "operation is not permitted for this local client",
            )

    def require_web_peer(self):
        if self.peer_uid() not in web_uids():
            raise ManagementError(
                403,
                "forbidden",
                "browser authentication is not permitted for this local client",
            )

    def request_length(self):
        if self.headers.get("Transfer-Encoding") is not None:
            raise ManagementError(
                400,
                "invalid-request",
                "Transfer-Encoding is not supported",
            )
        value = self.headers.get("Content-Length")
        if value is None:
            return None
        try:
            length = int(value)
        except ValueError as exc:
            raise ManagementError(
                400,
                "invalid-request",
                "invalid Content-Length",
            ) from exc
        if length < 0:
            raise ManagementError(
                400,
                "invalid-request",
                "invalid Content-Length",
            )
        return length

    def require_empty_body(self):
        length = self.request_length()
        if length not in (None, 0):
            raise ManagementError(
                400,
                "invalid-request",
                "request body is not supported",
            )

    def read_json_body(self):
        length = self.request_length()
        if length is None:
            raise ManagementError(
                411,
                "length-required",
                "Content-Length is required",
            )
        if length == 0:
            raise ManagementError(
                400,
                "invalid-request",
                "JSON request body is required",
            )
        if length > 256:
            raise ManagementError(
                413,
                "request-too-large",
                "request body is too large",
            )
        if self.headers.get_content_type() != "application/json":
            raise ManagementError(
                415,
                "unsupported-media-type",
                "Content-Type must be application/json",
            )
        try:
            payload = json.loads(self.rfile.read(length))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ManagementError(
                400,
                "invalid-request",
                "request body is not valid JSON",
            ) from exc
        if not isinstance(payload, dict):
            raise ManagementError(
                400,
                "invalid-request",
                "request body must be a JSON object",
            )
        return payload

    def current_web_session(self, touch=False):
        if not maintenance_enabled():
            clear_web_auth()
            return None
        token = session_token_from_headers(self.headers)
        if not web_session_valid(token, touch=touch):
            return None
        return token

    def require_maintenance_origin(self):
        origin = self.headers.get("Origin")
        host = self.headers.get("Host")
        if not origin or not host:
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            )
        try:
            origin_url = urllib.parse.urlsplit(origin)
            host_url = urllib.parse.urlsplit("//" + host)
            origin_port = origin_url.port
            host_port = host_url.port
        except ValueError as exc:
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            ) from exc

        if (
            origin_url.scheme != "http"
            or origin_url.path
            or origin_url.query
            or origin_url.fragment
            or origin_url.username is not None
            or origin_url.password is not None
            or origin_url.hostname is None
            or host_url.hostname is None
            or origin_port != MAINTENANCE_PORT
            or host_port != MAINTENANCE_PORT
            or origin_url.hostname.lower() != host_url.hostname.lower()
        ):
            raise ManagementError(
                403,
                "origin-invalid",
                "browser request origin is not permitted",
            )

    def require_web_admin(self):
        self.require_web_peer()
        self.require_maintenance_origin()
        token = self.current_web_session(touch=False)
        if token is None:
            raise ManagementError(
                401,
                "authentication-required",
                "browser administrative session is not authenticated",
            )

        supplied = self.headers.get(CSRF_HEADER)
        expected = _sessions[token]["csrf"]
        if (
            not isinstance(supplied, str)
            or not hmac.compare_digest(supplied, expected)
        ):
            raise ManagementError(
                403,
                "csrf-invalid",
                "browser administrative request is not authorized",
            )

        _sessions[token]["last_seen"] = time.monotonic()
        return token

    def auth_state(self, token):
        state = {
            "authenticated": token is not None,
            "idle_timeout_seconds": SESSION_IDLE_SECONDS,
            "max_age_seconds": SESSION_MAX_SECONDS,
        }
        if token is not None:
            state["csrf_token"] = _sessions[token]["csrf"]
        return state

    def fail(self, exc):
        if isinstance(exc, ManagementError):
            self.send_json(exc.status, error(exc.code, exc.message))
            return
        print(f"fre3nder management: {exc}", file=sys.stderr)
        self.send_json(500, error("internal-error", "management operation failed"))

    def do_GET(self):
        try:
            if self.path == "/fre3nder/api/v1/system":
                system = {
                    "version": read_line(VERSION_FILE, "Fre3nder version"),
                    "root_status": read_line(
                        ROOT_STATUS, "Fre3nder root status", required=False
                    )
                    or "unavailable",
                }
                self.send_json(200, response("system-status", system=system))
                return
            if self.path == "/fre3nder/api/v1/maintenance":
                state = {
                    "enabled": maintenance_enabled(),
                    "web_status": web_status(),
                }
                self.send_json(200, response("maintenance-status", maintenance=state))
                return
            if self.path == "/fre3nder/api/v1/auth/session":
                self.require_web_peer()
                raw_token = session_token_from_headers(self.headers)
                token = self.current_web_session()
                headers = ()
                if raw_token and token is None:
                    headers = (("Set-Cookie", expired_session_cookie()),)
                self.send_json(
                    200,
                    response(
                        "auth-session",
                        auth=self.auth_state(token),
                    ),
                    headers,
                )
                return
            raise ManagementError(404, "not-found", "management endpoint does not exist")
        except (ManagementError, OSError, ValueError, RuntimeError) as exc:
            self.fail(exc)

    def do_POST(self):
        try:
            actions = {
                "/fre3nder/api/v1/maintenance/enable": (True, "maintenance-enable"),
                "/fre3nder/api/v1/maintenance/disable": (False, "maintenance-disable"),
            }
            if self.path in actions:
                self.require_empty_body()
                self.require_admin()
                enabled, operation = actions[self.path]
                set_maintenance(enabled)
                refresh = refresh_web()
                state = {
                    "enabled": maintenance_enabled(),
                    "web_status": web_status(),
                }
                self.send_json(
                    200,
                    response(
                        operation,
                        maintenance=state,
                        web_refresh=refresh,
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/maintenance/unlock":
                self.require_empty_body()
                self.require_admin()
                code = create_pairing_code()
                self.send_json(
                    200,
                    response(
                        "maintenance-unlock",
                        auth={
                            "pairing_code": code,
                            "expires_in_seconds": PAIRING_TTL_SECONDS,
                        },
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/maintenance/lock":
                self.require_empty_body()
                self.require_admin()
                clear_web_auth()
                self.send_json(
                    200,
                    response(
                        "maintenance-lock",
                        auth={"locked": True},
                    ),
                )
                return

            if self.path == "/fre3nder/api/v1/auth/unlock":
                self.require_web_peer()
                self.require_maintenance_origin()
                payload = self.read_json_body()
                token = redeem_pairing_code(payload.get("code"))
                self.send_json(
                    200,
                    response(
                        "auth-unlock",
                        auth=self.auth_state(token),
                    ),
                    (("Set-Cookie", session_cookie(token)),),
                )
                return

            if self.path == "/fre3nder/api/v1/auth/lock":
                self.require_empty_body()
                token = self.require_web_admin()
                revoke_web_session(token)
                self.send_json(
                    200,
                    response(
                        "auth-lock",
                        auth=self.auth_state(None),
                    ),
                    (("Set-Cookie", expired_session_cookie()),),
                )
                return

            raise ManagementError(
                404,
                "not-found",
                "management endpoint does not exist",
            )
        except (ManagementError, OSError, ValueError, RuntimeError) as exc:
            self.fail(exc)

    def do_PUT(self):
        self.send_json(405, error("method-not-allowed", "HTTP method is not supported"))

    do_DELETE = do_PUT
    do_PATCH = do_PUT


class Server(socketserver.UnixStreamServer):
    allow_reuse_address = False


def prepare_socket():
    check_dir(SOCKET_PATH.parent, "management runtime directory")
    try:
        st = SOCKET_PATH.lstat()
    except FileNotFoundError:
        return
    if SOCKET_PATH.is_symlink() or not stat.S_ISSOCK(st.st_mode):
        raise ValueError(f"management socket path is unsafe: {SOCKET_PATH}")
    if st.st_uid != manager_uid():
        raise ValueError(f"management socket has unsafe ownership: {SOCKET_PATH}")
    SOCKET_PATH.unlink()


def serve():
    if os.geteuid() != 0:
        raise RuntimeError("management daemon must run as root")
    prepare_socket()
    try:
        group = grp.getgrnam(MANAGEMENT_GROUP)
    except KeyError as exc:
        raise RuntimeError(f"management group is unavailable: {MANAGEMENT_GROUP}") from exc

    server = Server(str(SOCKET_PATH), Handler)
    try:
        os.chown(SOCKET_PATH, 0, group.gr_gid)
        os.chmod(SOCKET_PATH, 0o660)
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()


if __name__ == "__main__":
    try:
        serve()
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"fre3nder management: {exc}", file=sys.stderr)
        raise SystemExit(1)
