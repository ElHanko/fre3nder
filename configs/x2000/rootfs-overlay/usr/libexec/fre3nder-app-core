#!/usr/bin/python3
"""Load an app from the platform's source revision, then dispatch one action."""

import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import urllib.request


APP_NAME_RE = re.compile(r"[a-z][a-z0-9_-]{0,63}")


def safe_path(path):
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError(f"unsafe path: {path}")
    for part in reversed((path, *path.parents)):
        if part.is_symlink():
            raise ValueError(f"symlink is not allowed: {part}")
        if part != path and part.exists() and not part.is_dir():
            raise ValueError(f"not a directory: {part}")


def desired_root():
    home = Path(os.environ.get("FRE3NDER_HOME_DIR", "/home/fre3nder"))
    return home / ".fre3nder/services"


def recovery_root():
    return Path(os.environ.get("FRE3NDER_APP_RECOVERY_DIR", "/ota/apps"))


def desired_marker(app):
    return desired_root() / app / "installed"


def recovery_marker(app):
    return recovery_root() / app / "restored"


def marker_present(path):
    safe_path(path.parent)
    if path.is_symlink():
        raise ValueError(f"symlink is not allowed: {path}")
    if not path.exists():
        return False
    if not path.is_file() or not stat.S_ISREG(path.stat().st_mode):
        raise ValueError(f"not a regular file: {path}")
    return True


def write_marker(path):
    safe_path(path.parent)
    path.parent.mkdir(parents=True, exist_ok=True)
    safe_path(path.parent)
    if marker_present(path):
        return
    try:
        with path.open("xb"):
            pass
    except FileExistsError:
        if not marker_present(path):
            raise
    path.chmod(0o644)


def remove_marker(path):
    safe_path(path.parent)
    if path.is_symlink():
        path.unlink()
        return
    if not path.exists():
        return
    if not path.is_file() or not stat.S_ISREG(path.stat().st_mode):
        raise ValueError(f"not a regular file: {path}")
    path.unlink()


def installed_apps():
    root = desired_root()
    safe_path(root)
    if not root.exists():
        return []
    if not root.is_dir():
        raise ValueError(f"not a directory: {root}")

    apps = []
    for entry in sorted(root.iterdir(), key=lambda item: item.name):
        if not APP_NAME_RE.fullmatch(entry.name):
            continue
        if entry.is_symlink() or not entry.is_dir():
            continue
        try:
            installed = marker_present(entry / "installed")
        except (OSError, ValueError):
            continue
        if installed:
            apps.append(entry.name)
    return apps


def handler_present(path):
    safe_path(path.parent)
    if path.is_symlink() or not path.is_file():
        return False
    if not stat.S_ISREG(path.stat().st_mode) or not os.access(path, os.X_OK):
        return False
    content = path.read_bytes()
    return content.startswith(b"#!/bin/sh\n") and b"\0" not in content


def read_ref(path):
    safe_path(path.parent)
    if path.is_symlink() or not path.is_file():
        return None
    try:
        return path.read_text().removesuffix("\n")
    except UnicodeError:
        return None


def platform_ref():
    path = Path(os.environ.get("FRE3NDER_APP_REF_FILE", "/usr/share/fre3nder/APP_REF"))
    ref = read_ref(path)
    if ref != "unpublished" and not re.fullmatch(r"[0-9a-f]{40}", ref or ""):
        raise ValueError(f"missing or invalid platform app source revision: {path}")
    return ref


def load_handler(app, target, ref=None):
    # Local source is an explicit administrator/development override, never a URL.
    local = os.environ.get("FRE3NDER_APP_SOURCE_DIR")
    safe_path(target.parent)
    if local:
        source = Path(local) / "apps" / app / "service"
        if not handler_present(source):
            raise ValueError(f"app definition missing: {source}")
        content = source.read_bytes()
        ref = None
    else:
        ref = ref if ref is not None else platform_ref()
        if ref == "unpublished":
            raise ValueError(
                "no published app source revision (dirty or invalid build); "
                "use a matching local handler or FRE3NDER_APP_SOURCE_DIR")
        url = f"https://raw.githubusercontent.com/ElHanko/fre3nder/{ref}/apps/{app}/service"
        with urllib.request.urlopen(url, timeout=60) as response:
            if response.geturl() != url:
                raise ValueError("unexpected app source redirect")
            content = response.read()
    if not content.startswith(b"#!/bin/sh\n") or b"\0" in content:
        raise ValueError("app definition must be a POSIX shell script (#!/bin/sh)")
    # Activate the complete two-file cache directory, never a mixed pair.
    app_dir = target.parent
    app_dir.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=app_dir.parent, prefix=f".{app}-") as tmp:
        staging = Path(tmp) / "new"
        staging.mkdir(mode=0o755)
        (staging / "service").write_bytes(content)
        (staging / "service").chmod(0o755)
        if ref is not None:
            (staging / "APP_REF").write_text(ref + "\n")
            (staging / "APP_REF").chmod(0o644)
        previous = Path(tmp) / "previous"
        safe_path(app_dir)
        if app_dir.exists():
            os.replace(app_dir, previous)
        try:
            os.replace(staging, app_dir)
        except OSError:
            if previous.exists():
                os.replace(previous, app_dir)
            raise


def ensure_handler(app, target):
    if os.environ.get("FRE3NDER_APP_SOURCE_DIR"):
        load_handler(app, target)
        return
    ref = platform_ref()
    present = handler_present(target)
    if ref == "unpublished":
        if not present:
            raise ValueError("unpublished build needs a valid local handler or FRE3NDER_APP_SOURCE_DIR")
        return
    if not present or read_ref(target.parent / "APP_REF") != ref:
        load_handler(app, target, ref)


def run_action(action, app):
    target = Path(os.environ.get("FRE3NDER_APPS_DIR", "/opt/fre3nder/apps")) / app / "service"
    ensure_handler(app, target)
    if not handler_present(target):
        raise ValueError(f"app handler missing: {target}")

    # A modifying lifecycle action invalidates the current-overlay completion
    # marker until the handler has completed successfully.
    if action in ("install", "uninstall", "restore"):
        remove_marker(recovery_marker(app))

    result = subprocess.run([str(target), action], check=False)
    if result.returncode != 0:
        return result.returncode

    marker = recovery_marker(app)
    if action == "uninstall":
        remove_marker(marker)
    elif action in ("install", "restore"):
        if marker_present(desired_marker(app)):
            write_marker(marker)
        else:
            remove_marker(marker)

    return 0


def restore_installed():
    failed = False

    for app in installed_apps():
        marker = recovery_marker(app)
        try:
            if marker_present(marker):
                continue

            returncode = run_action("restore", app)
            if returncode != 0:
                print(
                    f"fre3nder: app recovery failed for {app}: exit {returncode}",
                    file=sys.stderr,
                )
                failed = True
                continue

            if not marker_present(marker):
                raise ValueError(
                    f"restore completed without recovery marker: {marker}"
                )

            print(f"fre3nder app recovery: restored {app}")
        except (OSError, ValueError) as exc:
            print(f"fre3nder: app recovery failed for {app}: {exc}", file=sys.stderr)
            failed = True

    return 1 if failed else 0


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "restore-installed":
        return restore_installed()

    if len(sys.argv) != 3 or sys.argv[1] not in (
            "install", "uninstall", "status", "restore"):
        raise ValueError(
            "usage: fre3nder {install|uninstall|status|restore} <app> "
            "or fre3nder-app-core restore-installed"
        )

    action, app = sys.argv[1:]
    if not APP_NAME_RE.fullmatch(app):
        raise ValueError(
            "invalid app name: use 1–64 lowercase letters, digits, _ or -, "
            "starting with a letter"
        )

    return run_action(action, app)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        print(f"fre3nder: {exc}", file=sys.stderr)
        sys.exit(1)
