#!/usr/bin/python3
"""Common CLI frontend for Fre3nder platform operations."""

import json
import os
import pathlib
import subprocess
import sys


API_VERSION = 1

DEFAULT_APP_CORE = pathlib.Path("/usr/libexec/fre3nder-app-core")
DEFAULT_OTA_CORE = pathlib.Path("/usr/libexec/fre3nder-ota-core")

APP_ACTIONS = (
    "install",
    "uninstall",
    "status",
    "restore",
)

OTA_ACTIONS = (
    "verify",
    "preflight",
)


def app_core_path():
    override = os.environ.get("FRE3NDER_APP_CORE")
    if override:
        return pathlib.Path(override)
    return DEFAULT_APP_CORE


def ota_core_path():
    override = os.environ.get("FRE3NDER_OTA_CORE")
    if override:
        return pathlib.Path(override)
    return DEFAULT_OTA_CORE


def usage():
    print(
        "usage: fre3nder app {install|uninstall|status|restore} <app>",
        file=sys.stderr,
    )
    print(
        "       fre3nder ota {verify|preflight} <package.ota>",
        file=sys.stderr,
    )
    return 2


def run_app_core(action, app):
    core = app_core_path()

    try:
        os.execv(
            str(core),
            [
                str(core),
                action,
                app,
            ],
        )
    except OSError as exc:
        raise RuntimeError(f"cannot execute app core: {core}") from exc


def run_ota_core(operation, package):
    core = ota_core_path()

    try:
        result = subprocess.run(
            [
                str(core),
                operation,
                package,
            ],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise RuntimeError(f"cannot execute OTA core: {core}") from exc

    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("OTA core returned invalid JSON") from exc

    if not isinstance(response, dict):
        raise RuntimeError("OTA core returned an invalid response")

    if response.get("api_version") != API_VERSION:
        raise RuntimeError("unsupported OTA core API version")

    if response.get("operation") != operation:
        raise RuntimeError("OTA core operation mismatch")

    if result.returncode != 0:
        message = response.get("error")
        if not isinstance(message, str) or not message:
            raise RuntimeError("OTA core failed without an error message")
        raise ValueError(message)

    if response.get("ok") is not True:
        raise RuntimeError("OTA core returned inconsistent success state")

    return response


def format_ota_verify(response):
    package = response["package"]
    status = package["status"]

    if status != "valid":
        raise RuntimeError("OTA core returned an unsupported package status")

    return (
        f"{status.upper()} version={package['version']} "
        f"platform={package['platform']} "
        f"mode={package['artifact_mode']}"
    )


def format_ota_preflight(response):
    package = response["package"]
    runtime = response["runtime"]
    target = response["target"]
    persistence = response["persistence"]
    sys_state = persistence["sys"]
    home_state = persistence["home"]

    action_text = {
        "reset": "RESET on successful activation",
        "preserve": "PRESERVE",
    }

    try:
        sys_action = action_text[sys_state["action"]]
        home_action = action_text[home_state["action"]]
    except KeyError as exc:
        raise RuntimeError(
            "OTA core returned an unsupported persistence state"
        ) from exc

    status = package["status"]
    if status != "valid":
        raise RuntimeError("OTA core returned an unsupported package status")

    return "\n".join(
        (
            "Fre3nder OTA preflight",
            "",
            f"Package:         {package['path']}",
            f"Package status:  {status.upper()}",
            f"Current version: {runtime['installed_version']}",
            f"Target version:  {package['version']}",
            f"Mode:            {package['artifact_mode']}",
            "",
            f"Active slot:     {runtime['active_slot']}",
            f"Active root:     {runtime['active_root']}",
            f"Target slot:     {target['slot']}",
            f"Target kernel:   {target['kernel']}",
            f"Target rootfs:   {target['rootfs']}",
            "",
            f"SYS:             {sys_state['status'].upper()} "
            f"({sys_state['source']})",
            f"HOME:            {home_state['status'].upper()} "
            f"({home_state['source']})",
            f"SYS action:      {sys_action}",
            f"HOME action:     {home_action}",
            "",
            "Write plan:",
            f"  kernel.uImage   -> {target['kernel']}",
            f"  rootfs.squashfs -> {target['rootfs']}",
            "",
            "PREFLIGHT: PASS",
            "No changes have been made.",
        )
    )


def run_ota(operation, package):
    try:
        response = run_ota_core(operation, package)

        if operation == "verify":
            output = format_ota_verify(response)
        else:
            output = format_ota_preflight(response)
    except (KeyError, TypeError, AttributeError) as exc:
        exc = RuntimeError("OTA core returned an invalid response")
        if operation == "preflight":
            print("PREFLIGHT: FAIL", file=sys.stderr)
            print(f"Reason: {exc}", file=sys.stderr)
            print("No changes have been made.", file=sys.stderr)
        else:
            print(f"fre3nder ota: {exc}", file=sys.stderr)
        return 1
    except (RuntimeError, ValueError) as exc:
        if operation == "preflight":
            print("PREFLIGHT: FAIL", file=sys.stderr)
            print(f"Reason: {exc}", file=sys.stderr)
            print("No changes have been made.", file=sys.stderr)
        else:
            print(f"fre3nder ota: {exc}", file=sys.stderr)
        return 1

    print(output)
    return 0


def main():
    if len(sys.argv) < 2:
        return usage()

    namespace = sys.argv[1]

    if namespace == "app":
        if len(sys.argv) != 4 or sys.argv[2] not in APP_ACTIONS:
            return usage()

        try:
            run_app_core(sys.argv[2], sys.argv[3])
        except RuntimeError as exc:
            print(f"fre3nder app: {exc}", file=sys.stderr)
            return 1

        raise RuntimeError("app core unexpectedly returned")

    if namespace == "ota":
        if len(sys.argv) != 4 or sys.argv[2] not in OTA_ACTIONS:
            return usage()

        return run_ota(sys.argv[2], sys.argv[3])

    return usage()


if __name__ == "__main__":
    sys.exit(main())
