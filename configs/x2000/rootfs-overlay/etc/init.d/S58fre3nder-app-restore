#!/bin/sh

package_core=${FRE3NDER_PACKAGE_CORE:-/usr/libexec/fre3nder-package-core}

case "${1:-}" in
start)
    if "$package_core" restore-installed; then
        echo "fre3nder app recovery: PASS"
    else
        echo "fre3nder app recovery: DEGRADED" >&2
    fi
    ;;
stop)
    ;;
*)
    echo "usage: $0 {start|stop}" >&2
    exit 2
    ;;
esac

# App recovery failure must not stop the rest of the platform boot.
exit 0
