#!/bin/sh

runtime=${FRE3NDER_MAINTENANCE_WEB_RUNTIME:-/run/fre3nder-maintenance-web}
root_state=${FRE3NDER_ROOT_STATE:-/run/fre3nder-root}
maintenance_state=${FRE3NDER_MAINTENANCE_STATE:-/home/.fre3nder/maintenance/enabled}
maintenance_root=${FRE3NDER_MAINTENANCE_ROOT:-/usr/share/fre3nder/web-root/maintenance}
management_socket=${FRE3NDER_MANAGEMENT_SOCKET:-/run/fre3nder-management/api.sock}
base_config=${FRE3NDER_MAINTENANCE_WEB_BASE_CONFIG:-/etc/lighttpd/fre3nder-maintenance.conf}
daemon=${FRE3NDER_LIGHTTPD:-/usr/sbin/lighttpd}
python=${FRE3NDER_PYTHON:-/usr/bin/python3}
config=$runtime/lighttpd.conf
pid_file=$runtime/lighttpd.pid
status=$runtime/status

log() {
	echo "fre3nder maintenance web: $*"
}

set_status() {
	printf '%s\n' "$1" > "$status"
	log "$1"
}

safe_path() (
	case "$1" in /*) ;; *) exit 1 ;; esac
	case "/$1/" in */../*) exit 1 ;; esac
	check_path=$1
	while [ -n "$check_path" ]; do
		[ ! -L "$check_path" ] || exit 1
		check_path=${check_path%/*}
	done
)

prepare_runtime() {
	safe_path "$runtime" || return 1
	mkdir -p "$runtime" && chmod 0700 "$runtime" || return 1
	for file in "$config" "$pid_file" "$status" "$runtime/lighttpd.log"; do
		[ ! -L "$file" ] || return 1
		[ ! -e "$file" ] || [ -f "$file" ] || return 1
	done
}

prepare_config() {
	"$python" - "$runtime" "$root_state" "$maintenance_state" "$maintenance_root" "$management_socket" "$base_config" <<'PY_EMBED'
import os
from pathlib import Path
import stat
import sys
import tempfile

runtime, root_state, maintenance_state, maintenance_root, management_socket, base = map(
    Path, sys.argv[1:]
)


def safe(path):
    if not path.is_absolute() or ".." in path.parts or any(c in str(path) for c in '\n\r"\\'):
        raise ValueError(f"unsafe path: {path}")
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f"symlink: {part}")
        if part != path and part.exists() and not part.is_dir():
            raise ValueError(f"not a directory: {part}")


def regular(path):
    safe(path)
    if path.exists() and not path.is_file():
        raise ValueError(f"not a regular file: {path}")
    return path.is_file()


def stop(reason):
    print(reason)
    sys.exit(1)


try:
    root_status = root_state / "status"
    if not regular(root_status) or root_status.read_text().strip() != "active":
        stop("degraded-root")

    safe(maintenance_state)
    if not maintenance_state.exists():
        stop("disabled")
    if not regular(maintenance_state):
        stop("state-invalid")
    state_stat = maintenance_state.stat()
    if state_stat.st_uid != os.geteuid() or state_stat.st_mode & 0o022:
        stop("state-invalid")
    if maintenance_state.read_text() != "enabled\n":
        stop("state-invalid")

    safe(maintenance_root)
    if not maintenance_root.is_dir():
        stop("maintenance-unavailable")
    index = maintenance_root / "index.html"
    if not regular(index) or not index.stat().st_size:
        stop("maintenance-invalid")

    safe(management_socket)
    try:
        socket_stat = management_socket.lstat()
    except FileNotFoundError:
        stop("management-unavailable")
    if not stat.S_ISSOCK(socket_stat.st_mode):
        stop("management-unavailable")

    if not regular(base):
        stop("config-unavailable")

    lines = [
        f'server.document-root = "{maintenance_root}"',
        f'include "{base}"',
        '$HTTP["url"] =~ "^/fre3nder/api/v1/(system|maintenance|auth/(session|unlock|lock))$" {',
        f'    proxy.server = ( "" => (( "host" => "{management_socket}" )) )',
        '}',
    ]
    text = "\n".join(lines) + "\n"
    safe(runtime / "lighttpd.conf")
    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=runtime,
        prefix=".config-",
        delete=False,
    ) as output:
        staging = Path(output.name)
        try:
            output.write(text)
            output.flush()
            os.replace(staging, runtime / "lighttpd.conf")
        finally:
            staging.unlink(missing_ok=True)
except (OSError, ValueError) as exc:
    print(f"fre3nder maintenance web: {exc}", file=sys.stderr)
    stop("state-invalid")
PY_EMBED
}

pid_has_arg() {
	[ -r "/proc/$1/cmdline" ] || return 1
	tr '\000' '\n' < "/proc/$1/cmdline" | grep -F -x -q -- "$2"
}

pid_is_lighttpd() {
	case "$1" in *[!0-9]*|'') return 1 ;; esac
	[ "$1" -gt 1 ] || return 1
	kill -0 "$1" 2>/dev/null || return 1
	pid_has_arg "$1" "$daemon" && pid_has_arg "$1" -D &&
		pid_has_arg "$1" -f && pid_has_arg "$1" "$config"
}

start() {
	if [ -f "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_lighttpd "$pid"; then
			set_status active
			return 0
		fi
		case "$pid" in
		*[!0-9]*|'') ;;
		*)
			if kill -0 "$pid" 2>/dev/null; then
				set_status stale-pid
				return 0
			fi
			;;
		esac
		rm -f "$pid_file"
	fi

	if reason=$(prepare_config); then
		:
	else
		set_status "${reason:-config-invalid}"
		return 0
	fi
	[ -x "$daemon" ] || { set_status baseline-invalid; return 0; }
	if ! "$daemon" -tt -f "$config" > "$runtime/lighttpd.log" 2>&1; then
		set_status config-invalid
		return 0
	fi
	set_status starting
	"$daemon" -D -f "$config" >> "$runtime/lighttpd.log" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$pid_file" || {
		kill "$pid" 2>/dev/null || true
		set_status pid-write-failed
		return 0
	}
	sleep 1
	if pid_is_lighttpd "$pid"; then
		set_status active
	else
		rm -f "$pid_file"
		set_status startup-failed
	fi
}

stop() {
	if [ -f "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_lighttpd "$pid"; then
			kill "$pid" 2>/dev/null || true
			seconds=0
			while pid_is_lighttpd "$pid"; do
				if [ "$seconds" -ge 10 ]; then
					set_status stop-timeout
					return 0
				fi
				sleep 1
				seconds=$((seconds + 1))
			done
		else
			log 'stale PID ignored; no unrelated process was stopped'
		fi
		rm -f "$pid_file"
	fi
	set_status stopped
}

[ "$#" -eq 1 ] || { log 'usage: S62fre3nder-maintenance-web {start|stop|restart}'; exit 1; }
case "$1" in start|stop|restart) ;; *) log 'usage: S62fre3nder-maintenance-web {start|stop|restart}'; exit 1 ;; esac
prepare_runtime || { log 'unsafe or unavailable runtime directory'; exit 1; }
case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	[ "$(cat "$status")" = stopped ] && start
	;;
esac

exit 0
