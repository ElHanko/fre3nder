#!/bin/sh

runtime=${FRE3NDER_WEB_RUNTIME:-/run/fre3nder-web}
root_state=${FRE3NDER_ROOT_STATE:-/run/fre3nder-root}
fre3nder_home=${FRE3NDER_HOME_DIR:-/home/fre3nder}
package_state=${FRE3NDER_PACKAGE_STATE_ROOT:-/home/.fre3nder}
package_runtime=${FRE3NDER_PACKAGE_RUNTIME_ROOT:-/opt/fre3nder/apps-v2}
maintenance_state=${FRE3NDER_MAINTENANCE_STATE:-/home/.fre3nder/maintenance/enabled}
maintenance_root=${FRE3NDER_MAINTENANCE_ROOT:-/usr/share/fre3nder/web-root/maintenance}
management_socket=${FRE3NDER_MANAGEMENT_SOCKET:-/run/fre3nder-management/api.sock}
base_config=${FRE3NDER_WEB_BASE_CONFIG:-/etc/lighttpd/fre3nder.conf}
daemon=${FRE3NDER_LIGHTTPD:-/usr/sbin/lighttpd}
python=${FRE3NDER_PYTHON:-/usr/bin/python3}
config=$runtime/lighttpd.conf
pid_file=$runtime/lighttpd.pid
status=$runtime/status

log() {
	echo "fre3nder web: $*"
}

set_status() {
	printf '%s\n' "$1" > "$status"
	log "$1"
}

safe_path() (
	case "$1" in /*) ;; *) exit 1 ;; esac
	case "/$1/" in */../*) exit 1 ;; esac
	check_path=$1
	while [ -n "$check_path" ]; do
		[ ! -L "$check_path" ] || exit 1
		check_path=${check_path%/*}
	done
)

prepare_runtime() {
	safe_path "$runtime" || return 1
	mkdir -p "$runtime" && chmod 0700 "$runtime" || return 1
	for file in "$config" "$pid_file" "$status" "$runtime/lighttpd.log"; do
		[ ! -L "$file" ] || return 1
		[ ! -e "$file" ] || [ -f "$file" ] || return 1
	done
}

prepare_config() {
	"$python" - "$runtime" "$root_state" "$fre3nder_home" "$package_state" "$package_runtime" "$maintenance_state" "$maintenance_root" "$management_socket" "$base_config" <<'PY'
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

(
    runtime,
    root_state,
    home,
    package_state,
    package_runtime,
    maintenance_state,
    maintenance_root,
    management_socket,
    base,
) = map(Path, sys.argv[1:])


def safe(path):
    if not path.is_absolute() or ".." in path.parts or any(c in str(path) for c in '\n\r"\\'):
        raise ValueError(f"unsafe path: {path}")
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f"symlink: {part}")
        if part != path and part.exists() and not part.is_dir():
            raise ValueError(f"not a directory: {part}")


def regular(path):
    safe(path)
    if path.exists() and not path.is_file():
        raise ValueError(f"not a regular file: {path}")
    return path.is_file()


def stop(reason):
    print(reason)
    sys.exit(1)


def maintenance_enabled():
    if not maintenance_state.exists() and not maintenance_state.is_symlink():
        return False
    if not regular(maintenance_state):
        return False
    st = maintenance_state.stat()
    if st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError("unsafe maintenance state")
    if maintenance_state.read_text() != "enabled\n":
        raise ValueError("invalid maintenance state")
    return True


def maintenance_available():
    safe(maintenance_root)
    if not maintenance_root.is_dir():
        return False, "maintenance-unavailable"

    maintenance_index = maintenance_root / "index.html"
    if not regular(maintenance_index) or not maintenance_index.stat().st_size:
        return False, "maintenance-invalid"

    safe(management_socket)
    try:
        socket_stat = management_socket.lstat()
    except FileNotFoundError:
        return False, "management-unavailable"
    if not stat.S_ISSOCK(socket_stat.st_mode):
        return False, "management-unavailable"

    return True, None


def selected_frontend():
    disabled = home / ".fre3nder/web/disabled"
    if regular(disabled):
        return None, "disabled"

    active = package_state / "frontend/active"
    if not regular(active):
        return None, "no-frontend"

    name = active.read_text().removesuffix("\n")
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,63}", name):
        return None, "frontend-invalid"

    document_root = package_runtime / name / "payload"
    safe(document_root)
    if not document_root.is_dir():
        return None, "payload-unavailable"

    index = document_root / "index.html"
    if not regular(index) or not index.stat().st_size:
        return None, "payload-invalid"

    return document_root, None


try:
    root_status = root_state / "status"
    if not regular(root_status) or root_status.read_text().strip() != "active":
        stop("degraded-root")

    safe(home)
    if not home.is_dir():
        stop("userdata-unavailable")

    maintenance_reason = None
    try:
        maintenance_requested = maintenance_enabled()
    except (OSError, ValueError) as exc:
        maintenance_requested = False
        maintenance_reason = "maintenance-invalid"
        print(
            f"fre3nder web: maintenance state ignored: {exc}",
            file=sys.stderr,
        )

    maintenance = False
    if maintenance_requested:
        try:
            maintenance, maintenance_reason = maintenance_available()
        except (OSError, ValueError) as exc:
            maintenance_reason = "maintenance-invalid"
            print(
                f"fre3nder web: maintenance resources ignored: {exc}",
                file=sys.stderr,
            )
        if not maintenance and maintenance_reason:
            print(
                f"fre3nder web: maintenance unavailable: {maintenance_reason}",
                file=sys.stderr,
            )

    document_root = None
    frontend_reason = "no-frontend"
    try:
        document_root, frontend_reason = selected_frontend()
    except (OSError, ValueError) as exc:
        if not maintenance:
            raise
        print(
            f"fre3nder web: selected frontend ignored while maintenance is active: {exc}",
            file=sys.stderr,
        )
        frontend_reason = "frontend-invalid"

    if not maintenance and document_root is None:
        stop(maintenance_reason or frontend_reason)

    if not regular(base):
        stop("config-unavailable")

    if document_root is None:
        document_root = maintenance_root.parent
        safe(document_root)
        if not document_root.is_dir():
            stop("maintenance-unavailable")

    lines = [
        f'server.document-root = "{document_root}"',
        f'include "{base}"',
    ]

    if maintenance:
        lines.extend(
            (
                f'alias.url = ( "/maintenance/" => "{maintenance_root}/" )',
                '$HTTP["url"] =~ "^/fre3nder/api/v1/(system|maintenance)$" {',
                f'    proxy.server = ( "" => (( "host" => "{management_socket}" )) )',
                '}',
            )
        )

    text = "\n".join(lines) + "\n"
    safe(runtime / "lighttpd.conf")
    with tempfile.NamedTemporaryFile(mode="w", dir=runtime, prefix=".config-", delete=False) as output:
        staging = Path(output.name)
        try:
            output.write(text)
            output.flush()
            os.replace(staging, runtime / "lighttpd.conf")
        finally:
            staging.unlink(missing_ok=True)
except (OSError, ValueError) as exc:
    print(f"fre3nder web: {exc}", file=sys.stderr)
    stop("state-invalid")
PY
}

pid_has_arg() {
	[ -r "/proc/$1/cmdline" ] || return 1
	tr '\000' '\n' < "/proc/$1/cmdline" | grep -F -x -q -- "$2"
}

pid_is_lighttpd() {
	case "$1" in *[!0-9]*|'') return 1 ;; esac
	[ "$1" -gt 1 ] || return 1
	kill -0 "$1" 2>/dev/null || return 1
	pid_has_arg "$1" "$daemon" && pid_has_arg "$1" -D &&
		pid_has_arg "$1" -f && pid_has_arg "$1" "$config"
}

start() {
	if [ -f "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_lighttpd "$pid"; then
			set_status active
			return 0
		fi
		case "$pid" in
		*[!0-9]*|'') ;;
		*)
			if kill -0 "$pid" 2>/dev/null; then
				set_status stale-pid
				return 0
			fi
			;;
		esac
		rm -f "$pid_file"
	fi
	if reason=$(prepare_config); then
		:
	else
		set_status "${reason:-config-invalid}"
		return 0
	fi
	[ -x "$daemon" ] || { set_status baseline-invalid; return 0; }
	if ! "$daemon" -tt -f "$config" > "$runtime/lighttpd.log" 2>&1; then
		set_status config-invalid
		return 0
	fi
	set_status starting
	"$daemon" -D -f "$config" >> "$runtime/lighttpd.log" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$pid_file" || {
		kill "$pid" 2>/dev/null || true
		set_status pid-write-failed
		return 0
	}
	# Lighttpd runs in the foreground; bind/config errors normally exit at once.
	sleep 1
	if pid_is_lighttpd "$pid"; then
		set_status active
	else
		rm -f "$pid_file"
		set_status startup-failed
	fi
}

stop() {
	if [ -f "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_lighttpd "$pid"; then
			kill "$pid" 2>/dev/null || true
			seconds=0
			while pid_is_lighttpd "$pid"; do
				if [ "$seconds" -ge 10 ]; then
					set_status stop-timeout
					return 0
				fi
				sleep 1
				seconds=$((seconds + 1))
			done
		else
			log 'stale PID ignored; no unrelated process was stopped'
		fi
		rm -f "$pid_file"
	fi
	set_status stopped
}

[ "$#" -eq 1 ] || { log 'usage: S62fre3nder-web {start|stop|restart}'; exit 1; }
case "$1" in start|stop|restart) ;; *) log 'usage: S62fre3nder-web {start|stop|restart}'; exit 1 ;; esac
prepare_runtime || { log 'unsafe or unavailable runtime directory'; exit 1; }
case "$1" in
start) start ;;
stop) stop ;;
restart)
	stop
	[ "$(cat "$status")" = stopped ] && start
	;;
esac

exit 0
