#!/bin/sh
# Prepare Moonraker's platform-owned state and start only its signed fre3app.
# Klipper must be active before the managed application may run.
set -u
runtime=${FRE3NDER_MOONRAKER_RUNTIME:-/run/fre3nder-moonraker}
status=$runtime/status
root_state=${FRE3NDER_ROOT_STATE:-/run/fre3nder-root}
klipper_runtime=${FRE3NDER_KLIPPER_RUNTIME:-/run/fre3nder-klipper}
klipper_status=$klipper_runtime/status
klippy_uds=${FRE3NDER_KLIPPER_API_SOCKET:-$klipper_runtime/klippy.sock}
home_root=${FRE3NDER_HOME_ROOT:-/home}
fre3nder_home=${FRE3NDER_HOME_DIR:-$home_root/fre3nder}
printer_data=${FRE3NDER_PRINTER_DATA_DIR:-$fre3nder_home/printer_data}
config_dir=$printer_data/config
config=${FRE3NDER_MOONRAKER_CONFIG:-$config_dir/moonraker.conf}
default_config=${FRE3NDER_MOONRAKER_DEFAULT_CONFIG:-/usr/share/fre3nder/defaults/moonraker.conf}
fre3nder_config_dir=$config_dir/fre3nder
fre3nder_base_config=$fre3nder_config_dir/00-base.conf
camera_config=$fre3nder_config_dir/camera.conf
default_camera_config=${FRE3NDER_MOONRAKER_CAMERA_DEFAULT_CONFIG:-/usr/share/fre3nder/defaults/camera.conf}
persistent_logs=${FRE3NDER_MOONRAKER_LOG_DIR:-$printer_data/logs}
package_core=${FRE3NDER_PACKAGE_CORE:-/usr/libexec/fre3nder/package-core}

log() { echo "fre3nder moonraker: $*"; }
set_status() { mkdir -p "$runtime" 2>/dev/null || return 0; printf '%s\n' "$1" > "$status" 2>/dev/null || true; }
regular_file_equals() { [ -f "$1" ] && [ ! -L "$1" ] && [ "$(cat "$1")" = "$2" ]; }
root_active() { regular_file_equals "$root_state/status" active; }
klipper_active() { regular_file_equals "$klipper_status" active && [ -S "$klippy_uds" ]; }

ensure_directory() {
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then mkdir -m 0700 "$1" || return 1; fi
    [ -d "$1" ] && [ ! -L "$1" ] && chown fre3nder:fre3nder "$1"
}
seed_regular_file() {
    destination=$1; source=$2
    if [ -e "$destination" ] || [ -L "$destination" ]; then
        [ -f "$destination" ] && [ ! -L "$destination" ]; return
    fi
    [ -f "$source" ] && [ ! -L "$source" ] || return 1
    install -m 0644 "$source" "$destination"
}
prepare_printer_data() {
    [ -d "$home_root" ] && [ ! -L "$home_root" ] || return 1
    ensure_directory "$fre3nder_home" || return 1
    ensure_directory "$printer_data" || return 1
    ensure_directory "$config_dir" || return 1
    ensure_directory "$persistent_logs" || return 1
    ensure_directory "$fre3nder_config_dir" || return 1
    if [ -e "$fre3nder_base_config" ] || [ -L "$fre3nder_base_config" ]; then
        [ -f "$fre3nder_base_config" ] && [ ! -L "$fre3nder_base_config" ] || return 1
    else
        printf '%s\n' '# Fre3nder-managed Moonraker configuration fragments.' > "$fre3nder_base_config" || return 1
        chmod 0644 "$fre3nder_base_config" || return 1
    fi
    chown fre3nder:fre3nder "$fre3nder_base_config" || return 1
    seed_regular_file "$camera_config" "$default_camera_config" || return 1
    chown fre3nder:fre3nder "$camera_config" || return 1
    if [ -e "$config" ] || [ -L "$config" ]; then
        [ -f "$config" ] && [ ! -L "$config" ] || return 1
    else
        [ "${FRE3NDER_MOONRAKER_CONFIG+x}" != x ] || return 1
        [ -f "$default_config" ] && [ ! -L "$default_config" ] || return 1
        install -m 0644 "$default_config" "$config" || return 1
    fi
    chown fre3nder:fre3nder "$config"
}

prepare_runtime() {
    [ ! -L "$runtime" ] || return 1
    mkdir -p "$runtime" || return 1
    [ -d "$runtime" ] && [ ! -L "$status" ] || return 1
    [ ! -e "$status" ] || [ -f "$status" ] || return 1
    : >> "$status" || return 1
    chown root:root "$status" && chmod 0644 "$status" &&
        chown root:fre3nder "$runtime" && chmod 1770 "$runtime"
}

start() {
    prepare_runtime || { log 'invalid runtime directory'; return 0; }
    if ! root_active; then set_status degraded-root; return 0; fi
    if ! klipper_active; then set_status klipper-unavailable; return 0; fi
    if ! prepare_printer_data; then set_status printer-data-invalid; return 0; fi
    if ! "$package_core" service-start moonraker >/dev/null; then
        set_status app-start-failed
        log 'signed Moonraker app is unavailable or failed readiness'
        return 0
    fi
    set_status active
    log 'Moonraker running from signed system fre3app'
}
stop() {
    "$package_core" service-stop moonraker >/dev/null 2>&1 || true
    set_status stopped
}
case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo 'usage: S61fre3nder-moonraker {start|stop|restart}' >&2; exit 2 ;;
esac
exit 0
