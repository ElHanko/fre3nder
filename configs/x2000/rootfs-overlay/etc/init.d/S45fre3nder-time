#!/bin/sh

state=${FRE3NDER_STATE:-/run/fre3nder}
runtime=$state/time
lease_file=$state/network/lease
pid_file=$runtime/ntpd.pid
proc_root=${FRE3NDER_PROC_ROOT:-/proc}
ntpd=${FRE3NDER_NTPD:-/usr/sbin/ntpd}
peer=${FRE3NDER_NTP_PEER:-pool.ntp.org}
timezone_helper=${FRE3NDER_TIMEZONE_HELPER:-/usr/libexec/fre3nder/system_timezone.py}

log() {
	echo "fre3nder-x2000 time: $*"
}

pid_matches() {
	pid=$1

	[ -r "$proc_root/$pid/cmdline" ] || return 1

	command=$(
		tr '\000' ' ' < "$proc_root/$pid/cmdline"
	)

	case "$command" in
	*ntpd*|*S45fre3nder-time*)
		return 0
		;;
	esac

	return 1
}

stop() {
	if [ ! -r "$pid_file" ]; then
		return 0
	fi

	pid=$(cat "$pid_file")

	case "$pid" in
	*[!0-9]*|'')
		;;
	*)
		if pid_matches "$pid"; then
			kill "$pid" 2>/dev/null || true
		else
			log 'ignoring stale ntpd PID file'
		fi
		;;
	esac

	rm -f "$pid_file"
}

start() {
	mkdir -p "$runtime" || return 1
	chmod 0700 "$runtime" || return 1
	python3 "$timezone_helper" "$runtime" || log 'timezone activation failed; continuing time synchronization'

	if [ -r "$pid_file" ]; then
		pid=$(cat "$pid_file")
		case "$pid" in
		*[!0-9]*|'')
			;;
		*)
			if pid_matches "$pid"; then
				log 'time synchronization already running'
				return 0
			fi
			;;
		esac
		rm -f "$pid_file"
	fi

	[ -x "$ntpd" ] || {
		log 'ntpd is unavailable'
		return 0
	}

	(
		while [ ! -s "$lease_file" ]; do
			sleep 1
		done

		log 'network lease available; starting ntpd'
		exec "$ntpd" -n -p "$peer"
	) &

	printf '%s\n' "$!" > "$pid_file"
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
