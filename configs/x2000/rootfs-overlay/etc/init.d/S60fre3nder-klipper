#!/bin/sh

runtime=${FRE3NDER_KLIPPER_RUNTIME:-/run/fre3nder-klipper}
pid_file=$runtime/klippy.pid
status=$runtime/status
input_tty=$runtime/printer
api_socket=${FRE3NDER_KLIPPER_API_SOCKET:-$runtime/klippy.sock}
startup_timeout=${FRE3NDER_KLIPPER_START_TIMEOUT:-10}
state_helper=${FRE3NDER_MCU_STATE_HELPER:-/usr/libexec/fre3nder/f005-mcu-state}
python=${FRE3NDER_PYTHON:-/usr/bin/python3}
klippy=${FRE3NDER_KLIPPY:-/usr/share/klipper/klippy/klippy.py}
root_state=${FRE3NDER_ROOT_STATE:-/run/fre3nder-root}
fre3nder_home=${FRE3NDER_HOME_DIR:-/home/fre3nder}
printer_data=${FRE3NDER_PRINTER_DATA_DIR:-$fre3nder_home/printer_data}
config_dir=$printer_data/config
config=${FRE3NDER_KLIPPER_CONFIG:-$config_dir/printer.cfg}
default_config=${FRE3NDER_KLIPPER_DEFAULT_CONFIG:-/usr/share/fre3nder/defaults/printer.cfg}
persistent_logs=${FRE3NDER_KLIPPER_LOG_DIR:-$printer_data/logs}
transition_helper=${FRE3NDER_F005_TRANSITION_HELPER:-/usr/libexec/fre3nder/f005-stock-to-fre3nder}
auto_transition_file=${FRE3NDER_F005_AUTO_TRANSITION_FILE:-$fre3nder_home/f005-auto-transition.enabled}

case "$startup_timeout" in
''|*[!0-9]*) startup_timeout=10 ;;
esac

log() {
	echo "fre3nder klipper: $*"
}

set_status() {
	mkdir -p "$runtime" 2>/dev/null || return 0
	printf '%s\n' "$1" > "$status" 2>/dev/null || true
}

root_active() {
	[ -f "$root_state/status" ] &&
		[ ! -L "$root_state/status" ] &&
		[ "$(cat "$root_state/status")" = active ]
}

ensure_directory() {
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		mkdir -m 0700 "$1" || return 1
	fi
	[ -d "$1" ] && [ ! -L "$1" ]
}

prepare_printer_data() {
	ensure_directory "$fre3nder_home" || return 1
	ensure_directory "$printer_data" || return 1
	ensure_directory "$config_dir" || return 1
	ensure_directory "$persistent_logs" || return 1

	if [ -e "$config" ] || [ -L "$config" ]; then
		[ -f "$config" ] && [ ! -L "$config" ]
		return
	fi

	# An explicitly overridden config path is never implicitly populated.
	[ "${FRE3NDER_KLIPPER_CONFIG+x}" != x ] || return 1

	[ -f "$default_config" ] && [ ! -L "$default_config" ] || return 1
	install -m 0644 "$default_config" "$config" || return 1
}

pid_has_arg() {
	proc_pid=$1
	expected_arg=$2
	[ -r "/proc/$proc_pid/cmdline" ] || return 1
	tr '\000' '\n' < "/proc/$proc_pid/cmdline" |
		grep -F -x -q "$expected_arg"
}

pid_is_klippy() {
	proc_pid=$1
	case "$proc_pid" in
	*[!0-9]*|'') return 1 ;;
	esac

	kill -0 "$proc_pid" 2>/dev/null || return 1

	pid_has_arg "$proc_pid" "$python" &&
		pid_has_arg "$proc_pid" "$klippy" &&
		pid_has_arg "$proc_pid" "$config" &&
		pid_has_arg "$proc_pid" "$input_tty" &&
		pid_has_arg "$proc_pid" "$api_socket"
}

wait_for_klippy_ready() {
	proc_pid=$1
	remaining=$startup_timeout

	while [ "$remaining" -gt 0 ]; do
		kill -0 "$proc_pid" 2>/dev/null || return 2

		if [ -S "$api_socket" ]; then
			pid_is_klippy "$proc_pid" || return 2
			return 0
		fi

		sleep 1
		remaining=$((remaining - 1))
	done

	kill -0 "$proc_pid" 2>/dev/null || return 2
	[ -S "$api_socket" ] || return 1
	pid_is_klippy "$proc_pid" || return 2
}

f005_auto_transition_enabled() {
	[ -f "$auto_transition_file" ] && [ ! -L "$auto_transition_file" ] || return 1
	auto_transition_size=$(wc -c < "$auto_transition_file" 2>/dev/null) || return 1
	[ "$auto_transition_size" -eq 7 ] &&
		[ "$(cat "$auto_transition_file" 2>/dev/null)" = enabled ]
}

start() {
	mkdir -p "$runtime" || {
		log 'runtime setup failed'
		return 0
	}
	if ! root_active; then
		set_status degraded-root
		log 'persistent root is unavailable; normal Klippy remains stopped'
		return 0
	fi
	if [ -r "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_klippy "$pid"; then
			ready_rc=0
			wait_for_klippy_ready "$pid" || ready_rc=$?
			case "$ready_rc" in
			0)
				set_status active
				return 0
				;;
			1)
				kill "$pid" 2>/dev/null || true
				rm -f "$pid_file" "$input_tty" "$api_socket"
				set_status startup-timeout
				log 'existing Klippy did not create its API socket during startup'
				return 1
				;;
			*)
				rm -f "$pid_file" "$input_tty" "$api_socket"
				set_status startup-failed
				log 'existing Klippy is no longer running during startup'
				return 1
				;;
			esac
		fi
		case "$pid" in
		*[!0-9]*|'') ;;
		*)
			if kill -0 "$pid" 2>/dev/null; then
				log 'stale PID file refers to a non-Klippy process; ignoring it'
			fi
			;;
		esac
		rm -f "$pid_file"
	fi

	mcu_state=$("$state_helper" 2>>"$runtime/mcu-state.log") || mcu_state=unknown
	case "$mcu_state" in
	fre3nder) ;;
	stock)
		if ! f005_auto_transition_enabled; then
			set_status stock-mcu
			log 'Stock MCU detected; automatic F005 transition is not enabled'
			return 0
		fi

		if [ ! -x "$transition_helper" ]; then
			set_status mcu-transition-unavailable
			log 'Stock MCU detected, but the F005 transition helper is unavailable'
			return 0
		fi

		set_status mcu-transitioning
		log 'Stock MCU detected; automatic F005 transition is enabled'

		if ! "$transition_helper" --write >>"$runtime/mcu-transition.log" 2>&1; then
			set_status mcu-transition-failed
			log 'automatic F005 transition failed; normal Klippy remains stopped'
			return 0
		fi

		log 'automatic F005 transition completed'
		;;
	*)
		set_status unknown-mcu
		log 'unknown MCU state; normal Klippy remains stopped'
		return 0
		;;
	esac

	[ -x "$python" ] && [ -f "$klippy" ] && [ ! -L "$klippy" ] || {
		set_status runtime-invalid
		log 'Klippy runtime is unavailable'
		return 0
	}
	prepare_printer_data || {
		set_status printer-data-invalid
		log 'persistent printer data or configuration is unavailable'
		return 0
	}
	log_file=$persistent_logs/klippy.log
	rm -f "$input_tty" "$api_socket"
	set_status starting

	"$python" "$klippy" \
		-I "$input_tty" \
		-a "$api_socket" \
		-l "$log_file" \
		"$config" \
		>/dev/null 2>&1 &
	pid=$!

	printf '%s\n' "$pid" > "$pid_file" || {
		kill "$pid" 2>/dev/null || true
		rm -f "$input_tty" "$api_socket"
		set_status pid-write-failed
		return 0
	}

	ready_rc=0
	wait_for_klippy_ready "$pid" || ready_rc=$?
	case "$ready_rc" in
	0)
		set_status active
		log 'upstream Klippy started and API socket is ready'
		return 0
		;;
	1)
		kill "$pid" 2>/dev/null || true
		rm -f "$pid_file" "$input_tty" "$api_socket"
		set_status startup-timeout
		log 'upstream Klippy did not create its API socket during startup'
		return 1
		;;
	*)
		rm -f "$pid_file" "$input_tty" "$api_socket"
		set_status startup-failed
		log 'upstream Klippy exited during startup'
		return 1
		;;
	esac
}

stop() {
	if [ -r "$pid_file" ]; then
		pid=$(cat "$pid_file")
		if pid_is_klippy "$pid"; then
			kill "$pid" 2>/dev/null || true
		else
			case "$pid" in
			*[!0-9]*|'') ;;
			*)
				if kill -0 "$pid" 2>/dev/null; then
					log 'stale PID file refers to a non-Klippy process; not killing it'
				fi
				;;
			esac
		fi
		rm -f "$pid_file"
	fi
	rm -f "$input_tty" "$api_socket"
	set_status stopped
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
