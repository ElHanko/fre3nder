#!/bin/sh

state=${FRE3NDER_STATE:-/run/fre3nder}
provisioning=$state/provisioning
runtime=$state/network
wpa_pid=$runtime/wpa_supplicant.pid
dhcp_pid=$runtime/udhcpc.pid
interface_file=$runtime/interface
lease_file=$runtime/lease
sys_class_net=${FRE3NDER_SYS_CLASS_NET:-/sys/class/net}
proc_root=${FRE3NDER_PROC_ROOT:-/proc}
ifconfig=${FRE3NDER_IFCONFIG:-/sbin/ifconfig}
wpa_supplicant=${FRE3NDER_WPA_SUPPLICANT:-/usr/sbin/wpa_supplicant}
udhcpc=${FRE3NDER_UDHCPC:-/sbin/udhcpc}
udhcpc_hook=${FRE3NDER_UDHCPC_HOOK:-/usr/libexec/fre3nder/udhcpc}
carrier_timeout=${FRE3NDER_CARRIER_TIMEOUT:-5}
dhcp_lease_timeout=${FRE3NDER_DHCP_LEASE_TIMEOUT:-15}

log() {
	echo "fre3nder-x2000 network: $*"
}

pid_matches() {
	pid=$1
	expected=$2
	[ -r "$proc_root/$pid/cmdline" ] || return 1
	tr '\000' ' ' < "$proc_root/$pid/cmdline" | grep -Fq "$expected"
}

stop_pid() {
	pid_file=$1
	expected=$2
	if [ -r "$pid_file" ]; then
		pid=$(cat "$pid_file")
		case "$pid" in
		*[!0-9]*|'') ;;
		*)
			if pid_matches "$pid" "$expected"; then
				kill "$pid" 2>/dev/null || true
			else
				log "ignoring stale $expected PID file"
			fi
			;;
		esac
		rm -f "$pid_file"
	fi
}

stop() {
	interface=
	[ ! -r "$interface_file" ] || interface=$(cat "$interface_file")
	stop_pid "$dhcp_pid" udhcpc
	if [ -n "$interface" ]; then
		interface=$interface "$udhcpc_hook" deconfig
	fi
	stop_pid "$wpa_pid" wpa_supplicant
	[ -z "$interface" ] || "$ifconfig" "$interface" down 2>/dev/null || true
	rm -f "$interface_file" "$lease_file"
}

wait_for_carrier() {
	interface=$1
	seconds=0
	while [ "$seconds" -lt "$carrier_timeout" ]; do
		[ "$(cat "$sys_class_net/$interface/carrier" 2>/dev/null)" = 1 ] && return 0
		sleep 1
		seconds=$((seconds + 1))
	done
	[ "$(cat "$sys_class_net/$interface/carrier" 2>/dev/null)" = 1 ]
}

wait_for_lease() {
	interface=$1
	seconds=0
	while [ "$seconds" -lt "$dhcp_lease_timeout" ]; do
		[ "$(cat "$lease_file" 2>/dev/null)" = "$interface" ] && return 0
		sleep 1
		seconds=$((seconds + 1))
	done
	[ "$(cat "$lease_file" 2>/dev/null)" = "$interface" ]
}

start_dhcp() {
	interface=$1
	rm -f "$lease_file"
	"$udhcpc" -f -i "$interface" -s "$udhcpc_hook" -p "$dhcp_pid" &
	dhcp_process=$!
	sleep 1
	if ! kill -0 "$dhcp_process" 2>/dev/null; then
		log 'DHCP client failed to remain running'
		return 1
	fi
}

select_ethernet() {
	ethernet_interface=
	interfaces=0
	for path in "$sys_class_net"/*; do
		[ -r "$path/type" ] || continue
		interface=${path##*/}
		[ "$interface" = lo ] && continue
		[ -d "$path/wireless" ] && continue
		[ "$(cat "$path/type" 2>/dev/null)" = 1 ] || continue
		interfaces=$((interfaces + 1))
		ethernet_interface=$interface
	done
	if [ "$interfaces" -eq 1 ]; then
		return 0
	fi
	if [ "$interfaces" -gt 1 ]; then
		log 'multiple suitable Ethernet interfaces; falling back to WLAN'
	fi
	return 1
}

start_ethernet() {
	select_ethernet || return 1
	interface=$ethernet_interface
	printf '%s\n' "$interface" > "$interface_file"
	"$ifconfig" "$interface" up || {
		stop
		return 1
	}
	if ! wait_for_carrier "$interface"; then
		log 'Ethernet carrier timed out; falling back to WLAN'
		stop
		return 1
	fi
	if ! start_dhcp "$interface" || ! wait_for_lease "$interface"; then
		log 'Ethernet DHCP lease timed out; falling back to WLAN'
		stop
		return 1
	fi
	log 'Ethernet selected; DHCP lease acquired'
	return 0
}

start_wlan() {
	config=$provisioning/wpa_supplicant.conf
	if [ ! -f "$config" ] || [ -L "$config" ] || [ ! -s "$config" ]; then
		log 'no valid boot-local WLAN configuration'
		return 0
	fi

	interfaces=0
	interface=
	for path in "$sys_class_net"/*; do
		[ -d "$path/wireless" ] || continue
		interfaces=$((interfaces + 1))
		interface=${path##*/}
	done
	if [ "$interfaces" -ne 1 ]; then
		log 'expected exactly one wireless interface'
		return 0
	fi
	printf '%s\n' "$interface" > "$interface_file"

	"$ifconfig" "$interface" up || return 0
	"$wpa_supplicant" -B -P "$wpa_pid" -D nl80211 \
		-i "$interface" -c "$config" || {
		log 'wpa_supplicant rejected the configuration or failed to start'
		stop
		return 0
	}

	seconds=0
	while [ "$seconds" -lt 30 ]; do
		[ "$(cat "$sys_class_net/$interface/carrier" 2>/dev/null)" = 1 ] && break
		sleep 1
		seconds=$((seconds + 1))
	done
	if [ "$seconds" -eq 30 ]; then
		log 'WLAN association timed out'
		stop
		return 0
	fi

	if ! start_dhcp "$interface"; then
		stop
		return 0
	fi
	log 'WLAN associated; long-lived DHCP client started'
}

start_loopback() {
	"$ifconfig" lo 127.0.0.1 netmask 255.0.0.0 up || {
		log 'failed to configure loopback'
		return 1
	}
}

start() {
	mkdir -p "$runtime"
	chmod 0700 "$runtime"
	stop
	start_loopback || return 1
	start_ethernet || start_wlan
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
