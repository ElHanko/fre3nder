#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
user_service=$root/configs/x2000/rootfs-overlay/etc/init.d/S30fre3nder-user
display_service=$root/configs/x2000/rootfs-overlay/etc/init.d/S64fre3nder-display
component=$root/build/x2000/fre3nderscreen-component.sh

sh -n "$user_service" "$display_service" "$component"

tmp=$(mktemp -d)
runtime=$tmp/run/fre3nder-display
root_state=$tmp/run/root
active_display=$tmp/home/.fre3nder/display/active
input_sys=$tmp/sys/class/input
input_dev=$tmp/dev/input
backlight_power=$tmp/sys/class/backlight/backlight/bl_power
mock_console=$tmp/console
mock_core=$tmp/package-core
running=$tmp/running
called=$tmp/called
mockbin=$tmp/bin
group_file=$tmp/group

cleanup() {
	rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$root_state" "$(dirname "$active_display")" \
	"$input_sys/event7/device" "$input_dev" \
	"$(dirname "$backlight_power")" "$mockbin"

printf '%s\n' active > "$root_state/status"
printf '%s\n' ns2009_ts > "$input_sys/event7/device/name"
printf '%s\n' 4 > "$backlight_power"
ln -s /dev/null "$input_dev/event7"
printf '%s\n' \
	'fre3nder:x:1000:' \
	'video:x:28:' \
	'input:x:1001:' \
	'beep:x:1002:' > "$group_file"

cat > "$mock_core" <<'EOF'
#!/bin/sh
case "$1" in
display-service-status)
	[ -f "$FIXTURE_RUNNING" ] || exit 1
	checks=$(cat "$FIXTURE_ROOT/process-checks")
	checks=$((checks + 1))
	printf '%s\n' "$checks" > "$FIXTURE_ROOT/process-checks"
	[ "${FIXTURE_PROCESS_MISSING:-}" != yes ] || exit 1
	[ "$checks" -ge "${FIXTURE_PROCESS_DELAY:-0}" ]
	;;
display-service-start)
	{
		printf 'action=start\n'
		printf 'vt=%s\n' "${FRE3NDER_DISPLAY_VT:-}"
		printf 'api=%s\n' "${FRE3NDER_DISPLAY_API:-}"
		printf 'framebuffer=%s\n' "${FRE3NDER_DISPLAY_FRAMEBUFFER:-}"
		printf 'input=%s\n' "${FRE3NDER_DISPLAY_INPUT:-}"
		printf 'backlight=%s\n' "${FRE3NDER_DISPLAY_BACKLIGHT_POWER:-}"
		printf 'beeper=%s\n' "${FRE3NDER_DISPLAY_BEEPER:-}"
	} >> "$FIXTURE_CALLED"
	: > "$FIXTURE_RUNNING"
	printf '%s\n' 0 > "$FIXTURE_ROOT/process-checks"
	printf '%s\n' 0 > "$FIXTURE_ROOT/vt-checks"
	if [ "${FIXTURE_START_FAIL:-}" = yes ]; then
		echo 'fixture: definitive start failure' >&2
		exit 23
	fi
	;;
display-service-stop)
	[ "${FIXTURE_STOP_FAIL:-}" != yes ] || exit 23
	{
		printf 'action=stop\n'
		printf 'api=%s\n' "${FRE3NDER_DISPLAY_API:-}"
		printf 'framebuffer=%s\n' "${FRE3NDER_DISPLAY_FRAMEBUFFER:-}"
		printf 'input=%s\n' "${FRE3NDER_DISPLAY_INPUT:-}"
		printf 'backlight=%s\n' "${FRE3NDER_DISPLAY_BACKLIGHT_POWER:-}"
		printf 'beeper=%s\n' "${FRE3NDER_DISPLAY_BEEPER:-}"
	} >> "$FIXTURE_CALLED"
	rm -f "$FIXTURE_RUNNING"
	;;
*)
	exit 2
	;;
esac
EOF
chmod 0755 "$mock_core"
cat > "$mock_console" <<'EOF'
#!/bin/sh
printf '%s\n' "$1" >> "$FIXTURE_ROOT/console-calls"
[ "${FIXTURE_CONSOLE_FAIL:-}" != yes ] || exit 1
if [ "$1" = check ] && [ "${FIXTURE_LEGACY_DISPLAY:-}" = yes ]; then
    echo 'fixture: tty7 is not in graphics mode' >&2
    exit 1
fi
if [ "$1" = check ] && [ -f "$FIXTURE_RUNNING" ]; then
    checks=$(cat "$FIXTURE_ROOT/vt-checks")
    checks=$((checks + 1))
    printf '%s\n' "$checks" > "$FIXTURE_ROOT/vt-checks"
    [ "$checks" -ge "${FIXTURE_VT_DELAY:-0}" ] || exit 1
fi
if [ "$1" = background ]; then
    [ -f "$FIXTURE_RUNNING" ] || exit 1
    [ "$(cat "$FIXTURE_ROOT/vt-checks")" -ge "${FIXTURE_VT_DELAY:-0}" ] || exit 1
fi
if [ "$1" = boot ]; then
    [ ! -f "$FIXTURE_RUNNING" ] || exit 1
fi
EOF
chmod 0755 "$mock_console"

cat > "$mockbin/id" <<'EOF'
#!/bin/sh
[ "$2" = fre3nder ] || exit 1
case "$1" in
-u|-g) printf '%s\n' 1000 ;;
-G) printf '%s\n' "${FIXTURE_GROUPS:-1000 28 1001 1002}" ;;
*) exit 1 ;;
esac
EOF

cat > "$mockbin/chown" <<'EOF'
#!/bin/sh
case "$1" in
root:fre3nder|root:video|root:input|root:beep) ;;
*) exit 1 ;;
esac
case "$2" in
"$FIXTURE_ROOT"/*|/dev/null) ;;
*) exit 1 ;;
esac
EOF

cat > "$mockbin/chmod" <<'EOF'
#!/bin/sh
case "$2" in
/dev/null) exit 0 ;;
"$FIXTURE_ROOT"/*) exec /bin/chmod "$@" ;;
*) exit 1 ;;
esac
EOF
cat > "$mockbin/sleep" <<'EOF'
#!/bin/sh
[ "$1" = 0.1 ] || exit 1
printf '%s\n' "$1" >> "$FIXTURE_ROOT/sleep-calls"
EOF
chmod 0755 "$mockbin"/*

run_service() (
	PATH=$mockbin:$PATH
	export PATH
	export FIXTURE_ROOT=$tmp
	export FIXTURE_RUNNING=$running
	export FIXTURE_CALLED=$called
	export FIXTURE_STOP_FAIL=${FIXTURE_STOP_FAIL:-}
	export FIXTURE_GROUPS=${FIXTURE_GROUPS:-}
	export FIXTURE_PROCESS_DELAY="${FIXTURE_PROCESS_DELAY:-0}"
	export FIXTURE_VT_DELAY="${FIXTURE_VT_DELAY:-0}"
	export FIXTURE_PROCESS_MISSING="${FIXTURE_PROCESS_MISSING:-}"
	export FIXTURE_START_FAIL="${FIXTURE_START_FAIL:-}"
	export FRE3NDER_DISPLAY_RUNTIME=$runtime
	export FRE3NDER_ROOT_STATE=$root_state
	export FRE3NDER_DISPLAY_ACTIVE=$active_display
	export FRE3NDER_PACKAGE_CORE=$mock_core
	export FRE3NDER_DISPLAY_CONSOLE=$mock_console
	export FRE3NDER_DISPLAY_GROUP_FILE=$group_file
	export FRE3NDER_DISPLAY_FRAMEBUFFER_DEVICE=${FIXTURE_FRAMEBUFFER:-/dev/null}
	export FRE3NDER_DISPLAY_BACKLIGHT_POWER_DEVICE=$backlight_power
	export FRE3NDER_DISPLAY_INPUT_SYS=$input_sys
	export FRE3NDER_DISPLAY_INPUT_DEV=$input_dev

	if [ "${FIXTURE_DISCOVER_INPUT:-}" = yes ]; then
		unset FRE3NDER_DISPLAY_INPUT_DEVICE
	else
		export FRE3NDER_DISPLAY_INPUT_DEVICE=/dev/null
	fi

	if [ "${FIXTURE_NO_BEEPER:-}" = yes ]; then
		unset FRE3NDER_DISPLAY_BEEPER_DEVICE
	else
		export FRE3NDER_DISPLAY_BEEPER_DEVICE=/dev/null
	fi

	"$display_service" "$1"
)

# No selection leaves the local display explicitly disabled.
run_service start
[ "$(cat "$runtime/status")" = disabled ]
[ ! -e "$called" ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]

printf '%s\n' fre3nderscreen > "$active_display"

rm "$root_state/status"
run_service start
[ "$(cat "$runtime/status")" = degraded-root ]
[ ! -e "$called" ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]
printf '%s\n' active > "$root_state/status"

mv "$active_display" "$active_display.saved"
ln -s "$active_display.saved" "$active_display"
run_service start
[ "$(cat "$runtime/status")" = selection-invalid ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]
rm "$active_display"
mv "$active_display.saved" "$active_display"

chmod 0644 "$mock_core"
run_service start
[ "$(cat "$runtime/status")" = package-core-unavailable ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]
chmod 0755 "$mock_core"

FIXTURE_FRAMEBUFFER=$tmp/missing-fb run_service start
[ "$(cat "$runtime/status")" = framebuffer-unavailable ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]
[ ! -e "$called" ]

FIXTURE_GROUPS='1000 28' run_service start
[ "$(cat "$runtime/status")" = user-invalid ]
[ ! -e "$called" ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]

# Missing VT preparation stops only the UI; even failed fallback does not gate rcS.
export FIXTURE_CONSOLE_FAIL=yes
run_service start
[ "$(cat "$runtime/status")" = console-unavailable ]
[ ! -e "$called" ]
unset FIXTURE_CONSOLE_FAIL
rm -f "$tmp/console-calls"
run_service start
[ "$(cat "$runtime/status")" = active ]
[ "$(cat "$backlight_power")" = 0 ]
[ "$(readlink "$runtime/input")" = /dev/null ]
[ "$(readlink "$runtime/beeper")" = /dev/null ]
[ -f "$running" ]
grep -Fxq 'action=start' "$called"
grep -Fxq 'vt=/dev/tty7' "$called"
grep -Fxq 'api=1' "$called"
grep -Fxq 'framebuffer=/dev/null' "$called"
grep -Fxq "input=$runtime/input" "$called"
grep -Fxq "backlight=$backlight_power" "$called"
grep -Fxq "beeper=$runtime/beeper" "$called"
[ ! -e "$tmp/sleep-calls" ]
[ "$(cat "$tmp/console-calls")" = "$(printf 'prepare\ncheck\nbackground')" ]

# A second start is idempotent and uses service status instead of another start.
before=$(grep -c '^action=start$' "$called")
run_service start
after=$(grep -c '^action=start$' "$called")
[ "$before" = "$after" ]
[ ! -e "$tmp/sleep-calls" ]
[ "$(tail -n 1 "$tmp/console-calls")" = background ]

# Stop failure is reported and must not erase the runtime links/state.
if FIXTURE_STOP_FAIL=yes run_service stop; then
	echo 'display service unexpectedly accepted failed frontend stop' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = stop-failed ]
[ -L "$runtime/input" ]
[ -f "$running" ]

run_service stop
[ "$(cat "$runtime/status")" = stopped ]
[ ! -e "$runtime/input" ]
[ ! -e "$runtime/beeper" ]
[ ! -e "$running" ]
grep -Fxq 'action=stop' "$called"

# Process identity and VT readiness can each lag behind service start.
FIXTURE_PROCESS_DELAY=3 FIXTURE_VT_DELAY=3 run_service start
[ "$(cat "$runtime/status")" = active ]
[ -f "$running" ]
[ "$(cat "$tmp/process-checks")" = 5 ]
[ "$(cat "$tmp/vt-checks")" = 3 ]
[ "$(wc -l < "$tmp/sleep-calls")" -eq 4 ]
[ "$(tail -n 1 "$tmp/console-calls")" = background ]
! grep -Fxq boot "$tmp/console-calls"
run_service stop
rm -f "$tmp/sleep-calls"

# A definitive start error cleans up even a partially started app, without retries.
rm -f "$called" "$tmp/console-calls"
FIXTURE_START_FAIL=yes run_service start > "$tmp/start-error"
[ "$(cat "$runtime/status")" = startup-failed ]
[ ! -e "$running" ]
[ ! -L "$runtime/input" ]
[ ! -L "$runtime/beeper" ]
[ ! -e "$tmp/sleep-calls" ]
grep -Fq 'fixture: definitive start failure' "$tmp/start-error"
grep -Fxq 'action=stop' "$called"
[ "$(tail -n 2 "$tmp/console-calls")" = "$(printf 'release\nboot')" ]

# Never release the VT or draw diagnostics over an app whose stop failed.
rm -f "$tmp/console-calls"
FIXTURE_START_FAIL=yes FIXTURE_STOP_FAIL=yes run_service start > "$tmp/stop-error"
[ "$(cat "$runtime/status")" = stop-failed ]
[ -e "$running" ]
! grep -Eq '^(release|boot|background)$' "$tmp/console-calls"
grep -Fq 'retaining VT ownership' "$tmp/stop-error"
run_service stop

# An absent app process times out separately from missing VT readiness.
rm -f "$called" "$tmp/console-calls"
FIXTURE_PROCESS_MISSING=yes run_service start > "$tmp/process-error"
[ "$(cat "$runtime/status")" = startup-failed ]
[ "$(wc -l < "$tmp/sleep-calls")" -eq 50 ]
[ "$(cat "$tmp/process-checks")" = 51 ]
[ ! -e "$running" ]
[ ! -L "$runtime/input" ]
[ ! -L "$runtime/beeper" ]
grep -Fq 'app process is missing' "$tmp/process-error"
grep -Fxq 'action=stop' "$called"
[ "$(tail -n 2 "$tmp/console-calls")" = "$(printf 'release\nboot')" ]
rm -f "$tmp/sleep-calls"

# Backlight and beeper are optional and become empty API values.
rm -f "$backlight_power" "$called"
FIXTURE_NO_BEEPER=yes run_service start
[ "$(cat "$runtime/status")" = active ]
grep -Fxq 'backlight=' "$called"
grep -Fxq 'beeper=' "$called"
run_service stop

# A running frontend without VT_PROCESS/KD_GRAPHICS is stopped and reported.
export FIXTURE_LEGACY_DISPLAY=yes
rm -f "$tmp/console-calls" "$called"
run_service start > "$tmp/vt-error"
[ "$(cat "$runtime/status")" = startup-failed ]
[ "$(wc -l < "$tmp/sleep-calls")" -eq 50 ]
[ "$(cat "$tmp/process-checks")" = 51 ]
[ ! -e "$running" ]
[ ! -L "$runtime/input" ]
[ ! -L "$runtime/beeper" ]
grep -Fq 'VT readiness missing' "$tmp/vt-error"
grep -Fq 'fixture: tty7 is not in graphics mode' "$tmp/vt-error"
grep -Fxq 'action=stop' "$called"
[ "$(tail -n 2 "$tmp/console-calls")" = "$(printf 'release\nboot')" ]
unset FIXTURE_LEGACY_DISPLAY

# Touch remains required.
rm -f "$input_dev/event7" "$called"
FIXTURE_DISCOVER_INPUT=yes run_service start
[ "$(cat "$runtime/status")" = touch-unavailable ]
[ ! -s "$called" ]
[ "$(tail -n 1 "$tmp/console-calls")" = boot ]

python3 - "$root" <<'PY'
import json
import pathlib
import subprocess
import sys

root = pathlib.Path(sys.argv[1])
overlay = root / "configs/x2000/rootfs-overlay"
user = (overlay / "etc/init.d/S30fre3nder-user").read_text()
display = (overlay / "etc/init.d/S64fre3nder-display").read_text()
component = (root / "build/x2000/fre3nderscreen-component.sh").read_text()
post_build = (root / "configs/x2000/rootfs-post-build.sh").read_text()
sources = json.loads((root / "configs/x2000/sources.json").read_text())
source = sources["userspace"]["fre3nderscreen"]

assert not (overlay / "etc/init.d/S64fre3nderscreen").exists()

for line in (
    "root_active",
    "user_ready",
    'set_device_permissions "$framebuffer" video 0660',
    'set_device_permissions "$touch_device" input 0660',
    'set_device_permissions "$beeper_device" beep 0660',
    'set_device_permissions "$backlight_power" video 0664',
    'input_name=${FRE3NDER_DISPLAY_INPUT_NAME:-ns2009_ts}',
    'beeper_input_name=${FRE3NDER_DISPLAY_BEEPER_INPUT_NAME:-pwm-beeper}',
    "FRE3NDER_DISPLAY_API=1",
    'FRE3NDER_DISPLAY_FRAMEBUFFER="$framebuffer"',
    'FRE3NDER_DISPLAY_INPUT="$input_link"',
    '"$package_core" "display-service-$action"',
):
    assert line in display, line

assert "FRE3NDERSCREEN_" not in display
assert "/opt/fre3nder/fre3nderscreen" not in display
assert "/dev/input/event0" not in display
assert "chmod 0666" not in display
assert "chmod 0777" not in display

for line in (
    "ensure_group fre3nder 1000",
    "ensure_group video 28",
    "ensure_group input 1001",
    "ensure_group beep 1002",
    'addgroup fre3nder "$group"',
):
    assert line in user, line

assert "S64fre3nder-display" in post_build
assert '"$target/etc/init.d/S63fre3nder-factory-app"' in post_build
assert '"$target/etc/init.d/S64fre3nderscreen"' in post_build
assert "fre3nderscreen" not in user

assert source["repository"] == "https://github.com/ElHanko/fre3nderscreen.git"
assert source["release"] == "2026.2"
assert source["commit"] == "63e7ecb9fff980b53f4987ef9994675aecf9e0a2"
assert source["license"] == "GPL-3.0-only"
assert "vendored_dependency" not in source
assert sources["userspace"]["wpa_supplicant"]["source"] == "upstream Buildroot package"
assert "wpa_supplicant/COPYING" not in component
assert "WPA-SUPPLICANT-LICENSE" not in component
assert '"$tmp/app/bin/fre3nderscreen"' in component
assert 'rootfs-overlay.tar' not in component

# Execute the builder's actual development branch with only Git queries mocked.
development = component.split("prepare_source() {", 1)[1].split(
    'if [ "$artifact_mode" = development ]; then\n', 1
)[1].split("\n\telse\n", 1)[0]
fixture = '''
set -eu
git() {
    case "$*" in
    "-C fixture rev-parse HEAD") printf '%s\\n' abcdef1000000000000000000000000000000000000 ;;
    "-C fixture rev-parse --short=7 HEAD") printf '%s\\n' abcdef1 ;;
    *) return 1 ;;
    esac
}
source_dir=fixture
release=$1
'''
for release, expected in (
    ("2026.1.1", "2026.1.abcdef1"),
    ("2026.2", "2026.2.abcdef1"),
):
    actual = subprocess.check_output(
        ["sh", "-c", fixture + development + '\nprintf "%s\\n" "$release"\n',
         "version-fixture", release], text=True,
    ).strip()
    assert actual == expected, (release, actual, expected)
print("Fre3nderScreen development version checks: PASS (2 cases)")

for source_name, output_name in (
    ("DEJAVU-FONTS-LICENSE.txt", "DEJAVU-FONTS-LICENSE"),
    ("MATERIAL-DESIGN-ICONS-LICENSE.txt", "MATERIAL-DESIGN-ICONS-LICENSE"),
):
    assert f'"$source_dir/licenses/{source_name}"' in component
    assert f'"$tmp/app/licenses/{output_name}"' in component
PY

echo 'fre3nder-x2000 generic display service checks: PASS'
