#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
service=$root/configs/x2000/rootfs-overlay/etc/init.d/S64fre3nderscreen
default_config=$root/configs/x2000/rootfs-overlay/usr/share/fre3nder/defaults/fre3nderscreen.json
component=$root/build/x2000/fre3nderscreen-component.sh
sources=$root/configs/x2000/sources.json
tmp=$(mktemp -d)

cleanup() {
	if [ -r "$runtime/fre3nderscreen.pid" ]; then
		kill "$(cat "$runtime/fre3nderscreen.pid")" 2>/dev/null || true
	fi
	rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

runtime=$tmp/run/fre3nderscreen
root_state=$tmp/run/root
home_root=$tmp/home
binary=$tmp/opt/fre3nderscreen
theme_dir=$tmp/usr/share/fre3nderscreen/themes
input_sys=$tmp/sys/class/input
input_dev=$tmp/dev/input
backlight_power=$tmp/sys/class/backlight/backlight/bl_power
called=$tmp/called

mkdir -p "$root_state" "$home_root" "$(dirname "$binary")" "$theme_dir" \
	"$input_sys/event7/device" "$input_dev" "$(dirname "$backlight_power")"
printf '%s\n' active > "$root_state/status"
printf '%s\n' ns2009_ts > "$input_sys/event7/device/name"
printf '%s\n' 4 > "$backlight_power"
ln -s /dev/null "$input_dev/event7"
printf '%s\n' '{}' > "$theme_dir/blue.json"

cat > "$binary" <<'EOF'
#!/bin/sh
printf '%s\n' "$FRE3NDERSCREEN_CONFIG" "$FRE3NDERSCREEN_THEME_DIR" \
	"$FRE3NDERSCREEN_INPUT" "$FRE3NDERSCREEN_BACKLIGHT_POWER" \
	"$FRE3NDERSCREEN_BEEPER_INPUT" "$FRE3NDERSCREEN_DISPLAY_SLEEP_SEC" \
	> "$FIXTURE_CALLED"
sleep 60
EOF
chmod 0755 "$binary"

run_service() {
	FRE3NDER_SCREEN_RUNTIME=$runtime \
	FRE3NDER_ROOT_STATE=$root_state \
	FRE3NDER_HOME_ROOT=$home_root \
	FRE3NDER_SCREEN_DEFAULT_CONFIG=$default_config \
	FRE3NDER_SCREEN_BINARY=$binary \
	FRE3NDER_SCREEN_THEME_DIR=$theme_dir \
	FRE3NDER_SCREEN_FRAMEBUFFER=/dev/null \
	FRE3NDER_SCREEN_BACKLIGHT_POWER=$backlight_power \
	FRE3NDER_SCREEN_INPUT_SYS=$input_sys \
	FRE3NDER_SCREEN_INPUT_DEV=$input_dev \
	FRE3NDER_SCREEN_BEEPER_DEVICE=/dev/null \
	FIXTURE_CALLED=$called \
		"$service" "$1"
}

rm "$root_state/status"
run_service start
[ "$(cat "$runtime/status")" = degraded-root ]
[ ! -e "$called" ]
printf '%s\n' active > "$root_state/status"

run_service start
[ "$(cat "$runtime/status")" = active ]
[ "$(cat "$backlight_power")" = 0 ]
[ -f "$called" ]
config=$home_root/fre3nder/.fre3nder/fre3nderscreen/fre3nderscreen.json
[ -f "$config" ] && [ ! -L "$config" ]
cmp -s "$default_config" "$config"
[ "$(stat -c '%a' "$config")" = 600 ]
[ -d "$home_root/fre3nder/printer_data/logs" ]
printf '%s\n' \
	"$config" \
	"$theme_dir" \
	"$runtime/input" \
	"$backlight_power" \
	"/dev/null" \
	"60" | cmp -s - "$called"
[ "$(readlink "$runtime/input")" = "$input_dev/event7" ]

printf '%s\n' 4 > "$backlight_power"
run_service start
[ "$(cat "$backlight_power")" = 0 ]

run_service stop
[ "$(cat "$runtime/status")" = stopped ]
[ ! -e "$runtime/fre3nderscreen.pid" ]
[ ! -e "$runtime/input" ]

# Missing backlight control is non-fatal once the local UI itself is running.
rm -f "$backlight_power" "$called"
run_service start
[ "$(cat "$runtime/status")" = active ]
[ -f "$called" ]
run_service stop

rm -f "$input_dev/event7"
rm -f "$called"
run_service start
[ "$(cat "$runtime/status")" = touch-unavailable ]
[ ! -e "$called" ]

python3 - "$sources" "$default_config" <<'PY'
import json
import pathlib
import sys

sources = json.loads(pathlib.Path(sys.argv[1]).read_text())
screen = sources["userspace"]["fre3nderscreen"]
assert screen["repository"] == "https://github.com/ElHanko/guppyscreen.git"
assert screen["release"] == "0.0.26-beta+fre3nder.589275a"
assert screen["commit"] == "589275a7c3a7fd904184bb5f15b058b7c0376911"
assert screen["license"] == "GPL-3.0-only"
assert screen["submodules"]["lvgl"]["version"] == "8.3.11"
config = json.loads(pathlib.Path(sys.argv[2]).read_text())
assert "default_printer" not in config
assert "printers" not in config
assert "display_rotate" not in config
assert config["display_sleep_sec"] == 60
assert config["touch_calibrated"] is True
assert config["fre3nderscreen_init_script"] == "/etc/init.d/S64fre3nderscreen"
assert config["log_level"] == "info"
assert config["moonraker_host"] == "127.0.0.1"
assert config["moonraker_port"] == 17126
PY

! grep -Fq 'GUPPY_SMALL_SCREEN' "$component"
! grep -Fq 'GUPPY_ROTATE' "$component"
! grep -Fq 'EVDEV_CALIBRATE=1' "$component"
grep -Fq 'FRE3NDERSCREEN_VERSION="$release"' "$component"
! grep -Fq '/dev/input/event0' "$service"
grep -Fq '/sys/class/backlight/backlight/bl_power' "$service"
grep -Fq 'FRE3NDERSCREEN_BACKLIGHT_POWER' "$service"
grep -Fq 'FRE3NDERSCREEN_BEEPER_INPUT' "$service"
grep -Fq 'FRE3NDERSCREEN_DISPLAY_SLEEP_SEC' "$service"
grep -Fq 'FRE3NDER_SCREEN_DISPLAY_SLEEP_SEC:-60' "$service"
grep -Fq "printf '%s\\n' 0" "$service"
! grep -Eq 'wget|curl|https?://' "$service"
! grep -Eq 'moonraker.*(wait|active)|S61fre3nder-moonraker' "$service"

echo 'fre3nder-x2000 Fre3nderScreen service fixtures: PASS'
