#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
deploy="$root/scripts/deploy-f005"
overlay_libexec="$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder"

tmp=$(mktemp -d)

cleanup() {
	local result=$?
	trap - EXIT HUP INT TERM
	rm -rf -- "$tmp"
	exit "$result"
}

trap cleanup EXIT HUP INT TERM

assert_no_overlay_bytecode() {
	if find "$overlay_libexec" \
		\( -type d -name '__pycache__' -o \
		-type f \( -name '*.pyc' -o -name '*.pyo' \) \) \
		-print -quit | grep -q .; then
		echo 'RootFS overlay contains unexpected Python bytecode/cache files' >&2
		exit 1
	fi
}

assert_no_overlay_bytecode

bin=$tmp/bin
artifact=$tmp/klipper-f005-mainline.bin
raw=$tmp/raw.bin
manifest=$tmp/f005-mcu-release.json

selector=$tmp/selector
klipper_status=$tmp/klipper-status
remote_firmware=$tmp/remote-firmware
log=$tmp/log

mkdir -p "$bin"

python3 - "$raw" <<'PY'
import pathlib
import struct
import sys

image = bytearray(1024)

struct.pack_into("<I", image, 0, 0x20001000)
struct.pack_into("<I", image, 4, 0x08003001)

pathlib.Path(sys.argv[1]).write_bytes(image)
PY

python3 \
	"$root/scripts/package_f005_firmware.py" \
	"$raw" \
	"$artifact" \
	--version mcu0_004_000 \
	>/dev/null

artifact_size=$(wc -c < "$artifact")
artifact_sha=$(sha256sum "$artifact" | awk '{print $1}')

python3 - \
	"$manifest" \
	"$artifact_size" \
	"$artifact_sha" <<'PY'
import json
import pathlib
import sys

path, size, sha = sys.argv[1:]

manifest = {
    "schema": 1,
    "uart": {
        "path": "/dev/ttyS1",
        "baud": 230400,
    },
    "stock_identity": {
        "version": "stock-test-runtime",
        "constants": {
            "MCU": "gd32f303xe",
            "CLOCK_FREQ": 120000000,
            "SERIAL_BAUD": 230400,
        },
    },
    "fre3nder_release": {
        "name": "test-release",
        "version": "fre3nder-test-runtime",
        "constants": {
            "MCU": "gd32f303xe",
            "CLOCK_FREQ": 120000000,
            "SERIAL_BAUD": 230400,
        },
        "firmware": {
            "path": "/var/lib/fre3nder/firmware/f005/klipper-f005-mainline.bin",
            "size": int(size),
            "sha256": sha,
            "bootloader_identity": "mcu0_001_G32-mcu0_004_000",
        },
    },
}

pathlib.Path(path).write_text(
    json.dumps(manifest, indent=2) + "\n",
    encoding="utf-8",
)
PY

manifest_sha=$(sha256sum "$manifest" | awk '{print $1}')
transition_sha=$(sha256sum \
	"$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/f005-stock-to-fre3nder" |
	awk '{print $1}')
state_sha=$(sha256sum \
	"$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/f005-mcu-state" |
	awk '{print $1}')
mcu_sha=$(sha256sum \
	"$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/f005_mcu.py" |
	awk '{print $1}')
bootloader_sha=$(sha256sum \
	"$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/f005_bootloader.py" |
	awk '{print $1}')
service_sha=$(sha256sum \
	"$root/configs/x2000/rootfs-overlay/etc/init.d/S60fre3nder-klipper" |
	awk '{print $1}')


cat > "$bin/ab" <<'EOF'
#!/bin/sh
set -eu

[ "$2" = status ] ||
	exit 1

printf '%s\n' \
	"ACTIVE_ROOT=${F005_TEST_ACTIVE_ROOT:-/dev/mmcblk0p8}" \
	'P1_DEVICE=/dev/mmcblk0p1' \
	'P1_PARTITION_NUMBER=1' \
	'P1_START=2048' \
	'P1_SECTORS=2048' \
	"P1_IDENTITY=${F005_TEST_P1_IDENTITY:-VALID}" \
	"CLASSIFICATION=$(cat "$F005_TEST_SELECTOR")"
EOF


cat > "$bin/ssh" <<'EOF'
#!/bin/sh
set -eu

while [ "$#" -gt 0 ]; do
	case "$1" in
	-o)
		shift 2
		;;
	*)
		host=$1
		shift
		break
		;;
	esac
done

command=${1:-}

case "$command" in

'sh -eu'|'F005_DEPLOY_MODE=candidate sh -eu')
	body=$(cat)

	printf '%s\n' "$body" |
		grep -Fq 'F005_SURFACE=PASS' ||
		exit 1

	[ "${F005_TEST_REMOTE_SURFACE_FAIL:-false}" != true ] ||
		exit 1

	manifest_sha=${F005_TEST_MANIFEST_SHA_OVERRIDE:-$F005_TEST_MANIFEST_SHA}
	runtime_target=QUALIFIED
	if [ "$command" = 'F005_DEPLOY_MODE=candidate sh -eu' ]; then
		runtime_target=CANDIDATE
	fi

	firmware_present=NO
	firmware_size=0
	firmware_sha=NONE

	if [ -f "$F005_TEST_REMOTE_FIRMWARE" ]; then
		firmware_present=YES
		firmware_size=$(wc -c < "$F005_TEST_REMOTE_FIRMWARE")
		firmware_sha=$(sha256sum "$F005_TEST_REMOTE_FIRMWARE" |
			awk '{print $1}')
	fi

	printf '%s\n' \
		"MANIFEST_SHA256=$manifest_sha" \
		"RUNTIME_TARGET=${F005_TEST_RUNTIME_TARGET:-$runtime_target}" \
		"RUNTIME_TARGET_SHA256=${F005_TEST_TARGET_SHA_OVERRIDE:-${F005_TEST_TARGET_SHA:-UNSET}}" \
		"TRANSITION_SHA256=$F005_TEST_TRANSITION_SHA" \
		"STATE_SHA256=$F005_TEST_STATE_SHA" \
		"MCU_HELPER_SHA256=$F005_TEST_MCU_SHA" \
		"BOOTLOADER_SHA256=$F005_TEST_BOOTLOADER_SHA" \
		"KLIPPER_SERVICE_SHA256=$F005_TEST_SERVICE_SHA" \
		"ROOT_STATUS=${F005_TEST_ROOT_STATUS:-active}" \
		"KLIPPER_STATUS=$(cat "$F005_TEST_KLIPPER_STATUS")" \
		"FIRMWARE_PRESENT=$firmware_present" \
		"FIRMWARE_SIZE=$firmware_size" \
		"FIRMWARE_SHA256=$firmware_sha" \
		'F005_SURFACE=PASS'
	;;

'/usr/libexec/fre3nder/f005-stock-to-fre3nder'|'/usr/libexec/fre3nder/f005-stock-to-fre3nder --from-qualified')
	source_status=stock-mcu
	call=dry-run
	if [ "$command" = '/usr/libexec/fre3nder/f005-stock-to-fre3nder --from-qualified' ]; then
		source_status=f005-update-required
		call='dry-run --from-qualified'
	fi
	printf '%s\n' "$call" >> "$F005_TEST_LOG"
	[ "$(cat "$F005_TEST_KLIPPER_STATUS")" = "$source_status" ] ||
		exit 1

	[ "${F005_TEST_DRY_RUN_FAIL:-false}" != true ] ||
		exit 1

	[ -f "$F005_TEST_REMOTE_FIRMWARE" ] ||
		exit 1

	[ "$(sha256sum "$F005_TEST_REMOTE_FIRMWARE" |
		awk '{print $1}')" = "$F005_TEST_ARTIFACT_SHA" ] ||
		exit 1

	printf '%s\n' \
		'f005-stock-to-fre3nder: dry-run-ready' \
		'no reset sent and no flash invoked; use --write only after operator authorization'
	;;

'/usr/libexec/fre3nder/f005-stock-to-fre3nder --write'|'/usr/libexec/fre3nder/f005-stock-to-fre3nder --from-qualified --write')
	source_status=stock-mcu
	call=flash
	if [ "$command" = '/usr/libexec/fre3nder/f005-stock-to-fre3nder --from-qualified --write' ]; then
		source_status=f005-update-required
		call='flash --from-qualified --write'
	fi
	printf '%s\n' "$call" >> "$F005_TEST_LOG"
	[ "$(cat "$F005_TEST_KLIPPER_STATUS")" = "$source_status" ] ||
		exit 1

	[ "${F005_TEST_FLASH_FAIL:-false}" != true ] ||
		exit 1

	printf active > "$F005_TEST_KLIPPER_STATUS"

	printf '%s\n' \
		'f005-stock-to-fre3nder: transition-complete'
	;;

'/etc/init.d/S60fre3nder-klipper start >/dev/null 2>&1; sleep 2; cat /run/fre3nder-klipper/status')
	printf '%s\n' service-start >> "$F005_TEST_LOG"

	[ "${F005_TEST_SERVICE_FAIL:-false}" != true ] ||
		exit 1

	cat "$F005_TEST_KLIPPER_STATUS"
	;;

*)
	printf '%s\n' "$command" |
		grep -Fq 'dir=/var/lib/fre3nder/firmware/f005' ||
		exit 1
	printf '%s\n' "$command" |
		grep -Fq '[ -f /run/fre3nder-root/status ] && [ ! -L /run/fre3nder-root/status ]' ||
		exit 1
	printf '%s\n' "$command" |
		grep -Fq '[ "$(cat /run/fre3nder-root/status)" = active ]' ||
		exit 1

	printf '%s\n' stage >> "$F005_TEST_LOG"

	[ "${F005_TEST_STAGE_FAIL:-false}" != true ] ||
		exit 1

	cat > "$F005_TEST_REMOTE_FIRMWARE"

	sha256sum "$F005_TEST_REMOTE_FIRMWARE" |
		awk '{print $1}'
	;;

esac
EOF

chmod 0755 "$bin/ab" "$bin/ssh"


reset_case() {
	printf STOCK_A > "$selector"
	printf active > "$klipper_status"
	rm -f "$remote_firmware"
	: > "$log"

	unset \
		F005_TEST_MANIFEST_SHA_OVERRIDE \
		F005_TEST_ROOT_STATUS \
		F005_TEST_REMOTE_SURFACE_FAIL \
		F005_TEST_RUNTIME_TARGET \
		F005_TEST_DRY_RUN_FAIL \
		F005_TEST_FLASH_FAIL \
		F005_TEST_SERVICE_FAIL \
		F005_TEST_STAGE_FAIL
	unset F005_TEST_ACTIVE_ROOT F005_TEST_P1_IDENTITY F005_TEST_TARGET_SHA_OVERRIDE
}


run_deploy() {
	local local_artifact=$artifact
	local record_sha=$manifest_sha
	case " $* " in
	*' --develop '*) local_artifact=$candidate_artifact; record_sha=$project_manifest_sha ;;
	esac
	F005_DEPLOY_ARTIFACT="$local_artifact" \
	F005_DEPLOY_MANIFEST="$manifest" \
	F005_DEPLOY_SSH="$bin/ssh" \
	F005_DEPLOY_AB="$bin/ab" \
	F005_TEST_SELECTOR="$selector" \
	F005_TEST_KLIPPER_STATUS="$klipper_status" \
	F005_TEST_REMOTE_FIRMWARE="$remote_firmware" \
	F005_TEST_LOG="$log" \
	F005_TEST_MANIFEST_SHA="$record_sha" \
	F005_TEST_TARGET_SHA="${candidate_target_sha:-UNSET}" \
	F005_TEST_TRANSITION_SHA="$transition_sha" \
	F005_TEST_STATE_SHA="$state_sha" \
	F005_TEST_MCU_SHA="$mcu_sha" \
	F005_TEST_BOOTLOADER_SHA="$bootloader_sha" \
	F005_TEST_SERVICE_SHA="$service_sha" \
	F005_TEST_ARTIFACT_SHA="$artifact_sha" \
	"$deploy" develop "$@"
}


must_fail() {
	if "$@" >/dev/null 2>&1; then
		echo "unexpected success: $*" >&2
		exit 1
	fi
}


assert_called() {
	grep -Fxq "$1" "$log"
}


assert_not_called() {
	! grep -Fxq "$1" "$log" 2>/dev/null
}


# Fre3nder MCU, missing persistent image: preflight reports staging only.
reset_case
run_deploy > "$tmp/preflight-active.out"

grep -Fxq 'MCU_ACTION=ALREADY_FRE3NDER' \
	"$tmp/preflight-active.out"

grep -Fxq 'PERSISTENT_WRITE=NOT_PERFORMED' \
	"$tmp/preflight-active.out"

assert_not_called stage
assert_not_called dry-run
assert_not_called flash


# Stock MCU with exact staged image: dry-run is performed, never flash.
reset_case
printf stock-mcu > "$klipper_status"
cp "$artifact" "$remote_firmware"

run_deploy > "$tmp/preflight-stock.out"

grep -Fxq 'MCU_ACTION=READY_TO_TRANSITION' \
	"$tmp/preflight-stock.out"

assert_called dry-run
assert_not_called flash


# Stock MCU without staged image: dry-run is deferred.
reset_case
printf stock-mcu > "$klipper_status"

run_deploy > "$tmp/preflight-stock-no-image.out"

grep -Fxq 'MCU_ACTION=STAGE_THEN_TRANSITION' \
	"$tmp/preflight-stock-no-image.out"

assert_not_called dry-run
assert_not_called flash


# Unknown startup state fails closed.
reset_case
printf unknown-mcu > "$klipper_status"

must_fail run_deploy

assert_not_called stage
assert_not_called flash


# Fallback selector must already be STOCK_A.
reset_case
printf DEVELOP_B > "$selector"

must_fail run_deploy

assert_not_called stage
assert_not_called flash


# Product manifest mismatch fails before any write.
reset_case
export F005_TEST_MANIFEST_SHA_OVERRIDE=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

must_fail run_deploy --write

assert_not_called stage
assert_not_called flash

unset F005_TEST_MANIFEST_SHA_OVERRIDE

# Candidate Runtime targets cannot enter the qualified deployment workflow.
reset_case
export F005_TEST_RUNTIME_TARGET=CANDIDATE
must_fail run_deploy --write
assert_not_called stage
assert_not_called dry-run
assert_not_called flash
unset F005_TEST_RUNTIME_TARGET


# Degraded root state blocks staging and every MCU action.
reset_case
export F005_TEST_ROOT_STATUS=no-userdata-source

must_fail run_deploy --write

assert_not_called stage
assert_not_called dry-run
assert_not_called flash

unset F005_TEST_ROOT_STATUS


# Already-current MCU: stage missing image, but do not flash.
reset_case

run_deploy --write > "$tmp/write-active.out"

assert_called stage
assert_not_called dry-run
assert_not_called flash

grep -Fxq 'DEPLOY_F005=PASS' \
	"$tmp/write-active.out"

[ "$(sha256sum "$remote_firmware" |
	awk '{print $1}')" = "$artifact_sha" ]


# Stock MCU: stage, dry-run, exactly one flash, then start Klipper.
reset_case
printf stock-mcu > "$klipper_status"

run_deploy --write > "$tmp/write-stock.out"

assert_called stage
assert_called dry-run
assert_called flash
assert_called service-start

[ "$(grep -Fxc flash "$log")" -eq 1 ]

grep -Fxq 'DEPLOY_F005=PASS' \
	"$tmp/write-stock.out"

[ "$(cat "$klipper_status")" = active ]


# Exact staged image skips staging but still performs the transition.
reset_case
printf stock-mcu > "$klipper_status"
cp "$artifact" "$remote_firmware"

run_deploy --write > "$tmp/write-stock-staged.out"

assert_not_called stage
assert_called dry-run
assert_called flash
assert_called service-start


# Staging failure never reaches the MCU transition.
reset_case
printf stock-mcu > "$klipper_status"
export F005_TEST_STAGE_FAIL=true

must_fail run_deploy --write

assert_called stage
assert_not_called dry-run
assert_not_called flash

unset F005_TEST_STAGE_FAIL


# Dry-run failure prevents the hardware write.
reset_case
printf stock-mcu > "$klipper_status"
cp "$artifact" "$remote_firmware"
export F005_TEST_DRY_RUN_FAIL=true

must_fail run_deploy --write

assert_called dry-run
assert_not_called flash

unset F005_TEST_DRY_RUN_FAIL


# Flash failure is not retried and Klipper is not started.
reset_case
printf stock-mcu > "$klipper_status"
cp "$artifact" "$remote_firmware"
export F005_TEST_FLASH_FAIL=true

must_fail run_deploy --write

[ "$(grep -Fxc flash "$log")" -eq 1 ]
assert_not_called service-start

unset F005_TEST_FLASH_FAIL

# Development uses the same packaged fixture image with its own validated
# Candidate manifest, built against the current source inputs. No builder runs.
candidate_dir=$tmp/candidate
mkdir -p "$candidate_dir"
candidate_artifact=$candidate_dir/klipper-f005-mainline.bin
cp "$artifact" "$candidate_artifact"
project_manifest_sha=$(sha256sum "$root/configs/x2000/f005-mcu-release.json" | awk '{print $1}')
candidate_target_sha=$(python3 - "$root" "$candidate_artifact" <<'PY'
import hashlib
import json
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
root, firmware = map(Path, sys.argv[1:])
sys.path.insert(0, str(root / "build/x2000"))
from f005_firmware import CANDIDATE_INPUTS, runtime_target, sha256

sources = json.loads((root / "configs/x2000/sources.json").read_text())
candidate = {
    "schema": 1, "classification": "candidate", "qualified_release_match": False,
    "runtime_version": "fre3nder-f005-development-fixture",
    "project_commit": subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip(),
    "upstream": {"commit": sources["userspace"]["klipper"]["commit"]},
    "inputs": {relative: sha256(root / relative) for relative in CANDIDATE_INPUTS},
    "artifacts": {firmware.name: {"size": firmware.stat().st_size, "sha256": sha256(firmware)}},
}
(firmware.parent / "build-manifest.json").write_text(json.dumps(candidate))
target = runtime_target(root, firmware, "candidate", "development")
print(hashlib.sha256(json.dumps(target, sort_keys=True).encode()).hexdigest())
PY
)
cp "$candidate_dir/build-manifest.json" "$tmp/candidate-manifest.valid"

# Exact Candidate predecessor preflight works on either selected active slot.
for slot in A B; do
	reset_case
	if [ "$slot" = A ]; then
		export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
		printf STOCK_A > "$selector"
	else
		export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p8
		printf DEVELOP_B > "$selector"
	fi
	printf f005-update-required > "$klipper_status"
	cp "$candidate_artifact" "$remote_firmware"
	run_deploy --develop > "$tmp/development-$slot.out"
	assert_called 'dry-run --from-qualified'
	[ "$(wc -l < "$log")" -eq 1 ]
	grep -Fxq 'PERSISTENT_WRITE=NOT_PERFORMED' "$tmp/development-$slot.out"
done

# Selector mismatch, unknown active slot, invalid p1, and degraded root refuse
# before staging or invoking any MCU transition.
for failure in selector active-root p1 root; do
	reset_case
	printf f005-update-required > "$klipper_status"
	case "$failure" in
	selector) export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p8; printf STOCK_A > "$selector" ;;
	active-root) export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p9 ;;
	p1) export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7 F005_TEST_P1_IDENTITY=INVALID ;;
	root) export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7 F005_TEST_ROOT_STATUS=degraded ;;
	esac
	must_fail run_deploy --develop --write
	[ ! -s "$log" ]
done

# Qualified targets and mismatched remote Candidate/Qualified records refuse.
for failure in qualified-target target-hash qualified-record unknown; do
	reset_case
	export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
	printf f005-update-required > "$klipper_status"
	case "$failure" in
	qualified-target) export F005_TEST_RUNTIME_TARGET=QUALIFIED ;;
	target-hash) export F005_TEST_TARGET_SHA_OVERRIDE=wrong ;;
	qualified-record) export F005_TEST_MANIFEST_SHA_OVERRIDE=wrong ;;
	unknown) printf unknown-mcu > "$klipper_status" ;;
	esac
	must_fail run_deploy --develop --write
	[ ! -s "$log" ]
done

# Central Candidate validation rejects stale/wrong metadata before writes.
for failure in project upstream input size classification schema; do
	reset_case
	export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
	cp "$tmp/candidate-manifest.valid" "$candidate_dir/build-manifest.json"
	python3 - "$candidate_dir/build-manifest.json" "$failure" <<'PY'
import json
from pathlib import Path
import sys
path, failure = Path(sys.argv[1]), sys.argv[2]
manifest = json.loads(path.read_text())
if failure == "project": manifest["project_commit"] = "0" * 40
elif failure == "upstream": manifest["upstream"]["commit"] = "0" * 40
elif failure == "input": manifest["inputs"]["VERSION"] = "0" * 64
elif failure == "size": manifest["artifacts"]["klipper-f005-mainline.bin"]["size"] += 1
elif failure == "classification": manifest["classification"] = "qualified"
elif failure == "schema": manifest["schema"] = 2
path.write_text(json.dumps(manifest))
PY
	must_fail run_deploy --develop --write
	[ ! -s "$log" ]
done
cp "$tmp/candidate-manifest.valid" "$candidate_dir/build-manifest.json"

# Current Candidate is a no-op, even with --write and a missing staged image.
for write_flag in '' --write; do
	reset_case
	export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
	run_deploy --develop $write_flag > "$tmp/candidate-current.out"
	[ ! -s "$log" ]
	grep -Fxq 'MCU_ACTION=ALREADY_FRE3NDER' "$tmp/candidate-current.out"
	grep -Fxq 'PERSISTENT_WRITE=NOT_PERFORMED' "$tmp/candidate-current.out"
done

# A predecessor preflight always invokes its dry-run; missing target firmware
# refuses without writing and cannot bypass the transition image checks.
reset_case
export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
printf f005-update-required > "$klipper_status"
must_fail run_deploy --develop
assert_called 'dry-run --from-qualified'
[ "$(wc -l < "$log")" -eq 1 ]

# Explicit predecessor write: stage if needed, one dry-run, one flash, start.
reset_case
export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7
printf f005-update-required > "$klipper_status"
run_deploy --develop --write > "$tmp/candidate-write.out"
printf '%s\n' stage 'dry-run --from-qualified' 'flash --from-qualified --write' service-start |
	cmp -s - "$log"
grep -Fxq 'DEPLOY_F005=PASS' "$tmp/candidate-write.out"
grep -Fxq 'FINAL_SELECTOR=STOCK_A' "$tmp/candidate-write.out"

# Development Stock updates still use only the original exact Stock path.
reset_case
export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p8
printf DEVELOP_B > "$selector"
printf stock-mcu > "$klipper_status"
run_deploy --develop --write > "$tmp/candidate-stock-write.out"
printf '%s\n' stage dry-run flash service-start | cmp -s - "$log"
grep -Fxq 'FINAL_SELECTOR=DEVELOP_B' "$tmp/candidate-stock-write.out"

# A failed Candidate transfer is never retried or followed by Klippy start.
reset_case
export F005_TEST_ACTIVE_ROOT=/dev/mmcblk0p7 F005_TEST_FLASH_FAIL=true
printf f005-update-required > "$klipper_status"
cp "$candidate_artifact" "$remote_firmware"
must_fail run_deploy --develop --write
[ "$(grep -Fxc 'flash --from-qualified --write' "$log")" -eq 1 ]
assert_not_called service-start

# Repeated/unknown flags fail before entering any deployment workflow.
must_fail run_deploy --develop --develop
must_fail run_deploy --write --write
must_fail run_deploy --unknown

assert_no_overlay_bytecode

echo 'deploy-f005 tests: PASS'
