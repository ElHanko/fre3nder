#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
source_tree=${KLIPPER_SOURCE:-$root/local/production/work/x2000/klipper}
commit=$("$root/scripts/source-value" userspace.klipper.commit)
patch=$root/patches/klipper/0004-x2000-passive-uart-opt-in.patch
version_patch=$root/patches/klipper/0005-x2000-mcu-fre3nder-version.patch
linux_config=$root/build/x2000/klipper-linux.config
printer_config=$root/configs/klipper-f005/printer-f005-mainline.cfg
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM

[ "$(git -C "$source_tree" rev-parse HEAD)" = "$commit" ]
git -C "$source_tree" archive "$commit" > "$tmp/klipper.tar"
mkdir "$tmp/klipper"
tar -xf "$tmp/klipper.tar" -C "$tmp/klipper"
git -C "$tmp/klipper" apply --check "$patch"
git -C "$tmp/klipper" apply "$patch"
git -C "$tmp/klipper" apply --check "$version_patch"
git -C "$tmp/klipper" apply "$version_patch"
git -C "$tmp/klipper" apply --reverse --check "$version_patch"
git -C "$tmp/klipper" apply --reverse --check "$patch"

python3 - "$tmp/klipper/klippy/serialhdl.py" \
	"$tmp/klipper/klippy/mcu.py" <<'PY'
import ast
import pathlib
import sys

serial_path = pathlib.Path(sys.argv[1])
mcu_path = pathlib.Path(sys.argv[2])
serial_text = serial_path.read_text(encoding="utf-8")
mcu_text = mcu_path.read_text(encoding="utf-8")
tree = ast.parse(serial_text)
passive = None
for node in ast.walk(tree):
    if isinstance(node, ast.FunctionDef) and node.name == "connect_uart_passive":
        passive = ast.get_source_segment(serial_text, node)
        break
if passive is None:
    raise SystemExit("passive UART method missing")
for forbidden in ("stk500v2_leave", ".rts", ".dtr", "serial.Serial",
                  "B2400", "B115200"):
    if forbidden in passive:
        raise SystemExit("forbidden passive UART operation: " + forbidden)
for required in ("O_RDWR", "O_NOCTTY", "flock", "TIOCEXCL", "CS8",
                 "CREAD", "CLOCAL", "B230400"):
    if required not in passive:
        raise SystemExit("missing passive UART property: " + required)
if "HUPCL" in passive:
    raise SystemExit("passive UART must leave HUPCL disabled")
for required in (
        "self._x2000_passive_uart = config.getboolean(",
        "'x2000_passive_uart', False)",
        "self._serialport != '/dev/ttyS1'",
        "self._baud != 230400",
        "self._canbus_iface is not None",
        "self._serial.connect_uart_passive",
        "self._serial.connect_uart(self._serialport, self._baud, rts)"):
    if required not in mcu_text:
        raise SystemExit("missing opt-in/default-path property: " + required)
PY

python3 -m py_compile "$tmp/klipper/klippy/serialhdl.py" \
	"$tmp/klipper/klippy/mcu.py" "$tmp/klipper/scripts/buildcommands.py"
python3 "$tmp/klipper/scripts/check_whitespace.py" \
	"$tmp/klipper/klippy/serialhdl.py" "$tmp/klipper/klippy/mcu.py" \
	"$tmp/klipper/scripts/buildcommands.py"

# Exercise the pinned version generator and production source check without make.
git clone -q --shared --no-checkout "$source_tree" "$tmp/version-source"
git -C "$tmp/version-source" checkout -q --detach "$commit"
python3 - "$root" "$tmp/version-source" "$commit" <<'PY'
import os
import json
from pathlib import Path
import re
import runpy
import subprocess
import sys
from unittest.mock import patch

root, source = map(Path, sys.argv[1:3])
commit = sys.argv[3]
metadata = json.loads((root / 'configs/x2000/sources.json').read_text())
patches = [metadata['klipper_patch_set'][name]
           for name in ('file', 'mcu_version_patch')]
entrypoint = (root / 'build/x2000/entrypoint.sh').read_text()

def function(name):
    return re.search(r'^' + name + r'\(\) \{\n.*?^\}', entrypoint,
                     re.M | re.S).group()

shell = function('check_klipper_source') + '\n' + function('build_klipper_mcu')
env = dict(os.environ, project=str(root), klipper=str(source),
           klipper_commit=commit, klipper_patches='\n'.join(patches))

def check(command='check_klipper_source'):
    return subprocess.run(['sh', '-ec', shell + '\n' + command], env=env,
                          capture_output=True, text=True)

def git(*args):
    return subprocess.check_output(['git', '-C', str(source), *args], text=True)

os.chdir(source)
sys.path.insert(0, str(source / 'klippy'))
upstream = runpy.run_path(str(source / 'scripts/buildcommands.py'))
base = git('describe', '--always', '--tags', '--long').strip()
assert upstream['build_version']('', True) == base
assert check().returncode != 0  # Both production patches are required.
for name in patches:
    git('apply', '--check', str(root / name))
    git('apply', str(root / name))
    git('apply', '--reverse', '--check', str(root / name))
assert check().returncode == 0
version = runpy.run_path(str(source / 'scripts/buildcommands.py'))
with patch.object(version['time'], 'strftime', side_effect=AssertionError), \
        patch.object(version['socket'], 'gethostname', side_effect=AssertionError):
    assert version['build_version']('', True) == base + '-fre3nder'
    assert version['build_version']('', True) == base + '-fre3nder'
# Other non-clean build conditions retain upstream's diagnostic suffix.
with patch.object(version['time'], 'strftime', return_value='20000101_000000'), \
        patch.object(version['socket'], 'gethostname', return_value='build-host'):
    assert version['build_version']('-extra', False) == (
        base + '-fre3nder-20000101_000000-build-host-extra')
for name in ('out/generated', '.config', 'klippy/chelper/c_helper.so'):
    path = source / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text('generated build output\n')
    git('check-ignore', name)
assert check().returncode == 0
for name in ('src/linux/main.c', 'klippy/mcu.py', 'klippy/serialhdl.py',
             'scripts/buildcommands.py'):
    path = source / name
    original = path.read_bytes()
    path.write_bytes(original + b'\n# unexpected source change\n')
    result = check('build_klipper_mcu unused-build-output')
    assert result.returncode != 0
    assert 'Unexpected tracked Klipper source changes' in result.stderr
    path.write_bytes(original)
assert check().returncode == 0
extra = source / 'unexpected-source.c'
extra.write_text('unexpected tracked source\n')
git('add', extra.name)
assert check().returncode != 0
git('reset', '--', extra.name)
extra.unlink()
assert check().returncode == 0
git('restore', '--source', commit, '--worktree', '--', '.')
assert version['build_version']('', True) == base
print('Pinned Klipper version and exact source-content checks: PASS')
PY

cmp -s "$linux_config" "$tmp/klipper/test/configs/linuxprocess.config"
grep -Fxq 'CONFIG_MACH_LINUX=y' "$linux_config"
python3 - "$tmp/klipper/src/linux/main.c" \
	"$tmp/klipper/src/linux/spidev.c" "$tmp/klipper/Makefile" <<'PY'
import pathlib
import sys

main, spidev, makefile = (
    pathlib.Path(path).read_text(encoding="utf-8") for path in sys.argv[1:])
assert 'char *serial = "/tmp/klipper_host_mcu";' in main
assert 'console_setup(serial);' in main
assert 'open(fname, O_RDWR|O_CLOEXEC)' in spidev
assert 'snprintf(fname, sizeof(fname), "/dev/spidev%d.%d"' in spidev
assert 'CC=$(CROSS_PREFIX)gcc' in makefile
assert 'target-y := $(OUT)klipper.elf' in makefile
PY

python3 - "$printer_config" "$tmp/klipper/klippy/extras/bus.py" \
	"$tmp/klipper/klippy/extras/adxl345.py" \
	"$tmp/klipper/klippy/extras/resonance_tester.py" <<'PY'
import configparser
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
bus = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8")
adxl = pathlib.Path(sys.argv[3]).read_text(encoding="utf-8")
resonance = pathlib.Path(sys.argv[4]).read_text(encoding="utf-8")
parser = configparser.RawConfigParser(strict=True)
parser.read_string(path.read_text(encoding="utf-8"))
assert dict(parser["mcu rpi"]) == {"serial": "/tmp/klipper_host_mcu"}
assert dict(parser["adxl345"]) == {
    "cs_pin": "rpi:None",
    "spi_speed": "2000000",
    "spi_bus": "spidev2.0",
    "axes_map": "z,y,x",
}
assert dict(parser["resonance_tester"]) == {
    "accel_chip": "adxl345",
    "accel_per_hz": "50",
    "probe_points": "117.5,117.5,100",
    "max_freq": "100",
}
assert dict(parser["input_shaper"]) == {
    "shaper_type_x": "mzv",
    "shaper_freq_x": "62.4",
    "shaper_type_y": "mzv",
    "shaper_freq_y": "39.8",
}
assert parser["printer"]["max_accel"] == "4500"
lower = path.read_text(encoding="utf-8").lower()
for forbidden in ("bl24c16", "eeprom", "plr", "nebulaos"):
    assert forbidden not in lower
for required in ("config.get(pin_option)", "config.getint('spi_speed'",
                 "config.get('spi_bus', None)"):
    assert required in bus
assert "config.getlist('axes_map'" in adxl
assert "def _start_measurements(self):" in adxl
assert "self.read_reg(REG_DEVID)" in adxl
for required in ("config.getfloat('max_freq'",
                 "config.getfloat('accel_per_hz'",
                 "config.getlists('probe_points'"):
    assert required in resonance
PY

fragment=$root/configs/x2000/buildroot.fragment
for symbol in BR2_PACKAGE_PYTHON3 BR2_PACKAGE_PYTHON3_ZLIB \
	BR2_PACKAGE_PYTHON_CFFI BR2_PACKAGE_PYTHON_GREENLET \
	BR2_PACKAGE_PYTHON_JINJA2 BR2_PACKAGE_PYTHON_MARKUPSAFE \
	BR2_PACKAGE_PYTHON_SERIAL BR2_PACKAGE_PYTHON_NUMPY; do
	grep -Fxq "$symbol=y" "$fragment"
done
grep -Fxq '# BR2_PACKAGE_PYTHON_CAN is not set' "$fragment"
grep -Fq 'host/bin/mipsel-buildroot-linux-gnu-gcc' \
	"$root/build/x2000/entrypoint.sh"
grep -Fq 'SOURCE_FILES' "$root/build/x2000/entrypoint.sh"
grep -Fq 'usr/share/klipper/klippy/chelper' "$root/build/x2000/entrypoint.sh"
grep -Fq 'build_klipper_mcu "$brout"' "$root/build/x2000/entrypoint.sh"
grep -Fq 'CROSS_PREFIX="$cross_prefix"' "$root/build/x2000/entrypoint.sh"
grep -Fq 'usr/bin/klipper_mcu' "$root/build/x2000/entrypoint.sh"
grep -Fxq 'BR2_mips_xburst2=y' "$root/configs/x2000/buildroot.defconfig"
grep -Fxq 'BR2_MIPS_FP32_MODE_XX=y' \
	"$root/configs/x2000/buildroot.defconfig"
! grep -Fxq 'BR2_MIPS_NAN_LEGACY=y' \
	"$root/configs/x2000/buildroot.defconfig"
test -f "$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
grep -Fq 'prepare_buildroot' "$root/build/x2000/entrypoint.sh"
grep -Fq 'f005_bootloader.py' "$root/build/x2000/entrypoint.sh"
grep -Fxq 'x2000_passive_uart: True' \
	"$root/configs/klipper-f005/printer-f005-mainline.cfg"
if find "$root/configs/x2000/rootfs-overlay" -type f \
	-name mcu_util -print -quit | grep -q .; then
	echo 'immutable overlay contains mcu_util' >&2
	exit 1
fi
if grep -E -i -q 'nebula(os)?|openke|bl24c16|eeprom|power.loss|\bplr\b' \
	"$root/build/x2000/entrypoint.sh" \
	"$root/configs/x2000/rootfs-overlay/etc/init.d/S59fre3nder-klipper-mcu" \
	"$printer_config"; then
	echo 'Host-MCU runtime path gained an excluded dependency' >&2
	exit 1
fi

python3 "$root/tests/test_x2000_klipper.py"
KLIPPER_SOURCE="$source_tree" python3 "$root/tests/test_filament_change.py"
python3 "$root/tests/test_f005_bootloader.py"
if find "$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder" \
	\( -type d -name '__pycache__' -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) \
	-print -quit | grep -q .; then
	echo 'RootFS libexec overlay contains Python bytecode/cache files' >&2
	exit 1
fi
"$root/tests/test-x2000-klipper-service"
"$root/tests/test-x2000-klipper-mcu-service"
echo 'fre3nder-x2000 Klipper integration checks: PASS'
