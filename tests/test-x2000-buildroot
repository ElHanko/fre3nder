#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
entrypoint="$root/build/x2000/entrypoint.sh"
base="$root/configs/x2000/buildroot.defconfig"
fragment="$root/configs/x2000/buildroot.fragment"
sources="$root/configs/x2000/sources.json"
build_script="$root/scripts/build-x2000"
kernel_build_script="$root/scripts/build-x2000-kernel"
rootfs_build_script="$root/scripts/build-x2000-rootfs"
fingerprint="$root/scripts/x2000-build-input-sha256"
moonraker_service="$root/configs/x2000/rootfs-overlay/etc/init.d/S61fre3nder-moonraker"
moonraker_default="$root/configs/x2000/rootfs-overlay/usr/share/fre3nder/defaults/moonraker.conf"
moonraker_wheels="$root/configs/x2000/moonraker-python-wheels.json"
streaming_package="$root/configs/x2000/buildroot-external/package/python-streaming-form-data"
moonraker_source=${MOONRAKER_SOURCE:-$root/local/production/work/x2000/moonraker-source}
moonraker_wheel_cache=${MOONRAKER_WHEEL_CACHE:-$root/local/production/work/x2000/moonraker-python-wheels}
klipper_source=${KLIPPER_SOURCE:-$root/local/production/work/x2000/klipper}
post_build="$root/configs/x2000/rootfs-post-build.sh"

python3 - "$sources" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
buildroot = data["buildroot"]
assert buildroot == {
    "version": "2025.02.17",
    "url": "https://gitlab.com/buildroot.org/buildroot.git",
    "commit": "d0820dd09916edcefc44e525355afbea30d5bee4",
    "source": "upstream Buildroot",
}
greenlet = data["userspace"]["greenlet"]
assert greenlet == {
    "version": "3.1.1",
    "license": "MIT, PSF-2.0",
    "source": "upstream Buildroot 2025.02.17 package",
    "required_by": (
        "Klipper 0499b30374315f2a9f49fc12808527fc7d0f5cfa for Python >= 3.12"),
}
assert data["userspace_toolchain"] == {
    "identity": "Buildroot internal toolchain",
    "source": "upstream Buildroot 2025.02.17",
    "binutils": "2.43.1",
    "gcc": "13.4.0",
    "libc": "glibc",
    "kernel_headers": "6.6",
    "target": "mipsel MIPS32r2 O32 hard-float FPXX NaN2008",
    "hardware_validated": True,
}
assert data["kernel_toolchain"] == {
    "identity": "Buildroot internal toolchain",
    "source": "upstream Buildroot 2025.02.17",
    "binutils": "2.43.1",
    "gcc": "13.4.0",
    "compiler": "mipsel-buildroot-linux-gnu-gcc.br_real",
    "target": "mipsel MIPS32r5 O32 soft-float legacy-NaN",
    "relationship": (
        "same toolchain family as userspace, with separate Kbuild target flags"),
    "hardware_validated": True,
}
assert data["userspace"]["moonraker"] == {
    "repository": "https://github.com/Arksine/moonraker.git",
    "commit": "985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d",
    "license": "GPL-3.0-only",
    "role": "qualified RootFS application baseline",
}
PY

python3 - "$moonraker_wheels" <<'PY'
import json
import pathlib
import re
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["schema"] == 1
assert data["target"] == {
    "python": "3.12",
    "platform": "any",
    "implementation": "py",
    "abi": "none",
}
assert {wheel["name"] for wheel in data["wheels"]} == {
    "apprise",
    "importlib-metadata",
    "inotify-simple",
    "ldap3",
    "libnacl",
    "preprocess-cancellation",
    "pyserial",
    "smart-open",
    "zipp",
}
assert all(re.fullmatch(r"[0-9a-f]{64}", wheel["sha256"])
           for wheel in data["wheels"])
PY

# The staged layout is a PEP 405 environment, not merely a directory named
# "venv". Verify the same pyvenv.cfg and executable-link mechanism with the
# host CPython; target execution remains a build/hardware qualification item.
python3 - <<'PY'
import pathlib
import subprocess
import sys
import tempfile

with tempfile.TemporaryDirectory() as tmp:
    env = pathlib.Path(tmp) / "moonraker-env"
    (env / "bin").mkdir(parents=True)
    (env / "bin/python").symlink_to(sys.executable)
    (env / "pyvenv.cfg").write_text(
        f"home = {pathlib.Path(sys.executable).parent}\n"
        "include-system-site-packages = true\n"
        f"version = {sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}\n",
        encoding="utf-8",
    )
    subprocess.run(
        [
            str(env / "bin/python"),
            "-c",
            "import pathlib,sys; assert pathlib.Path(sys.prefix)==pathlib.Path(sys.argv[1]); assert sys.base_prefix != sys.prefix",
            str(env),
        ],
        check=True,
    )
PY

grep -Fxq 'buildroot="$work/buildroot"' "$entrypoint"
grep -Fxq 'buildroot_dl="$work/buildroot-dl"' "$entrypoint"
grep -Fxq 'buildroot_version=2025.02.17' "$entrypoint"
grep -Fxq 'buildroot_commit=d0820dd09916edcefc44e525355afbea30d5bee4' \
	"$entrypoint"
grep -Fq 'config BR2_mips_xburst2' "$entrypoint"
grep -Fq 'BR_FP_CONTRACT_OFF' "$entrypoint"
grep -Fq -- '-ffp-contract=off' "$entrypoint"
grep -Fq 'PYTHON_GREENLET_VERSION = 3.1.1' "$entrypoint"
grep -Fq 'BR2_DL_DIR="$buildroot_dl"' "$entrypoint"
grep -Fq 'BR2_GLOBAL_PATCH_DIR="$project/patches"' "$entrypoint"
grep -Fq 'BR2_EXTERNAL="$buildroot_external"' "$entrypoint"
grep -Fxq 'name: FRE3NDER' "$root/configs/x2000/buildroot-external/external.desc"
grep -Fq 'python-streaming-form-data' \
	"$root/configs/x2000/buildroot-external/Config.in"
grep -Fxq 'PYTHON_STREAMING_FORM_DATA_VERSION = 2.1.0' \
	"$streaming_package/python-streaming-form-data.mk"
grep -Fq '2c5c81fc9c451ea133083bc6da959f87e9b91fba3effe99411f1f90461ea7c5b' \
	"$streaming_package/python-streaming-form-data.hash"
grep -Fq 'BR2_GCC_TARGET_ARCH="mips32r2"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_ABI="32"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_FP32_MODE="xx"' "$entrypoint"
grep -Fq 'BR2_GCC_TARGET_NAN="2008"' "$entrypoint"
grep -Fq 'BR2_BINUTILS_VERSION="2.43.1"' "$entrypoint"
grep -Fq 'BR2_GCC_VERSION="13.4.0"' "$entrypoint"
grep -Fq "! grep -Eq '^BR2_TOOLCHAIN_EXTERNAL(=|_)'" "$entrypoint"
grep -Fq 'FP ABI: Hard float (32-bit CPU, Any FPU)' "$entrypoint"
grep -Fq 'Shared library: [ld-linux-mipsn8.so.1]' "$entrypoint"
! grep -Fq '$sdk/buildroot' "$entrypoint"
! grep -Fq 'halley5_linux_minimal_defconfig' "$entrypoint"
! grep -Fq 'libffi-disable-host-static-exec-tramp' "$entrypoint"
grep -Fxq 'BR2_PACKAGE_GIT=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL_FORCE_TLS=y' "$fragment"
grep -Fxq 'BR2_PACKAGE_LIBCURL_OPENSSL=y' "$fragment"

# These packages remain intentionally disabled in the product configuration,
# but Buildroot may omit invisible Kconfig symbols from the effective .config.
grep -Fxq '# BR2_PACKAGE_I2C_TOOLS is not set' "$fragment"
grep -Fxq '# BR2_PACKAGE_BASH is not set' "$fragment"

# Validate the semantic checks used for the effective RootFS instead of relying
# on invisible Kconfig symbols being materialized as "# ... is not set".
grep -Fq "grep -Fxq '# BR2_PACKAGE_BUSYBOX_SHOW_OTHERS is not set'" "$entrypoint"
grep -Fq -- "-name 'i2c-tools-*' -print -quit" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CGET=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CSET=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CDUMP=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CDETECT=y'" "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_I2CTRANSFER=y'" "$entrypoint"

grep -Fq -- "-name 'bash-*' -print -quit" "$entrypoint"
grep -Fq '[ ! -e "$target/bin/bash" ]' "$entrypoint"
grep -Fq '[ "$(readlink "$target/bin/sh")" = busybox ]' "$entrypoint"
grep -Fq "grep -Fxq 'CONFIG_ASH=y'" "$entrypoint"

! grep -Fq \
	"grep -Fxq '# BR2_PACKAGE_I2C_TOOLS is not set' \"\$brout/.config\"" \
	"$entrypoint"
! grep -Fq \
	"grep -Fxq '# BR2_PACKAGE_BASH is not set' \"\$brout/.config\"" \
	"$entrypoint"

for setting in \
	'BR2_mipsel=y' \
	'BR2_mips_xburst2=y' \
	'# BR2_MIPS_SOFT_FLOAT is not set' \
	'BR2_MIPS_FP32_MODE_XX=y' \
	'BR2_TOOLCHAIN_BUILDROOT=y' \
	'BR2_TOOLCHAIN_BUILDROOT_GLIBC=y' \
	'BR2_KERNEL_HEADERS_6_6=y' \
	'BR2_TOOLCHAIN_BUILDROOT_CXX=y' \
	'BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y'; do
	grep -Fxq "$setting" "$base"
done

! grep -Fq 'BR2_TOOLCHAIN_EXTERNAL' "$base"
! grep -Fq 'BR2_MIPS_NAN_LEGACY=y' "$base"
grep -Fq 'host/bin/mipsel-buildroot-linux-gnu-gcc' "$entrypoint"
grep -Fq 'gcc.br_real' "$entrypoint"
grep -Fq 'git -C "$sdk" sparse-checkout set kernel/kernel-6.6' "$entrypoint"
! grep -Fq 'mips-gcc720-glibc238' "$entrypoint"
! grep -Fq 'CROSS_COMPILE=mips-linux-gnu-' "$entrypoint"
[ -x "$fingerprint" ]
[ "$($fingerprint)" = "$($fingerprint)" ]
"$fingerprint" --list-inputs | grep -Fxq 'configs/x2000'
"$fingerprint" --list-inputs |
	grep -Fxq 'scripts/x2000-build-input-sha256'
"$fingerprint" --list-inputs | grep -Fxq 'scripts/build-x2000-kernel'
"$fingerprint" --list-inputs | grep -Fxq 'scripts/build-x2000-rootfs'
grep -Fq '[--develop] [--kernel-build] [--f005-build]' "$build_script"
grep -Fq 'build-x2000-rootfs' "$build_script"
grep -Fq 'build-x2000-kernel' "$build_script"
grep -Fq 'build-f005' "$build_script"
! grep -Fq -- '--rootfs-only' "$build_script"
! grep -Fq -- '--kernel-only' "$build_script"
grep -Fq 'fetch-kernel' "$kernel_build_script"
grep -Fq 'build-kernel-only' "$kernel_build_script"
! grep -Eq 'moonraker|f005|wifi' "$kernel_build_script"
grep -Fq 'fetch-rootfs' "$rootfs_build_script"
! grep -Eq '"\$image" fetch($|[[:space:]])' "$rootfs_build_script"
grep -Fq 'build-rootfs-only' "$rootfs_build_script"
grep -Fq 'FRE3NDER_F005_FIRMWARE' "$rootfs_build_script"
grep -Fq '$firmware_in_container:ro' "$rootfs_build_script"
! grep -Fq -- '--moonraker-app-only' "$build_script"
grep -Fq 'FRE3NDER_ARTIFACT_MODE=$artifact_mode' "$rootfs_build_script"
sed -n '/^fetch_rootfs_inputs() {$/,/^}$/p' "$entrypoint" |
	grep -Fq 'fetch_buildroot_inputs'
! sed -n '/^fetch_rootfs_inputs() {$/,/^}$/p' "$entrypoint" |
	grep -Fq '$sdk'
! sed -n '/^fetch_rootfs_inputs() {$/,/^}$/p' "$entrypoint" |
	grep -Fq 'fetch_kernel_inputs'
grep -Fq '"artifact_mode": os.environ["artifact_mode"]' "$entrypoint"
grep -Fq 'manifest["build_input_sha256"]' "$entrypoint"
grep -Fq 'write_build_manifest "$out" buildroot.config rootfs.squashfs' \
	"$entrypoint"
grep -Fq '"$target/usr/share/fre3nder/DEVELOPMENT"' "$entrypoint"
grep -Fq '[ ! -e "$target/usr/share/fre3nder/DEVELOPMENT" ]' "$entrypoint"
grep -Fq 'moonraker_commit=985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d' \
	"$entrypoint"
grep -Fq 'prepare_moonraker_overlay()' "$entrypoint"
[ "$(grep -Fc 'prepare_moonraker_overlay' "$entrypoint")" -eq 3 ]
grep -Fq '"$wifi_overlay $klipper_overlay $moonraker_overlay"' "$entrypoint"
grep -Fq 'moonraker_root="$moonraker_overlay/opt/fre3nder/moonraker"' \
	"$entrypoint"
grep -Fq 'moonraker_env="$moonraker_overlay/opt/fre3nder/moonraker-env"' \
	"$entrypoint"
grep -Fq 'include-system-site-packages = true' "$entrypoint"
grep -Fq 'git -C "$moonraker_root" remote get-url origin' "$entrypoint"
grep -Fq 'git -C "$moonraker_root" rev-parse HEAD' "$entrypoint"
grep -Fq 'git -C "$moonraker_root" read-tree HEAD' "$entrypoint"
grep -Fq 'mv "$moonraker_root/.git" "$moonraker_root/.fre3nder-git"' \
	"$entrypoint"
grep -Fq 'rsync -a --exclude=.git/ "$klipper/"' "$entrypoint"
grep -Fq '[ ! -e "$target/usr/share/klipper/.git" ]' "$entrypoint"
! grep -Fq 'build-moonraker-app-only' "$entrypoint"
! grep -Fq 'managed-app-manifest.json' "$entrypoint"
! grep -Fq 'PAYLOAD-MANIFEST.json' "$entrypoint"
[ -x "$moonraker_service" ]
[ -f "$moonraker_default" ]
grep -Fxq 'host: 127.0.0.1' "$moonraker_default"
grep -Fxq 'port: 17126' "$moonraker_default"
grep -Fxq 'klippy_uds_address: /run/fre3nder-klipper/klippy.sock' \
	"$moonraker_default"
grep -Fxq '[update_manager]' "$moonraker_default"
grep -Fxq 'channel: stable' "$moonraker_default"
grep -Fxq 'enable_system_updates: False' "$moonraker_default"
grep -Fxq '[authorization]' "$moonraker_default"
grep -Fxq 'trusted_clients:' "$moonraker_default"
grep -Fxq '  127.0.0.1' "$moonraker_default"
! grep -Fxq 'enabled: True' "$moonraker_default"
grep -Fq 'moonraker_root=${FRE3NDER_MOONRAKER_ROOT:-/opt/fre3nder/moonraker}' \
	"$moonraker_service"
grep -Fq 'moonraker=${FRE3NDER_MOONRAKER_ENTRYPOINT:-$moonraker_root/moonraker/moonraker.py}' \
	"$moonraker_service"
grep -Fq '/opt/fre3nder/moonraker-env/bin/python' "$moonraker_service"
grep -Fq 'PIP_ONLY_BINARY=:all:' "$moonraker_service"
grep -Fq -- '-u "$uds"' "$moonraker_service"
! grep -Eq 'pip|https?://' "$moonraker_service"
! grep -Fq 'managed-app-resolve' "$moonraker_service"
! grep -Fq 'active-version' "$moonraker_service"
[ ! -e "$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/managed-app-resolve" ]
grep -Fq 'f005_target_path=/var/lib/fre3nder/firmware/f005/klipper-f005-mainline.bin' \
	"$entrypoint"
grep -Fq 'validate_f005_firmware "$f005_firmware"' "$entrypoint"
grep -Fq 'validate_f005_firmware "$target$f005_target_path"' "$entrypoint"
grep -Fq 'install -m 0644 "$f005_firmware"' "$entrypoint"
grep -Fq 'relative.suffix in (".pyc", ".pyo")' "$entrypoint"

tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM

# The qualified F005 image is staged into the immutable RootFS overlay from the
# release-manifest-validated local artifact.
git clone -q "$klipper_source" "$tmp/klipper"
project=$root
version_file=$root/VERSION
klipper=$tmp/klipper
klipper_overlay=$tmp/klipper-overlay
klipper_commit=0499b30374315f2a9f49fc12808527fc7d0f5cfa
f005_release_manifest=$root/configs/x2000/f005-mcu-release.json
f005_target_path=/var/lib/fre3nder/firmware/f005/klipper-f005-mainline.bin
f005_firmware=$root/local/production/artifacts/x2000/f005/klipper-f005-mainline.bin
artifact_mode=release
project_commit=$(git -C "$root" rev-parse HEAD)
project_worktree_status=clean
sed -n '/^validate_f005_firmware() {$/,/^}$/p' "$entrypoint" \
	> "$tmp/validate-f005-firmware.sh"
sed -n '/^prepare_klipper_overlay() {$/,/^}$/p' "$entrypoint" \
	> "$tmp/prepare-klipper-overlay.sh"
. "$tmp/validate-f005-firmware.sh"
. "$tmp/prepare-klipper-overlay.sh"
prepare_klipper_overlay
[ "$(cat "$klipper_overlay/usr/share/fre3nder/APP_REF")" = "$project_commit" ]
staged_f005=$klipper_overlay$f005_target_path
python3 - "$f005_release_manifest" "$staged_f005" <<'PY'
import hashlib
import json
import pathlib
import stat
import sys

manifest_path, firmware_path = map(pathlib.Path, sys.argv[1:])
firmware = json.loads(manifest_path.read_text(encoding="utf-8"))["fre3nder_release"]["firmware"]
assert firmware["path"] == "/var/lib/fre3nder/firmware/f005/klipper-f005-mainline.bin"
assert firmware_path.is_file() and not firmware_path.is_symlink()
assert stat.S_IMODE(firmware_path.stat().st_mode) == 0o644
assert firmware_path.stat().st_size == firmware["size"]
assert hashlib.sha256(firmware_path.read_bytes()).hexdigest() == firmware["sha256"]
PY

# The staged Moonraker checkout keeps Git metadata under a neutral name so
# Buildroot's generic overlay VCS filter transfers it. The post-build hook
# restores the real Git directory without overwriting a conflicting target.
git clone -q "$moonraker_source" "$tmp/moonraker-source"
git -C "$tmp/moonraker-source" remote set-url origin \
	'https://github.com/Arksine/moonraker.git'
moonraker=$tmp/moonraker-source
moonraker_overlay=$tmp/moonraker-overlay
moonraker_wheel_manifest=$moonraker_wheels
moonraker_url=https://github.com/Arksine/moonraker.git
moonraker_commit=985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d
sed -n '/^prepare_moonraker_overlay() {$/,/^}$/p' "$entrypoint" \
	> "$tmp/prepare-moonraker-overlay.sh"
. "$tmp/prepare-moonraker-overlay.sh"
prepare_moonraker_source() {
	[ "$(git -C "$moonraker" rev-parse HEAD)" = \
		985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d ]
}
prepare_moonraker_overlay
moonraker_root="$moonraker_overlay/opt/fre3nder/moonraker"
[ -z "$(find "$moonraker_overlay/opt/fre3nder/moonraker-env/lib/python3.12/site-packages" \
	\( -type d -name '__pycache__' -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) \
	-print -quit)" ]
[ -d "$moonraker_root/.fre3nder-git" ]
[ ! -e "$moonraker_root/.git" ]
[ "$(git --git-dir="$moonraker_root/.fre3nder-git" rev-parse HEAD)" = \
	985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d ]
[ "$(git --git-dir="$moonraker_root/.fre3nder-git" remote get-url origin)" = \
	https://github.com/Arksine/moonraker.git ]

target=$tmp/target
mkdir -p "$target/etc/init.d" "$target/usr/libexec/fre3nder" "$target/usr/bin"
cp "$root/configs/x2000/rootfs-overlay/usr/bin/fre3nder" "$target/usr/bin/"
touch "$target/etc/init.d/fre3nder-root" \
	"$target/etc/init.d/S20fre3nder-provision" \
	"$target/etc/init.d/S40fre3nder-network" \
	"$target/etc/init.d/S50dropbear" \
	"$target/etc/init.d/S60fre3nder-klipper" \
	"$target/etc/init.d/S61fre3nder-moonraker" \
	"$target/etc/init.d/S62fre3nder-web" \
	"$target/etc/init.d/S50lighttpd" \
	"$target/usr/libexec/fre3nder/f005-mcu-state" \
	"$target/usr/libexec/fre3nder/f005-stock-to-fre3nder" \
	"$target/usr/libexec/fre3nder-udhcpc"
cp -a "$moonraker_overlay/." "$target/"
"$post_build" "$target"
[ -x "$target/usr/bin/fre3nder" ]
[ -x "$target/etc/init.d/S62fre3nder-web" ]
[ ! -e "$target/etc/init.d/S50lighttpd" ]
moonraker_root="$target/opt/fre3nder/moonraker"
[ -d "$moonraker_root/.git" ]
[ ! -e "$moonraker_root/.fre3nder-git" ]
[ "$(git -C "$moonraker_root" rev-parse HEAD)" = \
	985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d ]
[ "$(git -C "$moonraker_root" remote get-url origin)" = \
	https://github.com/Arksine/moonraker.git ]

[ "$(grep -Fc 'make -C "$buildroot" O="$brout" -j"$jobs" toolchain' \
	"$entrypoint")" -eq 2 ]

first_toolchain=$(grep -nF 'make -C "$buildroot" O="$brout" -j"$jobs" toolchain' \
	"$entrypoint" | head -n 1 | cut -d: -f1)
first_kernel=$(grep -nF 'prepare_kernel "$kernel_cross_compile" "$kernel_cc"' \
	"$entrypoint" | head -n 1 | cut -d: -f1)
[ "$first_toolchain" -lt "$first_kernel" ]

test -f "$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
grep -Fq 'select BR2_MIPS_NAN_2008' \
	"$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
grep -Fq '$(BR2_mips_xburst2)' \
	"$root/patches/buildroot/0001-mips-add-ingenic-xburst2-target.patch"
! test -e "$root/patches/python-greenlet/0001-gcc7-avoid-nontrivial-designated-initializers.patch"

echo 'fre3nder-x2000 Buildroot architecture tests: PASS'
