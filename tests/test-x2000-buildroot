# The staged layout is a PEP 405 environment, not merely a directory named
# "venv". Verify the same pyvenv.cfg and executable-link mechanism with the
# host CPython; target execution remains a build/hardware qualification item.
python3 - <<'PY'
import pathlib
import subprocess
import sys
import tempfile

with tempfile.TemporaryDirectory() as tmp:
    env = pathlib.Path(tmp) / "moonraker-env"
    (env / "bin").mkdir(parents=True)
    (env / "bin/python").symlink_to(sys.executable)
    (env / "pyvenv.cfg").write_text(
        f"home = {pathlib.Path(sys.executable).parent}\n"
        "include-system-site-packages = true\n"
        f"version = {sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}\n",
        encoding="utf-8",
    )
    subprocess.run(
        [
            str(env / "bin/python"),
            "-c",
            "import pathlib,sys; assert pathlib.Path(sys.prefix)==pathlib.Path(sys.argv[1]); assert sys.base_prefix != sys.prefix",
            str(env),
        ],
        check=True,
    )
PY

