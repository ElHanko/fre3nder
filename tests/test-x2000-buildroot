	985c1d0bbeb90bc057d34a232c9dc3b05e0c6c8d ]
[ "$(git -C "$moonraker_root" remote get-url origin)" = \
	https://github.com/Arksine/moonraker.git ]

# Re-running the post-build hook replaces stale Git metadata in an incremental
# target with the freshly transported metadata from the current overlay.
printf '%s\n' old > "$moonraker_root/.git/old-post-build-marker"
cp -a "$moonraker_root/.git" "$moonraker_root/.fre3nder-git"
rm -f -- "$moonraker_root/.fre3nder-git/old-post-build-marker"
printf '%s\n' current > \
	"$moonraker_root/.fre3nder-git/current-overlay-marker"
