create_cached_toolchain() {
	rm -rf -- "$cache_output"
	create_toolchain_fixture
	write_buildroot_toolchain_fingerprint "$cache_output"
	: > "$cache_output/preserved"
}

# 1. Release always removes an existing output.
mkdir -p "$cache_output"
: > "$cache_output/preserved"
artifact_mode=release
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot release build: CLEAN' ]
[ ! -e "$cache_output" ]

# 2. Development without an output takes the clean path.
artifact_mode=development
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (output missing)' ]
[ ! -e "$cache_output" ]

# A marker is recorded only for an intact toolchain and has exact SHA256 format.
mkdir -p "$cache_output"
if write_buildroot_toolchain_fingerprint "$cache_output" 2>/dev/null; then
	exit 1
fi
[ ! -e "$cache_output/$buildroot_toolchain_marker" ]
create_toolchain_fixture
write_buildroot_toolchain_fingerprint "$cache_output"
grep -Eq '^[0-9a-f]{64}$' "$cache_output/$buildroot_toolchain_marker"
[ "$(wc -l < "$cache_output/$buildroot_toolchain_marker")" -eq 1 ]

# 3. A matching Development output is preserved.
: > "$cache_output/preserved"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot development cache: HIT' ]
[ -e "$cache_output/preserved" ]
[ -f "$cache_output/$buildroot_toolchain_marker" ]

# 4. A different valid fingerprint removes the output.
create_cached_toolchain
printf '%064d\n' 0 > "$cache_output/$buildroot_toolchain_marker"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (toolchain fingerprint changed)' ]
[ ! -e "$cache_output" ]

# 5. buildroot.fragment is deliberately outside the toolchain fingerprint.
fingerprint_before=$(buildroot_toolchain_fingerprint)
create_cached_toolchain
printf '%s\n' 'BR2_PACKAGE_FRE3NDER_FIXTURE=y' >> \
	"$cache_project/configs/x2000/buildroot.fragment"
[ "$(buildroot_toolchain_fingerprint)" = "$fingerprint_before" ]
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot development cache: HIT' ]
[ -e "$cache_output/preserved" ]

# 6. A normal RootFS input is deliberately outside the fingerprint too.
create_cached_toolchain
printf '%s\n' 'changed RootFS fixture' >> \
	"$cache_project/configs/x2000/rootfs-overlay/etc/fixture"
[ "$(buildroot_toolchain_fingerprint)" = "$fingerprint_before" ]
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot development cache: HIT' ]
[ -e "$cache_output/preserved" ]

# 7. A buildroot.defconfig change produces a cache miss.
create_cached_toolchain
cp "$cache_project/configs/x2000/buildroot.defconfig" "$tmp/buildroot.defconfig"
printf '%s\n' '# toolchain fixture change' >> \
	"$cache_project/configs/x2000/buildroot.defconfig"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (toolchain fingerprint changed)' ]
[ ! -e "$cache_output" ]
cp "$tmp/buildroot.defconfig" "$cache_project/configs/x2000/buildroot.defconfig"

# 8. An XBurst II patch change produces a cache miss.
create_cached_toolchain
cp "$buildroot_patch" "$tmp/xburst2.patch"
printf '%s\n' '# toolchain fixture change' >> "$buildroot_patch"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (toolchain fingerprint changed)' ]
[ ! -e "$cache_output" ]
cp "$tmp/xburst2.patch" "$buildroot_patch"

# 9. A valid marker cannot hide an incomplete or malformed toolchain cache.
create_cached_toolchain
rm -f -- "$cache_output/host/bin/mipsel-buildroot-linux-gnu-gcc.br_real"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (toolchain output incomplete)' ]
[ ! -e "$cache_output" ]
create_toolchain_fixture
printf '%s' 'not-a-fingerprint' > \
	"$cache_output/$buildroot_toolchain_marker"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (fingerprint marker missing or invalid)' ]
[ ! -e "$cache_output" ]

# 10. A valid Development marker can never make Release incremental.
create_cached_toolchain
artifact_mode=release
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot release build: CLEAN' ]
[ ! -e "$cache_output" ]

# Legacy Development outputs can be adopted only with a complete, matching
# Buildroot/toolchain contract. No Buildroot make target is invoked here.

# 11-12. A compatible markerless output is adopted and receives the fingerprint.
artifact_mode=development
create_toolchain_fixture
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: ADOPTED (legacy output without fingerprint)' ]
[ -f "$cache_output/$buildroot_toolchain_marker" ]
[ "$(read_buildroot_toolchain_fingerprint "$cache_output")" = \
	"$(buildroot_toolchain_fingerprint)" ]

# 13. A markerless output without its compiler is cleaned.
rm -rf -- "$cache_output"
create_toolchain_fixture
rm -f -- "$cache_output/host/bin/mipsel-buildroot-linux-gnu-gcc.br_real"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (legacy output not safely adoptable)' ]
[ ! -e "$cache_output" ]

# 14. An incompatible effective configuration is cleaned.
create_toolchain_fixture
sed -i '/^BR2_mipsel=y$/d' "$cache_output/.config"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (legacy output not safely adoptable)' ]
[ ! -e "$cache_output" ]

# 15. A wrong ABI/toolchain configuration is cleaned.
create_toolchain_fixture
sed -i 's/^BR2_GCC_TARGET_ABI="32"$/BR2_GCC_TARGET_ABI="64"/' \
	"$cache_output/.config"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (legacy output not safely adoptable)' ]
[ ! -e "$cache_output" ]

# The compiler's reported target contract must also agree with .config.
create_toolchain_fixture
sed -i 's/mips32r2/mips64/' \
	"$cache_output/host/bin/mipsel-buildroot-linux-gnu-gcc.br_real"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: MISS (legacy output not safely adoptable)' ]
[ ! -e "$cache_output" ]

# 16. Release never adopts a compatible markerless output.
create_toolchain_fixture
artifact_mode=release
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = 'Buildroot release build: CLEAN' ]
[ ! -e "$cache_output" ]

# 17. Normal RootFS changes do not prevent toolchain adoption.
create_toolchain_fixture
artifact_mode=development
printf '%s\n' 'another RootFS-only change' >> \
	"$cache_project/configs/x2000/rootfs-overlay/etc/fixture"
cache_log=$(prepare_buildroot_output "$cache_output")
[ "$cache_log" = \
	'Buildroot development cache: ADOPTED (legacy output without fingerprint)' ]
[ -f "$cache_output/$buildroot_toolchain_marker" ]

