create_toolchain_fixture() {
	prefix="$cache_output/host/bin/mipsel-buildroot-linux-gnu-"
	sysroot="$cache_output/host/mipsel-buildroot-linux-gnu/sysroot"
	mkdir -p "${prefix%/*}" "$sysroot/lib" "$sysroot/usr/include" \
		"$sysroot/usr/lib" \
		"$cache_output/build/toolchain" \
		"$cache_output/build/toolchain-buildroot" \
		"$cache_output/build/host-gcc-final-13.4.0" \
		"$cache_output/build/host-binutils-2.43.1" \
		"$cache_output/build/glibc-2.41-143-gfc7a48bc9e999c0f9a1f9fa1b209eac1d6a93363" \
		"$cache_output/build/linux-headers-6.6.152"
	printf '%s\n' '#!/bin/sh' 'exit 0' '-ffp-contract=off' > \
		"$cache_output/host/bin/toolchain-wrapper"
	chmod +x "$cache_output/host/bin/toolchain-wrapper"
	ln -s toolchain-wrapper "${prefix}gcc"
	ln -s toolchain-wrapper "${prefix}g++"
	cat > "${prefix}gcc.br_real" <<'EOF'
#!/bin/sh
case "$1" in
-dumpmachine) printf '%s\n' mipsel-buildroot-linux-gnu ;;
-dumpfullversion) printf '%s\n' 13.4.0 ;;
