#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
network="$root/configs/x2000/rootfs-overlay/etc/init.d/S40fre3nder-network"
hook="$root/configs/x2000/rootfs-overlay/usr/libexec/fre3nder/udhcpc"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM

state=$tmp/state
sys_class_net=$tmp/sys/class/net
bin=$tmp/bin
log=$tmp/log

mkdir -p "$bin" "$sys_class_net"

cat > "$bin/ifconfig" <<'EOF'
#!/bin/sh
printf 'ifconfig %s\n' "$*" >> "$X2000_TEST_LOG"
EOF
cat > "$bin/route" <<'EOF'
#!/bin/sh
printf 'route %s\n' "$*" >> "$X2000_TEST_LOG"
[ "${1:-}" = del ] && exit 1
exit 0
EOF
cat > "$bin/wpa_supplicant" <<'EOF'
#!/bin/sh
while [ "$#" -gt 0 ]; do
	case "$1" in
	-c) config=$2; shift 2 ;;
	-P) pid_file=$2; shift 2 ;;
	*) shift ;;
	esac
done
printf 'wpa config=%s\n' "$config" >> "$X2000_TEST_LOG"
(
	trap 'exit 0' TERM INT
	while :; do sleep 60; done
) &
printf '%s\n' "$!" > "$pid_file"
EOF
cat > "$bin/udhcpc" <<'EOF'
#!/bin/sh
while [ "$#" -gt 0 ]; do
	case "$1" in
	-i) interface=$2; shift 2 ;;
	-s) hook=$2; shift 2 ;;
	-p) pid_file=$2; shift 2 ;;
	*) shift ;;
	esac
done
printf '%s\n' "$$" > "$pid_file"
if [ "${X2000_TEST_DHCP:-}" = lease ]; then
	interface=$interface ip=192.0.2.2 subnet=255.255.255.0 \
		router=192.0.2.1 dns=192.0.2.1 "$hook" bound ||
		printf 'udhcpc hook failed\n' >> "$X2000_TEST_LOG"
fi
trap 'exit 0' TERM INT
while :; do sleep 60; done
EOF
chmod 0755 "$bin/ifconfig" "$bin/route" "$bin/wpa_supplicant" "$bin/udhcpc"

run_network() {
	# The stubs receive the log path; only the network script appends to it.
	# shellcheck disable=SC2094
	X2000_TEST_DHCP=${X2000_TEST_DHCP:-} \
	FRE3NDER_STATE="$state" \
	FRE3NDER_SYS_CLASS_NET="$sys_class_net" \
	FRE3NDER_IFCONFIG="$bin/ifconfig" \
	FRE3NDER_ROUTE="$bin/route" \
	FRE3NDER_WPA_SUPPLICANT="$bin/wpa_supplicant" \
	FRE3NDER_UDHCPC="$bin/udhcpc" \
	FRE3NDER_UDHCPC_HOOK="$hook" \
	FRE3NDER_CARRIER_TIMEOUT=0 \
	FRE3NDER_DHCP_LEASE_TIMEOUT=0 \
	X2000_TEST_LOG="$log" \
	"$network" "$1" >> "$log"
}

reset_fixture() {
	run_network stop || true
	rm -rf "$state" "$sys_class_net" "$log"
	mkdir -p "$sys_class_net/lo"
	printf '772\n' > "$sys_class_net/lo/type"
}

add_ethernet() {
	interface=$1
	carrier=$2
	mkdir -p "$sys_class_net/$interface"
	printf '1\n' > "$sys_class_net/$interface/type"
	printf '%s\n' "$carrier" > "$sys_class_net/$interface/carrier"
}

add_wlan() {
	interface=$1
	carrier=$2
	mkdir -p "$sys_class_net/$interface/wireless"
	printf '1\n' > "$sys_class_net/$interface/type"
	printf '%s\n' "$carrier" > "$sys_class_net/$interface/carrier"
}

add_wlan_config() {
	mkdir -p "$state/provisioning"
	printf 'network={}\n' > "$state/provisioning/wpa_supplicant.conf"
}

expect_file() {
	[ -r "$1" ] || {
		echo "missing expected file: $1" >&2
		exit 1
	}
}

expect_no_file() {
	[ ! -e "$1" ] || {
		echo "unexpected file: $1" >&2
		exit 1
	}
}

# F, N: S40 consumes the exact boot-local runtime path when Ethernet is absent.
reset_fixture
add_wlan wlan0 1
add_wlan_config
X2000_TEST_DHCP=lease run_network start
[ "$(cat "$state/network/interface")" = wlan0 ]
expect_file "$state/network/wpa_supplicant.pid"
grep -Fqx "wpa config=$state/provisioning/wpa_supplicant.conf" "$log"

# B: Ethernet without carrier is stopped and WLAN is selected.
reset_fixture
add_ethernet lan0 0
add_wlan wlan0 1
add_wlan_config
X2000_TEST_DHCP=lease run_network start
[ "$(cat "$state/network/interface")" = wlan0 ]
grep -Fq 'ifconfig lan0 down' "$log"

# M: Ethernet carrier and lease select Ethernet without starting WLAN.
reset_fixture
add_ethernet lan0 1
add_wlan wlan0 1
add_wlan_config
X2000_TEST_DHCP=lease run_network start
[ "$(cat "$state/network/interface")" = lan0 ]
[ "$(cat "$state/network/lease")" = lan0 ]
expect_no_file "$state/network/wpa_supplicant.pid"

# D: Ethernet carrier without a lease is cleaned up before WLAN fallback.
reset_fixture
add_ethernet lan0 1
add_wlan wlan0 1
add_wlan_config
X2000_TEST_DHCP=none run_network start
[ "$(cat "$state/network/interface")" = wlan0 ]
expect_file "$state/network/wpa_supplicant.pid"
grep -Fq 'ifconfig lan0 down' "$log"

# E: Ethernet still works when no WLAN configuration was provisioned.
reset_fixture
add_ethernet lan0 1
X2000_TEST_DHCP=lease run_network start
[ "$(cat "$state/network/interface")" = lan0 ]
expect_no_file "$state/network/wpa_supplicant.pid"

# E: no usable Ethernet and no WLAN configuration leaves no active interface.
reset_fixture
X2000_TEST_DHCP=none run_network start
expect_no_file "$state/network/interface"
expect_no_file "$state/network/wpa_supplicant.pid"
expect_no_file "$state/network/udhcpc.pid"

echo 'fre3nder-x2000 network fixture tests: PASS'
