#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
service=$root/configs/x2000/rootfs-overlay/etc/init.d/S59fre3nder-klipper-mcu
tmp=$(mktemp -d)
runtime=$tmp/runtime
host_tty=$tmp/klipper_host_mcu
binary=$tmp/klipper_mcu
spi_device=$tmp/spidev2.0
mockbin=$tmp/bin
permissions=$tmp/permissions
start_calls=$tmp/start-calls
pty_state=$tmp/pty-state
cmdline_marker=$tmp/final-cmdline
race_pid_file=$tmp/race-pid
mkdir -p "$mockbin"

cat > "$mockbin/chown" <<'EOF'
#!/bin/sh
printf 'chown %s %s\n' "$1" "$2" >> "$FIXTURE_PERMISSIONS"
EOF
cat > "$mockbin/chmod" <<'EOF'
#!/bin/sh
printf 'chmod %s %s\n' "$1" "$2" >> "$FIXTURE_PERMISSIONS"
EOF
cat > "$mockbin/tr" <<'EOF'
#!/bin/sh
if [ -n "${FIXTURE_CMDLINE_MARKER:-}" ] && [ ! -e "$FIXTURE_CMDLINE_MARKER" ]; then
	cat >/dev/null
	exit 0
fi
exec /usr/bin/tr "$@"
EOF
cat > "$mockbin/start-stop-daemon" <<'EOF'
#!/bin/sh
[ "$#" -eq 12 ] || exit 1
[ "$1" = -S ] && [ "$2" = -q ] && [ "$3" = -p ] || exit 1
[ "$5" = -c ] && [ "$6" = root:fre3nder ] || exit 1
[ "$7" = -x ] && [ "$9" = -- ] || exit 1
binary=$8
printf '%s\n' "$*" >> "$FIXTURE_START_CALLS"
shift 9
# Like BusyBox without -b: replace the launcher, preserving the tracked PID.
exec "$binary" "$@"
EOF
chmod 0755 "$mockbin"/*

cleanup() {
	if [ -r "$race_pid_file" ]; then
		kill "$(cat "$race_pid_file")" 2>/dev/null || true
	fi
	FRE3NDER_KLIPPER_MCU_RUNTIME=$runtime \
	FRE3NDER_KLIPPER_MCU=$binary \
	FRE3NDER_KLIPPER_HOST_MCU_TTY=$host_tty \
	FRE3NDER_ADXL_SPI_DEVICE=$spi_device \
		"$service" stop >/dev/null 2>&1 || true
	rm -rf -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

cat > "$binary" <<'EOF'
#!/usr/bin/env python3
import json
import os
import pathlib
import signal
import sys
import time

assert sys.argv[1:3] == ['-r', '-I'] and len(sys.argv) == 4
host_tty = pathlib.Path(sys.argv[3])
if os.environ.get('FIXTURE_FAIL_FAST') == '1':
    sys.exit(1)
delay = int(os.environ.get('FIXTURE_TTY_DELAY', '0'))
if delay:
    pathlib.Path(os.environ['FIXTURE_RACE_PID_FILE']).write_text(str(os.getpid()))
    time.sleep(delay)
    pathlib.Path(os.environ['FIXTURE_CMDLINE_MARKER']).touch()

generation = int(os.environ.get('FIXTURE_GENERATION', '0'))

def reset(signum, frame):
    os.environ['FIXTURE_GENERATION'] = str(generation + 1)
    # Model upstream command_config_reset(): exec closes the old PTY fds.
    os.execv(sys.argv[0], sys.argv)

signal.signal(signal.SIGUSR1, reset)
if os.environ.get('FIXTURE_NO_TTY') != '1':
    master, slave = os.openpty()
    tty = os.ttyname(slave)
    host_tty.unlink(missing_ok=True)
    host_tty.symlink_to(tty)
    os.chmod(tty, 0o660)  # upstream console_setup()
    state = pathlib.Path(os.environ['FIXTURE_PTY_STATE'])
    pending = state.with_suffix('.tmp')
    pending.write_text(json.dumps(dict(pid=os.getpid(), generation=generation,
                                      tty=tty)))
    pending.replace(state)
while True:
    signal.pause()
EOF
chmod 0755 "$binary"

run_service() {
	PATH=$mockbin:$PATH FIXTURE_PERMISSIONS=$permissions \
	FIXTURE_START_CALLS=$start_calls FIXTURE_PTY_STATE=$pty_state \
	FRE3NDER_KLIPPER_MCU_RUNTIME=$runtime \
	FRE3NDER_KLIPPER_MCU=$binary \
	FRE3NDER_KLIPPER_HOST_MCU_TTY=$host_tty \
	FRE3NDER_ADXL_SPI_DEVICE=$spi_device \
	FRE3NDER_KLIPPER_MCU_START_TIMEOUT=${FRE3NDER_KLIPPER_MCU_START_TIMEOUT:-2} \
	FIXTURE_FAIL_FAST=${FIXTURE_FAIL_FAST:-0} \
	FIXTURE_NO_TTY=${FIXTURE_NO_TTY:-0} \
	FIXTURE_TTY_DELAY=${FIXTURE_TTY_DELAY:-0} \
	FIXTURE_CMDLINE_MARKER=${FIXTURE_CMDLINE_MARKER:-} \
	FIXTURE_RACE_PID_FILE=$race_pid_file \
		"$service" "$1"
}

if run_service start; then
	echo 'klipper_mcu unexpectedly started without spidev2.0' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = spi-unavailable ]
ln -s /dev/null "$spi_device"

run_service start
[ "$(cat "$runtime/status")" = active ]
[ -L "$host_tty" ] && [ -c "$host_tty" ]
grep -Fxq "chown root:fre3nder $(readlink -f "$host_tty")" "$permissions"
grep -Fxq "chmod 0660 $(readlink -f "$host_tty")" "$permissions"
pid=$(cat "$runtime/klipper_mcu.pid")
kill -0 "$pid"

# Reconnecting (RESTART) and MCU self-exec (FIRMWARE_RESTART or a config CRC
# mismatch) must work repeatedly without another init-script permission pass.
python3 - "$host_tty" "$pty_state" "$pid" "$permissions" "$start_calls" <<'PY'
import json
import os
import pathlib
import signal
import stat
import sys
import time

host_tty, state, pid, permissions, start_calls = sys.argv[1:]
state = pathlib.Path(state)
pid = int(pid)
permission_calls = pathlib.Path(permissions).read_text()
launch_calls = pathlib.Path(start_calls).read_text()
initial_owner = os.stat(host_tty).st_uid, os.stat(host_tty).st_gid
for generation in range(4):
    current = json.loads(state.read_text())
    assert current['pid'] == pid and current['generation'] == generation
    info = os.stat(host_tty)
    assert stat.S_ISCHR(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o660
    # The privileged identity switch is checked by the launcher fixture.
    assert (info.st_uid, info.st_gid) == initial_owner
    # Repeated Klippy reconnects open the same endpoint without a reset.
    for _ in range(3):
        fd = os.open(host_tty, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        os.close(fd)
    if generation == 3:
        break
    # Hold the previous slave open so the new PTY cannot reuse its number.
    old_slave = os.open(host_tty, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        os.kill(pid, signal.SIGUSR1)
        deadline = time.monotonic() + 3
        while json.loads(state.read_text())['generation'] == generation:
            assert time.monotonic() < deadline, 'MCU self-exec did not finish'
            time.sleep(0.01)
        assert os.readlink(host_tty) != current['tty'], 'PTY was not replaced'
    finally:
        os.close(old_slave)
assert pathlib.Path(permissions).read_text() == permission_calls
assert pathlib.Path(start_calls).read_text() == launch_calls
PY

# Starting an already-active instance must keep the same verified process.
run_service start
[ "$(cat "$runtime/klipper_mcu.pid")" = "$pid" ]

run_service restart
new_pid=$(cat "$runtime/klipper_mcu.pid")
[ "$new_pid" != "$pid" ]
kill -0 "$new_pid"

run_service stop
[ "$(cat "$runtime/status")" = stopped ]
[ ! -e "$runtime/klipper_mcu.pid" ]
[ ! -e "$host_tty" ]

# A stale PID file must never make stop kill an unrelated process.
mkdir -p "$runtime"
sleep 60 &
foreign_pid=$!
printf '%s\n' "$foreign_pid" > "$runtime/klipper_mcu.pid"
run_service stop
kill -0 "$foreign_pid"
kill "$foreign_pid"
wait "$foreign_pid" 2>/dev/null || true

# A stale live PID is ignored on start and replaced with a real host MCU PID.
sleep 60 &
foreign_pid=$!
printf '%s\n' "$foreign_pid" > "$runtime/klipper_mcu.pid"
run_service start
new_pid=$(cat "$runtime/klipper_mcu.pid")
[ "$new_pid" != "$foreign_pid" ]
kill -0 "$foreign_pid"
run_service stop
kill "$foreign_pid"
wait "$foreign_pid" 2>/dev/null || true

# The child exists before its final command line becomes visible. It creates
# the PTY only after the fixture exposes that command line.
rm -rf -- "$runtime"
rm -f "$cmdline_marker" "$race_pid_file" "$permissions"
FIXTURE_TTY_DELAY=2 FIXTURE_CMDLINE_MARKER=$cmdline_marker \
	FRE3NDER_KLIPPER_MCU_START_TIMEOUT=4 run_service start &
race_service_pid=$!
i=0
while [ ! -r "$race_pid_file" ] && [ "$i" -lt 50 ]; do
	sleep 0.01
	i=$((i + 1))
done
[ -r "$race_pid_file" ]
race_pid=$(cat "$race_pid_file")
kill -0 "$race_pid"
[ ! -e "$cmdline_marker" ]
[ ! -e "$host_tty" ]
wait "$race_service_pid"
[ "$(cat "$runtime/status")" = active ]
[ "$(cat "$runtime/klipper_mcu.pid")" = "$race_pid" ]
grep -Fxq "chown root:fre3nder $(readlink -f "$host_tty")" "$permissions"
grep -Fxq "chmod 0660 $(readlink -f "$host_tty")" "$permissions"
run_service stop
rm -f "$race_pid_file"

if FRE3NDER_KLIPPER_MCU_RUNTIME=$runtime \
	FRE3NDER_KLIPPER_MCU=$tmp/missing \
	FRE3NDER_KLIPPER_HOST_MCU_TTY=$host_tty \
	FRE3NDER_ADXL_SPI_DEVICE=$spi_device \
	"$service" start; then
	echo 'missing klipper_mcu binary unexpectedly started' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = runtime-invalid ]

rm -rf -- "$runtime"
if FIXTURE_FAIL_FAST=1 run_service start; then
	echo 'fail-fast klipper_mcu unexpectedly started' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = startup-failed ]
[ ! -e "$runtime/klipper_mcu.pid" ]

rm -rf -- "$runtime"
if FIXTURE_NO_TTY=1 FRE3NDER_KLIPPER_MCU_START_TIMEOUT=1 run_service start; then
	echo 'klipper_mcu without host PTY unexpectedly started' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = startup-timeout ]
[ ! -e "$runtime/klipper_mcu.pid" ]
[ ! -e "$host_tty" ]

echo 'fre3nder-x2000 Klipper MCU service fixtures: PASS'
