#!/usr/bin/env bash
set -Eeuo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
deploy=$repo/scripts/deploy-x2000

tmp=$(mktemp -d)
artifact_dir=$tmp/artifacts
stock_source=$tmp/stock
bin=$tmp/bin
active=$tmp/active
selector=$tmp/selector
log=$tmp/log
marker=$tmp/reset-marker
hash_count=$tmp/hash-count
slots=$tmp/slots

cleanup() {
	local result=$?
	trap - EXIT HUP INT TERM
	rm -rf -- "$tmp"
	exit "$result"
}

trap cleanup EXIT HUP INT TERM

mkdir -p "$artifact_dir" "$bin" "$slots"


# ----------------------------------------------------------------------
# Stock checksum fixture
# ----------------------------------------------------------------------

cat > "$bin/sha256sum" <<'EOF'
#!/bin/sh
set -eu

file=${1:-}

case "${file##*/}" in
p5.img|kernel.readback)
	hash=1111111111111111111111111111111111111111111111111111111111111111
	;;
p7.img|rootfs.readback)
	hash=2222222222222222222222222222222222222222222222222222222222222222
	;;
*)
	exit 1
	;;
esac

printf '%s  %s\n' "$hash" "$file"
EOF

chmod 0755 "$bin/sha256sum"


# ----------------------------------------------------------------------
# Development artifacts matching the current dirty build inputs
# ----------------------------------------------------------------------

printf 'kernel-candidate\n' > "$artifact_dir/kernel.uImage"
printf 'rootfs-candidate\n' > "$artifact_dir/rootfs.squashfs"

kernel_sha=$(
	sha256sum "$artifact_dir/kernel.uImage" |
		awk '{print $1}'
)

rootfs_sha=$(
	sha256sum "$artifact_dir/rootfs.squashfs" |
		awk '{print $1}'
)

printf '%s  kernel.uImage\n' "$kernel_sha" \
	> "$artifact_dir/SHA256SUMS"

printf '%s  rootfs.squashfs\n' "$rootfs_sha" \
	>> "$artifact_dir/SHA256SUMS"

head_commit=$(git -C "$repo" rev-parse HEAD)
fingerprint=$(
	"$repo/scripts/x2000-build-input-sha256" --root "$repo"
)

python3 - \
	"$artifact_dir/build-manifest.json" \
	"$head_commit" \
	"$fingerprint" \
	"$kernel_sha" \
	"$rootfs_sha" <<'PY'
import json
import pathlib
import sys

path, commit, fingerprint, kernel_sha, rootfs_sha = sys.argv[1:]

manifest = {
    "artifact_mode": "development",
    "project_commit": commit,
    "project_worktree_status": "dirty",
    "build_input_sha256": fingerprint,
    "artifacts": {
        "kernel.uImage": kernel_sha,
        "rootfs.squashfs": rootfs_sha,
    },
}

pathlib.Path(path).write_text(
    json.dumps(manifest, indent=2) + "\n",
    encoding="utf-8",
)
PY


# ----------------------------------------------------------------------
# Mock x2000-ab
# ----------------------------------------------------------------------

cat > "$bin/ab" <<'EOF'
#!/bin/sh
set -eu

host=$1
action=$2

[ "$host" = printer ] || exit 1

root_for_slot() {
	case "$1" in
	A) printf '%s\n' /dev/mmcblk0p7 ;;
	B) printf '%s\n' /dev/mmcblk0p8 ;;
	*) exit 1 ;;
	esac
}

class_for_slot() {
	case "$1" in
	A) printf '%s\n' STOCK_A ;;
	B) printf '%s\n' DEVELOP_B ;;
	*) exit 1 ;;
	esac
}

case "$action" in
status)
	active_slot=$(cat "$X2000_TEST_ACTIVE")
	selector_slot=$(cat "$X2000_TEST_SELECTOR")

	printf '%s\n' \
		"ACTIVE_ROOT=$(root_for_slot "$active_slot")" \
		'P1_DEVICE=/dev/mmcblk0p1' \
		'P1_LABEL_DEVICE=UNRESOLVED' \
		'P1_PARTLABEL=ABSENT_INFRASTRUCTURE' \
		'P1_PARTITION_NUMBER=1' \
		'P1_START=2048' \
		'P1_SECTORS=2048' \
		'P1_IDENTITY=VALID' \
		'P1_RECORD_BYTES=512' \
		'P1_SHA256=fixture' \
		"CLASSIFICATION=$(class_for_slot "$selector_slot")"
	;;

select-a)
	printf '%s\n' select-a >> "$X2000_TEST_LOG"

	[ "$(cat "$X2000_TEST_SELECTOR")" = B ] ||
		exit 1

	[ "${X2000_TEST_SELECT_A_FAIL:-false}" != true ] ||
		exit 1

	printf A > "$X2000_TEST_SELECTOR"
	;;

select-b)
	printf '%s\n' select-b >> "$X2000_TEST_LOG"

	[ "$(cat "$X2000_TEST_SELECTOR")" = A ] ||
		exit 1

	[ "${X2000_TEST_SELECT_B_FAIL:-false}" != true ] ||
		exit 1

	printf B > "$X2000_TEST_SELECTOR"
	;;

*)
	exit 1
	;;
esac
EOF


# ----------------------------------------------------------------------
# Mock ssh
# ----------------------------------------------------------------------

cat > "$bin/ssh" <<'EOF'
#!/bin/sh
set -eu

while [ "$#" -gt 0 ]; do
	case "$1" in
	-o)
		shift 2
		;;
	*)
		host=$1
		shift
		break
		;;
	esac
done

[ "$host" = printer ] || exit 1

command=${1:-}

root_for_slot() {
	case "$1" in
	A) printf '%s\n' /dev/mmcblk0p7 ;;
	B) printf '%s\n' /dev/mmcblk0p8 ;;
	*) exit 1 ;;
	esac
}

case "$command" in

'sh -eu')
	body=$(cat)

	if printf '%s\n' "$body" |
		grep -Fq '5:kernel:16384'; then

		active_slot=$(cat "$X2000_TEST_ACTIVE")

		printf '%s\n' \
			'P5_DEVICE=/dev/mmcblk0p5' \
			"P5_PARTLABEL=${X2000_TEST_P5_PARTLABEL:-VALID}" \
			'P5_PARTITION_NUMBER=5' \
			"P5_SECTORS=${X2000_TEST_P5_SECTORS:-16384}" \
			"P5_MOUNTED=${X2000_TEST_P5_MOUNTED:-NO}" \
			'P6_DEVICE=/dev/mmcblk0p6' \
			"P6_PARTLABEL=${X2000_TEST_P6_PARTLABEL:-VALID}" \
			'P6_PARTITION_NUMBER=6' \
			"P6_SECTORS=${X2000_TEST_P6_SECTORS:-16384}" \
			"P6_MOUNTED=${X2000_TEST_P6_MOUNTED:-NO}" \
			'P7_DEVICE=/dev/mmcblk0p7' \
			"P7_PARTLABEL=${X2000_TEST_P7_PARTLABEL:-VALID}" \
			'P7_PARTITION_NUMBER=7' \
			"P7_SECTORS=${X2000_TEST_P7_SECTORS:-1024000}" \
			"P7_MOUNTED=${X2000_TEST_P7_MOUNTED:-NO}" \
			'P8_DEVICE=/dev/mmcblk0p8' \
			"P8_PARTLABEL=${X2000_TEST_P8_PARTLABEL:-VALID}" \
			'P8_PARTITION_NUMBER=8' \
			"P8_SECTORS=${X2000_TEST_P8_SECTORS:-1024000}" \
			"P8_MOUNTED=${X2000_TEST_P8_MOUNTED:-NO}" \
			"ACTIVE_ROOT=$(root_for_slot "$active_slot")"

	elif printf '%s\n' "$body" |
		grep -Fq 'HOST_RUNTIME=PASS'; then

		printf '%s\n' "$body" |
			grep -Fq '.fre3nder-reset-target' ||
			exit 1

		[ "${X2000_TEST_RUNTIME_FAIL:-false}" != true ] ||
			exit 1

		[ ! -e "$X2000_TEST_MARKER" ] ||
			exit 1

		printf '%s\n' runtime-pass >> "$X2000_TEST_LOG"
		printf '%s\n' HOST_RUNTIME=PASS

	else
		exit 1
	fi
	;;

"TARGET_ROOT='/dev/mmcblk0p7' sh -eu"|\
"TARGET_ROOT='/dev/mmcblk0p8' sh -eu")
	body=$(cat)

	printf '%s\n' "$body" |
		grep -Fq '.fre3nder-reset-target' ||
		exit 1

	printf '%s\n' "$body" |
		grep -Fq 'legacy system reset marker is already pending' ||
		exit 1

	case "$command" in
	*"mmcblk0p7"*)
		target_root=/dev/mmcblk0p7
		target_number=7
		;;
	*"mmcblk0p8"*)
		target_root=/dev/mmcblk0p8
		target_number=8
		;;
	*)
		exit 1
		;;
	esac

	printf 'arm-reset-p%s\n' "$target_number" \
		>> "$X2000_TEST_LOG"

	[ "${X2000_TEST_RESET_FAIL:-false}" != true ] ||
		exit 1

	printf 'RESET_ON_NEXT_BOOT_ROOT=%s\n' "$target_root" \
		> "$X2000_TEST_MARKER"

	printf '%s\n' SYSTEM_PERSISTENCE_RESET_MARKER=PASS
	;;

'sync; reboot')
	printf '%s\n' reboot >> "$X2000_TEST_LOG"

	if [ "${X2000_TEST_BOOT_STUCK:-false}" != true ]; then
		cat "$X2000_TEST_SELECTOR" > "$X2000_TEST_ACTIVE"

		if [ "${X2000_TEST_CONSUME_MARKER:-true}" = true ]; then
			rm -f -- "$X2000_TEST_MARKER"
		fi
	fi
	;;

"sha256sum '/dev/mmcblk0p5' '/dev/mmcblk0p7'"|\
"sha256sum '/dev/mmcblk0p6' '/dev/mmcblk0p8'")
	active_slot=$(cat "$X2000_TEST_ACTIVE")

	count=$(cat "$X2000_TEST_HASH_COUNT")
	count=$((count + 1))
	printf '%s\n' "$count" > "$X2000_TEST_HASH_COUNT"

	kernel_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
	root_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

	if [ "$count" -gt 1 ] &&
		[ "${X2000_TEST_ACTIVE_HASH_CHANGED:-false}" = true ]; then
		root_hash=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
	fi

	case "$active_slot" in
	A)
		printf '%s  /dev/mmcblk0p5\n' "$kernel_hash"
		printf '%s  /dev/mmcblk0p7\n' "$root_hash"
		;;
	B)
		printf '%s  /dev/mmcblk0p6\n' "$kernel_hash"
		printf '%s  /dev/mmcblk0p8\n' "$root_hash"
		;;
	*)
		exit 1
		;;
	esac
	;;

"dd of=/dev/mmcblk0p5 bs=4096 2>/dev/null && sync"|\
"dd of=/dev/mmcblk0p6 bs=4096 2>/dev/null && sync"|\
"dd of=/dev/mmcblk0p7 bs=4096 2>/dev/null && sync"|\
"dd of=/dev/mmcblk0p8 bs=4096 2>/dev/null && sync")
	number=$(
		printf '%s\n' "$command" |
			sed -n 's#^dd of=/dev/mmcblk0p\([5-8]\) .*#\1#p'
	)

	[ -n "$number" ] || exit 1

	printf 'write-p%s\n' "$number" >> "$X2000_TEST_LOG"

	fail=false

	case "$number" in
	5) fail=${X2000_TEST_WRITE_FAIL_P5:-false} ;;
	6) fail=${X2000_TEST_WRITE_FAIL_P6:-false} ;;
	7) fail=${X2000_TEST_WRITE_FAIL_P7:-false} ;;
	8) fail=${X2000_TEST_WRITE_FAIL_P8:-false} ;;
	esac

	[ "$fail" != true ] || exit 1

	if [ "${X2000_TEST_STOCK_FIXTURE:-false}" = true ]; then
		: > "$X2000_TEST_SLOTS/p$number"
	else
		cat > "$X2000_TEST_SLOTS/p$number"
	fi
	;;

dd\ if=/dev/mmcblk0p[5-8]\ bs=512\ count=*\ 2\>/dev/null)
	number=$(
		printf '%s\n' "$command" |
			sed -n 's#^dd if=/dev/mmcblk0p\([5-8]\) .*#\1#p'
	)

	[ -n "$number" ] || exit 1

	printf 'readback-p%s\n' "$number" >> "$X2000_TEST_LOG"

	bad=false

	case "$number" in
	5) bad=${X2000_TEST_READBACK_BAD_P5:-false} ;;
	6) bad=${X2000_TEST_READBACK_BAD_P6:-false} ;;
	7) bad=${X2000_TEST_READBACK_BAD_P7:-false} ;;
	8) bad=${X2000_TEST_READBACK_BAD_P8:-false} ;;
	esac

	if [ "${X2000_TEST_STOCK_FIXTURE:-false}" = true ]; then
		:
	elif [ "$bad" = true ]; then
		printf corrupt
	else
		cat "$X2000_TEST_SLOTS/p$number"
	fi
	;;

*)
	exit 1
	;;
esac
EOF

chmod 0755 "$bin/ab" "$bin/ssh"


make_stock_artifacts() {
	rm -rf -- "$stock_source"
	mkdir -p "$stock_source"

	truncate -s 8388608 		"$stock_source/p5.img"

	truncate -s 524288000 		"$stock_source/p7.img"

	cat > "$stock_source/SHA256SUMS" <<'EOF'
1111111111111111111111111111111111111111111111111111111111111111  p5.img
2222222222222222222222222222222222222222222222222222222222222222  p7.img
EOF
}


reset_case() {
	local slot=$1

	printf '%s' "$slot" > "$active"
	printf '%s' "$slot" > "$selector"

	: > "$log"
	printf 0 > "$hash_count"

	rm -f -- "$marker"
	rm -rf -- "$slots"
	mkdir -p "$slots"

	unset \
		X2000_TEST_SELECT_A_FAIL \
		X2000_TEST_SELECT_B_FAIL \
		X2000_TEST_RESET_FAIL \
		X2000_TEST_BOOT_STUCK \
		X2000_TEST_CONSUME_MARKER \
		X2000_TEST_RUNTIME_FAIL \
		X2000_TEST_ACTIVE_HASH_CHANGED \
		X2000_TEST_READBACK_BAD_P5 \
		X2000_TEST_READBACK_BAD_P6 \
		X2000_TEST_READBACK_BAD_P7 \
		X2000_TEST_READBACK_BAD_P8 \
		X2000_TEST_WRITE_FAIL_P5 \
		X2000_TEST_WRITE_FAIL_P6 \
		X2000_TEST_WRITE_FAIL_P7 \
		X2000_TEST_WRITE_FAIL_P8 \
		X2000_TEST_P5_PARTLABEL \
		X2000_TEST_P6_PARTLABEL \
		X2000_TEST_P7_PARTLABEL \
		X2000_TEST_P8_PARTLABEL \
		X2000_TEST_P5_SECTORS \
		X2000_TEST_P6_SECTORS \
		X2000_TEST_P7_SECTORS \
		X2000_TEST_P8_SECTORS \
		X2000_TEST_P5_MOUNTED \
		X2000_TEST_P6_MOUNTED \
		X2000_TEST_P7_MOUNTED \
		X2000_TEST_P8_MOUNTED \
		X2000_TEST_BOOT_TIMEOUT
}

