		"$deploy" printer --develop "$@"
}

run_without_develop() {
	X2000_DEPLOY_ARTIFACT_DIR="$artifact_dir" 	X2000_DEPLOY_SSH="$bin/ssh" 	X2000_DEPLOY_AB="$bin/ab" 	X2000_TEST_ACTIVE="$active" 	X2000_TEST_SELECTOR="$selector" 	X2000_TEST_LOG="$log" 	X2000_TEST_MARKER="$marker" 	X2000_TEST_HASH_COUNT="$hash_count" 	X2000_TEST_SLOTS="$slots" 		"$deploy" printer "$@"
}


run_stock_deploy() {
	PATH="$bin:$PATH" \
	X2000_DEPLOY_SSH="$bin/ssh" \
	X2000_DEPLOY_AB="$bin/ab" \
	X2000_TEST_ACTIVE="$active" \
	X2000_TEST_SELECTOR="$selector" \
	X2000_TEST_LOG="$log" \
