	X2000_TEST_P7_SECTORS="${X2000_TEST_P7_SECTORS:-1024000}" \
	X2000_TEST_P8_SECTORS="${X2000_TEST_P8_SECTORS:-1024000}" \
	X2000_TEST_P5_MOUNTED="${X2000_TEST_P5_MOUNTED:-NO}" \
