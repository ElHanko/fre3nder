#!/usr/bin/env bash
set -Eeuo pipefail

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

tmp=$(mktemp -d)

cleanup() {
	local result=$?
	trap - EXIT HUP INT TERM
	rm -rf -- "$tmp"
	exit "$result"
}

trap cleanup EXIT HUP INT TERM

root=$tmp/project
mkdir -p "$root/scripts"
cp -a \
	"$source_root/VERSION" \
	"$source_root/build" \
	"$source_root/configs" \
	"$source_root/patches" \
	"$root/"
cp -a \
	"$source_root/scripts/build-x2000" \
	"$source_root/scripts/build-x2000-buildroot" \
	"$source_root/scripts/build-x2000-guppyscreen" \
	"$source_root/scripts/build-x2000-kernel" \
	"$source_root/scripts/build-x2000-moonraker" \
	"$source_root/scripts/deploy-x2000" \
	"$source_root/scripts/x2000-build-input-sha256" \
	"$root/scripts/"
git -C "$root" init -q
git -C "$root" config user.email tests@example.invalid
git -C "$root" config user.name 'Fre3nder tests'
git -C "$root" add .
git -C "$root" commit -qm fixture

deploy="$root/scripts/deploy-x2000"
artifact_dir=$tmp/artifacts
bin=$tmp/bin
state=$tmp/state
selector=$tmp/selector
log=$tmp/log
p6=$tmp/p6
p8=$tmp/p8
hash_count=$tmp/hash-count
operator_input=$tmp/operator-input

mkdir -p "$bin"


# ----------------------------------------------------------------------
# Mock x2000-ab
# ----------------------------------------------------------------------

cat > "$bin/ab" <<'EOF'
#!/bin/sh
set -eu

host=$1
action=$2
phase=$(cat "$X2000_TEST_STATE")

root_for_phase() {
	case "$1" in
	develop-initial)
		printf '%s\n' "${X2000_TEST_DEVELOP_ROOT:-/dev/mmcblk0p8}"
		;;
	develop-initial-after-a)
		printf '%s\n' "${X2000_TEST_INITIAL_AFTER_A_ROOT:-/dev/mmcblk0p8}"
		;;
	develop-after-b)
		printf '%s\n' "${X2000_TEST_POST_B_ROOT:-/dev/mmcblk0p8}"
		;;
	develop-final)
		printf '%s\n' "${X2000_TEST_FINAL_ROOT:-/dev/mmcblk0p8}"
		;;
	stock)
		printf '%s\n' "${X2000_TEST_STOCK_ROOT:-/dev/mmcblk0p7}"
		;;
	*)
		exit 1
		;;
	esac
}

selector_for_phase() {
	current=$(cat "$X2000_TEST_SELECTOR")

	case "$1" in
	develop-initial)
		printf '%s\n' "${X2000_TEST_DEVELOP_SELECTOR:-$current}"
		;;
	develop-initial-after-a)
		printf '%s\n' "${X2000_TEST_INITIAL_AFTER_A_SELECTOR:-$current}"
		;;
	develop-after-b)
		printf '%s\n' "${X2000_TEST_POST_B_SELECTOR:-$current}"
		;;
	develop-final)
		printf '%s\n' "${X2000_TEST_FINAL_SELECTOR:-$current}"
		;;
	stock)
		printf '%s\n' "${X2000_TEST_STOCK_SELECTOR:-$current}"
		;;
	*)
		exit 1
		;;
	esac
}

case "$action" in
status)
	case "$host:$phase" in
	develop:develop-initial|\
develop:develop-initial-after-a|\
develop:develop-after-b|\
develop:develop-final)
		[ "${X2000_TEST_DEVELOP_AVAILABLE:-true}" = true ] ||
			exit 1
		;;
	stock:stock)
		[ "${X2000_TEST_STOCK_AVAILABLE:-true}" = true ] ||
			exit 1
		;;
	*)
		exit 1
		;;
	esac

	active_root=$(root_for_phase "$phase")
	classification=$(selector_for_phase "$phase")

	printf '%s\n' \
		"ACTIVE_ROOT=$active_root" \
		'P1_DEVICE=/dev/mmcblk0p1' \
		'P1_PARTITION_NUMBER=1' \
		'P1_START=2048' \
		'P1_SECTORS=2048' \
		'P1_IDENTITY=VALID' \
		"CLASSIFICATION=$classification"
	;;

select-a)
	[ "$host" = develop ] ||
		exit 1

	case "$phase" in
	develop-initial|develop-after-b)
		;;
	*)
		exit 1
		;;
	esac

	[ "$(cat "$X2000_TEST_SELECTOR")" = DEVELOP_B ] ||
		exit 1

	printf '%s\n' select-a >> "$X2000_TEST_LOG"

	if [ "$phase" = develop-initial ]; then
		[ "${X2000_TEST_INITIAL_SELECT_A_FAIL:-false}" != true ] ||
			exit 1

		printf STOCK_A > "$X2000_TEST_SELECTOR"
		printf develop-initial-after-a > "$X2000_TEST_STATE"
	else
		[ "${X2000_TEST_FINAL_SELECT_A_FAIL:-false}" != true ] ||
			exit 1

		printf STOCK_A > "$X2000_TEST_SELECTOR"
		printf develop-final > "$X2000_TEST_STATE"
	fi
	;;

select-b)
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	[ "$(cat "$X2000_TEST_SELECTOR")" = STOCK_A ] ||
		exit 1

	printf '%s\n' select-b >> "$X2000_TEST_LOG"

	[ "${X2000_TEST_SELECT_B_FAIL:-false}" != true ] ||
		exit 1

	printf DEVELOP_B > "$X2000_TEST_SELECTOR"
	;;

*)
	exit 1
	;;
esac
EOF


# ----------------------------------------------------------------------
# Mock ssh
# ----------------------------------------------------------------------

cat > "$bin/ssh" <<'EOF'
#!/bin/sh
set -eu

while [ "$#" -gt 0 ]; do
	case "$1" in
	-o)
		shift 2
		;;
	*)
		host=$1
		shift
		break
		;;
	esac
done

command=${1:-}
phase=$(cat "$X2000_TEST_STATE")

case "$command" in

'sync; reboot')
	printf 'reboot-%s\n' "$host" >> "$X2000_TEST_LOG"

	case "$host:$phase" in
	develop:develop-initial|develop:develop-initial-after-a)
		[ "${X2000_TEST_REBOOT_DEVELOP:-true}" = true ] &&
			printf stock > "$X2000_TEST_STATE"
		;;

	stock:stock)
		[ "${X2000_TEST_REBOOT_STOCK:-true}" = true ] &&
			printf develop-after-b > "$X2000_TEST_STATE"
		;;

	*)
		exit 1
		;;
	esac
	;;

'sh -eu')
	body=$(cat)

	if printf '%s\n' "$body" |
		grep -Fq 'kernel2:16384'; then

		case "$phase" in
		stock)
			active_root=${X2000_TEST_STOCK_ROOT:-/dev/mmcblk0p7}
			p6_mounted=${X2000_TEST_STOCK_P6_MOUNTED:-NO}
			p8_mounted=${X2000_TEST_STOCK_P8_MOUNTED:-NO}
			p6_label=${X2000_TEST_STOCK_P6_PARTLABEL:-VALID}
			p8_label=${X2000_TEST_STOCK_P8_PARTLABEL:-VALID}
			;;

		develop-initial|develop-initial-after-a|develop-after-b|develop-final)
			active_root=${X2000_TEST_DEVELOP_METADATA_ROOT:-/dev/mmcblk0p8}
			p6_mounted=${X2000_TEST_DEVELOP_P6_MOUNTED:-NO}
			p8_mounted=${X2000_TEST_DEVELOP_P8_MOUNTED:-YES}
			p6_label=${X2000_TEST_DEVELOP_P6_PARTLABEL:-VALID}
			p8_label=${X2000_TEST_DEVELOP_P8_PARTLABEL:-VALID}
			;;

		*)
			exit 1
			;;
		esac

		[ "$p6_label" != WRONG ] || exit 1
		[ "$p8_label" != WRONG ] || exit 1

		printf '%s\n' \
			"P6_DEVICE=/dev/mmcblk0p6" \
			"P6_PARTLABEL=$p6_label" \
			"P6_PARTITION_NUMBER=6" \
			"P6_SECTORS=${X2000_TEST_P6_SECTORS:-16384}" \
			"P6_MOUNTED=$p6_mounted" \
			"P8_DEVICE=/dev/mmcblk0p8" \
			"P8_PARTLABEL=$p8_label" \
			"P8_PARTITION_NUMBER=8" \
			"P8_SECTORS=${X2000_TEST_P8_SECTORS:-1024000}" \
			"P8_MOUNTED=$p8_mounted" \
			"ACTIVE_ROOT=$active_root"

	elif printf '%s\n' "$body" |
		grep -Fq 'RESET_ON_NEXT_BOOT'; then

		[ "$host:$phase" = stock:stock ] ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'LABEL="FRE3NDERSYS"' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mounted FRE3NDERSYS is not ext4' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mounted FRE3NDERSYS is not writable' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq '.fre3nder-reset' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'multiple FRE3NDERSYS filesystems found' ||
			exit 1

		printf '%s\n' arm-system-reset >> "$X2000_TEST_LOG"

		[ "${X2000_TEST_SYSTEM_RESET_FAIL:-false}" != true ] ||
			exit 1

		printf '%s\n' 'SYSTEM_PERSISTENCE_RESET_MARKER=PASS'

	elif printf '%s\n' "$body" |
		grep -Fq 'HOST_RUNTIME=PASS'; then

		case "$host:$phase" in
		develop:develop-after-b|develop:develop-final)
			;;
		*)
			exit 1
			;;
		esac

		printf '%s\n' "$body" |
			grep -Fq '/run/fre3nder-root/status' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mount_contract / overlay rw' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mount_contract /rom squashfs ro' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mount_contract /home ext4 rw' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'mount_contract /run/fre3nder-root/system ext4 rw' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'LABEL="FRE3NDERSYS"' ||
			exit 1

		printf '%s\n' "$body" |
			grep -Fq 'LABEL="FRE3NDERHOME"' ||
			exit 1

		[ "${X2000_TEST_RUNTIME_FAIL:-false}" != true ] ||
			exit 1

		printf '%s\n' 'HOST_RUNTIME=PASS'

	else
		exit 1
	fi
	;;

'sha256sum /dev/mmcblk0p5 /dev/mmcblk0p7')
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	count=$(cat "$X2000_TEST_HASH_COUNT")
	count=$((count + 1))
	printf '%s\n' "$count" > "$X2000_TEST_HASH_COUNT"

	p5=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
	p7=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

	if [ "$count" -gt 1 ] &&
		[ "${X2000_TEST_P5_CHANGED:-false}" = true ]; then
		p5=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
	fi

	if [ "$count" -gt 1 ] &&
		[ "${X2000_TEST_P7_CHANGED:-false}" = true ]; then
		p7=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
	fi

	printf '%s  /dev/mmcblk0p5\n' "$p5"
	printf '%s  /dev/mmcblk0p7\n' "$p7"
	;;

'dd of=/dev/mmcblk0p6 bs=4096 2>/dev/null && sync')
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	printf '%s\n' write-p6 >> "$X2000_TEST_LOG"

	[ "${X2000_TEST_WRITE_P6_FAIL:-false}" != true ] ||
		exit 1

	cat > "$X2000_TEST_P6"
	;;

'dd of=/dev/mmcblk0p8 bs=4096 2>/dev/null && sync')
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	printf '%s\n' write-p8 >> "$X2000_TEST_LOG"

	[ "${X2000_TEST_WRITE_P8_FAIL:-false}" != true ] ||
		exit 1

	cat > "$X2000_TEST_P8"
	;;

dd\ if=/dev/mmcblk0p6\ bs=512\ count=*)
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	printf '%s\n' readback-p6 >> "$X2000_TEST_LOG"

	if [ "${X2000_TEST_READBACK_P6_BAD:-false}" = true ]; then
		printf corrupt
	else
		cat "$X2000_TEST_P6"
	fi
	;;

dd\ if=/dev/mmcblk0p8\ bs=512\ count=*)
	[ "$host:$phase" = stock:stock ] ||
		exit 1

	printf '%s\n' readback-p8 >> "$X2000_TEST_LOG"

	if [ "${X2000_TEST_READBACK_P8_BAD:-false}" = true ]; then
		printf corrupt
	else
		cat "$X2000_TEST_P8"
	fi
	;;

*)
	exit 1
	;;
esac
EOF

chmod 0755 "$bin/ab" "$bin/ssh"


# ----------------------------------------------------------------------
# Test helpers
# ----------------------------------------------------------------------

reset_case() {
	rm -rf -- \
		"$artifact_dir" \
		"$state" \
		"$selector" \
		"$log" \
		"$p6" \
		"$p8" \
		"$hash_count" \
		"$operator_input"

	mkdir -p "$artifact_dir"

	printf 'kernel-candidate\n' > "$artifact_dir/kernel.uImage"
	printf 'rootfs-candidate\n' > "$artifact_dir/rootfs.squashfs"

	kernel_sha=$(
		sha256sum "$artifact_dir/kernel.uImage" |
			awk '{print $1}'
	)

	rootfs_sha=$(
		sha256sum "$artifact_dir/rootfs.squashfs" |
			awk '{print $1}'
	)

	printf '%s  kernel.uImage\n' "$kernel_sha" \
		> "$artifact_dir/SHA256SUMS"

	printf '%s  rootfs.squashfs\n' "$rootfs_sha" \
		>> "$artifact_dir/SHA256SUMS"

	head_commit=$(git -C "$root" rev-parse HEAD)

	python3 - \
		"$artifact_dir/build-manifest.json" \
		"$head_commit" \
		"$kernel_sha" \
		"$rootfs_sha" <<'PY'
import json
import pathlib
import sys

path, commit, kernel_sha, rootfs_sha = sys.argv[1:]

manifest = {
    "artifact_mode": "release",
    "project_commit": commit,
    "project_worktree_status": "clean",
    "artifacts": {
        "kernel.uImage": kernel_sha,
        "rootfs.squashfs": rootfs_sha,
    },
}

pathlib.Path(path).write_text(
    json.dumps(manifest, indent=2) + "\n",
    encoding="utf-8",
)
PY

	printf develop-initial > "$state"
	printf STOCK_A > "$selector"
	printf 0 > "$hash_count"
	: > "$log"

	unset \
		X2000_TEST_DEVELOP_AVAILABLE \
		X2000_TEST_STOCK_AVAILABLE \
		X2000_TEST_DEVELOP_ROOT \
		X2000_TEST_INITIAL_AFTER_A_ROOT \
		X2000_TEST_POST_B_ROOT \
		X2000_TEST_FINAL_ROOT \
		X2000_TEST_STOCK_ROOT \
		X2000_TEST_DEVELOP_SELECTOR \
		X2000_TEST_INITIAL_AFTER_A_SELECTOR \
		X2000_TEST_POST_B_SELECTOR \
		X2000_TEST_FINAL_SELECTOR \
		X2000_TEST_STOCK_SELECTOR \
		X2000_TEST_DEVELOP_METADATA_ROOT \
		X2000_TEST_DEVELOP_P6_MOUNTED \
		X2000_TEST_DEVELOP_P8_MOUNTED \
		X2000_TEST_STOCK_P6_MOUNTED \
		X2000_TEST_STOCK_P8_MOUNTED \
		X2000_TEST_DEVELOP_P6_PARTLABEL \
		X2000_TEST_DEVELOP_P8_PARTLABEL \
		X2000_TEST_STOCK_P6_PARTLABEL \
		X2000_TEST_STOCK_P8_PARTLABEL \
		X2000_TEST_P6_SECTORS \
		X2000_TEST_P8_SECTORS \
		X2000_TEST_REBOOT_DEVELOP \
		X2000_TEST_REBOOT_STOCK \
		X2000_TEST_INITIAL_SELECT_A_FAIL \
		X2000_TEST_FINAL_SELECT_A_FAIL \
		X2000_TEST_SELECT_B_FAIL \
		X2000_TEST_WRITE_P6_FAIL \
		X2000_TEST_WRITE_P8_FAIL \
		X2000_TEST_READBACK_P6_BAD \
		X2000_TEST_READBACK_P8_BAD \
		X2000_TEST_P5_CHANGED \
		X2000_TEST_P7_CHANGED \
		X2000_TEST_SYSTEM_RESET_FAIL \
		X2000_TEST_RUNTIME_FAIL
}

make_development_manifest() {
	local fingerprint
	local worktree_status

	fingerprint=$("$root/scripts/x2000-build-input-sha256" --root "$root")
	if [ -n "$(git -C "$root" status --porcelain=v1)" ]; then
		worktree_status=dirty
	else
		worktree_status=clean
	fi

	python3 - \
		"$artifact_dir/build-manifest.json" \
		"$fingerprint" \
		"$worktree_status" <<'PY'
import json
import pathlib
import sys

path, fingerprint, worktree_status = sys.argv[1:]
manifest_path = pathlib.Path(path)
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
manifest["artifact_mode"] = "development"
manifest["project_worktree_status"] = worktree_status
manifest["build_input_sha256"] = fingerprint
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY
}

reset_stock_case() {
	reset_case
	printf stock > "$state"
}

run_deploy_with_input() {
	local input=$1
	shift

	X2000_DEPLOY_ARTIFACT_DIR="$artifact_dir" \
	X2000_DEPLOY_SSH="$bin/ssh" \
	X2000_DEPLOY_AB="$bin/ab" \
	X2000_TEST_STATE="$state" \
	X2000_TEST_SELECTOR="$selector" \
	X2000_TEST_LOG="$log" \
	X2000_TEST_P6="$p6" \
	X2000_TEST_P8="$p8" \
	X2000_TEST_HASH_COUNT="$hash_count" \
	"$deploy" develop stock "$@" < "$input"
}

run_deploy() {
	local arg
	local write=false

	for arg in "$@"; do
		if [ "$arg" = --write ]; then
			write=true
		fi
	done

	if [ "$write" = true ]; then
		printf '\n\n' > "$operator_input"
	else
		: > "$operator_input"
	fi

	run_deploy_with_input "$operator_input" "$@"
}

run_without_confirmation() {
	: > "$operator_input"
	run_deploy_with_input "$operator_input" "$@"
}

run_with_one_confirmation() {
	printf '\n' > "$operator_input"
	run_deploy_with_input "$operator_input" "$@"
}

must_fail() {
	if "$@" >/dev/null 2>&1; then
		echo "unexpected success: $*" >&2
		exit 1
	fi
}

assert_called() {
	grep -Fxq "$1" "$log"
}

assert_not_called() {
	! grep -Fxq "$1" "$log" 2>/dev/null
}

assert_before() {
	local first=$1
	local second=$2
	local first_line
	local second_line

	first_line=$(grep -n -Fx "$first" "$log" | head -n 1 | cut -d: -f1)
	second_line=$(grep -n -Fx "$second" "$log" | head -n 1 | cut -d: -f1)

	[ -n "$first_line" ]
	[ -n "$second_line" ]
	[ "$first_line" -lt "$second_line" ]
}

assert_plan() {
	local output=$1
	local kernel=$2
	local rootfs=$3
	local mode=$4

	grep -Fxq "KERNEL=$kernel" "$output"
	grep -Fxq "ROOTFS=$rootfs" "$output"
	grep -Fxq "MODE=$mode" "$output"
}


