	X2000_TEST_HASH_COUNT="$hash_count" \
	X2000_TEST_SLOTS="$slots" \
	X2000_TEST_STOCK_FIXTURE=true \
		"$deploy" printer --stock "$stock_source" "$@"
}


must_fail() {
	if "$@" >/dev/null 2>&1; then
		echo "unexpected success: $*" >&2
		return 1
	fi
}

assert_called() {
	grep -Fxq "$1" "$log"
}

assert_not_called() {
	! grep -Fxq "$1" "$log" 2>/dev/null
}

assert_before() {
	local first=$1
	local second=$2
	local first_line
	local second_line

	first_line=$(
		grep -n -Fx "$first" "$log" |
			head -n 1 |
			cut -d: -f1
	)

	second_line=$(
		grep -n -Fx "$second" "$log" |
			head -n 1 |
			cut -d: -f1
	)

	[ -n "$first_line" ]
	[ -n "$second_line" ]
	[ "$first_line" -lt "$second_line" ]
}


