    def test_candidate_staged_binary_and_rootfs_manifest(self):
        self.write_candidate()
        entrypoint = (ROOT / "build/x2000/entrypoint.sh").read_text()
        functions = "\n".join(re.search(
            rf"^{name}\(\) \{{\n.*?^\}}", entrypoint, re.M | re.S
        )[0] for name in ("validate_f005_firmware", "record_rootfs_components"))
        staged_root = self.directory / "buildroot/target"
        staged = staged_root / TARGET_PATH.lstrip("/")
        staged.parent.mkdir(parents=True)
        shutil.copyfile(self.firmware, staged)
        staged.chmod(0o644)  # Match the overlay's install -m 0644.
        share = staged_root / "usr/share/fre3nder"
        share.mkdir(parents=True)
        shutil.copyfile(ROOT / "configs/x2000/f005-mcu-release.json", share / "f005-mcu-release.json")
        runtime_path = share / "f005-runtime-target.json"
        check_start = entrypoint.index('\t[ -f "$target/usr/share/fre3nder/f005-mcu-release.json" ]')
        check_end = entrypoint.index('\tcmp -s "$version_file"', check_start)
        target_checks = entrypoint[check_start:check_end]
        output = self.directory / "rootfs-output"
        output.mkdir()
        (output / "build-manifest.json").write_text('{"artifact_mode":"development"}')
        component = self.directory / "moonraker"
        component.mkdir()
        (component / "component-manifest.json").write_text(json.dumps({
            "component": "moonraker", "source": {}, "build_input_sha256": "fixture",
            "artifact": {"sha256": "fixture"},
        }))
        command = functions + '\nvalidate_f005_firmware "$f005_firmware" --runtime-target > '
        command += '"$target/usr/share/fre3nder/f005-runtime-target.json"\n'
        command += target_checks + '\nrecord_rootfs_components "$output"\n'
        env = dict(os.environ, project=str(ROOT), f005_firmware=str(self.firmware),
                   f005_target_path=TARGET_PATH, f005_firmware_mode="candidate",
                   artifact_mode="development", brout=str(staged_root.parent),
                   target=str(staged_root), output=str(output), moonraker_component=str(component))
        result = subprocess.run(["sh", "-eu"], input=command, text=True, env=env,
                                capture_output=True)
        self.assertEqual(result.returncode, 0, result.stderr)
        manifest = json.loads((output / "build-manifest.json").read_text())
        self.assertEqual(manifest["f005_firmware"], self.candidate_identity())
        target = json.loads(runtime_path.read_text())
        self.assertEqual(target, runtime_target(ROOT, self.firmware, "candidate", "development"))
        target["fre3nder_release"]["version"] = "wrong-runtime"
        runtime_path.write_text(json.dumps(target))
        result = subprocess.run(["sh", "-eu"], input=functions + "\n" + target_checks,
                                text=True, env=env, capture_output=True)
        self.assertNotEqual(result.returncode, 0)
        staged.write_bytes(b"Fixture firmware")
        result = subprocess.run(["sh", "-eu"], input=command, text=True, env=env,
                                capture_output=True)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("SHA256", result.stderr)

    def test_host_candidate_mount_and_mode(self):
        self.write_candidate()
        wrapper = (ROOT / "scripts/build-x2000-buildroot").read_text()
        command = wrapper[wrapper.index('python3 "$root/build/x2000/f005_firmware.py"'):]
        docker = self.directory / "docker-fixture"
        docker.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> "$docker_log"\n')
        docker.chmod(0o755)
        log = self.directory / "docker.log"
        env = dict(os.environ, root=str(ROOT), f005_firmware=str(self.firmware),
                   f005_firmware_mode="candidate", artifact_mode="development",
                   docker_cmd=str(docker), docker_log=str(log), runtime_user="fixture",
                   work_root=str(self.directory), image="fixture", ota_public_key="fixture",
                   factory_seed="fixture")
        result = subprocess.run(["sh", "-eu"], input=command, text=True, env=env,
                                capture_output=True)
        self.assertEqual(result.returncode, 0, result.stderr)
        calls = log.read_text()
        self.assertIn(f"{self.directory}:/f005-candidate:ro", calls)
        self.assertIn("FRE3NDER_F005_FIRMWARE=/f005-candidate/" + FIRMWARE_NAME, calls)
        self.assertIn("FRE3NDER_F005_FIRMWARE_MODE=candidate", calls)
        self.assertIn("--network none", calls)

    def test_orchestrator_modes_with_mocked_builders(self):
        project = self.directory / "orchestrator-project"
        scripts = project / "scripts"
        scripts.mkdir(parents=True)
        (project / "configs/x2000/rootfs-overlay").mkdir(parents=True)
        shutil.copyfile(ROOT / "scripts/build-x2000", scripts / "build-x2000")
        (scripts / "build-x2000").chmod(0o755)
        for name in ("build-f005", "build-x2000-moonraker", "build-x2000-buildroot"):
            path = scripts / name
            path.write_text('#!/bin/sh\nprintf "%s %s %s\\n" "$(basename "$0")" '
                            '"$*" "${FRE3NDER_F005_FIRMWARE_MODE:-unset}" >> "$fixture_log"\n'
                            'if [ "$(basename "$0")" = build-f005 ]; then '
                            'exit "${f005_result:-0}"; fi\n')
            path.chmod(0o755)
        log = self.directory / "builders.log"
        env = dict(os.environ, fixture_log=str(log), FRE3NDER_F005_FIRMWARE_MODE="candidate")
        for args, expected_mode in (([], "qualified"), (["--develop"], "qualified"),
                                    (["--develop", "--f005-build"], "candidate")):
            with self.subTest(args=args):
                log.write_text("")
                result = subprocess.run([str(scripts / "build-x2000"), "--rootfs-only", *args],
                                        env=env, capture_output=True, text=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                assembly = [line for line in log.read_text().splitlines() if "--assemble" in line]
                self.assertEqual(len(assembly), 1)
                self.assertTrue(assembly[0].endswith(" " + expected_mode))
        for args, extra_env in ((["--f005-build"], {}),
                                (["--develop", "--f005-build"], {"f005_result": "1"})):
            with self.subTest(rejected=args, env=extra_env):
                log.write_text("")
                result = subprocess.run([str(scripts / "build-x2000"), "--rootfs-only", *args],
                                        env=dict(env, **extra_env), capture_output=True, text=True)
                self.assertNotEqual(result.returncode, 0)
                self.assertNotIn("build-x2000-buildroot", log.read_text())

    def test_input_inventory_matches_unchanged_builder(self):
        builder = (ROOT / "scripts/build-f005").read_text()
        inventory = re.search(r"^input_paths = \[.*?^\]", builder, re.M | re.S)[0]
        self.assertEqual(tuple(ast.literal_eval(inventory.split("=", 1)[1].strip())),
                         CANDIDATE_INPUTS)


