    def test_invalid_candidate_metadata_rejected(self):
        mutations = (
            ("size", lambda m: m["artifacts"][FIRMWARE_NAME].update(size=999), "size"),
            ("upstream", lambda m: m["upstream"].update(commit="0" * 40), "upstream commit"),
            ("classification", lambda m: m.update(classification="release"), "classification"),
            ("schema", lambda m: m.update(schema=2), "schema"),
            ("boolean schema", lambda m: m.update(schema=True), "schema"),
            ("boolean", lambda m: m.update(qualified_release_match="false"), "boolean"),
            ("project", lambda m: m.update(project_commit="0" * 40), "project commit"),
            ("stale input", lambda m: m["inputs"].update(VERSION="0" * 64), "stale"),
            ("missing input", lambda m: m["inputs"].pop("VERSION"), "inventory"),
            ("missing artifact", lambda m: m["artifacts"].clear(), FIRMWARE_NAME),
        )
        for name, mutate, message in mutations:
            with self.subTest(case=name):
                candidate = copy.deepcopy(self.candidate)
                mutate(candidate)
                self.write_candidate(candidate)
                with self.assertRaisesRegex((ValueError, KeyError), message):
                    self.candidate_identity()

