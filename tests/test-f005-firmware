class FirmwareFixtures(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.directory = Path(self.tmp.name)
        self.firmware = self.directory / FIRMWARE_NAME
        self.firmware.write_bytes(b"fixture firmware")
        self.sidecar = self.directory / "build-manifest.json"
        self.qualified_root = self.directory / "qualified-project"
        config = self.qualified_root / "configs/x2000"
        config.mkdir(parents=True)
        self.release_path = config / "f005-mcu-release.json"
        self.release = json.loads((ROOT / "configs/x2000/f005-mcu-release.json").read_text())
        self.release["fre3nder_release"]["version"] = "qualified-fixture"
        self.release["fre3nder_release"]["firmware"].update(
            size=self.firmware.stat().st_size, sha256=sha256(self.firmware))
        self.release_path.write_text(json.dumps(self.release))
        sources = json.loads((ROOT / "configs/x2000/sources.json").read_text())
        self.candidate = {
            "schema": 1, "classification": "candidate", "qualified_release_match": False,
            "runtime_version": "fre3nder-f005-fixture-0-g1234567",
            "project_commit": subprocess.check_output(
                ["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True
            ).strip(),
            "upstream": {"commit": sources["userspace"]["klipper"]["commit"],
                         "prepared_source_commit": "1" * 40},
            "inputs": {relative: sha256(ROOT / relative) for relative in CANDIDATE_INPUTS},
            "artifacts": {FIRMWARE_NAME: {"size": self.firmware.stat().st_size,
                                         "sha256": sha256(self.firmware)}},
        }

    def write_candidate(self, candidate=None):
        self.sidecar.write_text(json.dumps(candidate or self.candidate))

    def candidate_identity(self, artifact_mode="development"):
        return validate(ROOT, self.firmware, "candidate", artifact_mode)

    def test_qualified_release_and_development(self):
        for mode in ("release", "development"):
            with self.subTest(mode=mode):
                identity = validate(self.qualified_root, self.firmware, "qualified", mode)
                self.assertEqual(identity, {
                    "classification": "qualified", "runtime_version": "qualified-fixture",
                    "size": self.firmware.stat().st_size, "sha256": sha256(self.firmware),
                })

    def test_candidate_development_and_provenance(self):
        for release_match in (False, True):
            with self.subTest(qualified_release_match=release_match):
                self.candidate["qualified_release_match"] = release_match
                self.write_candidate()
                self.assertEqual(self.candidate_identity(), {
                    "classification": "candidate", "runtime_version": self.candidate["runtime_version"],
                    "size": self.firmware.stat().st_size, "sha256": sha256(self.firmware),
                    "upstream_commit": self.candidate["upstream"]["commit"],
                    "prepared_source_commit": "1" * 40,
                })

    def test_candidate_release_rejected(self):
        self.write_candidate()
        with self.assertRaisesRegex(ValueError, "development RootFS"):
            self.candidate_identity("release")
        with self.assertRaisesRegex(ValueError, "development RootFS"):
            runtime_target(ROOT, self.firmware, "candidate", "release")

    def test_qualified_runtime_target_matches_release(self):
        for artifact_mode in ("release", "development"):
            with self.subTest(artifact_mode=artifact_mode):
                target = runtime_target(self.qualified_root, self.firmware, "qualified", artifact_mode)
                self.assertEqual(target.pop("firmware_target"), {
                    "classification": "qualified", "artifact_mode": artifact_mode,
                    "hardware_qualified": True,
                })
                self.assertEqual(target, self.release)

    def test_candidate_runtime_target_preserves_board_contract(self):
        self.write_candidate()
        target = runtime_target(ROOT, self.firmware, "candidate", "development")
        qualified = json.loads((ROOT / "configs/x2000/f005-mcu-release.json").read_text())
        self.assertEqual(target["firmware_target"], {
            "classification": "candidate", "artifact_mode": "development",
            "hardware_qualified": False,
        })
        self.assertEqual(target["fre3nder_release"]["version"], self.candidate["runtime_version"])
        self.assertEqual(target["fre3nder_release"]["name"], "f005-development-candidate")
        self.assertIn("qualification pending", target["fre3nder_release"]["evidence"])
        for key in ("schema", "uart", "stock_identity"):
            self.assertEqual(target[key], qualified[key])
        self.assertEqual(target["fre3nder_release"]["constants"],
                         qualified["fre3nder_release"]["constants"])
        expected_firmware = copy.deepcopy(qualified["fre3nder_release"]["firmware"])
        expected_firmware.update(size=self.firmware.stat().st_size, sha256=sha256(self.firmware))
        self.assertEqual(target["fre3nder_release"]["firmware"], expected_firmware)
        self.assertEqual(expected_firmware["bootloader_identity"], "mcu0_001_G32-mcu0_004_000")

    def test_candidate_runtime_preflight_and_identity(self):
        self.firmware.write_bytes(make_image())
        self.candidate["artifacts"][FIRMWARE_NAME].update(
            size=self.firmware.stat().st_size, sha256=sha256(self.firmware))
        self.write_candidate()
        target = runtime_target(ROOT, self.firmware, "candidate", "development")
        target["fre3nder_release"]["firmware"]["path"] = str(self.firmware)
        target_path = self.directory / "f005-runtime-target.json"
        target_path.write_text(json.dumps(target))
        loaded = f005_mcu.load_release_manifest(target_path)
        image, policy, _info = load_validated_image(loaded)
        self.assertEqual(image, self.firmware.read_bytes())
        from test_x2000_klipper import transition_module
        status = self.directory / "root-status"
        status.write_text("active\n")
        preflight_manifest, preflight_image, _policy = transition_module.preflight(target_path, status)
        self.assertEqual(preflight_manifest, loaded)
        self.assertEqual(preflight_image, image)
        self.assertEqual(policy.expected_version, "mcu0_004_000")
        self.assertEqual(policy.allowed_hardware_ids, ("mcu0_001_G32",))
        observed = {"version": self.candidate["runtime_version"],
                    "constants": loaded["fre3nder_release"]["constants"]}
        self.assertEqual(f005_mcu.classify_identity(observed, loaded), "fre3nder")
        qualified = json.loads((ROOT / "configs/x2000/f005-mcu-release.json").read_text())
        self.assertEqual(f005_mcu.classify_identity(observed, qualified), "unknown")
        self.firmware.write_bytes(self.firmware.read_bytes()[:-1])
        with self.assertRaises(FlasherError):
            load_validated_image(loaded)

    def test_runtime_helpers_default_to_effective_target(self):
        from unittest.mock import mock_open, patch
        from test_x2000_klipper import transition_module
        self.assertEqual(f005_mcu.RUNTIME_TARGET_MANIFEST,
                         "/usr/share/fre3nder/f005-runtime-target.json")
        with patch("builtins.open", mock_open(read_data=json.dumps(self.release))) as opened:
            f005_mcu.load_release_manifest()
        opened.assert_called_once_with(f005_mcu.RUNTIME_TARGET_MANIFEST, "r", encoding="utf-8")
        with patch.object(transition_module, "preflight", return_value=(self.release, b"", None)) as preflight:
            result = transition_module.transition(probe=lambda *a, **k: {
                "state": "stock", "reset_supported": True})
        self.assertEqual(result, "dry-run-ready")
        self.assertEqual(preflight.call_args.args[0], f005_mcu.RUNTIME_TARGET_MANIFEST)

    def test_deploy_guard_remains_qualified(self):
        script = (ROOT / "scripts/deploy-f005").read_text()
        guard = re.search(r'python3 - "\$manifest" "\$runtime_target" <<\x27PY\x27\n(.*?)^PY$',
                          script, re.M | re.S)[1]
        self.assertIn('manifest=${F005_DEPLOY_MANIFEST:-"$root/configs/x2000/f005-mcu-release.json"}', script)
        qualified_target = runtime_target(self.qualified_root, self.firmware, "qualified", "development")
        path = self.directory / "deployment-runtime-target.json"
        path.write_text(json.dumps(qualified_target))
        command = [sys.executable, "-", str(self.release_path), str(path)]
        result = subprocess.run(command, input=guard, text=True, capture_output=True)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.splitlines()[0], "RUNTIME_TARGET=QUALIFIED")
        self.write_candidate()
        candidate_target = runtime_target(ROOT, self.firmware, "candidate", "development")
        for target in (candidate_target,
                       dict(candidate_target, firmware_target=qualified_target["firmware_target"])):
            with self.subTest(metadata=target["firmware_target"]):
                path.write_text(json.dumps(target))
                result = subprocess.run(command, input=guard, text=True, capture_output=True)
                self.assertNotEqual(result.returncode, 0)
                self.assertIn("qualified Runtime target", result.stderr)

    def test_development_deploy_guard_requires_unqualified_candidate(self):
        self.write_candidate()
        target = runtime_target(ROOT, self.firmware, "candidate", "development")
        path = self.directory / "deployment-runtime-target.json"
        script = (ROOT / "scripts/deploy-f005").read_text()
        guard = re.search(r'python3 - "\$manifest" "\$runtime_target" <<\x27PY\x27\n(.*?)^PY$',
                          script, re.M | re.S)[1]
        command = [sys.executable, "-", str(self.release_path), str(path)]
        env = dict(os.environ, F005_DEPLOY_MODE="candidate")
        path.write_text(json.dumps(target))
        result = subprocess.run(command, input=guard, text=True, capture_output=True, env=env)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout.splitlines()[0], "RUNTIME_TARGET=CANDIDATE")
        for field, value in (("classification", "qualified"), ("artifact_mode", "release"),
                             ("hardware_qualified", True), ("hardware_qualified", "false")):
            invalid = copy.deepcopy(target)
            invalid["firmware_target"][field] = value
            path.write_text(json.dumps(invalid))
            result = subprocess.run(command, input=guard, text=True, capture_output=True, env=env)
            self.assertNotEqual(result.returncode, 0)
        target["schema"] = True
        path.write_text(json.dumps(target))
        result = subprocess.run(command, input=guard, text=True, capture_output=True, env=env)
        self.assertNotEqual(result.returncode, 0)

    def test_modified_binary_hash_rejected(self):
        self.write_candidate()
        self.firmware.write_bytes(b"Fixture firmware")  # Same length, different hash.
        with self.assertRaisesRegex(ValueError, "SHA256"):
