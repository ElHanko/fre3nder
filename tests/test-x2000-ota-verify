def test_backup_execution():
    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        private_key, public_key = generate_keys(temporary)

        package = temporary / "backup.ota"
        make_package(
            package,
            private_key,
            public_key,
        )

        home_source = temporary / "home"
        sys_source = temporary / "sys-upper"
        usb_root = temporary / "usb"

        home_source.mkdir()
        sys_source.mkdir()
        usb_root.mkdir()

        (home_source / "printer_data").mkdir()
        (
            home_source
            / "printer_data"
            / "fixture.cfg"
        ).write_text("home fixture\n")

        home_backup_directory = (
            home_source / "Fre3nderBackup"
        )
        home_backup_directory.mkdir()
        (
            home_backup_directory / "old.tar"
        ).write_text(
            "old backup must not enter HOME archive\n"
        )

        (sys_source / "etc").mkdir()
        (
            sys_source
            / "etc"
            / "fixture.conf"
        ).write_text("sys fixture\n")

        usb_backup_directory = (
            usb_root / "Fre3nderBackup"
        )
        pending_transaction = (
            temporary
            / "ota-state"
            / "pending.json"
        )

        # USB available: HOME and SYS both go to USB.
        runtime = make_runtime(
            temporary / "runtime-backup-usb"
        )

        usb_helper = make_usb_helper(
            temporary
            / "runtime-backup-usb"
            / "fre3nder-usb",
            status="mounted",
            source="/dev/fixture-usb",
            filesystem="exfat",
        )

        transaction_runtime = {
            **runtime,
            "usb_helper": usb_helper,
        }

        response = module.backup_response(
            package,
            ["--home", "--sys", "usb"],
            home_source=home_source,
            sys_source=sys_source,
            home_backup_directory=home_backup_directory,
            usb_backup_directory=usb_backup_directory,
            pending_transaction_path=pending_transaction,
            public_key=public_key,
            **transaction_runtime,
        )

        assert response["operation"] == "backup"

        result = response["backup_result"]

        confirmation = response["confirmation"]
        assert confirmation["required"] is True
        assert (
            confirmation["state"]
            == "awaiting-confirmation"
        )

        transaction_id = confirmation["transaction_id"]
        assert len(transaction_id) == 32
        int(transaction_id, 16)

        pending = json.loads(
            pending_transaction.read_text()
        )

        assert (
            pending["state"]
            == "awaiting-confirmation"
        )
        assert (
            pending["transaction_id"]
            == transaction_id
        )
        assert (
            pending["package"]["version"]
            == "2026.4.fixture"
        )
        assert (
            pending["backup_selection"]
            == response["backup_selection"]
        )
        assert (
            pending["backup_result"]
            == response["backup_result"]
        )

        with package.open("rb") as stream:
            package_digest, package_size = (
                module.sha256_stream(stream)
            )

        assert (
            pending["package"]["sha256"]
            == package_digest
        )
        assert (
            pending["package"]["size"]
            == package_size
        )

        assert result["complete"] is True
        assert result["home"]["selected"] is True
        assert result["home"]["target"] == "usb"
        assert result["sys"]["selected"] is True
        assert result["sys"]["target"] == "usb"

        home_archive = Path(
            result["home"]["archive"]
        )
        sys_archive = Path(
            result["sys"]["archive"]
        )

        assert (
            home_archive.parent
            == usb_backup_directory
        )
        assert (
            sys_archive.parent
            == usb_backup_directory
        )

        assert home_archive.is_file()
        assert sys_archive.is_file()

        # Wrong confirmation must fail without consuming the receipt.
        try:
            module.confirm_response(
                package,
                ["0" * 32],
                pending_transaction_path=pending_transaction,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert "transaction ID does not match" in str(exc)
        else:
            raise AssertionError(
                "wrong transaction ID unexpectedly confirmed OTA"
            )

        assert (
            json.loads(
                pending_transaction.read_text()
            )["state"]
            == "awaiting-confirmation"
        )

        # Selected backups are part of the confirmation contract.
        original_home_archive = home_archive.read_bytes()
        home_archive.write_bytes(
            original_home_archive + b"tampered"
        )

        try:
            module.confirm_response(
                package,
                [transaction_id],
                pending_transaction_path=pending_transaction,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert (
                "HOME backup archive changed after backup"
                in str(exc)
            )
        else:
            raise AssertionError(
                "tampered backup unexpectedly confirmed OTA"
            )

        home_archive.write_bytes(original_home_archive)

        confirmed = module.confirm_response(
            package,
            [transaction_id],
            pending_transaction_path=pending_transaction,
            public_key=public_key,
            **transaction_runtime,
        )

        assert confirmed["operation"] == "confirm"
        assert confirmed["confirmation"] == {
            "state": "confirmed",
            "transaction_id": transaction_id,
        }

        assert (
            json.loads(
                pending_transaction.read_text()
            )["state"]
            == "confirmed"
        )

        try:
            module.backup_response(
                package,
                ["--no-home", "--no-sys"],
                pending_transaction_path=pending_transaction,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert (
                "another OTA transaction is already active"
                in str(exc)
            )
        else:
            raise AssertionError(
                "active OTA transaction was unexpectedly replaced"
            )


        with tarfile.open(
            home_archive,
            mode="r:",
        ) as archive:
            names = set(archive.getnames())

            assert (
                "home/printer_data/fixture.cfg"
                in names
            )

            assert not any(
                name == "home/Fre3nderBackup"
                or name.startswith(
                    "home/Fre3nderBackup/"
                )
                for name in names
            )

        with tarfile.open(
            sys_archive,
            mode="r:",
        ) as archive:
            assert (
                "sys/etc/fixture.conf"
                in archive.getnames()
            )

        assert not list(
            usb_backup_directory.glob(".*.tmp")
        )

        # No USB: HOME is declined and SYS may go to HOME.
        home_pending_transaction = (
            temporary
            / "ota-state-home"
            / "pending.json"
        )

        runtime = make_runtime(
            temporary / "runtime-backup-home"
        )

        usb_helper = make_usb_helper(
            temporary
            / "runtime-backup-home"
            / "fre3nder-usb",
            status="absent",
        )

        response = module.backup_response(
            package,
            ["--no-home", "--sys", "home"],
            home_source=home_source,
            sys_source=sys_source,
            home_backup_directory=home_backup_directory,
            usb_backup_directory=usb_backup_directory,
            pending_transaction_path=home_pending_transaction,
            usb_helper=usb_helper,
            public_key=public_key,
            **runtime,
        )

        result = response["backup_result"]

        assert result["complete"] is True

        assert result["home"] == {
            "selected": False,
            "target": None,
        }

        assert result["sys"]["selected"] is True
        assert result["sys"]["target"] == "home"

        sys_home_archive = Path(
            result["sys"]["archive"]
        )

        assert (
            sys_home_archive.parent
            == home_backup_directory
        )
        assert sys_home_archive.is_file()

        with tarfile.open(
            sys_home_archive,
            mode="r:",
        ) as archive:
            assert (
                "sys/etc/fixture.conf"
                in archive.getnames()
            )

        assert not list(
            home_backup_directory.glob(".*.tmp")
        )




def test_partition_identity():
    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        dev = temporary / "dev"
        sysfs = temporary / "sys-class-block"
        labels = temporary / "by-partlabel"

        dev.mkdir()
        sysfs.mkdir()
        labels.mkdir()

        devices = {}

        for number, sectors in (
            (6, 16384),
            (7, 1024000),
            (8, 1024000),
        ):
            name = f"mmcblk0p{number}"

            device = dev / name
            device.write_bytes(b"fixture")
            devices[number] = device

            metadata = sysfs / name
            metadata.mkdir()

            (
                metadata / "partition"
            ).write_text(
                f"{number}\n"
            )

            (
                metadata / "size"
            ).write_text(
                f"{sectors}\n"
            )

        (
            labels / "kernel2"
        ).symlink_to(
            devices[6]
        )

        (
            labels / "rootfs2"
        ).symlink_to(
            devices[8]
        )

        module.validate_partition_identity(
            devices[6],
            6,
            16384,
            "kernel2",
            devices[7],
            sysfs,
            labels,
            allow_regular_target=True,
        )

        module.validate_partition_identity(
            devices[8],
            8,
            1024000,
            "rootfs2",
            devices[7],
            sysfs,
            labels,
            allow_regular_target=True,
        )

        # Wrong physical partition size must fail closed.
        (
            sysfs
            / "mmcblk0p6"
            / "size"
        ).write_text("1\n")

        try:
            module.validate_partition_identity(
                devices[6],
                6,
                16384,
                "kernel2",
                devices[7],
                sysfs,
                labels,
                allow_regular_target=True,
            )
        except ValueError as exc:
            assert (
                "inactive OTA target size mismatch"
                in str(exc)
            )
        else:
            raise AssertionError(
                "wrong OTA partition size was accepted"
            )

        (
            sysfs
            / "mmcblk0p6"
            / "size"
        ).write_text("16384\n")

        # Wrong partlabel mapping must also fail.
        (
            labels / "kernel2"
        ).unlink()

        (
            labels / "kernel2"
        ).symlink_to(
            devices[8]
        )

        try:
            module.validate_partition_identity(
                devices[6],
                6,
                16384,
                "kernel2",
                devices[7],
                sysfs,
                labels,
                allow_regular_target=True,
            )
        except ValueError as exc:
            assert (
                "kernel2 partlabel does not resolve"
                in str(exc)
            )
        else:
            raise AssertionError(
                "wrong OTA partlabel mapping was accepted"
            )


def test_write_inactive_slot():
    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        private_key, public_key = generate_keys(temporary)

        package = temporary / "write.ota"
        make_package(
            package,
            private_key,
            public_key,
        )

        runtime = make_runtime(
            temporary / "runtime-write"
        )

        usb_helper = make_usb_helper(
            temporary
            / "runtime-write"
            / "fre3nder-usb",
            status="absent",
        )

        transaction_runtime = {
            **runtime,
            "usb_helper": usb_helper,
        }

        pending = (
            temporary
            / "ota-state"
            / "pending.json"
        )

        backup = module.backup_response(
            package,
            ["--no-home", "--no-sys"],
            pending_transaction_path=pending,
            public_key=public_key,
            **transaction_runtime,
        )

        transaction_id = (
            backup["confirmation"]["transaction_id"]
        )

        manifest = module.verify_package(
            package,
            public_key,
        )

        kernel_size = (
            manifest["artifact_sizes"]["kernel.uImage"]
        )
        rootfs_size = (
            manifest["artifact_sizes"]["rootfs.squashfs"]
        )

        kernel_target = temporary / "kernel.target"
        rootfs_target = temporary / "rootfs.target"

        kernel_target.write_bytes(
            b"K" * (kernel_size + 4096)
        )
        rootfs_target.write_bytes(
            b"R" * (rootfs_size + 4096)
        )

        kernel_before = kernel_target.read_bytes()
        rootfs_before = rootfs_target.read_bytes()

        # No write may happen before confirmation.
        try:
            module.write_response(
                package,
                [transaction_id],
                pending_transaction_path=pending,
                write_lock_path=temporary / "write.lock",
                target_overrides={
                    "kernel": kernel_target,
                    "rootfs": rootfs_target,
                },
                allow_regular_targets=True,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert (
                "transaction is not confirmed"
                in str(exc)
            )
        else:
            raise AssertionError(
                "unconfirmed transaction unexpectedly wrote targets"
            )

        assert kernel_target.read_bytes() == kernel_before
        assert rootfs_target.read_bytes() == rootfs_before

        module.confirm_response(
            package,
            [transaction_id],
            pending_transaction_path=pending,
            public_key=public_key,
            **transaction_runtime,
        )

        response = module.write_response(
            package,
            [transaction_id],
            pending_transaction_path=pending,
            write_lock_path=temporary / "write.lock",
            target_overrides={
                "kernel": kernel_target,
                "rootfs": rootfs_target,
            },
            allow_regular_targets=True,
            public_key=public_key,
            **transaction_runtime,
        )

        assert response["operation"] == "write"
        assert response["write_result"]["complete"] is True
        assert response["transaction"] == {
            "state": "written-awaiting-readback",
            "transaction_id": transaction_id,
        }

        with tarfile.open(package, mode="r:") as archive:
            kernel_expected = archive.extractfile(
                archive.getmember("kernel.uImage")
            ).read()
            rootfs_expected = archive.extractfile(
                archive.getmember("rootfs.squashfs")
            ).read()

        kernel_after = kernel_target.read_bytes()
        rootfs_after = rootfs_target.read_bytes()

        assert (
            kernel_after[:kernel_size]
            == kernel_expected
        )
        assert (
            rootfs_after[:rootfs_size]
            == rootfs_expected
        )

        # Writing a partition image must not truncate the target.
        assert len(kernel_after) == len(kernel_before)
        assert len(rootfs_after) == len(rootfs_before)

        assert (
            kernel_after[kernel_size:]
            == kernel_before[kernel_size:]
        )
        assert (
            rootfs_after[rootfs_size:]
            == rootfs_before[rootfs_size:]
        )

        state = json.loads(pending.read_text())

        assert (
            state["state"]
            == "written-awaiting-readback"
        )
        assert state["write_result"] == response["write_result"]

        # Corruption between write and readback must be detected.
        rootfs_good = rootfs_target.read_bytes()

        corrupted = bytearray(rootfs_good)
        corrupted[0] ^= 0x01
        rootfs_target.write_bytes(corrupted)

        try:
            module.readback_response(
                package,
                [transaction_id],
                pending_transaction_path=pending,
                target_overrides={
                    "kernel": kernel_target,
                    "rootfs": rootfs_target,
                },
                allow_regular_targets=True,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert (
                "RootFS readback checksum mismatch"
                in str(exc)
            )
        else:
            raise AssertionError(
                "corrupt RootFS unexpectedly passed readback"
            )

        assert (
            json.loads(
                pending.read_text()
            )["state"]
            == "written-awaiting-readback"
        )

        rootfs_target.write_bytes(rootfs_good)

        readback = module.readback_response(
            package,
            [transaction_id],
            pending_transaction_path=pending,
            target_overrides={
                "kernel": kernel_target,
                "rootfs": rootfs_target,
            },
            allow_regular_targets=True,
            public_key=public_key,
            **transaction_runtime,
        )

        assert readback["operation"] == "readback"
        assert readback["readback_result"]["complete"] is True
        assert readback["transaction"] == {
            "state": "readback-verified",
            "transaction_id": transaction_id,
        }

        state = json.loads(pending.read_text())

        assert state["state"] == "readback-verified"
        assert (
            state["readback_result"]
            == readback["readback_result"]
        )

        assert (
            state["readback_result"]["kernel"]["sha256"]
            == manifest["artifacts"]["kernel.uImage"]
        )
        assert (
            state["readback_result"]["rootfs"]["sha256"]
            == manifest["artifacts"]["rootfs.squashfs"]
        )

        # READBACK is also single-use for this transaction state.
        try:
            module.readback_response(
                package,
                [transaction_id],
                pending_transaction_path=pending,
                target_overrides={
                    "kernel": kernel_target,
                    "rootfs": rootfs_target,
                },
                allow_regular_targets=True,
                public_key=public_key,
                **transaction_runtime,
            )
        except ValueError as exc:
            assert (
                "transaction is not awaiting readback"
                in str(exc)
            )
        else:
            raise AssertionError(
                "completed readback unexpectedly ran twice"
            )

        activation_record = (
            temporary
            / "system"
            / ".fre3nder-ota-activation.json"
        )
        target_reset_marker = (
            temporary
            / "system"
            / ".fre3nder-reset-target"
        )
        legacy_reset_marker = (
            temporary
            / "system"
            / ".fre3nder-reset"
        )

        activation_record.parent.mkdir()

        selector = temporary / "selector"
        selector.write_bytes(
            module.selector_payload("A")
            + b"UNCHANGED"
        )

        # A target changed after READBACK must not be made bootable.
        kernel_good = kernel_target.read_bytes()

        corrupted = bytearray(kernel_good)
        corrupted[0] ^= 0x01
        kernel_target.write_bytes(corrupted)

        try:
            module.prepare_activation_response(
                package,
                [transaction_id],
                pending_transaction_path=pending,
                activation_record_path=activation_record,
                target_reset_marker_path=target_reset_marker,
                legacy_reset_marker_path=legacy_reset_marker,
