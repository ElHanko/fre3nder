        )

        assert target_reset_marker.read_text() == (
            "RESET_ON_NEXT_BOOT_ROOT="
            "/dev/mmcblk0p8\n"
        )

        persistent = json.loads(
            activation_record.read_text()
        )

        assert (
            persistent["state"]
            == "activation-prepared"
        )
        assert (
            persistent["transaction_id"]
            == transaction_id
        )
        assert (
            persistent["target"]["slot"]
            == "B"
        )
        assert (
            persistent["selector_result"][
                "target_slot"
            ]
            == "B"
        )

        assert (
            json.loads(
                pending.read_text()
            )["state"]
            == "activation-prepared"
        )

        # Repeating PREPARE_ACTIVATION is idempotent.
        prepared_again = (
            module.prepare_activation_response(
                package,
                [transaction_id],
                pending_transaction_path=pending,
                activation_record_path=activation_record,
                target_reset_marker_path=target_reset_marker,
