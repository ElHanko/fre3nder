def test_selector_primitives():
    assert len(module.selector_payload("A")) == 512
    assert len(module.selector_payload("B")) == 512

    assert (
        module.classify_selector(
            module.selector_payload("A")
        )
        == "A"
    )

    assert (
        module.classify_selector(
            module.selector_payload("B")
        )
        == "B"
    )

    assert (
        module.classify_selector(
            b"x" * 512
        )
        is None
    )

    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        selector = temporary / "selector"

        # Simulate p1 while preserving bytes beyond the
        # selector record.
        selector.write_bytes(
            module.selector_payload("A")
            + b"UNCHANGED"
        )

        before_size = selector.stat().st_size

        current = module.read_selector_target(
            selector,
            allow_regular_target=True,
        )

        assert current == {
            "slot": "A",
            "sha256": module.SELECTOR_HASHES["A"],
        }

        result = module.write_selector_target(
            selector,
            "A",
            "B",
            allow_regular_target=True,
        )

        assert result == {
            "previous_slot": "A",
            "target_slot": "B",
            "size": 512,
            "sha256": module.SELECTOR_HASHES["B"],
        }

        assert selector.stat().st_size == before_size

        content = selector.read_bytes()

        assert (
            content[:512]
            == module.selector_payload("B")
        )
        assert content[512:] == b"UNCHANGED"

        # Selector and active runtime must agree before
        # another transition is allowed.
        try:
            module.write_selector_target(
                selector,
                "A",
                "B",
                allow_regular_target=True,
            )
        except ValueError as exc:
            assert (
                "selector does not match the active runtime slot"
                in str(exc)
            )
        else:
            raise AssertionError(
                "selector/runtime mismatch was accepted"
            )

        # Reverse transition proves both known payloads.
        result = module.write_selector_target(
            selector,
            "B",
            "A",
            allow_regular_target=True,
        )

        assert result["target_slot"] == "A"
        assert (
            selector.read_bytes()[:512]
            == module.selector_payload("A")
        )


