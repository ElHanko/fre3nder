def make_usb_helper(
    path,
    *,
    status="absent",
    source="/dev/fixture-usb",
    filesystem="exfat",
    writable=True,
):
    lines = [
        "api_version=1",
        f"status={status}",
        "mount=/run/fre3nder/usb",
    ]

    if status == "mounted":
        lines.extend(
            (
                f"source={source}",
                f"filesystem={filesystem}",
                (
                    "writable=true"
                    if writable
                    else "writable=false"
                ),
            )
        )

    payload = "\n".join(lines) + "\n"

    path.write_text(
        "#!/bin/sh\n"
        "cat <<'USB_STATUS'\n"
        + payload
        + "USB_STATUS\n"
    )
    path.chmod(0o755)

    return path


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def run_cli(core, operation, package, *arguments):
    environment = os.environ.copy()
    environment["FRE3NDER_OTA_CORE"] = str(core)

    return subprocess.run(
        [
            str(CLI),
            "ota",
            operation,
            str(package),
            *arguments,
        ],
        env=environment,
        capture_output=True,
        text=True,
        check=False,
    )




def run_core_process(operation, package):
    return subprocess.run(
        [str(CORE), operation, str(package)],
        capture_output=True,
        text=True,
        check=False,
    )


