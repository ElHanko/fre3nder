sys.dont_write_bytecode = True


ROOT = Path(__file__).resolve().parent.parent
CORE = ROOT / "configs/x2000/rootfs-overlay/usr/libexec/fre3nder-ota-core"
CLI = ROOT / "configs/x2000/rootfs-overlay/usr/bin/fre3nder"
BUILDROOT_FRAGMENT = ROOT / "configs/x2000/buildroot.fragment"

loader = importlib.machinery.SourceFileLoader(
    "fre3nder_ota_core",
    str(CORE),
)
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def run_cli(core, operation, package, *arguments):
    environment = os.environ.copy()
    environment["FRE3NDER_OTA_CORE"] = str(core)

    return subprocess.run(
        [
            str(CLI),
            "ota",
            operation,
            str(package),
            *arguments,
        ],
        env=environment,
        capture_output=True,
        text=True,
        check=False,
    )


def run_core_process(operation, package):
    return subprocess.run(
        [str(CORE), operation, str(package)],
        capture_output=True,
        text=True,
        check=False,
    )


