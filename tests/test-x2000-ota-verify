def test_backup_archive_primitive():
    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        source = temporary / "source"
        target = temporary / "target"
        source.mkdir()
        target.mkdir()

        (source / "etc").mkdir()
        (source / "etc" / "printer.conf").write_text("fixture\n")
        (source / "data").mkdir()
        (source / "data" / "value.txt").write_text("value\n")
        (source / "link").symlink_to("etc/printer.conf")

        excluded = source / "Fre3nderBackup"
        excluded.mkdir()
        (excluded / "old-backup.tar").write_text(
            "must not be archived\n"
        )

        result = module.create_backup_archive(
            source,
            target,
            "SYS",
            "2026.4.fixture",
            excluded_paths=(excluded,),
        )

        archive_path = Path(result["archive"])
        assert archive_path.is_file()
        assert result["size"] == archive_path.stat().st_size

        with archive_path.open("rb") as stream:
            digest, size = module.sha256_stream(stream)

        assert digest == result["sha256"]
        assert size == result["size"]

        with tarfile.open(archive_path, mode="r:") as archive:
            names = set(archive.getnames())

            assert names == {
                "sys",
                "sys/etc",
                "sys/etc/printer.conf",
                "sys/data",
                "sys/data/value.txt",
                "sys/link",
            }

            link = archive.getmember("sys/link")
            assert link.issym()
            assert link.linkname == "etc/printer.conf"

            content = archive.extractfile(
                archive.getmember("sys/etc/printer.conf")
            )
            assert content is not None
            assert content.read() == b"fixture\n"

        assert not list(target.glob(".*.tmp"))


def test_backup_execution():
    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)

        private_key, public_key = generate_keys(temporary)

        package = temporary / "backup.ota"
        make_package(
            package,
            private_key,
            public_key,
        )

        home_source = temporary / "home"
        sys_source = temporary / "sys-upper"
        usb_root = temporary / "usb"

        home_source.mkdir()
        sys_source.mkdir()
        usb_root.mkdir()

        (home_source / "printer_data").mkdir()
        (
            home_source
            / "printer_data"
            / "fixture.cfg"
        ).write_text("home fixture\n")

        home_backup_directory = (
            home_source / "Fre3nderBackup"
        )
        home_backup_directory.mkdir()
        (
            home_backup_directory / "old.tar"
        ).write_text(
            "old backup must not enter HOME archive\n"
        )

        (sys_source / "etc").mkdir()
        (
            sys_source
            / "etc"
            / "fixture.conf"
        ).write_text("sys fixture\n")

        usb_backup_directory = (
            usb_root / "Fre3nderBackup"
        )

        # USB available: HOME and SYS both go to USB.
        runtime = make_runtime(
            temporary / "runtime-backup-usb"
        )

        usb_status = (
            temporary
            / "runtime-backup-usb"
            / "usb-status"
        )
        usb_status.write_text("mounted\n")
        runtime["usb_status_path"] = usb_status

        mounts = runtime["mounts_path"]
        mounts.write_text(
            mounts.read_text()
            + "/dev/fixture-usb /run/fre3nder/usb "
            "exfat rw,nosuid,nodev,noexec 0 0\n"
        )

        response = module.backup_response(
            package,
            ["--home", "--sys", "usb"],
            home_source=home_source,
            sys_source=sys_source,
            home_backup_directory=home_backup_directory,
            usb_backup_directory=usb_backup_directory,
            public_key=public_key,
            **runtime,
        )

        assert response["operation"] == "backup"

        result = response["backup_result"]

        assert result["complete"] is True
        assert result["home"]["selected"] is True
        assert result["home"]["target"] == "usb"
        assert result["sys"]["selected"] is True
        assert result["sys"]["target"] == "usb"

        home_archive = Path(
            result["home"]["archive"]
        )
        sys_archive = Path(
            result["sys"]["archive"]
        )

        assert (
            home_archive.parent
            == usb_backup_directory
        )
        assert (
            sys_archive.parent
            == usb_backup_directory
        )

        assert home_archive.is_file()
        assert sys_archive.is_file()

        with tarfile.open(
            home_archive,
            mode="r:",
        ) as archive:
            names = set(archive.getnames())

            assert (
                "home/printer_data/fixture.cfg"
                in names
            )

            assert not any(
                name == "home/Fre3nderBackup"
                or name.startswith(
                    "home/Fre3nderBackup/"
                )
                for name in names
            )

        with tarfile.open(
            sys_archive,
            mode="r:",
        ) as archive:
            assert (
                "sys/etc/fixture.conf"
                in archive.getnames()
            )

        assert not list(
            usb_backup_directory.glob(".*.tmp")
        )

        # No USB: HOME is declined and SYS may go to HOME.
        runtime = make_runtime(
            temporary / "runtime-backup-home"
        )

        response = module.backup_response(
            package,
            ["--no-home", "--sys", "home"],
            home_source=home_source,
            sys_source=sys_source,
            home_backup_directory=home_backup_directory,
            usb_backup_directory=usb_backup_directory,
            public_key=public_key,
            **runtime,
        )

        result = response["backup_result"]

        assert result["complete"] is True

        assert result["home"] == {
            "selected": False,
            "target": None,
        }

        assert result["sys"]["selected"] is True
        assert result["sys"]["target"] == "home"

        sys_home_archive = Path(
            result["sys"]["archive"]
        )

        assert (
            sys_home_archive.parent
            == home_backup_directory
        )
        assert sys_home_archive.is_file()

        with tarfile.open(
            sys_home_archive,
            mode="r:",
        ) as archive:
            assert (
                "sys/etc/fixture.conf"
                in archive.getnames()
            )

        assert not list(
            home_backup_directory.glob(".*.tmp")
        )


        # A selected USB backup must be revalidated immediately before
        # writing. If the runtime USB disappeared after preflight, no target
        # directory or archive may be created.
        runtime = make_runtime(
            temporary / "runtime-backup-disappeared"
        )

        usb_status = (
            temporary
            / "runtime-backup-disappeared"
            / "usb-status"
        )
        usb_status.write_text("mounted\n")
        runtime["usb_status_path"] = usb_status

        mounts = runtime["mounts_path"]
        mounts.write_text(
            mounts.read_text()
            + "/dev/fixture-usb /run/fre3nder/usb "
            "exfat rw,nosuid,nodev,noexec 0 0\n"
        )

        vanished_target = (
            temporary
            / "vanished-usb"
            / "Fre3nderBackup"
        )

        original_read_runtime_usb_state = (
            module.read_runtime_usb_state
        )

        module.read_runtime_usb_state = (
            lambda *args, **kwargs: {
                "available": False,
                "status": "absent",
                "mount": None,
            }
        )

        try:
            try:
                module.backup_response(
                    package,
                    ["--home", "--no-sys"],
                    home_source=home_source,
                    sys_source=sys_source,
                    home_backup_directory=home_backup_directory,
                    usb_backup_directory=vanished_target,
                    public_key=public_key,
                    **runtime,
                )
            except ValueError as exc:
                assert (
                    "backup-capable runtime USB volume "
                    "is no longer available"
                    in str(exc)
                )
            else:
                raise AssertionError(
                    "backup unexpectedly continued after USB disappeared"
                )
        finally:
            module.read_runtime_usb_state = (
                original_read_runtime_usb_state
            )

        assert not vanished_target.exists()



def test_runtime_usb_backup_offer():
    absent = module.runtime_usb_state("absent", "")
    assert absent == {
        "available": False,
        "status": "absent",
        "mount": None,
    }

    absent_offer = module.build_backup_offer(absent)
    assert absent_offer == {
        "selection_required": True,
        "home": {
            "role": "HOME",
            "offered": False,
            "required": False,
            "targets": [],
        },
        "sys": {
            "role": "SYS",
            "offered": True,
            "required": False,
            "targets": ["home"],
        },
        "targets": {
            "home": {
                "available": True,
                "path": "/home/Fre3nderBackup",
            },
            "usb": {
                "available": False,
                "path": None,
            },
        },
    }

    mounts = (
        "/dev/sdz1 /run/fre3nder/usb "
        "exfat rw,nosuid,nodev,noexec 0 0\n"
    )
    mounted = module.runtime_usb_state("mounted", mounts)

    assert mounted == {
        "available": True,
        "status": "mounted",
        "mount": "/run/fre3nder/usb",
        "source": "/dev/sdz1",
        "filesystem": "exfat",
        "backup_available": True,
    }

    mounted_offer = module.build_backup_offer(mounted)
    assert mounted_offer == {
        "selection_required": True,
        "home": {
            "role": "HOME",
            "offered": True,
            "required": False,
            "targets": ["usb"],
        },
        "sys": {
            "role": "SYS",
            "offered": True,
            "required": False,
            "targets": ["usb", "home"],
        },
        "targets": {
            "home": {
                "available": True,
                "path": "/home/Fre3nderBackup",
            },
            "usb": {
                "available": True,
                "path": "/run/fre3nder/usb/Fre3nderBackup",
            },
        },
    }

    vfat_mounts = (
        "/dev/sdz1 /run/fre3nder/usb "
        "vfat rw,nosuid,nodev,noexec 0 0\n"
    )
    vfat = module.runtime_usb_state(
        "mounted",
        vfat_mounts,
    )
    assert vfat == {
        "available": True,
        "status": "mounted",
        "mount": "/run/fre3nder/usb",
        "source": "/dev/sdz1",
        "filesystem": "vfat",
        "backup_available": False,
    }

    vfat_offer = module.build_backup_offer(vfat)
    assert vfat_offer["home"]["offered"] is False
    assert vfat_offer["home"]["targets"] == []
    assert vfat_offer["sys"]["targets"] == ["home"]
    assert vfat_offer["targets"]["usb"]["available"] is False

    readonly_mounts = (
        "/dev/sdz1 /run/fre3nder/usb "
        "vfat ro,nosuid,nodev,noexec 0 0\n"
    )
    readonly = module.runtime_usb_state(
        "mounted",
        readonly_mounts,
    )
    assert readonly == {
        "available": False,
        "status": "not-writable",
        "mount": None,
    }


def test_backup_plan_arguments():
    no_usb_offer = module.build_backup_offer(
        module.runtime_usb_state("absent", "")
    )

    usb_mounts = (
        "/dev/sdz1 /run/fre3nder/usb "
        "exfat rw,nosuid,nodev,noexec 0 0\\n"
    )
    usb_offer = module.build_backup_offer(
        module.runtime_usb_state("mounted", usb_mounts)
    )

    selection = module.parse_backup_plan_args(
        ["--no-home", "--sys", "home"],
        no_usb_offer,
    )
    assert selection == {
        "home": {
            "selected": False,
            "target": None,
        },
        "sys": {
            "selected": True,
            "target": "home",
        },
    }

    selection = module.parse_backup_plan_args(
        ["--home", "--sys", "usb"],
        usb_offer,
    )
    assert selection == {
        "home": {
            "selected": True,
            "target": "usb",
        },
        "sys": {
            "selected": True,
            "target": "usb",
        },
    }

    selection = module.parse_backup_plan_args(
        ["--home", "--sys", "home"],
        usb_offer,
    )
    assert selection["home"]["target"] == "usb"
    assert selection["sys"]["target"] == "home"

    selection = module.parse_backup_plan_args(
        ["--no-home", "--no-sys"],
        no_usb_offer,
    )
    assert selection == {
        "home": {
            "selected": False,
            "target": None,
        },
        "sys": {
            "selected": False,
            "target": None,
        },
    }

    invalid = (
        (
            ["--home", "--no-sys"],
            no_usb_offer,
            "backup-capable runtime USB",
        ),
        (
            ["--no-home", "--sys", "usb"],
            no_usb_offer,
            "not available",
        ),
        (
            ["--no-home", "--sys", "other"],
            usb_offer,
            "must be usb or home",
        ),
        (
            ["--no-home"],
            usb_offer,
            "SYS backup must be explicitly",
        ),
        (
            ["--no-sys"],
            usb_offer,
            "HOME backup must be explicitly",
        ),
        (
            ["--home", "--no-home", "--no-sys"],
            usb_offer,
            "HOME backup selection specified more than once",
        ),
        (
            ["--no-home", "--sys", "home", "--no-sys"],
            usb_offer,
            "SYS backup selection specified more than once",
        ),
        (
            ["--home-target", "/tmp/backup", "--no-sys"],
            usb_offer,
            "unsupported backup selection argument",
        ),
    )

    for arguments, offer, expected in invalid:
        try:
            module.parse_backup_plan_args(arguments, offer)
        except ValueError as exc:
            assert expected in str(exc)
        else:
            raise AssertionError(
                f"invalid backup selection accepted: {arguments}"
            )


def generate_keys(directory):
    private_key = directory / "private.pem"
    public_key = directory / "public.pem"
    run(
        "openssl",
        "genpkey",
        "-algorithm",
        "ED25519",
        "-out",
        str(private_key),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    run(
        "openssl",
        "pkey",
        "-in",
        str(private_key),
        "-pubout",
        "-out",
        str(public_key),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return private_key, public_key


def make_package(
    path,
    private_key,
    public_key,
    *,
    platform="ender3-v3-ke",
    key_hash=None,
    tamper_rootfs=False,
    extra_member=False,
    symlink_rootfs=False,
    corrupt_signature=False,
):
    kernel = b"fixture-kernel\n"
    signed_rootfs = b"fixture-rootfs\n"
    archived_rootfs = b"tampered-rootfs\n" if tamper_rootfs else signed_rootfs

    payload_hashes = {
        "kernel.uImage": hashlib.sha256(kernel).hexdigest(),
        "rootfs.squashfs": hashlib.sha256(signed_rootfs).hexdigest(),
    }
    payload_sizes = {
        "kernel.uImage": len(kernel),
        "rootfs.squashfs": len(archived_rootfs),
    }
    manifest = {
        "version": "2026.4.fixture",
        "artifact_mode": "development",
        "ota_public_key_sha256": (
            key_hash
            if key_hash is not None
            else hashlib.sha256(public_key.read_bytes()).hexdigest()
        ),
        "artifacts": payload_hashes,
        "artifact_sizes": payload_sizes,
        "ota": {
            "format": "fre3nder-ota",
            "format_version": 1,
            "platform": platform,
            "signature": {
                "algorithm": "Ed25519",
                "file": "SHA256SUMS.sig",
                "signed_file": "SHA256SUMS",
            },
        },
    }
    manifest_data = (
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    ).encode()
    checksums_data = (
        f"{hashlib.sha256(manifest_data).hexdigest()}  manifest.json\n"
        f"{payload_hashes['kernel.uImage']}  kernel.uImage\n"
        f"{payload_hashes['rootfs.squashfs']}  rootfs.squashfs\n"
    ).encode()

    with tempfile.TemporaryDirectory() as temporary:
        temporary = Path(temporary)
        sums = temporary / "SHA256SUMS"
        signature = temporary / "SHA256SUMS.sig"
        sums.write_bytes(checksums_data)
        run(
            "openssl",
            "pkeyutl",
            "-sign",
            "-rawin",
            "-inkey",
            str(private_key),
            "-in",
            str(sums),
            "-out",
            str(signature),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        signature_data = bytearray(signature.read_bytes())
    if corrupt_signature:
        signature_data[0] ^= 1

    def info(name, size):
        entry = tarfile.TarInfo(name)
        entry.size = size
        entry.mode = 0o644
        entry.uid = 0
        entry.gid = 0
        entry.uname = "root"
        entry.gname = "root"
        entry.mtime = 0
        return entry

    with tarfile.open(path, "w", format=tarfile.USTAR_FORMAT) as archive:
        for name, data in (
            ("manifest.json", manifest_data),
            ("SHA256SUMS", checksums_data),
            ("SHA256SUMS.sig", bytes(signature_data)),
            ("kernel.uImage", kernel),
        ):
            archive.addfile(info(name, len(data)), io.BytesIO(data))

        if symlink_rootfs:
            entry = tarfile.TarInfo("rootfs.squashfs")
            entry.type = tarfile.SYMTYPE
            entry.linkname = "kernel.uImage"
            entry.mode = 0o777
            entry.mtime = 0
            archive.addfile(entry)
        else:
            archive.addfile(
                info("rootfs.squashfs", len(archived_rootfs)),
                io.BytesIO(archived_rootfs),
            )

        if extra_member:
            data = b"extra\n"
            archive.addfile(info("extra", len(data)), io.BytesIO(data))


def expect_valid(package, public_key):
    manifest = module.verify_package(package, public_key)
    assert manifest["version"] == "2026.4.fixture"


def expect_invalid(package, public_key, text):
    try:
        module.verify_package(package, public_key)
    except ValueError as exc:
        assert text in str(exc), (text, str(exc))
    else:
        raise AssertionError(f"package unexpectedly verified: {package}")


def make_runtime(
    directory,
    *,
    active_root="/dev/mmcblk0p7",
    status="active",
    duplicate_sys=False,
    home_mount_source="/dev/fre3nder-home",
    home_fs_type="ext4",
):
    directory.mkdir()

    version = directory / "VERSION"
    root_status = directory / "status"
    cmdline = directory / "cmdline"
    mounts = directory / "mounts"
    blkid = directory / "blkid"

    version.write_text("2026.3\n")
    root_status.write_text(status + "\n")
    cmdline.write_text(
        f"console=ttyS4 root={active_root} rootwait\n"
    )

    mounts.write_text(
        "/dev/fre3nder-sys /run/fre3nder-root/system "
        "ext4 rw 0 0\n"
        f"{home_mount_source} /home {home_fs_type} rw 0 0\n"
    )

    blkid_lines = [
        '/dev/fre3nder-sys: LABEL="FRE3NDERSYS" TYPE="ext4"',
        '/dev/fre3nder-home: LABEL="FRE3NDERHOME" TYPE="ext4"',
    ]
    if duplicate_sys:
        blkid_lines.append(
            '/dev/duplicate-sys: LABEL="FRE3NDERSYS" TYPE="ext4"'
        )

    blkid.write_text(
        "#!/bin/sh\n"
        "cat <<'BLKID_OUTPUT'\n"
        + "\n".join(blkid_lines)
        + "\nBLKID_OUTPUT\n"
    )
    blkid.chmod(0o755)

    return {
        "installed_version_path": version,
        "root_status_path": root_status,
        "cmdline_path": cmdline,
        "mounts_path": mounts,
        "blkid_command": blkid,
    }


def expect_preflight_invalid(package, public_key, runtime, text):
    try:
        module.preflight_package(
            package,
            public_key=public_key,
            **runtime,
        )
    except ValueError as exc:
        assert text in str(exc), (text, str(exc))
    else:
        raise AssertionError("preflight unexpectedly succeeded")


