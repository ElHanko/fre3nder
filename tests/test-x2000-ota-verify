                "changed kernel target was made bootable"
            )

        assert not activation_record.exists()
        assert not target_reset_marker.exists()

        assert (
            selector.read_bytes()[:512]
            == module.selector_payload("A")
        )

        kernel_target.write_bytes(kernel_good)

        prepared = module.prepare_activation_response(
            package,
            [transaction_id],
