#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
service=$root/configs/x2000/rootfs-overlay/etc/init.d/S60fre3nder-klipper
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM

runtime=$tmp/runtime
state_dir=$tmp/root-state
fre3nder_home=$tmp/home/fre3nder
printer_data=$fre3nder_home/printer_data
config=$printer_data/config/printer.cfg
log_dir=$printer_data/logs
api_socket=$runtime/klippy.sock
default_config=$tmp/default-printer.cfg
host_mcu_tty=$tmp/klipper_host_mcu
mkdir -p "$state_dir" "$tmp/home"
printf '%s\n' active > "$state_dir/status"
klippy=$tmp/klippy.py
helper=$tmp/f005-mcu-state
transition_helper=$tmp/f005-stock-to-fre3nder
transition_calls=$tmp/transition-calls
auto_transition_file=$tmp/f005-auto-transition.enabled
python=$tmp/python3
called=$tmp/python-called
fail_fast=$tmp/fail-fast
printf '%s\n' '[mcu]' > "$default_config"
cat > "$helper" <<'EOF'
#!/bin/sh
printf '%s\n' "${FIXTURE_MCU_STATE:-unknown}"
[ "${FIXTURE_MCU_STATE:-unknown}" != unknown ]
EOF

cat > "$transition_helper" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$FIXTURE_TRANSITION_CALLS"
printf '%s\n' 'transition fixture stdout'
printf '%s\n' 'transition fixture stderr' >&2
exit "${FIXTURE_TRANSITION_RC:-0}"
EOF

cat > "$klippy" <<'EOF'
import os
import pathlib
import socket
import sys
import time

pathlib.Path(os.environ["FIXTURE_PYTHON_CALLED"]).write_text(
    "\n".join(sys.argv[1:]) + "\n",
    encoding="utf-8",
)

if pathlib.Path(os.environ["FIXTURE_FAIL_FAST"]).exists():
    raise SystemExit(1)

if os.environ.get("FIXTURE_NO_SOCKET") != "1":
    time.sleep(float(os.environ.get("FIXTURE_SOCKET_DELAY", "0")))
    socket_path = sys.argv[sys.argv.index("-a") + 1]
    pathlib.Path(socket_path).unlink(missing_ok=True)
    api_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    api_socket.bind(socket_path)
    api_socket.listen(1)

time.sleep(60)
EOF

ln -s "$(command -v python3)" "$python"
chmod 0755 "$helper" "$transition_helper"

run_service() {
	FRE3NDER_KLIPPER_RUNTIME=$runtime \
	FRE3NDER_MCU_STATE_HELPER=$helper \
	FRE3NDER_PYTHON=$python \
	FRE3NDER_KLIPPY=$klippy \
	FRE3NDER_ROOT_STATE=$state_dir \
	FRE3NDER_HOME_DIR=$fre3nder_home \
	FRE3NDER_KLIPPER_DEFAULT_CONFIG=$default_config \
	FRE3NDER_KLIPPER_HOST_MCU_TTY=$host_mcu_tty \
	FRE3NDER_F005_TRANSITION_HELPER=$transition_helper \
	FRE3NDER_F005_AUTO_TRANSITION_FILE=$auto_transition_file \
	FIXTURE_PYTHON_CALLED=$called \
	FIXTURE_FAIL_FAST=$fail_fast \
	FIXTURE_TRANSITION_CALLS=$transition_calls \
	FIXTURE_TRANSITION_RC=${FIXTURE_TRANSITION_RC:-0} \
	FIXTURE_SOCKET_DELAY=${FIXTURE_SOCKET_DELAY:-0} \
	FIXTURE_NO_SOCKET=${FIXTURE_NO_SOCKET:-0} \
	FIXTURE_MCU_STATE=$1 \
		"$service" "$2"
}

rm -f "$state_dir/status"
run_service fre3nder start
[ "$(cat "$runtime/status")" = degraded-root ]
[ ! -e "$called" ]
printf '%s\n' active > "$state_dir/status"

run_service fre3nder start || true
[ "$(cat "$runtime/status")" = host-mcu-unavailable ]
[ ! -e "$called" ]
ln -s /dev/null "$host_mcu_tty"

run_service stock start
[ "$(cat "$runtime/status")" = stock-mcu ]
[ ! -e "$called" ]
[ ! -e "$transition_calls" ]

rm -rf -- "$runtime"
run_service unknown start
[ "$(cat "$runtime/status")" = unknown-mcu ]
[ ! -e "$called" ]
[ ! -e "$transition_calls" ]

# The opt-in marker must be a regular non-symlink file containing exactly
# "enabled", without even a trailing newline.
printf '%s\n' enabled > "$auto_transition_file"
rm -rf -- "$runtime"
run_service stock start
[ "$(cat "$runtime/status")" = stock-mcu ]
[ ! -e "$called" ]
[ ! -e "$transition_calls" ]

printf '%s' enabled > "$tmp/marker-target"
rm -f "$auto_transition_file"
ln -s "$tmp/marker-target" "$auto_transition_file"
rm -rf -- "$runtime"
run_service stock start
[ "$(cat "$runtime/status")" = stock-mcu ]
[ ! -e "$called" ]
[ ! -e "$transition_calls" ]

# A valid opt-in invokes the transition exactly once and then reaches the
# normal Klippy start path.
rm -f "$auto_transition_file"
printf '%s' enabled > "$auto_transition_file"
rm -rf -- "$runtime"
run_service stock start
[ "$(cat "$runtime/status")" = active ]
[ -e "$called" ]
[ "$(wc -l < "$transition_calls")" -eq 1 ]
[ "$(cat "$transition_calls")" = --write ]
grep -Fxq 'transition fixture stdout' "$runtime/mcu-transition.log"
grep -Fxq 'transition fixture stderr' "$runtime/mcu-transition.log"
run_service fre3nder stop

# A failed transition and an unavailable helper both fail closed.
rm -rf -- "$runtime"
rm -f "$called" "$transition_calls"
if FIXTURE_TRANSITION_RC=1 run_service stock start; then
	:
else
	echo 'failed transition unexpectedly made the service fail' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = mcu-transition-failed ]
[ ! -e "$called" ]
[ "$(wc -l < "$transition_calls")" -eq 1 ]
[ "$(cat "$transition_calls")" = --write ]

rm -rf -- "$runtime"
rm -f "$called" "$transition_calls"
chmod 0644 "$transition_helper"
run_service stock start
[ "$(cat "$runtime/status")" = mcu-transition-unavailable ]
[ ! -e "$called" ]
[ ! -e "$transition_calls" ]
chmod 0755 "$transition_helper"

rm -f "$auto_transition_file"

rm -rf -- "$runtime"
mkdir -p "$runtime"
printf '%s\n' stale > "$api_socket"
run_service fre3nder start
i=0
while [ ! -e "$called" ] && [ "$i" -lt 50 ]; do
	sleep 0.01
	i=$((i + 1))
done
[ -e "$called" ]
[ "$(cat "$runtime/status")" = active ]
[ ! -e "$transition_calls" ]
[ -f "$config" ] && [ ! -L "$config" ]
cmp -s "$default_config" "$config"
[ "$(stat -c '%a' "$config")" = 644 ]
[ -S "$api_socket" ]
grep -Fxq -- '-I' "$called"
grep -Fxq -- "$runtime/printer" "$called"
grep -Fxq -- '-a' "$called"
grep -Fxq -- "$api_socket" "$called"
grep -Fxq -- "$log_dir/klippy.log" "$called"
grep -Fxq -- "$config" "$called"
run_service fre3nder stop
[ ! -e "$runtime/printer" ]
[ ! -e "$api_socket" ]
[ ! -e "$runtime/klippy.pid" ]

# Klippy may be alive before its API socket is ready; S60 must wait.
rm -rf -- "$runtime"
rm -f "$called"
(
	if FIXTURE_SOCKET_DELAY=2 run_service fre3nder start; then
		printf '%s\n' 0 > "$tmp/race-result"
	else
		printf '%s\n' "$?" > "$tmp/race-result"
	fi
) &
race_pid=$!
i=0
while [ ! -e "$called" ] && [ "$i" -lt 50 ]; do
	sleep 0.01
	i=$((i + 1))
done
[ -e "$called" ]
[ ! -e "$tmp/race-result" ]
[ "$(cat "$runtime/status")" = starting ]
[ ! -S "$api_socket" ]
sleep 1
[ ! -e "$tmp/race-result" ]
wait "$race_pid"
[ "$(cat "$tmp/race-result")" = 0 ]
[ "$(cat "$runtime/status")" = active ]
[ -S "$api_socket" ]
run_service fre3nder stop

# A living Klippy without an API socket is not ready.
rm -rf -- "$runtime"
rm -f "$called"
if FIXTURE_NO_SOCKET=1 FRE3NDER_KLIPPER_START_TIMEOUT=1 \
	run_service fre3nder start; then
	echo 'Klippy startup without API socket unexpectedly succeeded' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = startup-timeout ]
[ ! -e "$runtime/klippy.pid" ]
[ ! -e "$api_socket" ]

# Existing printer.cfg is userdata and must never be replaced by the default.
printf '%s\n' '# retained-user-config' > "$config"
rm -rf -- "$runtime"
rm -f "$called"

run_service fre3nder start

i=0
while [ ! -e "$called" ] && [ "$i" -lt 50 ]; do
	sleep 0.01
	i=$((i + 1))
done

[ -e "$called" ]
[ "$(cat "$runtime/status")" = active ]
[ "$(cat "$config")" = '# retained-user-config' ]
grep -Fxq -- "$config" "$called"
grep -Fxq -- "$log_dir/klippy.log" "$called"

run_service fre3nder stop

# A stale PID file must never cause an unrelated live process to be killed.
rm -rf -- "$runtime"
mkdir -p "$runtime"
sleep 60 &
foreign_pid=$!
printf '%s\n' "$foreign_pid" > "$runtime/klippy.pid"

run_service fre3nder stop

kill -0 "$foreign_pid"
[ ! -e "$runtime/klippy.pid" ]

kill "$foreign_pid"
wait "$foreign_pid" 2>/dev/null || true

# A stale live PID must also not be accepted as an already-active Klippy.
rm -rf -- "$runtime"
rm -f "$called"
mkdir -p "$runtime"

sleep 60 &
foreign_pid=$!
printf '%s\n' "$foreign_pid" > "$runtime/klippy.pid"

run_service fre3nder start

i=0
while [ ! -e "$called" ] && [ "$i" -lt 50 ]; do
	sleep 0.01
	i=$((i + 1))
done

[ -e "$called" ]
[ "$(cat "$runtime/status")" = active ]
new_pid=$(cat "$runtime/klippy.pid")
[ "$new_pid" != "$foreign_pid" ]
kill -0 "$foreign_pid"

run_service fre3nder stop
kill "$foreign_pid"
wait "$foreign_pid" 2>/dev/null || true

rm -rf -- "$runtime"
rm -f "$called"
touch "$fail_fast"
if run_service fre3nder start; then
	echo 'fail-fast Klippy startup unexpectedly succeeded' >&2
	exit 1
fi
[ "$(cat "$runtime/status")" = startup-failed ]
[ ! -e "$runtime/klippy.pid" ]
rm -f "$fail_fast"

echo 'fre3nder-x2000 Klipper service fixtures: PASS'
