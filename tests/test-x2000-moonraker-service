#!/bin/sh
set -eu
# S61 integration fixture: verifies gates, state preservation and single service owner.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
service="$root/configs/x2000/rootfs-overlay/etc/init.d/S61fre3nder-moonraker"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM
runtime="$tmp/run/moonraker"
klipper_runtime="$tmp/run/klipper"
root_state="$tmp/run/root"
home="$tmp/home"
printer_data="$home/fre3nder/printer_data"
config="$printer_data/config/moonraker.conf"
default="$tmp/default-moonraker.conf"
camera="$tmp/default-camera.conf"
core="$tmp/fake-package-core"
calls="$tmp/calls"
mockbin="$tmp/bin"
mkdir -p "$runtime" "$klipper_runtime" "$root_state" "$home" "$mockbin"
cat > "$mockbin/chown" <<'MOCK'
#!/bin/sh
exit 0
MOCK
chmod 755 "$mockbin/chown"
cat > "$core" <<'MOCK'
#!/bin/sh
printf '%s\n' "$1 $2" >> "$FIXTURE_CALLS"
case "$1 $2" in
'service-start moonraker')
    [ -S "$FRE3NDER_KLIPPER_API_SOCKET" ] || exit 1
    exit "${FIXTURE_START_RC:-0}"
    ;;
'service-stop moonraker') ;;
*) exit 1 ;;
esac
MOCK
chmod 755 "$core"
printf '%s\n' '[server]' '[include fre3nder/*.conf]' > "$default"
printf '%s\n' '[webcam fre3nder_camera]' > "$camera"
run() {
    PATH="$mockbin:$PATH" FIXTURE_CALLS="$calls" FIXTURE_START_RC="${FIXTURE_START_RC:-0}" \
    FRE3NDER_PACKAGE_CORE="$core" FRE3NDER_MOONRAKER_RUNTIME="$runtime" \
    FRE3NDER_ROOT_STATE="$root_state" \
    FRE3NDER_KLIPPER_RUNTIME="$klipper_runtime" \
    FRE3NDER_KLIPPER_API_SOCKET="$klipper_runtime/klippy.sock" \
    FRE3NDER_HOME_ROOT="$home" \
    FRE3NDER_MOONRAKER_DEFAULT_CONFIG="$default" \
    FRE3NDER_MOONRAKER_CAMERA_DEFAULT_CONFIG="$camera" \
        sh "$service" "$1"
}
run start
[ "$(cat "$runtime/status")" = degraded-root ]
[ ! -e "$calls" ]
printf 'active\n' > "$root_state/status"
run start
[ "$(cat "$runtime/status")" = klipper-unavailable ]
[ ! -e "$calls" ]
python3 - "$klipper_runtime/klippy.sock" <<'PY_SOCKET'
import socket
import sys
s = socket.socket(socket.AF_UNIX)
s.bind(sys.argv[1])
s.close()
PY_SOCKET
printf 'active\n' > "$klipper_runtime/status"
run start
[ "$(cat "$runtime/status")" = active ]
[ -f "$config" ] && cmp "$default" "$config"
[ -f "$printer_data/config/fre3nder/camera.conf" ]
[ "$(cat "$calls")" = 'service-start moonraker' ]
printf 'user-owned config\n' > "$config"
mkdir -p "$printer_data/database" "$printer_data/gcodes"
printf history > "$printer_data/database/fixture"
printf gcode > "$printer_data/gcodes/fixture"
printf log > "$printer_data/logs/fixture"
run start
[ "$(cat "$config")" = 'user-owned config' ]
run stop
[ "$(cat "$runtime/status")" = stopped ]
FIXTURE_START_RC=17 run start
[ "$(cat "$runtime/status")" = app-start-failed ]
[ "$(cat "$config")" = 'user-owned config' ]
[ "$(cat "$printer_data/database/fixture")" = history ]
[ "$(cat "$printer_data/gcodes/fixture")" = gcode ]
[ "$(cat "$printer_data/logs/fixture")" = log ]
! grep -Fq 'start-stop-daemon' "$service"
! grep -Fq 'moonraker-env' "$service"
printf 'fre3nder-x2000 Moonraker system fre3app S61 fixture: PASS\n'
